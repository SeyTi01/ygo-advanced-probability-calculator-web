            <ul>
                <li>@Message("Help.Properties.PropertyExamples", @<strong>@UiText.Get("Help.Properties.PropertyExamples.Part0")</strong>)</li>
                <li>@Message("Help.Properties.CategoryExamples", @<strong>@UiText.Get("Help.Properties.CategoryExamples.Part0")</strong>)</li>
            </ul>
            <p>@UiText.Get("Help.Properties.Overlaps")</p>
