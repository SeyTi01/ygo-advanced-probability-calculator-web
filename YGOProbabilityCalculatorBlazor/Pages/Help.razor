        <p>@Message("Help.Footer.Credits", @<a href="https://github.com/SeyTi01" target="_blank" rel="noopener noreferrer">@UiText.Get("Help.Footer.Credits.Part0")</a>, @<a href="https://ygoprodeck.com/api-guide/" target="_blank" rel="noopener noreferrer">@UiText.Get("Help.Footer.Credits.Part1")</a>)</p>
