                <li>@Message("Help.GettingStarted.DefineCombo", @<strong>@UiText.Get("Help.GettingStarted.DefineCombo.Part0")</strong>)</li>
                <li>@Message("Help.GettingStarted.CheckEffects", @<strong>@UiText.Get("Help.GettingStarted.CheckEffects.Part0")</strong>)</li>
                <li>@Message("Help.GettingStarted.Calculate", @<strong>@UiText.Get("Help.GettingStarted.Calculate.Part0")</strong>, @<strong>@UiText.Get("Help.GettingStarted.Calculate.Part1")</strong>)</li>
            </ol>
            <p>@UiText.Get("Help.GettingStarted.Deactivate")</p>
        </div>
    </details>

    <details id="properties" class="help-topic">
        <summary><h2>@UiText.Get("Help.Properties.Question")</h2></summary>
        <div class="help-topic-body">
