@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<div class="page">
    <main>
        <div class="top-row">
            <div class="top-row-inner">
                @if (IsHelpPage) {
                    <div class="h3 app-title mb-0">Yu-Gi-Oh! Advanced Probability Calculator</div>
                }
                else {
                    <h1 class="h3 app-title mb-0">Yu-Gi-Oh! Advanced Probability Calculator</h1>
                }
                <div class="top-row-controls">
                    <label class="visually-hidden" for="theme-preference">Color theme preference</label>
                    <select id="theme-preference"
                            class="form-select form-select-sm theme-select"
                            aria-label="Color theme preference"
                            title="Color theme preference"
                            value="@ThemePreference"
                            @onchange="ChangeThemePreference">
                        <option value="system">System</option>
                        <option value="light">Light</option>
                        <option value="dark">Dark</option>
                    </select>
                    @if (IsHelpPage) {
                        <a href="/" class="btn btn-outline-primary">Back</a>
                    }
                    else {
                        <a href="/help" class="btn btn-outline-primary">Help</a>
                    }
                </div>
            </div>
        </div>

        <article class="content">
            @Body
        </article>
    </main>
</div>

@code {
    private bool IsHelpPage => new Uri(NavigationManager.Uri).AbsolutePath.TrimEnd('/')
        .Equals("/help", StringComparison.OrdinalIgnoreCase);
    private string ThemePreference { get; set; } = "system";

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender) return;

        try {
            var preference = NormalizeThemePreference(await JSRuntime.InvokeAsync<string>("ygoTheme.getPreference"));
            if (ThemePreference != preference) {
                ThemePreference = preference;
                StateHasChanged();
            }
        }
        catch (JSException) {
            // Theme initialization is optional; a storage or interop failure must not stop the calculator.
        }
    }

    private async Task ChangeThemePreference(ChangeEventArgs args) {
        var preference = NormalizeThemePreference(args.Value?.ToString());
        ThemePreference = preference;

        try {
            await JSRuntime.InvokeVoidAsync("ygoTheme.setPreference", preference);
        }
        catch (JSException) {
            // Keep the control usable if browser storage or JavaScript interop is unavailable.
        }
    }

    private static string NormalizeThemePreference(string? preference) => preference?.ToLowerInvariant() switch {
        "light" => "light",
        "dark" => "dark",
        _ => "system"
    };
}
