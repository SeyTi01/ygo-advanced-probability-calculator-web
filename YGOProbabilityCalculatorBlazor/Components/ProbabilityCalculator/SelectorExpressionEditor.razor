@using YGOProbabilityCalculatorBlazor.Models

<div class="selector-expression" data-selector-path="@Path">
    @if (IsGroup && Rows.Length > 1) {
        @if (IsEditing) { @EditForm() }
        <ExpressionGroup Label="@(Selector.Kind == CardSelectorKind.AllOf ? "All eligibility rows match the same card" : "Any eligibility row may match")">
            @for (int index = 0; index < Rows.Length; index++) {
                int position = index;
                SelectorRow currentRow = Rows[index];
                @if (index > 0) { <ExpressionSeparator Operator="@(Selector.Kind == CardSelectorKind.AllOf ? "AND" : "OR")" OnOperatorChanged="ChangeGroupOperator" /> }
                <div @key="_termKeys[currentRow.Value.Signature]" class="selector-term @(currentRow.Value.Kind != Selector.Kind && currentRow.Value.Kind is CardSelectorKind.AllOf or CardSelectorKind.AnyOf ? "selector-nested-term" : "")">
                <SelectorExpressionEditor @ref="_childEditors[_termKeys[currentRow.Value.Signature]]"
                    Selector="Rows[index].Value" IsRoot="false" Path="@($"{Path}.{index}")" Available="Available" Options="Options"
                    CategoryColorIndices="CategoryColorIndices" RelevantMetadataIdentities="RelevantMetadataIdentities" CategoryRename="CategoryRename" Session="EditorSession"
                    ReplaceSelector="value => ReplaceRow(position, value)" OnRemove="() => RemoveRow(position)"
                    OnValidation="OnValidation" OnEditingChanged="OnEditingChanged" OnEditContainer="BeginEdit" />
                </div>
            }
        </ExpressionGroup>
    }
    else {
        <ExpressionRow Label="@($"Edit {Description(Selector)}")" Expanded="IsEditing" OnEdit="ToggleEdit" InteractiveSummary="IsGroup" @ref="_row">
            <ChildContent>@Summary(Selector, true)</ChildContent>
            <EditorContent>@if (IsEditing) { @EditForm() }</EditorContent>
        </ExpressionRow>
    }
    @if (_nestedIndex is { } nestedIndex && nestedIndex < Terms.Length) {
        <ExpressionGroup Label="Nested conditions" Nested="true">
            <button type="button" class="btn btn-link btn-sm p-0" @onclick="Back">Back to row</button>
            <SelectorExpressionEditor Selector="Terms[nestedIndex]" IsRoot="false" @ref="_nestedEditor" Path="@($"{Path}.nested")"
                Available="Available" Options="Options" CategoryColorIndices="CategoryColorIndices" RelevantMetadataIdentities="RelevantMetadataIdentities" CategoryRename="CategoryRename"
                Session="EditorSession" ReplaceSelector="value => ReplaceTerm(nestedIndex, value)" OnRemove="() => RemoveTerm(nestedIndex)"
                OnValidation="OnValidation" OnEditingChanged="OnEditingChanged" />
        </ExpressionGroup>
    }
</div>

@code {
    private RenderFragment EditForm() => @<RequirementEditForm @key="_mode" @ref="_editForm"
        Title="@(_mode == "add" ? "Add requirement" : _mode == "replace" ? "Replace group" : "Edit requirement")"
        OperandCount="_operands.Count" OperandKey="index => _operands[index]" Operator="@(_operation == CardSelectorKind.AllOf ? "AND" : "OR")" Error="@_error"
        OnSubmit="Save" OnCancel="Cancel" OnKeyDown="HandleKeyDown" OnRemoveOperand="RemoveOperand"
        OnOperatorChanged="@(operation => _operation = operation == "AND" ? CardSelectorKind.AllOf : CardSelectorKind.AnyOf)">
        <BeforeContent>@if (_mode == "add") { <div class="mb-2">@Summary(_seed!)</div> }</BeforeContent>
        <OperandContent Context="position">
            @{ OperandDraft operand = _operands[position]; }
            @if (operand.Group is { } group) {
                <button type="button" class="btn btn-outline-secondary w-100" @onclick="() => EditNested(position)">@Summary(group) <span class="small">Edit</span></button>
            }
            else {
                <RequirementPropertyPicker @key="operand" @ref="_entryInputs[position]" Id="@OperandId(position)" Value="@operand.Identity"
                    Categories="Available" RelevantIdentities="RelevantMetadataIdentities" OnChanged="change => ChangeIdentity(position, change)" />
            }
        </OperandContent>
        <ActionsContent>
            @if (_mode == "edit") {
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => Add(CardSelectorKind.AllOf)">Add property (AND)</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => Add(CardSelectorKind.AnyOf)">Add alternative (OR)</button>
                @if (IsGroup || OnEditContainer.HasDelegate) {
                    <details class="selector-more-actions">
                        <summary>More actions</summary>
                        @if (IsGroup) {
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ReplaceGroup">Replace group</button>
                            @for (int index = 0; index < _operands.Count; index++) {
                                int position = index;
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => GroupOperand(position)">Group condition @(index + 1)</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => RemoveOperand(position)">Remove condition @(index + 1)</button>
                            }
                        }
                        @if (OnEditContainer.HasDelegate) {
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="OnEditContainer">Edit outer group</button>
                        }
                        </details>
                }
            }
            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="RemoveSelf">@(IsGroup ? "Remove group" : "Remove clause")</button>
        </ActionsContent>
    </RequirementEditForm>;

    private RenderFragment Summary(CardSelector selector, bool interactive = false) => @<text>
        @if (selector.Kind is CardSelectorKind.AllOf or CardSelectorKind.AnyOf) {
            CardSelector[] terms = selector.AuthoredTerms.ToArray();
            <ExpressionTerm Count="terms.Length" Operator="@(selector.Kind == CardSelectorKind.AllOf ? "AND" : "OR")"
                OnOperatorChanged="@(interactive ? EventCallback.Factory.Create<string>(this, ChangeGroupOperator) : default)">
                <OperandContent Context="index">@Summary(terms[index])</OperandContent>
            </ExpressionTerm>
        }
        else {
            <ExpressionBadge CssClass="@($"draw-selector-chip {ChipClass(selector)}")" Title="@FullLabel(selector)">@Description(selector)</ExpressionBadge>
        }
    </text>;

    [Parameter] public CardSelector Selector { get; set; } = CardSelector.Any;
    [Parameter] public bool IsRoot { get; set; } = true;
    [Parameter] public string Path { get; set; } = "root";
    [Parameter] public IReadOnlyList<CategoryBase> Available { get; set; } = [];
    [Parameter] public IReadOnlyDictionary<string, int> CategoryColorIndices { get; set; } = new Dictionary<string, int>();
    [Parameter] public IReadOnlySet<string> RelevantMetadataIdentities { get; set; } = new HashSet<string>();
    [Parameter] public RenderFragment? Options { get; set; }
    [Parameter] public CategoryRenameNotice? CategoryRename { get; set; }
    [Parameter] public SelectorEditSession? Session { get; set; }
    [Parameter] public Func<CardSelector, Task>? ReplaceSelector { get; set; }
    [Parameter] public EventCallback<CardSelector> OnChanged { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }
    [Parameter] public EventCallback OnEditContainer { get; set; }
    [Parameter] public EventCallback<bool> OnEditingChanged { get; set; }
    [Parameter] public EventCallback<(CardSelector Selector, string? Message)> OnValidation { get; set; }

    private sealed class OperandDraft(CardSelector selector) {
        public CardSelector Original { get; set; } = selector;
        public string Identity { get; set; } = selector.Kind is CardSelectorKind.LevelAtLeast or CardSelectorKind.NumericRange && NumericPropertyRange.TryFromSelector(selector, out NumericPropertyRange? range) ? range.Identity : selector.CategoryIdentities.FirstOrDefault() ?? "";
        public string? Error { get; set; }
        public CardSelector? Group { get; set; } = selector.Kind is CardSelectorKind.AllOf or CardSelectorKind.AnyOf ? selector : null;
        public CardSelector Build() {
            if (Group is not null) { return Group; }
            if (Original.Kind == CardSelectorKind.Category && Identity == Original.CategoryIdentities[0]
                || NumericPropertyRange.TryFromSelector(Original, out NumericPropertyRange? originalRange) && Identity == originalRange.Identity) { return Original; }
            return Identity.StartsWith("metadata:numeric:", StringComparison.Ordinal) && NumericPropertyRange.TryFromIdentity(Identity, out NumericPropertyRange? range)
                ? range.ToSelector() : new(CardSelectorKind.Category, [Identity]);
        }
    }

    private sealed record SelectorRow(CardSelector Value, CardSelector[] Terms);
    private readonly SelectorEditSession _session = new();
    private readonly object _node = new();
    private readonly string _fieldId = "selector-clause-" + Guid.NewGuid().ToString("N");
    private readonly Dictionary<string, object> _termKeys = new(StringComparer.Ordinal);
    private readonly Dictionary<object, SelectorExpressionEditor> _childEditors = [];
    private readonly List<OperandDraft> _operands = [];
    private readonly Dictionary<int, RequirementPropertyPicker> _entryInputs = [];
    private RequirementEditForm? _editForm;
    private SelectorEditSession EditorSession => Session ?? _session;
    private bool IsEditing => ReferenceEquals(EditorSession.ActiveNode, _node);
    private bool IsGroup => Selector.Kind is CardSelectorKind.AllOf or CardSelectorKind.AnyOf;
    private CardSelector[] Terms { get; set; } = [];
    private SelectorRow[] Rows { get; set; } = [];
    private CardSelector? _previous;
    private CardSelector? _seed;
    private CardSelector[]? _operandContainer;
    private CardSelectorKind _containerOperation;
    private int? _operandIndex;
    private CardSelector? _validationOwner;
    private CardSelectorKind _operation;
    private string _mode = "edit";
    private string? _error;
    private int _renameVersion;
    private bool _focusEntry;
    private bool _focusRow;
    private bool _openNested;
    private int? _nestedIndex;
    private CardSelector? _nestedTarget;
    private ExpressionRow? _row;
    private SelectorExpressionEditor? _nestedEditor;

    private string OperandId(int index) => $"{_fieldId}-{index}";
    private string IdentityLabel(string identity) {
        if (Available.FirstOrDefault(category => category.Identity == identity) is { } category) { return ShortLabel(category); }
        bool metadata = identity.StartsWith("metadata:", StringComparison.Ordinal);
        int separator = metadata ? identity.LastIndexOf(':') : identity.IndexOf(':');
        string value = Uri.UnescapeDataString(identity[(separator + 1)..]);
        return metadata ? System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(value) : value;
    }
    private static string ShortLabel(CategoryBase category) {
        int colon = category.Name.IndexOf(':');
        return category.Source == CategorySource.Metadata && colon > 0 ? category.Name[(colon + 1)..].Trim() : category.Name;
    }
    private string Description(CardSelector selector) => selector.Kind switch {
        CardSelectorKind.AllOf => string.Join(" AND ", selector.AuthoredTerms.Select(Description)),
        CardSelectorKind.AnyOf => string.Join(" OR ", selector.AuthoredTerms.Select(Description)),
        CardSelectorKind.LevelAtLeast => $"Level >= {selector.MinimumLevel}",
        CardSelectorKind.NumericRange => selector.NumericRange!.Description,
        _ => IdentityLabel(selector.CategoryIdentities.FirstOrDefault() ?? "")
    };
    private string FullLabel(CardSelector selector) => selector.Kind == CardSelectorKind.Category
        ? Available.FirstOrDefault(category => category.Identity == selector.CategoryIdentities[0])?.Name ?? Description(selector) : Description(selector);
    private string ChipClass(CardSelector selector) => selector.Kind is CardSelectorKind.LevelAtLeast or CardSelectorKind.NumericRange
        ? "card-property-tag " + CardPropertyColorPalette.GetCssClass((selector.NumericRange?.Key ?? "level") + ":0")
        : Available.FirstOrDefault(category => category.Identity == selector.CategoryIdentities.FirstOrDefault()) is { } category
            ? CategoryChipPalette.GetCssClass(category, CategoryColorIndices) : FallbackChipClass(selector.CategoryIdentities.FirstOrDefault() ?? "");
    private static string FallbackChipClass(string identity) => identity.StartsWith("metadata:", StringComparison.Ordinal)
        ? "card-property-tag " + CardPropertyColorPalette.GetCssClass(identity[9..]) : CategoryChipPalette.GetFallbackCssClass(identity);

    // A row is a maximal adjacent run of direct operands. Nested groups remain
    // independent terms; the projection never changes the stored Boolean tree.
    private static SelectorRow[] ProjectRows(CardSelectorKind operation, CardSelector[] terms) {
        List<SelectorRow> rows = [];
        List<CardSelector> run = [];
        foreach (CardSelector term in terms) {
            if (term.Kind is CardSelectorKind.AllOf or CardSelectorKind.AnyOf) {
                FlushRun();
                rows.Add(new(term, [term]));
            }
            else {
                run.Add(term);
            }
        }
        FlushRun();

        return rows.ToArray();

        void FlushRun() {
            if (run.Count == 0) { return; }
            CardSelector[] operands = run.ToArray();
            rows.Add(new(Combine(operation, operands), operands));
            run.Clear();
        }
    }

    protected override void OnParametersSet() {
        if (CategoryRename is { } rename && rename.Version != _renameVersion) {
            string oldIdentity = $"user:{rename.OldName}";
            string newIdentity = $"user:{rename.NewName}";
            foreach (SelectorRow row in Rows) {
                if (_termKeys.TryGetValue(row.Value.Signature, out object? key)) {
                    _termKeys.TryAdd(row.Value.RenameCategory(oldIdentity, newIdentity).Signature, key);
                }
            }
            foreach (OperandDraft operand in _operands) {
                if (operand.Identity == oldIdentity) { operand.Identity = newIdentity; }
                operand.Group = operand.Group?.RenameCategory(oldIdentity, newIdentity);
                operand.Original = operand.Original.RenameCategory(oldIdentity, newIdentity);
            }
            Rows = Rows.Select(row => new SelectorRow(row.Value.RenameCategory(oldIdentity, newIdentity),
                row.Terms.Select(term => term.RenameCategory(oldIdentity, newIdentity)).ToArray())).ToArray();
            _seed = _seed?.RenameCategory(oldIdentity, newIdentity);
            _operandContainer = _operandContainer?.Select(term => term.RenameCategory(oldIdentity, newIdentity)).ToArray();
            _nestedTarget = _nestedTarget?.RenameCategory(oldIdentity, newIdentity);
            _renameVersion = rename.Version;
        }
        if (!ReferenceEquals(_previous, Selector)) {
            CardSelector[] previousTerms = Terms;
            SelectorRow[] previousRows = Rows;
            Terms = IsGroup ? Selector.AuthoredTerms.ToArray() : [Selector];
            Rows = IsGroup ? ProjectRows(Selector.Kind, Terms) : [];
            HashSet<object> retainedKeys = Rows.Where(row => _termKeys.ContainsKey(row.Value.Signature))
                .Select(row => _termKeys[row.Value.Signature]).ToHashSet();
            foreach (SelectorRow row in Rows) {
                if (_termKeys.TryGetValue(row.Value.Signature, out object? exact)) {
                    retainedKeys.Add(exact);
                    continue;
                }
                SelectorRow? previousRow = previousRows.Where(previousRow => previousRow.Terms.Any(row.Terms.Contains)
                        && _termKeys.TryGetValue(previousRow.Value.Signature, out object? key) && !retainedKeys.Contains(key))
                    .OrderByDescending(previousRow => _childEditors.TryGetValue(_termKeys[previousRow.Value.Signature], out SelectorExpressionEditor? child) && child.IsEditing)
                    .FirstOrDefault();
                if (previousRow is not null) {
                    object key = _termKeys[previousRow.Value.Signature];
                    _termKeys.TryAdd(row.Value.Signature, key);
                    retainedKeys.Add(key);
                }
            }
            if (IsEditing && _mode == "edit" && _previous?.Kind == Selector.Kind) {
                // Preserve local changes, and incorporate newly inserted siblings in
                // authored order so saving a draft cannot erase a concurrent addition.
                List<OperandDraft> refreshed = [];
                foreach (CardSelector term in Terms) {
                    OperandDraft? draft = _operands.FirstOrDefault(operand => operand.Original.Equals(term));
                    if (draft is not null) { refreshed.Add(draft); }
                    else if (!previousTerms.Contains(term)) { refreshed.Add(new(term)); }
                }
                _operands.Clear();
                _operands.AddRange(refreshed);
            }
            if (_nestedTarget is not null) {
                int nested = Array.FindIndex(Terms, term => term.Equals(_nestedTarget));
                _nestedIndex = nested < 0 ? null : nested;
            }
            _previous = Selector;
        }
        HashSet<string> current = Rows.Select(row => row.Value.Signature).ToHashSet(StringComparer.Ordinal);
        foreach (string removed in _termKeys.Keys.Where(signature => !current.Contains(signature)).ToArray()) { _termKeys.Remove(removed); }
        foreach (SelectorRow row in Rows) { _termKeys.TryAdd(row.Value.Signature, new object()); }
        foreach (object removed in _childEditors.Keys.Where(key => !_termKeys.Values.Contains(key)).ToArray()) { _childEditors.Remove(removed); }
    }

    private async Task ChangeGroupOperator(string operation) {
        await BeginEdit();
        _operation = operation == "AND" ? CardSelectorKind.AllOf : CardSelectorKind.AnyOf;
    }

    public async Task<bool> EditGroupOperatorAsync(CardSelector target, string operation) {
        if (Selector.Equals(target)) {
            await ChangeGroupOperator(operation);
            StateHasChanged();
            return true;
        }
        foreach (SelectorExpressionEditor child in _childEditors.Values) {
            if (await child.EditGroupOperatorAsync(target, operation)) { return true; }
        }
        return false;
    }

    private Task ToggleEdit() => IsEditing ? Close(true) : BeginEdit();

    private async Task BeginEdit() {
        if (IsEditing) { return; }
        if (EditorSession.CancelActive is { } cancel) { await cancel(); }
        _nestedIndex = null;
        _nestedTarget = null;
        _mode = "edit";
        _seed = null;
        _operandIndex = null;
        _operands.Clear();
        _operands.AddRange(Terms.Select(term => new OperandDraft(term)));
        _operation = IsGroup ? Selector.Kind : CardSelectorKind.AllOf;
        _validationOwner = Selector;
        EditorSession.ActiveNode = _node;
        EditorSession.CancelActive = () => InvokeAsync(() => Close(false));
        _focusEntry = true;
        await OnEditingChanged.InvokeAsync(true);
    }

    private async Task Close(bool focus) {
        await SetError(null);
        EditorSession.ActiveNode = null;
        EditorSession.CancelActive = null;
        _focusRow = focus;
        await OnEditingChanged.InvokeAsync(false);
        StateHasChanged();
    }
    private Task Cancel() => Close(true);
    private Task HandleKeyDown(KeyboardEventArgs args) => args.Key == "Escape" ? Cancel() : Task.CompletedTask;

    private async Task ChangeIdentity(int index, RequirementPropertyPicker.Change change) {
        _operands[index].Error = change.Error;
        if (change.Error is null) { _operands[index].Identity = change.Value; }
        await Validate();
    }
    private Task Validate() {
        string? error = null;
        foreach (OperandDraft operand in _operands.Where(operand => operand.Group is null)) {
            if (operand.Error is not null) { error = operand.Error; break; }
            if (operand.Identity.Length == 0) { error = "Choose a property or category."; break; }
        }
        return SetError(error);
    }
    private async Task SetError(string? message) {
        _error = message;
        await OnValidation.InvokeAsync((_validationOwner ?? Selector, message));
    }
    private CardSelector Edited() => Combine(_operation, _operands.Select(operand => operand.Build()));

    private async Task Add(CardSelectorKind operation) {
        await Validate();
        if (_error is not null) { return; }
        _seed = Edited();
        _operandIndex = null;
        _operation = operation;
        _mode = "add";
        _operands.Clear();
        _operands.Add(new(CardSelector.Any));
        _focusEntry = true;
        await SetError(null);
    }
    private async Task GroupOperand(int index) {
        await Validate();
        if (_error is not null) { return; }
        _operandContainer = _operands.Select(operand => operand.Build()).ToArray();
        _containerOperation = _operation;
        _operandIndex = index;
        _seed = _operandContainer[index];
        _operation = CardSelectorKind.AnyOf;
        _mode = "add";
        _operands.Clear();
        _operands.Add(new(CardSelector.Any));
        _focusEntry = true;
    }
    private async Task ReplaceGroup() {
        _mode = "replace";
        _operands.Clear();
        _operands.Add(new(CardSelector.Any));
        _focusEntry = true;
        await SetError(null);
    }
    private async Task RemoveOperand(int index) {
        if (_operands.Count == 1) { await RemoveSelf(); return; }
        _operands.RemoveAt(index);
        await Validate();
    }
    private async Task Save() {
        await Validate();
        if (_error is not null || _operands.Count == 0) { return; }
        if (await Apply(BuildResult)) { await Close(true); }
    }
    private CardSelector BuildResult() {
        CardSelector value = _mode == "add" ? Combine(_operation, [_seed!, Edited()]) : Edited();
        return _mode == "add" && _operandIndex is { } position
            ? Combine(_containerOperation, _operandContainer!.Select((term, index) => index == position ? value : term)) : value;
    }
    private static CardSelector Combine(CardSelectorKind kind, IEnumerable<CardSelector> terms) => kind == CardSelectorKind.AllOf
        ? CardSelector.AllOfSelectors(terms) : CardSelector.AnyOfSelectors(terms);
    private async Task Publish(CardSelector value) {
        if (Selector.Equals(value)) { return; }
        if (ReplaceSelector is { } replace) { await replace(value); }
        else { await OnChanged.InvokeAsync(value); }
    }
    private async Task<bool> Apply(Func<CardSelector> create) {
        try { await Publish(create()); await SetError(null); return true; }
        catch (ArgumentException) { await SetError("Filter is too large or too deeply grouped."); return false; }
    }
    private async Task ReplaceRow(int position, CardSelector value) {
        SelectorRow row = Rows[position];
        CardSelector updated = Combine(Selector.Kind, Rows.SelectMany((current, index) => index == position ? [value] : current.Terms));
        _termKeys.TryAdd(value.Signature, _termKeys[row.Value.Signature]);
        bool rowRetained = updated.Kind is CardSelectorKind.AllOf or CardSelectorKind.AnyOf
            && ProjectRows(updated.Kind, updated.AuthoredTerms.ToArray()).Any(projected => projected.Value.Equals(value));
        await Publish(updated);
        if (!rowRetained) { _focusRow = true; StateHasChanged(); }
    }
    private async Task RemoveRow(int position) {
        CardSelector[] remaining = Terms.Where(term => !Rows[position].Terms.Contains(term)).ToArray();
        if (remaining.Length == 0) { await OnRemove.InvokeAsync(); }
        else { await Publish(Combine(Selector.Kind, remaining)); }
        _focusRow = true;
        StateHasChanged();
    }
    private async Task ReplaceTerm(int position, CardSelector value) {
        await Publish(Combine(Selector.Kind, Terms.Select((term, index) => index == position ? value : term)));
        _nestedIndex = null;
        _nestedTarget = null;
        _focusRow = true;
        StateHasChanged();
    }
    private async Task RemoveTerm(int position) {
        CardSelector[] remaining = Terms.Where((term, index) => index != position).ToArray();
        _nestedIndex = null;
        _nestedTarget = null;
        if (remaining.Length == 0) { await OnRemove.InvokeAsync(); }
        else { await Publish(Combine(Selector.Kind, remaining)); }
        _focusRow = true;
    }
    private async Task RemoveSelf() { await Close(false); await OnRemove.InvokeAsync(); }
    private async Task EditNested(int index) {
        await Close(false);
        _nestedIndex = index;
        _nestedTarget = Terms[index];
        _openNested = true;
    }
    private async Task Back() {
        if (EditorSession.CancelActive is { } cancel) { await cancel(); }
        _nestedIndex = null;
        await BeginEdit();
    }
    private async ValueTask FocusFirstRow() {
        if (!(IsGroup && Rows.Length > 1) && _row is not null) { await _row.FocusAsync(); return; }
        foreach (SelectorRow row in Rows) {
            if (_termKeys.TryGetValue(row.Value.Signature, out object? key) && _childEditors.TryGetValue(key, out SelectorExpressionEditor? child)) {
                await child.FocusFirstRow();
                return;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (_openNested && _nestedEditor is not null) {
            _openNested = false;
            await _nestedEditor.BeginEdit();
            _nestedEditor.StateHasChanged();
        }
        if (_focusEntry && IsEditing) {
            int level = _operands.FindIndex(operand => NumericPropertyRange.TryFromIdentity(operand.Identity, out _) && operand.Group is null);
            int entry = _operands.FindIndex(operand => operand.Group is null);
            if (level >= 0 && _entryInputs.TryGetValue(level, out RequirementPropertyPicker? levelInput)) {
                _focusEntry = false;
                await levelInput.FocusAsync(number: true);
            }
            else if (entry >= 0 && _entryInputs.TryGetValue(entry, out RequirementPropertyPicker? entryInput)) {
                _focusEntry = false;
                await entryInput.FocusAsync();
            }
            else if (_editForm is not null) {
                _focusEntry = false;
                await _editForm.FocusAsync();
            }
        }
        if (_focusRow) {
            _focusRow = false;
            await FocusFirstRow();
        }
    }
}
