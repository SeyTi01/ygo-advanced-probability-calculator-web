@inject YGOProbabilityCalculatorBlazor.Services.Interface.ICardInfoService CardInfoService
@using YGOProbabilityCalculatorBlazor.Models
@using YGOProbabilityCalculatorBlazor.Services.CardEffects
@using YGOProbabilityCalculatorBlazor.Services.ProbabilityCalculator
@using Microsoft.AspNetCore.Components.Web

<section class="card-simulation mb-3" aria-label="@(UiText.Get("Ui.Simulation"))" @onkeydown="HandleKeyDown" @oninput:stopPropagation="true">
    <div class="simulation-heading">
        <span class="simulation-source">
            @if (IsSupportedBuiltIn) {
                <svg class="simulation-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false">
                    <circle cx="12" cy="12" r="9" /><path d="m7.5 12 3 3 6-6" />
                </svg>
            }
            else if (IsUnconfigured) {
                <svg class="simulation-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false">
                    <path d="M4 7h4m4 0h8M4 17h8m4 0h4" /><circle cx="10" cy="7" r="2" /><circle cx="14" cy="17" r="2" />
                </svg>
            }
            @SourceLabel
        </span>
        @if (_effect.Source == EffectSource.BuiltIn && _effect.CanExecute && _effect.Support != EffectSupport.ModeledWithinRules) {
            <span class="simulation-status text-warning-emphasis">@(_effect.Support == EffectSupport.Partial ? UiText.Get("Ui.Partial") : UiText.Get("Ui.Unmodeled"))</span>
        }
        @if (!_effect.CanExecute) {
            <span class="text-danger" role="status">@(UiText.Get("Ui.UnsupportedExecutionModel"))</span>
        }
    </div>
    @if (!IsUnconfigured && _effect.Source != EffectSource.BuiltIn && Card.Search is null) {
        <div class="simulation-summary">@DrawEffectPresentation.DescribePlan(Card.EffectPlan, CategoryBases)</div>
    }
    @if (!_effect.CanExecute) {
        <div class="small text-danger" role="alert">@(UiText.Get("Ui.ThisSavedEffectCannotRunInThisCalculator"))</div>
    }
    else if (ModeNotice is { } notice) {
        <div id="cardDrawModeHelp@(Index)" class="simulation-mode small" role="note">@notice</div>
    }
    @if ((_draft is not null ? _draft.Search : Card.Search) is { } search) {
        <div class="simulation-summary">@SearchSummary(_draft ?? Card)</div>
        <div class="simulation-targets small" role="status" aria-label="@(UiText.Get("Ui.CurrentSearchTargets"))">
            @(UiText.Format("Effect.Targets", SearchTargets(search) is { Length: > 0 } targets ? string.Join(", ", targets) : UiText.Get("Ui.None")))
        </div>
    }
    @if (Card.HasEffect && !Card.SimulationEnabled) {
        <div class="simulation-disabled small text-body-secondary" role="status">@(UiText.Get("Ui.SimulationDisabled"))</div>
    }
    <div class="simulation-actions">
        @if (_effect.CanExecute) {
            <button @ref="_editButton" type="button" class="btn btn-sm btn-link simulation-edit"
                    aria-expanded="@(_draft is not null ? "true" : "false")" aria-controls="simulationEditor@(Index)"
                    @onclick="ToggleEditor">@EditLabel</button>
        }
        @if (Card.HasEffect) {
            <button type="button" class="btn btn-sm btn-link simulation-toggle" @onclick="ToggleSimulation">@(UiText.Get(Card.SimulationEnabled ? "Ui.DisableSimulation" : "Ui.EnableSimulation"))</button>
        }
        @if (_effect.CanRestore && _effect.Source != EffectSource.BuiltIn) {
            <button type="button" class="btn btn-sm btn-link simulation-restore" @onclick="Restore">@(UiText.Get("Ui.RestoreBuiltInSimulation"))</button>
        }
        @if (HasDetails) {
            <button @ref="_detailsButton" type="button" class="btn btn-sm btn-link simulation-details-toggle"
                    aria-expanded="@(_detailsOpen ? "true" : "false")" aria-controls="simulationDetails@(Index)"
                    title="@(_performanceNote ? UiText.Get("Ui.ModelNotesIncludePerformanceGuidance") : null)"
                    @onclick="() => _detailsOpen = !_detailsOpen">@(UiText.Get("Ui.ModelNotes"))</button>
        }
    </div>
    @if (_detailsOpen && HasDetails) {
        <div id="simulationDetails@(Index)" class="simulation-details small">
            @if (_performanceNote) {
                <p class="simulation-performance"><strong>@(UiText.Get("Ui.Performance"))</strong> @(UiText.Get("Ui.ThisEffectRequiresDetailedHandStateCalculationInEffectModesAndCanBecomeExpensiveInComple"))</p>
            }
            @if (_effect.Source == EffectSource.BuiltIn) {
                @if (!string.IsNullOrWhiteSpace(_effect.Limitations)) {
                    <p class="simulation-limitations"><strong>@(UiText.Get("Ui.ModelLimits"))</strong> @_effect.Limitations</p>
                }
                @if (HasSavedRevisionDetails) {
                    <p>@(UiText.Format("Effect.SavedRevision", Card.EffectProfile.Revision))</p>
                    @if (_effect.CanRestore) {
                        <button type="button" class="btn btn-sm btn-outline-secondary simulation-restore" @onclick="Restore">@(UiText.Get("Ui.RestoreBuiltInSimulation"))</button>
                    }
                }
            }
            else if (_effect.Source == EffectSource.LegacySnapshot) {
                <p>@(UiText.Get("Ui.Savedsettingsnobuiltinrevisionrecorded"))</p>
            }
        </div>
    }
    @if (_draft is not null) {
        <div id="simulationEditor@(Index)" class="simulation-editor">
            <div class="small fw-semibold mb-2">@(UiText.Get("Ui.CustomSimulation"))</div>
            @if (_draft.PostDrawDeckMillCount > 0) {
                <div class="form-text simulation-mill-note">@(UiText.Format("Effect.PreservedMill", _draft.PostDrawDeckMillCount))</div>
            }
            @if (Error is not null) {
                <div class="alert alert-danger py-2" role="alert">@Error</div>
            }
            <label for="cardDraw@(Index)" class="form-label">@(UiText.Get("Ui.Effect"))</label>
            <div class="d-flex flex-wrap align-items-center gap-3">
                <select @ref="_drawInput" id="cardDraw@(Index)" class="form-select form-select-sm w-auto"
                        value="@(_draft.Search is not null ? "search" : _draft.DrawCount?.ToString() ?? string.Empty)"
                         @onchange="e => ChangeDrawCount(e.Value)">
                    <option value="">@(UiText.Get("Ui.None"))</option>
                    <option value="1">@(UiText.Get("Ui.Draw1"))</option>
                    <option value="2">@(UiText.Get("Ui.Draw2"))</option>
                    <option value="3">@(UiText.Get("Ui.Draw3"))</option>
                    <option value="search">@(UiText.Get("Ui.Search1"))</option>
                </select>
                @if (_draft.EffectPlan.ActivationLimit is int limit) {
                    <div class="form-text">@(UiText.Format("Effect.PreservedAllowance", limit))</div>
                }
                else if (_draft.HasEffect && _draft.Search?.Modes is null) {
                    <div class="form-check form-switch mb-0">
                        <input id="@OnceInputId" class="form-check-input" type="checkbox" role="switch"
                               checked="@_draft.OncePerTurn" @onchange="e => ChangeOncePerTurn(e.Value)" />
                        <label for="@OnceInputId" class="form-check-label">@(UiText.Get("Ui.OncePerTurn"))</label>
                    </div>
                }
                @if (_draft.HasEffect) {
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <label for="cardCost@(Index)" class="form-label mb-0">@(_draft.Search is null ? UiText.Get("Effect.BeforeDrawing") : UiText.Get("Effect.BeforeSearching"))</label>
                        <select id="cardCost@(Index)" class="form-select form-select-sm w-auto"
                                value="@_draft.PreDrawRemovalCount"
                                @onchange="e => ChangePreDrawRemovalCount(e.Value)">
                            <option value="0">@(UiText.Get("Ui.None"))</option>
                            <option value="1">@(UiText.Get("Ui.Remove1"))</option>
                            <option value="2">@(UiText.Get("Ui.Remove2"))</option>
                        </select>
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <label for="cardDiscard@(Index)" class="form-label mb-0">@(_draft.Search is null ? UiText.Get("Effect.AfterDrawing") : UiText.Get("Effect.AfterSearching"))</label>
                        <select id="cardDiscard@(Index)" class="form-select form-select-sm w-auto"
                                value="@_draft.PostDrawDiscardCount"
                                @onchange="e => ChangePostDrawDiscardCount(e.Value)">
                            <option value="0">@(UiText.Get("Ui.None"))</option>
                            <option value="1">@(UiText.Get("Ui.Remove1"))</option>
                            <option value="2">@(UiText.Get("Ui.Remove2"))</option>
                        </select>
                    </div>
                }
            </div>
            @if (_draft.PreDrawRemovalCount > 0) {
                <div class="mt-2 small">@(_draft.Search is null ? UiText.Get("Effect.BeforeDrawingRemoval") : UiText.Get("Effect.BeforeSearchingRemoval"))</div>
                <PostDrawSelectorEditor Id="@($"cardCostEligibility{Index}")" Selector="_draft.PreDrawSelector"
                                        CategoryBases="CategoryBases"
                                        RelevantMetadataCategoryIdentities="RelevantMetadataCategoryIdentities"
                                        CategoryColorIndices="CategoryColorIndices"
                                        ShowHelp="false"
                                        CategoryRename="CategoryRename" OnEditingChanged='editing => SelectorEditing("cost-filter", editing)'
                                        OnError='error => SelectorError("cost-filter", error)'
                                        OnChanged='selector => SetDraft(_draft.WithPreDrawSelector(selector), "selector")' />
            }
            @if (_draft.PostDrawDiscardCount > 0) {
                <div class="mt-2 small">@(_draft.Search is null ? UiText.Get("Effect.AfterDrawingRemoval") : UiText.Get("Effect.AfterSearchingRemoval"))</div>
                <PostDrawSelectorEditor Id="@($"cardEligibility{Index}")" Selector="_draft.PostDrawSelector"
                                        CategoryBases="CategoryBases"
                                        RelevantMetadataCategoryIdentities="RelevantMetadataCategoryIdentities"
                                        CategoryColorIndices="CategoryColorIndices"
                                        ShowHelp="false" OnError='error => SelectorError("removal-filter", error)'
                                        CategoryRename="CategoryRename" OnEditingChanged='editing => SelectorEditing("removal-filter", editing)'
                                        OnChanged='selector => SetDraft(_draft.WithPostDrawSelector(selector), "selector")' />
            }
            @if (_draft.MinimumHandSize > 0) {
                <div class="form-text">@(UiText.Format("Effect.PreservedHandSize", _draft.MinimumHandSize))</div>
            }
            @if (_draft.Search?.Modes is { } modes) {
                <div class="form-text">@DrawEffectPresentation.DescribePlan(_draft.EffectPlan, CategoryBases)</div>
            }
            else if (_draft.Search is { } draftSearch) {
                <PostDrawSelectorEditor Id="@($"cardSearchEligibility{Index}")" Selector="draftSearch.Selector"
                    CategoryBases="CategoryBases" RelevantMetadataCategoryIdentities="RelevantMetadataCategoryIdentities"
                    CategoryColorIndices="CategoryColorIndices" ShowHelp="false"
                    CategoryRename="CategoryRename" OnEditingChanged='editing => SelectorEditing("search-filter", editing)'
                    OnChanged="ChangeSearchSelector" OnError='error => SelectorError("search-filter", error)' />
            }
            @if (_draft.DrawCount is not null) {
                <details class="simulation-advanced mt-2">
                    <summary>@(_draft.PreDrawDeckRemovalCount > 0 ? UiText.Format("Effect.AdvancedWithBanish", _draft.PreDrawDeckRemovalCount) : UiText.Get("Effect.Advanced"))</summary>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <label for="cardDeckCost@(Index)" class="form-label mb-0">@(UiText.Get("Ui.BanishFromDeck"))</label>
                        <input id="cardDeckCost@(Index)" class="form-control form-control-sm" type="number" min="0" max="60"
                               style="width: 4.5rem" value="@_draft.PreDrawDeckRemovalCount"
                               @onchange="e => ChangePreDrawDeckRemovalCount(e.Value)" />
                    </div>
                    <div class="form-text">@(UiText.Get("Ui.Deckdepletionismodeledsearchtargetsurvivalfollowsthereportedresultaccuracy"))</div>
                </details>
            }
            <div class="d-flex gap-2 mt-3">
                <button type="button" class="btn btn-primary btn-sm simulation-save" disabled="@(Error is not null || _filterEdits.Count > 0)"
                        title="@(_filterEdits.Count > 0 ? UiText.Get("Ui.SaveOrCancelTheConditionEditFirst") : null)" @onclick="Save">@(UiText.Get("Ui.Save"))</button>
                <button type="button" class="btn btn-outline-secondary btn-sm simulation-cancel" @onclick="Cancel">@(UiText.Get("Ui.Cancel"))</button>
            </div>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public Card Card { get; set; } = null!;
    [Parameter] public IReadOnlyList<Card> Deck { get; set; } = [];
    [Parameter] public int Index { get; set; }
    [Parameter] public bool DrawEffectsEnabled { get; set; } = true;
    [Parameter] public IReadOnlyList<CategoryBase> CategoryBases { get; set; } = [];
    [Parameter] public IReadOnlySet<string> RelevantMetadataCategoryIdentities { get; set; } = new HashSet<string>(StringComparer.Ordinal);
    [Parameter] public IReadOnlyDictionary<string, int> CategoryColorIndices { get; set; } = new Dictionary<string, int>(StringComparer.Ordinal);
    [Parameter] public CategoryRenameNotice? CategoryRename { get; set; }
    [Parameter] public EventCallback<Card> OnChanged { get; set; }

    private EffectiveCardEffect _effect = null!;
    private Card? _previous;
    private Card? _draft;
    private readonly Dictionary<string, string> _errors = [];
    private readonly Dictionary<string, string> _filterErrors = [];
    private readonly HashSet<string> _filterEdits = [];
    private string? Error => _errors.Values.Concat(_filterErrors.Values).FirstOrDefault();
    private bool _detailsOpen;
    private bool _performanceNote;
    private bool _focusDraw;
    private bool _focusEdit;
    private int _renameVersion;
    private ElementReference _drawInput;
    private ElementReference _editButton;
    private ElementReference _detailsButton;

    // New manual entries are empty legacy profiles; unknown catalog entries are
    // empty custom profiles with a canonical identity. Neither has a built-in.
    // Preserve explicit manual custom None and maintained-card overrides.
    private bool IsUnconfigured => !Card.HasEffect && _effect.Maintained is null
        && _effect.CanExecute && (_effect.Source == EffectSource.LegacySnapshot
            || (_effect.Source == EffectSource.Custom && Card.EffectProfile.CanonicalCardId is not null));
    private bool IsSupportedBuiltIn => _effect.Source == EffectSource.BuiltIn && _effect.CanExecute
        && _effect.Support == EffectSupport.ModeledWithinRules;
    private string SourceLabel => IsUnconfigured ? UiText.Get("Ui.NoBuiltInSimulation") : _effect.Source switch {
        EffectSource.BuiltIn => UiText.Get("Ui.BuiltInSimulation"),
        EffectSource.Custom => UiText.Get("Ui.CustomSimulation"),
        _ => UiText.Get("Ui.SavedSimulation")
    };
    private string EditLabel => _draft is not null ? UiText.Get("Ui.CloseEditor") : !Card.HasEffect && _effect.Source != EffectSource.BuiltIn
        ? UiText.Get("Ui.ConfigureSimulation") : UiText.Get("Ui.CustomizeSimulation");
    private bool HasSavedRevisionDetails => _effect.Source == EffectSource.BuiltIn
        && !_effect.UsesCurrentDescription;
    private bool HasDetails => _performanceNote || (_effect.Source == EffectSource.BuiltIn
        && (!string.IsNullOrWhiteSpace(_effect.Limitations) || HasSavedRevisionDetails))
        || (_effect.Source == EffectSource.LegacySnapshot && Card.HasEffect);
    private string? ModeNotice => Card.HasEffect && !DrawEffectsEnabled
        ? UiText.Get("Ui.OpeningHandOnlySavedSimulationIsOff")
        : null;

    private string SearchSummary(Card card) => _effect.Source == EffectSource.BuiltIn && card.EffectPlan == Card.EffectPlan
            ? _effect.Summary
            : UiText.Get("Ui.Search1CardFromDeck");

    private string[] SearchTargets(SearchEffectPlan search) {
        List<Card> targets = CategoryMembership.Materialize(Deck, CategoryBases)
            .Where(card => card.Id != Card.Id && search.Matches(card))
            .GroupBy(TargetIdentity, StringComparer.Ordinal)
            .Select(group => group.FirstOrDefault(card => !string.IsNullOrWhiteSpace(card.Name)) ?? group.First())
            .ToList();
        Dictionary<string, int> nameCounts = targets
            .GroupBy(TargetName, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(group => group.Key, group => group.Count(), StringComparer.OrdinalIgnoreCase);
        Dictionary<string, int> customNameIndices = [];

        return targets.Select(target => {
            string name = TargetName(target);
            if (nameCounts[name] == 1) {
                return name;
            }

            if (target.ExternalCardId is > 0) {
                return $"{name} ({target.ExternalCardId.Value})";
            }

            customNameIndices.TryGetValue(name, out int index);
            customNameIndices[name] = ++index;
            return UiText.Format("Ui.0Custom1", name, index);
        }).ToArray();
    }

    private static string TargetIdentity(Card card) => card.ExternalCardId is > 0
        ? $"catalog:{card.ExternalCardId.Value}"
        : $"entry:{card.Id}";

    private string TargetName(Card card) => string.IsNullOrWhiteSpace(card.Name) ? UiText.Get("Ui.UnnamedCard") : DisplayLabels.Card(card, CardInfoService.GetLocalizedCardName(card));

    private void ToggleEditor() {
        if (_draft is not null) {
            CloseEditor();
            return;
        }

        _draft = Card;
        _errors.Clear();
        _filterErrors.Clear();
        _filterEdits.Clear();
        _focusDraw = true;
    }

    private void CloseEditor() {
        _draft = null;
        _errors.Clear();
        _filterErrors.Clear();
        _filterEdits.Clear();
        _focusEdit = true;
    }

    private void Cancel() => CloseEditor();

    private async Task Save() {
        if (_draft is null || Error is not null || _filterEdits.Count > 0) {
            return;
        }

        DrawEffectPlan plan = _draft.EffectPlan;
        if (plan == Card.EffectPlan) {
            CloseEditor();
            return;
        }

        bool missingCategory = plan.HandCostSelector.CategoryIdentities.Concat(plan.RemovalSelector.CategoryIdentities)
            .Concat(plan.Search?.Selector.CategoryIdentities ?? [])
            .Any(identity => identity.StartsWith("user:", StringComparison.Ordinal) && !CategoryBases.Any(category => category.Identity == identity));
        if (missingCategory) {
            _errors["selector"] = UiText.Get("Ui.ASelectedCategoryWasRemovedUpdateTheEligibilityFilter");
            return;
        }

        CloseEditor();
        await OnChanged.InvokeAsync(Card.WithEffect(plan, Card.EffectProfile.AsCustom()));
    }

    private Task ToggleSimulation() => OnChanged.InvokeAsync(Card.WithSimulationEnabled(!Card.SimulationEnabled));

    private async Task Restore() {
        CloseEditor();
        _detailsOpen = false;
        await OnChanged.InvokeAsync(CardEffectRegistry.Default.RestoreBuiltIn(Card));
    }

    private async Task HandleKeyDown(KeyboardEventArgs args) {
        if (args.Key != "Escape") {
            return;
        }

        if (_draft is not null) {
            CloseEditor();
        }
        else if (_detailsOpen) {
            _detailsOpen = false;
            await _detailsButton.FocusAsync();
        }
    }

    private void SetDraft(Card draft, string field) {
        _draft = draft;
        _errors.Remove(field);
        _errors.Remove("selector");
        if (draft.Search is null) { ClearSelectorState("search-filter"); }
        if (draft.PreDrawRemovalCount == 0) { ClearSelectorState("cost-filter"); }
        if (draft.PostDrawDiscardCount == 0) { ClearSelectorState("removal-filter"); }
        if (draft.DrawCount is null) {
            _errors.Clear();
        }
    }

    private void ChangeDrawCount(object? value) {
        string? text = value?.ToString();
        if (string.IsNullOrEmpty(text)) {
            SetDraft(_draft!.WithDrawCount(null).WithSearch(null), "draw");
        }
        else if (text == "search") {
            SearchEffectPlan search = _effect.Maintained?.Plan.Search ?? new(CardSelector.Any, false);
            Card draft = _draft!.WithDrawCount(null).WithSearch(search);
            draft = _effect.Maintained?.Plan.Search is not null
                ? draft.WithEffect(_effect.Maintained.Plan, draft.EffectProfile.AsCustom())
                : draft.WithOncePerTurn(false);
            SetDraft(draft, "draw");
        }
        else if (int.TryParse(text, out int count) && count is >= 1 and <= 3) {
            SetDraft(_draft!.WithDrawCount(count), "draw");
        }
        else {
            _errors["draw"] = UiText.Get("Ui.ChooseNoneDraw13OrSearch1");
        }
    }

    private void ChangeSearchSelector(CardSelector selector) {
        // A deliberate filter edit creates a hypothetical custom search over all
        // assigned roles/properties. Merely opening/saving an older draft keeps
        // its saved provenance policy, including schema-6 true/false values.
        SetDraft(_draft!.WithSearch(_draft.Search! with { Selector = selector, ObjectiveMetadataOnly = false }), "selector");
    }

    private void SelectorError(string field, string? error) {
        if (error is null) {
            _filterErrors.Remove(field);
        }
        else {
            _filterErrors[field] = error;
        }
    }

    private void SelectorEditing(string field, bool editing) {
        if (editing) { _filterEdits.Add(field); }
        else { _filterEdits.Remove(field); }
    }

    private void ClearSelectorState(string field) {
        _filterErrors.Remove(field);
        _filterEdits.Remove(field);
    }

    private string OnceInputId => _draft?.Search is null ? $"cardDrawOnce{Index}" : $"cardSearchOnce{Index}";

    private void ChangeOncePerTurn(object? value) {
        if (value is bool oncePerTurn) {
            SetDraft(_draft!.WithOncePerTurn(oncePerTurn), "once");
        }
    }

    private void ChangePreDrawDeckRemovalCount(object? value) {
        if (int.TryParse(value?.ToString(), out int count) && count is >= 0 and <= 60) {
            SetDraft(_draft!.WithPreDrawDeckRemovalCount(count), "deck");
        }
        else {
            _errors["deck"] = UiText.Get("Ui.ChooseADeckBanishCountFrom0To60");
        }
    }

    private void ChangePreDrawRemovalCount(object? value) {
        if (int.TryParse(value?.ToString(), out int count) && count is >= 0 and <= 2) {
            SetDraft(_draft!.WithPreDrawRemovalCount(count), "before");
        }
        else {
            _errors["before"] = UiText.Get("Ui.ChooseNoneRemove1OrRemove2");
        }
    }

    private void ChangePostDrawDiscardCount(object? value) {
        if (int.TryParse(value?.ToString(), out int count) && count is >= 0 and <= 2) {
            SetDraft(_draft!.WithPostDrawDiscardCount(count), "after");
        }
        else {
            _errors["after"] = UiText.Get("Ui.ChooseNoneRemove1OrRemove2");
        }
    }

    protected override void OnParametersSet() {
        if (CategoryRename is { } rename && rename.Version != _renameVersion) {
            if (_draft is not null) {
                _draft = RenameFilters(_draft, rename);
            }
            if (_previous is not null) {
                _previous = RenameFilters(_previous, rename);
            }
            _renameVersion = rename.Version;
        }

        if (_previous is not null && (_previous.Id != Card.Id || _previous.EffectProfile != Card.EffectProfile || _previous.EffectPlan != Card.EffectPlan)) {
            _draft = null;
            _errors.Clear();
            _filterErrors.Clear();
            _filterEdits.Clear();
            _detailsOpen = false;
        }

        if (_previous is null || _previous.EffectPlan != Card.EffectPlan
            || _previous.EffectProfile.ExecutionModel != Card.EffectProfile.ExecutionModel) {
            _performanceNote = DrawEffectPerformance.RequiresDetailedHandState(Card.EffectPlan, Card.EffectProfile.ExecutionModel);
        }

        _previous = Card;
        _effect = EffectDescriptions.Describe(Card);
    }

    private static Card RenameFilters(Card card, CategoryRenameNotice rename) => card.WithEffect(card.EffectPlan with {
        HandCostSelector = card.PreDrawSelector.RenameCategory($"user:{rename.OldName}", $"user:{rename.NewName}"),
        RemovalSelector = card.PostDrawSelector.RenameCategory($"user:{rename.OldName}", $"user:{rename.NewName}"),
        Search = card.Search?.RenameCategory($"user:{rename.OldName}", $"user:{rename.NewName}")
    }, card.EffectProfile);

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (_focusDraw && _draft is not null) {
            _focusDraw = false;
            await _drawInput.FocusAsync();
        }
        if (_focusEdit && _effect.CanExecute) {
            _focusEdit = false;
            await _editButton.FocusAsync();
        }
    }
}
