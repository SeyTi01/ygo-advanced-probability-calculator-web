@using YGOProbabilityCalculatorBlazor.Models
@using YGOProbabilityCalculatorBlazor.Components.Shared

<div class="accordion-item combo-editor @(Combo.Active ? "" : "entry-inactive") @(RecentlyMoved ? "reorder-moved-feedback" : "")">
    <div class="accordion-header entry-editor-header combo-editor-header">
        <h2 class="entry-heading">
            <button class="accordion-button flex-grow-1 @(Index == ActiveComboIndex ? "" : "collapsed")"
                    type="button"
                    aria-expanded="@(Index == ActiveComboIndex ? "true" : "false")"
                    aria-controls="combo@(Index)"
                    @onclick="ToggleCombo">
                <span class="combo-header-content">
                    <span class="combo-header-name">@ComboDisplayName</span>

                    @if (AssignedGroup is { } assignedGroup) {
                        <small class="combo-group-membership text-body-secondary" aria-label="@($"Group: {assignedGroup.Name}")">
                            <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false">
                                <path d="M2 2.5A1.5 1.5 0 0 1 3.5 1h9A1.5 1.5 0 0 1 14 2.5v1A1.5 1.5 0 0 1 12.5 5h-9A1.5 1.5 0 0 1 2 3.5zm1 0v1a.5.5 0 0 0 .5.5h9a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5h-9a.5.5 0 0 0-.5.5m-1 4A1.5 1.5 0 0 1 3.5 5h9A1.5 1.5 0 0 1 14 6.5v1A1.5 1.5 0 0 1 12.5 9h-9A1.5 1.5 0 0 1 2 7.5zm1 0v1a.5.5 0 0 0 .5.5h9a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5h-9a.5.5 0 0 0-.5.5m-1 4A1.5 1.5 0 0 1 3.5 9h9a1.5 1.5 0 0 1 1.5 1.5v1a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 11.5zm1 0v1a.5.5 0 0 0 .5.5h9a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5h-9a.5.5 0 0 0-.5.5" fill="currentColor"/>
                            </svg>
                            <span>@assignedGroup.Name</span>
                        </small>
                    }

                    @if (ConstraintCount > 0) {
                        @for (int categoryIndex = 0; categoryIndex < Math.Min(Combo.Categories.Count, MaxHeaderBadges); categoryIndex++) {
                            int currentCategoryIndex = categoryIndex;
                            ComboCategory category = Combo.Categories[currentCategoryIndex];
                            <span class="expression-term">
                                @if (currentCategoryIndex > 0) { <span class="expression-and" aria-hidden="true">+</span> }
                                @CategoryBadge(category)
                            </span>
                        }
                        @for (int cardIndex = 0; cardIndex < Math.Min(Combo.Cards.Count, Math.Max(0, MaxHeaderBadges - Combo.Categories.Count)); cardIndex++) {
                            int currentCardIndex = cardIndex;
                            ComboCard card = Combo.Cards[currentCardIndex];
                            <span class="expression-term">
                                @if (Combo.Categories.Count + currentCardIndex > 0) { <span class="expression-and" aria-hidden="true">+</span> }
                                @CardBadge(card)
                            </span>
                        }

                        @for (int groupIndex = 0; groupIndex < Math.Min(Combo.AlternativeGroups.Count, Math.Max(0, MaxHeaderBadges - Combo.Categories.Count - Combo.Cards.Count)); groupIndex++) {
                            int currentGroupIndex = groupIndex;
                            ComboAlternativeGroup group = Combo.AlternativeGroups[currentGroupIndex];
                            <span class="expression-term">
                                @if (Combo.Categories.Count + Combo.Cards.Count + currentGroupIndex > 0) { <span class="expression-and" aria-hidden="true">+</span> }
                                @AlternativeGroupMarkup(group, currentGroupIndex, selectable: false, removable: false, compact: true)
                            </span>
                        }
                        @if (HiddenHeaderCategoriesCount > 0) {
                            <span class="badge bg-secondary ms-1">+@HiddenHeaderCategoriesCount more</span>
                        }
                    }
                    else {
                        <span class="text-muted ms-2">(no requirements)</span>
                    }
                    @if (!Combo.Active) {
                        <span class="badge text-bg-secondary ms-2">Inactive</span>
                    }
                </span>
            </button>

        </h2>
        <div class="entry-actions">
            <ReorderControls Index="Index" Count="Count" ItemLabel="@($"combo {ComboDisplayName}, row {Index + 1}")" OnMove="OnMove" />
            <label for="comboActive@(Index)" class="entry-editor-active-toggle">
                <input id="comboActive@(Index)" class="form-check-input entry-editor-active-checkbox" type="checkbox"
                       checked="@Combo.Active"
                       aria-label="@ActiveToggleLabel"
                       title="@ActiveToggleTitle"
                       @onchange="e => ChangeActive(e.Value)"/>
            </label>

            <button class="btn btn-danger entry-editor-delete flex-shrink-0" type="button" aria-label="Remove combo" title="Remove combo" @onclick="() => OnRemoveCombo.InvokeAsync(Index)">
                <span class="entry-editor-delete-face">
                    <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false">
                        <path d="M6 2h4l1 1h3v1H2V3h3l1-1zM4 5h8l-.7 9H4.7z"/>
                        <path d="M6 6h1v6H6zm3 0h1v6H9z" fill="var(--bs-danger)"/>
                    </svg>
                </span>
            </button>
        </div>
    </div>

    <div id="combo@(Index)" class="accordion-collapse collapse @(Index == ActiveComboIndex ? "show" : "")">
        <div class="accordion-body">
            @if (_error is not null) {
                <DismissibleAlert Message="@_error" OnDismiss="@(() => _error = null)"/>
            }
            @if (Combo.AllCards.Any(card => !Cards.Any(row => row.Id == card.CardId))) {
                <p class="text-danger" role="status">Missing card reference. Remove the missing requirement, then add another card if needed.</p>
            }
            <div class="combo-name-row mb-3">
                <div class="combo-name-field">
                    <label for="comboName@(Index)" class="form-label">Name</label>
                    <input id="comboName@(Index)" class="form-control"
                           value="@(Combo.Name ?? string.Empty)"
                           @oninput="e => Rename(e.Value?.ToString())"/>
                </div>
            </div>

            @if (AlternativeScope) {
                <div class="alternative-scope mb-2" role="status">
                    Add alternative to @ScopeLabel
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelAlternative">Cancel</button>
                </div>
            }
            <div class="requirement-fields @(AlternativeScope ? "alternative-fields" : "") mb-3">
                <div class="requirement-selector">
                    @if (_selectedKind == "Card") {
                        <label for="comboCard@(Index)" class="form-label">Card</label>
                        <select id="comboCard@(Index)" @ref="_alternativeEntryTarget" class="form-select" value="@_selectedCardId" @onchange="e => OnSelectCard(e.Value?.ToString())">
                            <option value="">Select card…</option>
                            @foreach (Card card in AlphabeticalCards) {
                                <option value="@card.Id">@CardSelectionLabel(card.Id)</option>
                            }
                        </select>
                    }
                    else {
                        <label for="comboCategory@(Index)" class="form-label">Category</label>
                        <select id="comboCategory@(Index)" @ref="_alternativeEntryTarget" class="form-select" value="@_selectedCategory" @onchange="e => OnSelectCategory(e.Value?.ToString())">
                            <option value="">Select category…</option>
                            @if (_availableCategories.Any(c => c.Source == CategorySource.Metadata)) {
                                <optgroup label="User categories">
                                    @foreach (CategoryBase categoryBase in _availableCategories.Where(category => category.Source == CategorySource.User)) {
                                        <option value="@categoryBase.Identity">@categoryBase.Name</option>
                                    }
                                </optgroup>
                                <optgroup label="Card properties">
                                    @foreach (CategoryBase categoryBase in _availableCategories.Where(category => category.Source == CategorySource.Metadata)) {
                                        <option value="@categoryBase.Identity">@categoryBase.Name</option>
                                    }
                                </optgroup>
                            }
                            else {
                                @foreach (CategoryBase categoryBase in _availableCategories) {
                                    <option value="@categoryBase.Identity">@categoryBase.Name</option>
                                }
                            }
                        </select>
                    }
                </div>
                <div class="requirement-kind">
                    <label for="constraintKind@(Index)" class="form-label">Type</label>
                    <select id="constraintKind@(Index)" class="form-select" value="@_selectedKind" @onchange="e => ChangeKind(e.Value?.ToString())">
                        <option value="Category">Category</option>
                        <option value="Card">Card</option>
                    </select>
                </div>
                <div class="requirement-min">
                    <label for="minCount@(Index)" class="form-label">Min</label>
                    <input id="minCount@(Index)" class="form-control" type="number" min="0"
                           value="@_minCount"
                           @oninput="e => _minCount = e.Value?.ToString() ?? string.Empty"/>
                </div>
                <div class="requirement-max">
                    <label for="maxCount@(Index)" class="form-label">Max</label>
                    <input id="maxCount@(Index)" class="form-control" type="number" min="0" step="1"
                           placeholder="Any" title="Leave empty for Any" value="@_maxCount"
                           @oninput="e => _maxCount = e.Value?.ToString() ?? string.Empty"/>
                </div>
                <div class="requirement-submit">
                    <button class="btn btn-primary w-100" @onclick="AddConstraint">@(AlternativeScope ? "Add alternative" : HasSelectedConstraint ? "Update" : "Add")</button>
                </div>
            </div>

            <div class="alternative-authoring mb-3">
                @if (!AlternativeScope) {
                    <button @ref="_addOrButton" type="button" class="btn btn-sm btn-outline-secondary add-or-button"
                            aria-pressed="@_selectingAlternativeTarget.ToString().ToLowerInvariant()"
                            disabled="@(!HasAlternativeTargets)"
                            title="@(HasAlternativeTargets ? null : "Add a requirement before making alternatives.")"
                            @onclick="ToggleAlternativeTargetSelection">Add OR</button>
                }
                @if (_selectingAlternativeTarget) {
                    <div class="alternative-target-instruction mt-2" role="status">
                        <span>Click a condition or OR group to add an alternative.</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelAlternativeTargetSelection">Cancel</button>
                    </div>
                }
            </div>

            <div class="combo-group-row mb-3">
                <div class="combo-group-field">
                    <label for="comboGroup@(Index)" class="form-label">Group</label>
                    <select id="comboGroup@(Index)" class="form-select"
                            aria-label="@($"Group for {ComboDisplayName}")"
                            value="@Combo.GroupId"
                            @onchange="e => AssignGroup(e.Value?.ToString())">
                        <option value="">Ungrouped</option>
                        @foreach (ComboGroup group in ComboGroups) {
                            <option value="@group.Id">@group.Name</option>
                        }
                    </select>
                </div>
            </div>

            <div class="expanded-expression">
                @if (ConstraintCount == 0) {
                    <em>No requirements yet.</em>
                }
                else {
                    @for (int categoryIndex = 0; categoryIndex < Combo.Categories.Count; categoryIndex++) {
                        int currentCategoryIndex = categoryIndex;
                        ComboCategory category = Combo.Categories[currentCategoryIndex];
                        <span class="expression-term">
                            @if (currentCategoryIndex > 0) { <span class="expression-and" aria-hidden="true">+</span> }
                            @if (_selectingAlternativeTarget) {
                                <button type="button" class="combo-expression-target"
                                        data-alternative-target="@($"category:{currentCategoryIndex}")"
                                        aria-label="@($"Add an alternative to {CategoryTargetLabel(category, currentCategoryIndex)}")"
                                        title="@($"Add an alternative to {CategoryTargetLabel(category, currentCategoryIndex)}")"
                                        @onclick="() => SelectCategoryTarget(category, currentCategoryIndex)">@CategoryBadge(category)</button>
                            }
                            else {
                                @CategoryBadge(category, currentCategoryIndex)
                            }
                        </span>
                    }
                    @for (int cardIndex = 0; cardIndex < Combo.Cards.Count; cardIndex++) {
                        int currentCardIndex = cardIndex;
                        ComboCard card = Combo.Cards[currentCardIndex];
                        <span class="expression-term">
                            @if (Combo.Categories.Count + currentCardIndex > 0) { <span class="expression-and" aria-hidden="true">+</span> }
                            @if (_selectingAlternativeTarget) {
                                <button type="button" class="combo-expression-target"
                                        data-alternative-target="@($"card:{currentCardIndex}")"
                                        aria-label="@($"Add an alternative to {CardTargetLabel(card, currentCardIndex)}")"
                                        title="@($"Add an alternative to {CardTargetLabel(card, currentCardIndex)}")"
                                        @onclick="() => SelectCardTarget(card, currentCardIndex)">@CardBadge(card)</button>
                            }
                            else {
                                @CardBadge(card, currentCardIndex)
                            }
                        </span>
                    }
                    @for (int groupIndex = 0; groupIndex < Combo.AlternativeGroups.Count; groupIndex++) {
                        int currentGroupIndex = groupIndex;
                        ComboAlternativeGroup group = Combo.AlternativeGroups[currentGroupIndex];
                        <span @key="currentGroupIndex" class="expression-term">
                            @if (Combo.Categories.Count + Combo.Cards.Count + currentGroupIndex > 0) { <span class="expression-and" aria-hidden="true">+</span> }
                            @if (_selectingAlternativeTarget) {
                                <button type="button" class="combo-expression-target"
                                        data-alternative-target="@($"group:{currentGroupIndex}")"
                                        aria-label="@($"Add an alternative to {GroupTargetLabel(group, currentGroupIndex)}")"
                                        title="@($"Add an alternative to {GroupTargetLabel(group, currentGroupIndex)}")"
                                        @onclick="() => SelectGroupTarget(group, currentGroupIndex)">@AlternativeGroupMarkup(group, currentGroupIndex, selectable: true, removable: false)</button>
                            }
                            else {
                                @AlternativeGroupMarkup(group, currentGroupIndex, selectable: false, removable: true)
                            }
                        </span>
                    }
                }
            </div>

            @if (Index == ActiveComboIndex) {
                <div class="mt-3">
                    <button class="btn btn-outline-secondary btn-sm"
                            type="button"
                            aria-label="@($"Duplicate combo {ComboDisplayName}")"
                            title="@($"Duplicate combo {ComboDisplayName}")"
                            @onclick="() => OnDuplicateCombo.InvokeAsync(Index)">
                        <svg class="me-1" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                             aria-hidden="true" focusable="false">
                            <rect x="8" y="8" width="13" height="13" rx="2"></rect>
                            <path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"></path>
                        </svg>
                        Duplicate combo
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int Index { get; set; }
    [Parameter] public int Count { get; set; }
    [Parameter] public bool RecentlyMoved { get; set; }
    [Parameter] public EventCallback<(int From, int To)> OnMove { get; set; }
    [Parameter] public Combo Combo { get; set; } = null!;
    [Parameter] public IReadOnlyList<Card> Cards { get; set; } = [];
    [Parameter] public IReadOnlyList<CategoryBase> CategoryBases { get; set; } = [];
    [Parameter] public IReadOnlyList<ComboGroup> ComboGroups { get; set; } = [];
    [Parameter] public IReadOnlyDictionary<string, int> CategoryColorIndices { get; set; } = new Dictionary<string, int>(StringComparer.Ordinal);
    [Parameter] public CategoryRenameNotice? CategoryRename { get; set; }

    [Parameter] public int ActiveComboIndex { get; set; }
    [Parameter] public EventCallback<int> ActiveComboIndexChanged { get; set; }

    [Parameter] public EventCallback<(int Index, Combo NewCombo)> OnReplaceCombo { get; set; }
    [Parameter] public EventCallback<int> OnRemoveCombo { get; set; }
    [Parameter] public EventCallback<int> OnDuplicateCombo { get; set; }

    [Parameter] public int HandSize { get; set; } = 5;

    private const int MaxHeaderBadges = 6;
    private IReadOnlyList<CategoryBase> _availableCategories = [];
    private string? _error;
    private string _selectedCategory = string.Empty;
    private string _selectedCardId = string.Empty;
    private string _selectedKind = "Category";
    private string _minCount = "1";
    private string _maxCount = string.Empty;
    private ElementReference _alternativeEntryTarget;
    private ElementReference _addOrButton;
    private bool _focusAlternativeEntry;
    private bool _focusAddOr;
    private (string Kind, string Category, string Card, string Min, string Max)? _suspendedDraft;
    private bool _selectingAlternativeTarget;
    private ComboAlternativeGroup? _alternativeGroup;
    private int? _alternativeGroupIndex;
    private ComboAlternative? _alternativeSeed;
    private int? _alternativeSeedIndex;
    private Combo? _previousCombo;
    private int _previousCategoryRenameVersion;

    private string CategoryCssClass(CategoryBase category) => category.Source == CategorySource.Metadata
        ? $"card-property-tag {CardPropertyColorPalette.GetCssClass(category)}"
        : CategoryColorPalette.GetCssClass(category.Name, CategoryColorIndices);

    private bool AlternativeScope => _alternativeGroupIndex is not null || _alternativeSeed is not null;
    private bool HasAlternativeTargets => ConstraintCount > 0;
    private string ScopeLabel {
        get {
            if (_alternativeSeed is ComboAlternative seed) {
                int requirementOffset = seed.Category is not null ? 0 : Combo.Categories.Count;
                return $"requirement {requirementOffset + _alternativeSeedIndex + 1}: {AlternativeTargetLabel(seed)}";
            }

            return $"OR group {_alternativeGroupIndex + 1}";
        }
    }

    private string AlternativeLabel(ComboAlternative alternative) =>
        alternative.Category?.BaseCategory.Name ?? $"Card: {CardDisplayName(alternative.Card!.CardId)}";

    private string AlternativeRange(ComboAlternative alternative) => alternative.Category is { } category
        ? RequirementRangeFormatter.Format(category.MinCount, category.MaxCount, category.MaximumMode)
        : RequirementRangeFormatter.Format(alternative.Card!.MinCount, alternative.Card.MaxCount, alternative.Card.MaximumMode);

    private string AlternativeTargetLabel(ComboAlternative alternative) {
        string subject;

        if (alternative.Card is { } card) {
            subject = $"Card: {CardSelectionLabel(card.CardId)}";
        }
        else {
            CategoryBase category = alternative.Category!.BaseCategory;
            string categoryKind = category.Source == CategorySource.Metadata ? "Property" : "Category";
            subject = $"{categoryKind}: {category.Name}";
        }

        return $"{subject} ({AlternativeRange(alternative)})";
    }

    private RenderFragment CategoryBadge(ComboCategory category, int? removeIndex = null) => @<span class="badge category-tag @CategoryCssClass(category.BaseCategory)"
        title="@(category.BaseCategory.Source == CategorySource.Metadata ? "Card property" : null)">
        @category.BaseCategory.Name (@RequirementRangeFormatter.Format(category.MinCount, category.MaxCount, category.MaximumMode))
        @if (removeIndex is int index) {
            <button type="button" class="btn-close category-remove-button ms-1"
                    aria-label="@($"Remove category {category.BaseCategory.Name} from combo {ComboDisplayName}")"
                    title="@($"Remove category {category.BaseCategory.Name} from combo {ComboDisplayName}")"
                    @onclick="() => RemoveCategory(category, index)"></button>
        }
    </span>;

    private RenderFragment CardBadge(ComboCard card, int? removeIndex = null) => @<span class="badge category-tag combo-card-tag @(Cards.Any(row => row.Id == card.CardId) ? "" : "combo-missing-card")"
        title="@card.CardId">
        Card: @CardDisplayName(card.CardId) (@RequirementRangeFormatter.Format(card.MinCount, card.MaxCount, card.MaximumMode))
        @if (removeIndex is int index) {
            <button type="button" class="btn-close category-remove-button ms-1"
                    aria-label="@($"Remove card {CardSelectionLabel(card.CardId)} from combo {ComboDisplayName}")"
                    title="@($"Remove card {CardDisplayName(card.CardId)} from combo {ComboDisplayName}")"
                    @onclick="() => RemoveCard(card, index)"></button>
        }
    </span>;

    private RenderFragment AlternativeBadge(ComboAlternative alternative, int? removableGroupIndex = null, int leafIndex = 0) => @<span class="badge category-tag @(alternative.Category is { } category ? CategoryCssClass(category.BaseCategory) : "combo-card-tag")">
        <span>@AlternativeLabel(alternative) (@AlternativeRange(alternative))</span>
        @if (removableGroupIndex is int groupIndex) {
            <button type="button" class="btn-close category-remove-button ms-1"
                    title="Remove alternative" aria-label="@($"Remove alternative {leafIndex + 1} ({AlternativeLabel(alternative)}) from group {groupIndex + 1}")"
                    @onclick="() => RemoveAlternative(Combo.AlternativeGroups[groupIndex], groupIndex, alternative, leafIndex)"></button>
        }
    </span>;

    private RenderFragment AlternativeGroupMarkup(
        ComboAlternativeGroup group,
        int groupIndex,
        bool selectable,
        bool removable,
        bool compact = false
    ) => @<span class="alternative-group @(compact ? "summary-group" : "")"
        role="@(selectable ? null : "group")" aria-label="@(selectable ? null : $"Alternative group {groupIndex + 1}")">
        <span>(</span>
        @for (int alternativeIndex = 0; alternativeIndex < group.Alternatives.Count; alternativeIndex++) {
            int currentAlternativeIndex = alternativeIndex;
            ComboAlternative alternative = group.Alternatives[currentAlternativeIndex];
            <span @key="currentAlternativeIndex" class="alternative-term">
                @if (currentAlternativeIndex > 0) { <span class="alternative-separator">OR</span> }
                <span class="alternative-leaf">@AlternativeBadge(alternative, removable ? groupIndex : null, currentAlternativeIndex)</span>
            </span>
        }
        <span>)</span>
    </span>;

    private string CategoryTargetLabel(ComboCategory category, int index) =>
        $"requirement {index + 1}: {AlternativeTargetLabel(ComboAlternative.For(category))}";
    private string CardTargetLabel(ComboCard card, int index) =>
        $"requirement {Combo.Categories.Count + index + 1}: {AlternativeTargetLabel(ComboAlternative.For(card))}";
    private string GroupTargetLabel(ComboAlternativeGroup group, int index) =>
        $"OR group {index + 1}: {string.Join(" OR ", group.Alternatives.Select(AlternativeTargetLabel))}";

    private void ToggleAlternativeTargetSelection() {
        if (AlternativeScope || !HasAlternativeTargets) {
            return;
        }

        _selectingAlternativeTarget = !_selectingAlternativeTarget;
    }

    private void CancelAlternativeTargetSelection() {
        _selectingAlternativeTarget = false;
        _focusAddOr = true;
    }

    private void SelectCategoryTarget(ComboCategory category, int index) {
        bool isCurrentTarget = _selectingAlternativeTarget
            && index >= 0
            && index < Combo.Categories.Count
            && ReferenceEquals(Combo.Categories[index], category);

        if (!isCurrentTarget) {
            return;
        }

        BeginAlternativeDraft(ComboAlternative.For(category), index, null, null);
    }

    private void SelectCardTarget(ComboCard card, int index) {
        bool isCurrentTarget = _selectingAlternativeTarget
            && index >= 0
            && index < Combo.Cards.Count
            && ReferenceEquals(Combo.Cards[index], card);

        if (!isCurrentTarget) {
            return;
        }

        BeginAlternativeDraft(ComboAlternative.For(card), index, null, null);
    }

    private void SelectGroupTarget(ComboAlternativeGroup group, int index) {
        bool isCurrentTarget = _selectingAlternativeTarget
            && index >= 0
            && index < Combo.AlternativeGroups.Count
            && ReferenceEquals(Combo.AlternativeGroups[index], group);

        if (!isCurrentTarget) {
            return;
        }

        BeginAlternativeDraft(null, null, group, index);
    }

    private void CancelAlternative() {
        _focusAlternativeEntry = true;
        _alternativeGroup = null;
        _alternativeGroupIndex = null;
        _alternativeSeed = null;
        _alternativeSeedIndex = null;
        _selectedCategory = string.Empty;
        _selectedCardId = string.Empty;
        ResetEditorDefaults();

        if (_suspendedDraft is { } draft) {
            (_selectedKind, _selectedCategory, _selectedCardId, _minCount, _maxCount) = draft;
            _suspendedDraft = null;
        }

        _error = null;
    }

    private void BeginAlternativeDraft(
        ComboAlternative? seed,
        int? seedIndex,
        ComboAlternativeGroup? group,
        int? groupIndex
    ) {
        _suspendedDraft = (_selectedKind, _selectedCategory, _selectedCardId, _minCount, _maxCount);
        _selectingAlternativeTarget = false;
        _alternativeSeed = seed;
        _alternativeSeedIndex = seedIndex;
        _alternativeGroup = group;
        _alternativeGroupIndex = groupIndex;
        _selectedCategory = string.Empty;
        _selectedCardId = string.Empty;
        ResetEditorDefaults();
        _error = null;
        _focusAlternativeEntry = true;
    }

    private Task CommitAlternative() {
        if (!AlternativeScope || !AlternativeTargetIsCurrent) {
            CancelAlternative();

            return Task.CompletedTask;
        }

        if (!int.TryParse(_minCount, out int minimum) || minimum < 0 || !TryMaximum(minimum, out int maximum)) {
            _error = "Enter valid minimum and maximum counts.";

            return Task.CompletedTask;
        }

        ComboAlternative leaf;

        if (_selectedKind == "Card" && Cards.Any(card => card.Id == _selectedCardId)) {
            leaf = ComboAlternative.For(new ComboCard(_selectedCardId, minimum, maximum, MaximumMode));
        }
        else if (_selectedKind == "Category" && _availableCategories.FirstOrDefault(category => category.Identity == _selectedCategory) is { } category) {
            leaf = ComboAlternative.For(new ComboCategory(category, minimum, maximum, MaximumMode));
        }
        else {
            _error = "Select a target for this alternative.";

            return Task.CompletedTask;
        }

        Combo updated = Combo;
        List<ComboAlternativeGroup> groups = Combo.AlternativeGroups.ToList();

        if (_alternativeGroup is ComboAlternativeGroup currentGroup && _alternativeGroupIndex is int groupIndex) {
            List<ComboAlternative> alternatives = currentGroup.Alternatives.ToList();
            alternatives.Add(leaf);
            groups[groupIndex] = new ComboAlternativeGroup(alternatives);
        }
        else if (_alternativeSeed is { } seed) {
            if (seed.Category is not null) {
                updated = updated.WithCategories(updated.Categories.Where((_, index) => index != _alternativeSeedIndex));
            }
            else {
                updated = updated.WithCards(updated.Cards.Where((_, index) => index != _alternativeSeedIndex));
            }

            groups.Add(new ComboAlternativeGroup([seed, leaf]));
        }

        CancelAlternative();

        return OnReplaceCombo.InvokeAsync((Index, updated.WithAlternativeGroups(groups)));
    }

    private bool AlternativeTargetIsCurrent {
        get {
            if (_alternativeGroup is ComboAlternativeGroup currentGroup && _alternativeGroupIndex is int groupIndex) {
                return groupIndex >= 0
                    && groupIndex < Combo.AlternativeGroups.Count
                    && ReferenceEquals(Combo.AlternativeGroups[groupIndex], currentGroup);
            }

            if (_alternativeSeedIndex is not int seedIndex || seedIndex < 0) {
                return false;
            }

            if (_alternativeSeed?.Category is ComboCategory category) {
                return seedIndex < Combo.Categories.Count
                    && ReferenceEquals(Combo.Categories[seedIndex], category);
            }

            return _alternativeSeed?.Card is ComboCard card
                && seedIndex < Combo.Cards.Count
                && ReferenceEquals(Combo.Cards[seedIndex], card);
        }
    }

    private Task RemoveAlternative(
        ComboAlternativeGroup group,
        int groupIndex,
        ComboAlternative alternative,
        int leafIndex
    ) {
        List<ComboAlternativeGroup> groups = Combo.AlternativeGroups.ToList();

        bool isCurrentGroup = groupIndex >= 0
            && groupIndex < groups.Count
            && ReferenceEquals(groups[groupIndex], group);

        if (!isCurrentGroup) {
            return Task.CompletedTask;
        }

        bool isCurrentAlternative = leafIndex >= 0
            && leafIndex < group.Alternatives.Count
            && ReferenceEquals(group.Alternatives[leafIndex], alternative);

        if (!isCurrentAlternative) {
            return Task.CompletedTask;
        }

        ComboAlternative[] remaining = group.Alternatives.Where((_, index) => index != leafIndex).ToArray();
        Combo updated = Combo;

        if (remaining.Length == 0) {
            groups.RemoveAt(groupIndex);
        }
        else if (remaining.Length == 1) {
            groups.RemoveAt(groupIndex);
            if (remaining[0].Category is { } category) {
                updated = updated.WithCategories(updated.Categories.Append(category));
            }
            else {
                updated = updated.WithCards(updated.Cards.Append(remaining[0].Card!));
            }
        }
        else {
            groups[groupIndex] = new ComboAlternativeGroup(remaining);
        }

        if (_alternativeGroupIndex == groupIndex && ReferenceEquals(_alternativeGroup, group)) {
            CancelAlternative();
        }

        return OnReplaceCombo.InvokeAsync((Index, updated.WithAlternativeGroups(groups)));
    }

    private string ComboDisplayName => string.IsNullOrWhiteSpace(Combo.Name) ? $"Combo {Index + 1}" : Combo.Name;
    private string ActiveToggleLabel => $"Active combo {ComboDisplayName}";
    private string ActiveToggleTitle => $"Toggle {ComboDisplayName} active state";

    private ComboGroup? AssignedGroup => Combo.GroupId is { Length: > 0 } groupId
        ? ComboGroups.FirstOrDefault(group => group.Id == groupId)
        : null;

    private bool HasSelectedConstraint => _selectedKind == "Card"
        ? Combo.Cards.Any(card => card.CardId == _selectedCardId)
        : Combo.Categories.Any(category => category.BaseCategory.Identity == _selectedCategory);

    private int ConstraintCount => Combo.RequirementCount;
    private IEnumerable<Card> AlphabeticalCards => CardOrdering.Alphabetize(Cards);
    private int HiddenHeaderCategoriesCount => Math.Max(0, ConstraintCount - MaxHeaderBadges);

    private RequirementMaximumMode MaximumMode => string.IsNullOrWhiteSpace(_maxCount)
        ? RequirementMaximumMode.HandSize
        : RequirementMaximumMode.Fixed;

    private string CardDisplayName(string cardId) {
        int index = Cards.ToList().FindIndex(card => card.Id == cardId);

        if (index < 0) {
            return $"Missing card ({cardId[..Math.Min(8, cardId.Length)]})";
        }

        string? cardName = Cards[index].Name;

        return string.IsNullOrWhiteSpace(cardName) ? "Unnamed card" : cardName;
    }

    private string CardSelectionLabel(string cardId) {
        int index = Cards.ToList().FindIndex(card => card.Id == cardId);

        if (index < 0) {
            return CardDisplayName(cardId);
        }

        return $"{CardDisplayName(cardId)} #{index + 1}";
    }

    private void ChangeKind(string? kind) {
        _selectedKind = kind == "Card" ? "Card" : "Category";

        if (_selectedKind == "Card") {
            OnSelectCard(_selectedCardId);
        }
        else {
            OnSelectCategory(_selectedCategory);
        }
    }

    private Task ToggleCombo() {
        int next = ActiveComboIndex == Index ? -1 : Index;

        return ActiveComboIndexChanged.InvokeAsync(next);
    }

    private Task Rename(string? name) {
        Combo newCombo = Combo.WithName(string.IsNullOrWhiteSpace(name) ? null : name);

        return OnReplaceCombo.InvokeAsync((Index, newCombo));
    }

    private Task ChangeActive(object? value) {
        if (!bool.TryParse(value?.ToString(), out bool active)) {
            return Task.CompletedTask;
        }

        return OnReplaceCombo.InvokeAsync((Index, Combo.WithActive(active)));
    }

    private Task AssignGroup(string? groupId) =>
        OnReplaceCombo.InvokeAsync((Index, Combo.WithGroup(string.IsNullOrEmpty(groupId) ? null : groupId)));

    private Task AddConstraint() {
        if (AlternativeScope) {
            return CommitAlternative();
        }

        if (_selectedKind == "Card") {
            return AddCard();
        }

        if (string.IsNullOrWhiteSpace(_selectedCategory)) {
            _error = "Please select a category to add.";

            return Task.CompletedTask;
        }

        CategoryBase? categoryBase = _availableCategories.FirstOrDefault(category => category.Identity == _selectedCategory);

        if (categoryBase is null) {
            _error = "Selected category not found.";

            return Task.CompletedTask;
        }

        if (!int.TryParse(_minCount, out int minimum) || minimum < 0) {
            _error = "Minimum count must be a non-negative whole number.";

            return Task.CompletedTask;
        }

        if (!TryMaximum(minimum, out int maximum)) {
            _error = "Maximum count must be a whole number at least equal to minimum count.";

            return Task.CompletedTask;
        }

        List<ComboCategory> newCategories = Combo.Categories.ToList();
        int existingIndex = newCategories.FindIndex(category => category.BaseCategory.Identity == categoryBase.Identity);
        ComboCategory constraint = new(categoryBase, minimum, maximum, MaximumMode);

        if (existingIndex >= 0) {
            newCategories[existingIndex] = constraint;
        }
        else {
            newCategories.Add(constraint);
        }

        Combo newCombo = Combo.WithCategories(newCategories);
        _selectedCategory = string.Empty;
        _error = null;
        ResetEditorDefaults();

        return OnReplaceCombo.InvokeAsync((Index, newCombo));
    }

    private Task AddCard() {
        if (string.IsNullOrEmpty(_selectedCardId) || !Cards.Any(card => card.Id == _selectedCardId)) {
            _error = "Please select a card to add.";

            return Task.CompletedTask;
        }

        if (!int.TryParse(_minCount, out int minimum) || minimum < 0) {
            _error = "Minimum count must be a non-negative whole number.";

            return Task.CompletedTask;
        }

        if (!TryMaximum(minimum, out int maximum)) {
            _error = "Maximum count must be a whole number at least equal to minimum count.";

            return Task.CompletedTask;
        }

        List<ComboCard> newCards = Combo.Cards.ToList();
        int existingIndex = newCards.FindIndex(card => card.CardId == _selectedCardId);
        ComboCard constraint = new(_selectedCardId, minimum, maximum, MaximumMode);

        if (existingIndex >= 0) {
            newCards[existingIndex] = constraint;
        }
        else {
            newCards.Add(constraint);
        }

        _selectedCardId = string.Empty;
        _error = null;
        ResetEditorDefaults();
        return OnReplaceCombo.InvokeAsync((Index, Combo.WithCards(newCards)));
    }

    private Task RemoveCard(ComboCard card, int index) {
        bool isCurrentCard = index >= 0
            && index < Combo.Cards.Count
            && ReferenceEquals(Combo.Cards[index], card);

        if (!isCurrentCard) {
            return Task.CompletedTask;
        }

        if (ReferenceEquals(_alternativeSeed?.Card, card) && _alternativeSeedIndex == index) {
            CancelAlternative();
        }

        List<ComboCard> cards = Combo.Cards.ToList();
        cards.RemoveAt(index);

        return OnReplaceCombo.InvokeAsync((Index, Combo.WithCards(cards)));
    }

    private void OnSelectCard(string? value) {
        _selectedCardId = value ?? string.Empty;
        _error = null;
        ComboCard? existing = AlternativeScope ? null : Combo.Cards.FirstOrDefault(card => card.CardId == _selectedCardId);

        if (existing is not null) {
            _minCount = existing.MinCount.ToString();
            _maxCount = existing.MaximumMode == RequirementMaximumMode.HandSize ? string.Empty : existing.MaxCount.ToString();
        }
        else {
            ResetEditorDefaults();
        }
    }

    private Task RemoveCategory(ComboCategory category, int index) {
        bool isCurrentCategory = index >= 0
            && index < Combo.Categories.Count
            && ReferenceEquals(Combo.Categories[index], category);

        if (!isCurrentCategory) {
            return Task.CompletedTask;
        }

        if (ReferenceEquals(_alternativeSeed?.Category, category) && _alternativeSeedIndex == index) {
            CancelAlternative();
        }

        List<ComboCategory> newCategories = Combo.Categories.ToList();
        newCategories.RemoveAt(index);
        Combo newCombo = Combo.WithCategories(newCategories);

        return OnReplaceCombo.InvokeAsync((Index, newCombo));
    }

    private void OnSelectCategory(string? value) {
        _selectedCategory = value ?? string.Empty;
        _error = null;

        ComboCategory? existing = AlternativeScope
            ? null
            : Combo.Categories.FirstOrDefault(category => category.BaseCategory.Identity == _selectedCategory);

        if (existing is not null) {
            _minCount = existing.MinCount.ToString();
            _maxCount = existing.MaximumMode == RequirementMaximumMode.HandSize ? string.Empty : existing.MaxCount.ToString();
        }
        else {
            ResetEditorDefaults();
        }
    }

    private void ResetEditorDefaults() {
        _minCount = "1";
        _maxCount = string.Empty;
    }

    private bool TryMaximum(int minimum, out int maximum) {
        if (MaximumMode == RequirementMaximumMode.HandSize) {
            maximum = HandSize;
            return true;
        }

        return int.TryParse(_maxCount, out maximum) && maximum >= minimum && maximum >= 0;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (_focusAlternativeEntry) {
            _focusAlternativeEntry = false;
            await _alternativeEntryTarget.FocusAsync();
        }

        if (_focusAddOr) {
            _focusAddOr = false;
            await _addOrButton.FocusAsync();
        }
    }

    protected override void OnInitialized() {
        ResetEditorDefaults();
    }

    protected override void OnParametersSet() {
        _availableCategories = CategoryCatalog.Build(CategoryBases, Cards, [Combo]);
        if (CategoryRename is CategoryRenameNotice rename && rename.Version != _previousCategoryRenameVersion) {
            if (_selectedCategory.Equals($"user:{rename.OldName}", StringComparison.Ordinal)) {
                _selectedCategory = $"user:{rename.NewName}";
            }

            if (_suspendedDraft is { } draft && draft.Category == $"user:{rename.OldName}") {
                _suspendedDraft = (draft.Kind, $"user:{rename.NewName}", draft.Card, draft.Min, draft.Max);
            }

            if (_alternativeSeed?.Category is ComboCategory seed && seed.BaseCategory.Identity == $"user:{rename.OldName}") {
                int index = _alternativeSeedIndex ?? -1;
                bool isCurrentRenamedSeed = ReferenceEquals(_previousCombo, Combo)
                    && index >= 0
                    && index < Combo.Categories.Count
                    && Combo.Categories[index].BaseCategory.Identity == $"user:{rename.NewName}"
                    && Combo.Categories[index].MinCount == seed.MinCount
                    && Combo.Categories[index].MaxCount == seed.MaxCount
                    && Combo.Categories[index].MaximumMode == seed.MaximumMode;

                if (isCurrentRenamedSeed) {
                    _alternativeSeed = ComboAlternative.For(Combo.Categories[index]);
                }
            }

            _previousCategoryRenameVersion = rename.Version;
        }

        if (AlternativeScope && !AlternativeTargetIsCurrent) {
            CancelAlternative();
        }

        _previousCombo = Combo;

        // Hand size affects effective bounds only; leave committed values and drafts intact.
    }
}
