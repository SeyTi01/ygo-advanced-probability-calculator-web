@using YGOProbabilityCalculatorBlazor.Models
@using YGOProbabilityCalculatorBlazor.Components.Shared

<div class="accordion-item combo-editor @(Combo.Active ? "" : "entry-inactive")">
    <div class="accordion-header entry-editor-header combo-editor-header">
        <h2 class="entry-heading">
            <button class="accordion-button flex-grow-1 @(Index == ActiveComboIndex ? "" : "collapsed")"
                    type="button"
                    aria-expanded="@(Index == ActiveComboIndex ? "true" : "false")"
                    aria-controls="combo@(Index)"
                    @onclick="ToggleCombo">
                <span class="combo-header-content">
                    <span class="combo-header-name">@ComboDisplayName</span>

                    @if (AssignedGroup is { } assignedGroup) {
                        <small class="combo-group-membership text-body-secondary">· Group: @assignedGroup.Name</small>
                    }

                    @if (ConstraintCount > 0) {
                        @foreach (var cc in HeaderCategories) {
                            <span class="badge category-tag ms-1 @CategoryCssClass(cc.BaseCategory)" title="@(cc.BaseCategory.Source == CategorySource.Metadata ? "Card property" : null)">
                                @cc.BaseCategory.Name (@RequirementRangeFormatter.Format(cc.MinCount, cc.MaxCount, cc.MaximumMode))
                            </span>
                        }
                        @foreach (var card in HeaderCards) {
                            <span class="badge category-tag combo-card-tag ms-1">Card: @CardDisplayName(card.CardId) (@RequirementRangeFormatter.Format(card.MinCount, card.MaxCount, card.MaximumMode))</span>
                        }

                        @if (HiddenHeaderCategoriesCount > 0) {
                            <span class="badge bg-secondary ms-1">+@HiddenHeaderCategoriesCount more</span>
                        }
                    }
                    else {
                        <span class="text-muted ms-2">(no requirements)</span>
                    }
                    @if (!Combo.Active) {
                        <span class="badge text-bg-secondary ms-2">Inactive</span>
                    }
                </span>
            </button>

        </h2>
        <div class="entry-actions">
            <ReorderControls Index="Index" Count="Count" ItemLabel="@($"combo {ComboDisplayName}, row {Index + 1}")" OnMove="OnMove" />
            <label for="comboActive@(Index)" class="entry-editor-active-toggle">
                <input id="comboActive@(Index)" class="form-check-input entry-editor-active-checkbox" type="checkbox"
                       checked="@Combo.Active"
                       aria-label="@ActiveToggleLabel"
                       title="@ActiveToggleTitle"
                       @onchange="e => ChangeActive(e.Value)"/>
            </label>

            <button class="btn btn-danger align-self-center flex-shrink-0" type="button" aria-label="Remove combo" title="Remove combo" @onclick="() => OnRemoveCombo.InvokeAsync(Index)">
                <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false">
                    <path d="M6 2h4l1 1h3v1H2V3h3l1-1zM4 5h8l-.7 9H4.7z"/>
                    <path d="M6 6h1v6H6zm3 0h1v6H9z" fill="var(--bs-danger)"/>
                </svg>
            </button>
        </div>
    </div>

    <div id="combo@(Index)" class="accordion-collapse collapse @(Index == ActiveComboIndex ? "show" : "")">
        <div class="accordion-body">
            @if (error is not null) {
                <DismissibleAlert Message="@error" OnDismiss="@(() => error = null)"/>
            }
            @if (Combo.Cards.Any(card => !Cards.Any(row => row.Id == card.CardId))) {
                <p class="text-danger" role="status">Missing card reference. Remove the missing requirement, then add another card if needed.</p>
            }
            <div class="combo-name-row mb-3">
                <div class="combo-name-field">
                    <label for="comboName@(Index)" class="form-label">Name</label>
                    <input id="comboName@(Index)" class="form-control"
                           value="@(Combo.Name ?? string.Empty)"
                           @oninput="e => Rename(e.Value?.ToString())"/>
                </div>
            </div>

            <div class="requirement-fields mb-3">
                <div class="requirement-selector">
                    @if (selectedKind == "Card") {
                        <label for="comboCard@(Index)" class="form-label">Card</label>
                        <select id="comboCard@(Index)" class="form-select" value="@selectedCardId" @onchange="e => OnSelectCard(e.Value?.ToString())">
                            <option value="">Select card…</option>
                            @foreach (var card in AlphabeticalCards) {
                                <option value="@card.Id">@CardSelectionLabel(card.Id)</option>
                            }
                        </select>
                    }
                    else {
                        <label for="comboCategory@(Index)" class="form-label">Category</label>
                        <select id="comboCategory@(Index)" class="form-select" value="@selectedCategory" @onchange="e => OnSelectCategory(e.Value?.ToString())">
                            <option value="">Select category…</option>
                            @if (availableCategories.Any(c => c.Source == CategorySource.Metadata)) {
                                <optgroup label="User categories">
                                    @foreach (var cb in availableCategories.Where(c => c.Source == CategorySource.User)) {
                                        <option value="@cb.Identity">@cb.Name</option>
                                    }
                                </optgroup>
                                <optgroup label="Card properties">
                                    @foreach (var cb in availableCategories.Where(c => c.Source == CategorySource.Metadata)) {
                                        <option value="@cb.Identity">@cb.Name</option>
                                    }
                                </optgroup>
                            }
                            else {
                                @foreach (var cb in availableCategories) {
                                    <option value="@cb.Identity">@cb.Name</option>
                                }
                            }
                        </select>
                    }
                </div>
                <div class="requirement-kind">
                    <label for="constraintKind@(Index)" class="form-label">Type</label>
                    <select id="constraintKind@(Index)" class="form-select" value="@selectedKind" @onchange="e => ChangeKind(e.Value?.ToString())">
                        <option value="Category">Category</option>
                        <option value="Card">Card</option>
                    </select>
                </div>
                <div class="requirement-min">
                    <label for="minCount@(Index)" class="form-label">Min</label>
                    <input id="minCount@(Index)" class="form-control" type="number" min="0"
                           value="@minCount"
                           @oninput="e => minCount = e.Value?.ToString() ?? string.Empty"/>
                </div>
                <div class="requirement-max">
                    <label for="maxCount@(Index)" class="form-label">Max</label>
                    <input id="maxCount@(Index)" class="form-control" type="number" min="0" step="1"
                           placeholder="Any" title="Leave empty for Any" value="@maxCount"
                           @oninput="e => maxCount = e.Value?.ToString() ?? string.Empty"/>
                </div>
                <div class="requirement-submit">
                    <button class="btn btn-primary w-100" @onclick="AddConstraint">@(HasSelectedConstraint ? "Update" : "Add")</button>
                </div>
            </div>

            <div class="combo-group-row mb-3">
                <div class="combo-group-field">
                    <label for="comboGroup@(Index)" class="form-label">Group</label>
                    <select id="comboGroup@(Index)" class="form-select"
                            aria-label="@($"Group for {ComboDisplayName}")"
                            value="@Combo.GroupId"
                            @onchange="e => AssignGroup(e.Value?.ToString())">
                        <option value="">Ungrouped</option>
                        @foreach (var group in ComboGroups) {
                            <option value="@group.Id">@group.Name</option>
                        }
                    </select>
                </div>
            </div>

            <div>
                @if (ConstraintCount == 0) {
                    <em>No requirements yet.</em>
                }
                else {
                    @foreach (var cc in Combo.Categories) {
                        <span class="badge me-2 category-tag @CategoryCssClass(cc.BaseCategory)" title="@(cc.BaseCategory.Source == CategorySource.Metadata ? "Card property" : null)">
                            @cc.BaseCategory.Name (@RequirementRangeFormatter.Format(cc.MinCount, cc.MaxCount, cc.MaximumMode))
                            <button type="button"
                                    class="btn-close category-remove-button ms-1"
                                    aria-label="@($"Remove category {cc.BaseCategory.Name} from combo {ComboDisplayName}")"
                                    title="@($"Remove category {cc.BaseCategory.Name} from combo {ComboDisplayName}")"
                                    @onclick="() => RemoveCategory(cc)">
                            </button>
                        </span>
                    }
                    @foreach (var card in Combo.Cards) {
                        <span class="badge me-2 category-tag combo-card-tag @(Cards.Any(row => row.Id == card.CardId) ? "" : "combo-missing-card")"
                              title="@card.CardId">
                            Card: @CardDisplayName(card.CardId) (@RequirementRangeFormatter.Format(card.MinCount, card.MaxCount, card.MaximumMode))
                            <button type="button" class="btn-close category-remove-button ms-1"
                                    aria-label="@($"Remove card {CardSelectionLabel(card.CardId)} from combo {ComboDisplayName}")"
                                    title="@($"Remove card {CardDisplayName(card.CardId)} from combo {ComboDisplayName}")"
                                    @onclick="() => RemoveCard(card)"></button>
                        </span>
                    }
                }
            </div>

            @if (Index == ActiveComboIndex) {
                <div class="mt-3">
                    <button class="btn btn-outline-secondary btn-sm"
                            type="button"
                            aria-label="@($"Duplicate combo {ComboDisplayName}")"
                            title="@($"Duplicate combo {ComboDisplayName}")"
                            @onclick="() => OnDuplicateCombo.InvokeAsync(Index)">
                        <svg class="me-1" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                             aria-hidden="true" focusable="false">
                            <rect x="8" y="8" width="13" height="13" rx="2"></rect>
                            <path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"></path>
                        </svg>
                        Duplicate combo
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int Index { get; set; }
    [Parameter] public int Count { get; set; }
    [Parameter] public EventCallback<(int From, int To)> OnMove { get; set; }
    [Parameter] public Combo Combo { get; set; } = null!;
    [Parameter] public IReadOnlyList<Card> Cards { get; set; } = [];
    [Parameter] public IReadOnlyList<CategoryBase> CategoryBases { get; set; } = [];
    [Parameter] public IReadOnlyList<ComboGroup> ComboGroups { get; set; } = [];
    [Parameter] public IReadOnlyDictionary<string, int> CategoryColorIndices { get; set; } = new Dictionary<string, int>(StringComparer.Ordinal);
    [Parameter] public CategoryRenameNotice? CategoryRename { get; set; }

    [Parameter] public int ActiveComboIndex { get; set; }
    [Parameter] public EventCallback<int> ActiveComboIndexChanged { get; set; }

    [Parameter] public EventCallback<(int Index, Combo NewCombo)> OnReplaceCombo { get; set; }
    [Parameter] public EventCallback<int> OnRemoveCombo { get; set; }
    [Parameter] public EventCallback<int> OnDuplicateCombo { get; set; }

    [Parameter] public int HandSize { get; set; } = 5;

    private IReadOnlyList<CategoryBase> availableCategories = [];
    private string CategoryCssClass(CategoryBase category) => category.Source == CategorySource.Metadata
        ? $"card-property-tag {CardPropertyColorPalette.GetCssClass(category)}"
        : CategoryColorPalette.GetCssClass(category.Name, CategoryColorIndices);
    private const int MaxHeaderBadges = 6;
    private string? error;
    private string selectedCategory = string.Empty;
    private string selectedCardId = string.Empty;
    private string selectedKind = "Category";
    private string minCount = "1";
    private string maxCount = string.Empty;
    private int previousCategoryRenameVersion;
    private string ComboDisplayName => string.IsNullOrWhiteSpace(Combo.Name) ? $"Combo {Index + 1}" : Combo.Name;
    private string ActiveToggleLabel => $"Active combo {ComboDisplayName}";
    private string ActiveToggleTitle => $"Toggle {ComboDisplayName} active state";
    private ComboGroup? AssignedGroup => Combo.GroupId is { Length: > 0 } groupId
        ? ComboGroups.FirstOrDefault(group => group.Id == groupId)
        : null;
    private bool HasSelectedConstraint => selectedKind == "Card"
        ? Combo.Cards.Any(c => c.CardId == selectedCardId)
        : Combo.Categories.Any(c => c.BaseCategory.Identity == selectedCategory);

    private int ConstraintCount => Combo.Categories.Count + Combo.Cards.Count;
    private IEnumerable<Card> AlphabeticalCards => CardOrdering.Alphabetize(Cards);
    private IEnumerable<ComboCategory> HeaderCategories => Combo.Categories.Take(MaxHeaderBadges);
    private IEnumerable<ComboCard> HeaderCards => Combo.Cards.Take(Math.Max(0, MaxHeaderBadges - Combo.Categories.Count));
    private int HiddenHeaderCategoriesCount => Math.Max(0, ConstraintCount - MaxHeaderBadges);

    private RequirementMaximumMode MaximumMode => string.IsNullOrWhiteSpace(maxCount)
        ? RequirementMaximumMode.HandSize
        : RequirementMaximumMode.Fixed;

    private string CardDisplayName(string cardId) {
        var index = Cards.ToList().FindIndex(card => card.Id == cardId);
        if (index < 0) return $"Missing card ({cardId[..Math.Min(8, cardId.Length)]})";
        var cardName = Cards[index].Name;
        return string.IsNullOrWhiteSpace(cardName) ? "Unnamed card" : cardName;
    }

    private string CardSelectionLabel(string cardId) {
        var index = Cards.ToList().FindIndex(card => card.Id == cardId);
        return index < 0 ? CardDisplayName(cardId) : $"{CardDisplayName(cardId)} #{index + 1}";
    }

    private void ChangeKind(string? kind) {
        selectedKind = kind == "Card" ? "Card" : "Category";
        if (selectedKind == "Card") OnSelectCard(selectedCardId);
        else OnSelectCategory(selectedCategory);
    }

    private Task ToggleCombo() {
        var next = ActiveComboIndex == Index ? -1 : Index;
        return ActiveComboIndexChanged.InvokeAsync(next);
    }

    private Task Rename(string? name) {
        var newCombo = Combo.WithName(string.IsNullOrWhiteSpace(name) ? null : name);
        return OnReplaceCombo.InvokeAsync((Index, newCombo));
    }

    private Task ChangeActive(object? value) {
        if (!bool.TryParse(value?.ToString(), out var active)) return Task.CompletedTask;
        return OnReplaceCombo.InvokeAsync((Index, Combo.WithActive(active)));
    }

    private Task AssignGroup(string? groupId) =>
        OnReplaceCombo.InvokeAsync((Index, Combo.WithGroup(string.IsNullOrEmpty(groupId) ? null : groupId)));

    private Task AddConstraint() {
        if (selectedKind == "Card") return AddCard();
        if (string.IsNullOrWhiteSpace(selectedCategory)) {
            error = "Please select a category to add.";
            return Task.CompletedTask;
        }
        var baseCat = availableCategories.FirstOrDefault(c => c.Identity == selectedCategory);
        if (baseCat is null) {
            error = "Selected category not found.";
            return Task.CompletedTask;
        }
        if (!int.TryParse(minCount, out var min) || min < 0) {
            error = "Minimum count must be a non-negative whole number.";
            return Task.CompletedTask;
        }
        if (!TryMaximum(min, out var max)) {
            error = "Maximum count must be a whole number at least equal to minimum count.";
            return Task.CompletedTask;
        }
        var newCats = Combo.Categories.ToList();
        var existing = newCats.FindIndex(c => c.BaseCategory.Identity == baseCat.Identity);
        var constraint = new ComboCategory(baseCat, min, max, MaximumMode);
        if (existing >= 0) newCats[existing] = constraint;
        else newCats.Add(constraint);

        var newCombo = Combo.WithCategories(newCats);
        selectedCategory = string.Empty;
        error = null;
        ResetEditorDefaults();
        return OnReplaceCombo.InvokeAsync((Index, newCombo));
    }

    private Task AddCard() {
        if (string.IsNullOrEmpty(selectedCardId) || !Cards.Any(card => card.Id == selectedCardId)) {
            error = "Please select a card to add.";
            return Task.CompletedTask;
        }
        if (!int.TryParse(minCount, out var min) || min < 0) {
            error = "Minimum count must be a non-negative whole number.";
            return Task.CompletedTask;
        }
        if (!TryMaximum(min, out var max)) {
            error = "Maximum count must be a whole number at least equal to minimum count.";
            return Task.CompletedTask;
        }
        var newCards = Combo.Cards.ToList();
        var existing = newCards.FindIndex(card => card.CardId == selectedCardId);
        var constraint = new ComboCard(selectedCardId, min, max, MaximumMode);
        if (existing >= 0) newCards[existing] = constraint;
        else newCards.Add(constraint);
        selectedCardId = string.Empty;
        error = null;
        ResetEditorDefaults();
        return OnReplaceCombo.InvokeAsync((Index, Combo.WithCards(newCards)));
    }

    private Task RemoveCard(ComboCard card) =>
        OnReplaceCombo.InvokeAsync((Index, Combo.WithCards(Combo.Cards.Where(item => item != card))));

    private void OnSelectCard(string? value) {
        selectedCardId = value ?? string.Empty;
        error = null;
        var existing = Combo.Cards.FirstOrDefault(card => card.CardId == selectedCardId);
        if (existing is not null) {
            minCount = existing.MinCount.ToString();
            maxCount = existing.MaximumMode == RequirementMaximumMode.HandSize ? string.Empty : existing.MaxCount.ToString();
        }
        else ResetEditorDefaults();
    }

    private Task RemoveCategory(ComboCategory category) {
        var newCats = Combo.Categories.Where(c => c != category).ToList();
        var newCombo = Combo.WithCategories(newCats);
        return OnReplaceCombo.InvokeAsync((Index, newCombo));
    }

    private void OnSelectCategory(string? value) {
        selectedCategory = value ?? string.Empty;
        error = null;
        var existing = Combo.Categories.FirstOrDefault(c => c.BaseCategory.Identity == selectedCategory);
        if (existing is not null) {
            minCount = existing.MinCount.ToString();
            maxCount = existing.MaximumMode == RequirementMaximumMode.HandSize ? string.Empty : existing.MaxCount.ToString();
        }
        else {
            ResetEditorDefaults();
        }
    }

    private void ResetEditorDefaults() {
        minCount = "1";
        maxCount = string.Empty;
    }

    private bool TryMaximum(int minimum, out int maximum) {
        if (MaximumMode == RequirementMaximumMode.HandSize) {
            maximum = HandSize;
            return true;
        }

        return int.TryParse(maxCount, out maximum) && maximum >= minimum && maximum >= 0;
    }

    protected override void OnInitialized() {
        ResetEditorDefaults();
    }

    protected override void OnParametersSet() {
        availableCategories = CategoryCatalog.Build(CategoryBases, Cards, [Combo]);
        if (CategoryRename is { } rename && rename.Version != previousCategoryRenameVersion) {
            if (selectedCategory.Equals($"user:{rename.OldName}", StringComparison.Ordinal))
                selectedCategory = $"user:{rename.NewName}";
            previousCategoryRenameVersion = rename.Version;
        }

        // Hand size affects effective bounds only; leave committed values and drafts intact.
    }
}
