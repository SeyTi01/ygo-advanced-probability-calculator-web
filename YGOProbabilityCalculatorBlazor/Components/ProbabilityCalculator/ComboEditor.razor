@inject YGOProbabilityCalculatorBlazor.Services.Interface.ICardInfoService CardInfoService
@using YGOProbabilityCalculatorBlazor.Models
@using YGOProbabilityCalculatorBlazor.Components.Shared

<div data-language-edit="@(HasUnsubmittedEdit ? "true" : null)" class="accordion-item combo-editor @(Combo.Active ? "" : "entry-inactive")">
    <div class="accordion-header entry-editor-header combo-editor-header">
        <h2 class="entry-heading">
            <button class="accordion-button flex-grow-1 @(Index == ActiveComboIndex ? "" : "collapsed")"
                    type="button"
                    aria-expanded="@(Index == ActiveComboIndex ? "true" : "false")"
                    aria-controls="combo@(Index)"
                    @onclick="ToggleCombo">
                <span class="combo-header-content">
                    <span class="combo-header-identity">
                        <span class="combo-header-name">@ComboDisplayName</span>
                        @if (AssignedGroup is { } assignedGroup) {
                            <small class="combo-group-membership text-body-secondary" aria-label="@(UiText.Format("Combo.GroupLabel", assignedGroup.Name))">
                                <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false">
                                    <path d="M2 2.5A1.5 1.5 0 0 1 3.5 1h9A1.5 1.5 0 0 1 14 2.5v1A1.5 1.5 0 0 1 12.5 5h-9A1.5 1.5 0 0 1 2 3.5zm1 0v1a.5.5 0 0 0 .5.5h9a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5h-9a.5.5 0 0 0-.5.5m-1 4A1.5 1.5 0 0 1 3.5 5h9A1.5 1.5 0 0 1 14 6.5v1A1.5 1.5 0 0 1 12.5 9h-9A1.5 1.5 0 0 1 2 7.5zm1 0v1a.5.5 0 0 0 .5.5h9a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5h-9a.5.5 0 0 0-.5.5m-1 4A1.5 1.5 0 0 1 3.5 9h9a1.5 1.5 0 0 1 1.5 1.5v1a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 11.5zm1 0v1a.5.5 0 0 0 .5.5h9a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5h-9a.5.5 0 0 0-.5.5" fill="currentColor"/>
                                </svg>
                                <span>@assignedGroup.Name</span>
                            </small>
                        }
                    </span>

                    <span class="combo-header-requirements">
                        @if (ConstraintCount > 0) {
                            @foreach (ComboRequirementPosition position in Combo.RequirementOrder.Take(MaxHeaderBadges)) {
                                <span class="expression-term">
                                    @if (position != Combo.RequirementOrder[0]) { <span class="expression-and" aria-hidden="true">+</span> }
                                    @if (position.Kind == ComboRequirementKind.Category) { @CategoryBadge(Combo.Categories[position.Index]) }
                                    else if (position.Kind == ComboRequirementKind.Card) { @CardBadge(Combo.Cards[position.Index]) }
                                    else { @AlternativeGroupMarkup(Combo.AlternativeGroups[position.Index]) }
                                </span>
                            }
                            @if (HiddenHeaderCategoriesCount > 0) {
                                <span class="badge bg-secondary ms-1">@(UiText.Format("Combo.MoreRequirements", HiddenHeaderCategoriesCount))</span>
                            }
                        }
                        else {
                            <span class="text-muted ms-2">@(UiText.Get("Combo.NoRequirements"))</span>
                        }
                        @if (!Combo.Active) {
                            <span class="badge text-bg-secondary ms-2">@(UiText.Get("Ui.Inactive"))</span>
                        }
                    </span>
                </span>
            </button>

        </h2>
        <div class="entry-actions">
            <RowActionMenu Kind="combo" ItemLabel="@(UiText.Format("Ui.Combo0Row1", ComboDisplayName, Index + 1))"
                           Index="Index" Count="Count" Active="Combo.Active"
                           OnMove="OnMove" OnDuplicate="() => OnDuplicateCombo.InvokeAsync(Index)"
                           OnToggle="() => ChangeActive(!Combo.Active)"
                           OnRemove="() => OnRemoveCombo.InvokeAsync(Index)" />
        </div>
    </div>

    <div id="combo@(Index)" class="accordion-collapse collapse @(Index == ActiveComboIndex ? "show" : "")">
        <div class="accordion-body">
            @if (_error is not null) {
                <DismissibleAlert Message="@_error" OnDismiss="@(() => _error = null)"/>
            }
            @if (Combo.AllCards.Any(card => !Cards.Any(row => row.Id == card.CardId))) {
                <p class="text-danger" role="status">@(UiText.Get("Ui.MissingCardReferenceRemoveTheMissingRequirementThenAddAnotherCardIfNeeded"))</p>
            }
            <div class="combo-name-row">
                <div class="combo-name-field">
                    <label for="comboName@(Index)" class="form-label">@(UiText.Get("Ui.Name"))</label>
                    <input id="comboName@(Index)" class="form-control"
                           value="@(Combo.Name ?? string.Empty)"
                           @oninput="e => Rename(e.Value?.ToString())"/>
                </div>
            </div>

            <div class="requirement-list expanded-expression" aria-label="@(UiText.Get("Ui.ComboRequirements"))">
                @foreach (ComboRequirementPosition position in Combo.RequirementOrder) {
                    @if (position != Combo.RequirementOrder[0]) { @RequirementSeparator(position) }
                    @if (position.Kind == ComboRequirementKind.Category) {
                        @RequirementRow(ComboAlternative.For(Combo.Categories[position.Index]), position.Index, null)
                    }
                    else if (position.Kind == ComboRequirementKind.Card) {
                        @RequirementRow(ComboAlternative.For(Combo.Cards[position.Index]), position.Index, null)
                    }
                    else {
                        int groupIndex = position.Index;
                        ComboAlternativeGroup group = Combo.AlternativeGroups[groupIndex];
                        <ExpressionGroup Label="@(UiText.Format("Ui.AlternativeGroup0", groupIndex + 1))">
                            @foreach ((int start, int count) in AlternativeTerms(group)) {
                                @if (start > 0) { @GroupSeparator(groupIndex, boundary: start) }
                                @if (count == 1 && IsComposite(group.Alternatives[start])) {
                                    @RequirementRow(group.Alternatives[start], start, groupIndex)
                                }
                                else { @AlternativeTerm(group, groupIndex, start, count) }
                            }
                        </ExpressionGroup>
                    }
                }
                <ExpressionSeparator Operator="AND" Symbol="+" InputLabel="@(UiText.Get(ConstraintCount == 0 ? "Ui.AddRequirement.2d4936b2" : "Ui.AddASeparateCopyRequirement"))"
                                     AddButtonClass="add-top-level-group" AddExpanded="_draft.IsNewRequirement" OnAdd="BeginTopLevelRequirement" @ref="_newRequirementButton" />
                @if (_draft.IsNewRequirement) { @RequirementForm() }
            </div>

            <div class="combo-footer">
                <div class="combo-group-field">
                    <label for="comboGroup@(Index)" class="form-label">@(UiText.Get("Ui.ResultGroup"))</label>
                    <select id="comboGroup@(Index)" class="form-select form-select-sm"
                            aria-label="@(UiText.Format("Ui.GroupFor0", ComboDisplayName))" value="@Combo.GroupId"
                            @onchange="e => AssignGroup(e.Value?.ToString())">
                        <option value="">@(UiText.Get("Ui.Ungrouped"))</option>
                        @foreach (ComboGroup group in ComboGroups) {
                            <option value="@group.Id">@group.Name</option>
                        }
                    </select>
                </div>
            </div>

        </div>
    </div>
</div>

@code {
    private RenderFragment RequirementSeparator(ComboRequirementPosition right) => @<ExpressionSeparator Operator="AND" Symbol="+" AllowedOperators="PeerOperators(right)" Error="@(ConnectorError($"peer:{right}"))"
        @ref="_connectors[PeerKey(right)]" OnOperatorChanged="operation => BeginPeerConversion(right, operation)" />;

    private RenderFragment RequirementRow(ComboAlternative requirement, int index, int? groupIndex) => @<ExpressionRow
        @key="TermIdentity(requirement, index, groupIndex)" Label="@(UiText.Format("Ui.Edit0", AlternativeTargetLabel(requirement)))" Expanded="IsOpenRow(requirement, index, groupIndex)"
        InteractiveSummary="@(requirement.Category?.CategoryBases.Count > 1)" CenterContent="true" HideEditLabel="true"
        @ref="_rowButtons[RowKey(requirement, index, groupIndex)]" data-requirement="@RowKey(requirement, index, groupIndex)"
        OnEdit="() => BeginEdit(requirement, index, groupIndex)">
        <ChildContent>
            @if (requirement.Category is { } category) { @CategoryBadge(category, operation => ConvertSameCard(requirement, index, groupIndex, operation), SameCardOperators(requirement, index, groupIndex), ConnectorError($"same:{RowKey(requirement, index, groupIndex)}"), showParentheses: false, editProperty: property => BeginEdit(requirement, index, groupIndex, property), activeProperty: IsOpenRow(requirement, index, groupIndex) ? _draft.Values.ActiveProperty : null) }
            else { @CardBadge(requirement.Card!) }
        </ChildContent>
        <EditorContent>
            @if (IsOpenRow(requirement, index, groupIndex)) { @RequirementForm() }
        </EditorContent>
    </ExpressionRow>;

    private RenderFragment GroupSeparator(int groupIndex, bool inline = false, int? boundary = null) => @<ExpressionSeparator Operator="OR" Inline="inline"
        AllowedOperators="AlternativeRowOperators(groupIndex, boundary)" Error="@ConnectorError($"group:{groupIndex}")"
        @ref="_connectors[GroupKey(groupIndex)]" OnOperatorChanged="operation => ChangeAlternativeRowOperator(groupIndex, boundary, operation)" />;

    private RenderFragment AlternativeTerm(ComboAlternativeGroup group, int groupIndex, int start, int count) => @<ExpressionRow
        @key="TermIdentity(group.Alternatives[start], start, groupIndex)" Label="@(UiText.Format("Ui.EditAlternativesInORGroup0", groupIndex + 1))"
        Expanded="@Enumerable.Range(start, count).Any(index => IsOpenRow(group.Alternatives[index], index, groupIndex))"
        InteractiveSummary="true" CenterContent="true" HideEditLabel="true" @ref="_rowButtons[RowKey(group.Alternatives[start], start, groupIndex)]"
        OnEdit="() => ToggleAlternativeTerm(group, groupIndex, start, count)">
        <ChildContent>
            <ExpressionTerm Count="count" Operator="OR" CenterOperands="@(count > 1 && !group.Alternatives.Skip(start).Take(count).Any(IsComposite))" OperandKey="offset => RowIdentity(group.Alternatives[start + offset], start + offset, groupIndex)">
                <SeparatorContent>@GroupSeparator(groupIndex, inline: true)</SeparatorContent>
                <OperandContent Context="offset">
                    @{ int leafIndex = start + offset; ComboAlternative leaf = group.Alternatives[leafIndex]; }
                    @if (IsComposite(leaf)) {
                        <span data-requirement="@RowKey(leaf, leafIndex, groupIndex)">
                        @CategoryBadge(leaf.Category!, showParentheses: true,
                            editProperty: property => BeginEdit(leaf, leafIndex, groupIndex, property),
                            activeProperty: IsOpenRow(leaf, leafIndex, groupIndex) ? _draft.Values.ActiveProperty : null)
                        </span>
                    }
                    else {
                    <ExpressionMember @ref="_alternativeButtons[RowKey(leaf, leafIndex, groupIndex)]" data-requirement="@RowKey(leaf, leafIndex, groupIndex)"
                        Label="@(UiText.Format("Ui.Edit0", AlternativeTargetLabel(leaf)))" Expanded="IsOpenRow(leaf, leafIndex, groupIndex)" OnEdit="() => BeginEdit(leaf, leafIndex, groupIndex)">
                        @AlternativeBadge(leaf, showParentheses: false)
                    </ExpressionMember>
                    }
                </OperandContent>
            </ExpressionTerm>
        </ChildContent>
        <EditorContent>
            @if (Enumerable.Range(start, count).Any(index => IsOpenRow(group.Alternatives[index], index, groupIndex))) { @RequirementForm() }
        </EditorContent>
    </ExpressionRow>;

    private RenderFragment RequirementForm() => @<RequirementEditForm @key="_formVersion"
        Mode="@(_draft.Editing is not null ? "edit" : AndScope ? "AND" : AlternativeScope ? "OR" : "add")"
        UpdateExisting="@(_draft.Editing is null && !AuthoringScope && HasSelectedConstraint)"
        ShowActions="@(_draft.Editing is not null)" ActionOperators="@(_draft.Values.Target.Kind == ComboDraftTargetKind.Category ? new[] { "AND", "OR" } : new[] { "OR" })"
        OnAddAlternative="ExtendWithAlternative" OnAddProperty="ExtendWithProperty" OnRemoveRequirement="DeleteEditingRequirement"
        OperandCount="1" OperandKey="FormOperandKey" Error="@PropertyError" OnSubmit="AddConstraint" OnCancel="CancelRequirement">
        <OperandContent Context="position">
            <RequirementPropertyPicker @ref="_propertyPickers[position]" Id="@(position == 0 ? $"comboTarget{Index}" : $"comboProperty{Index}-{position}")"
                Value="@SelectedTarget"
                Label="@(UiText.Get("Ui.Requirement"))"
                Categories="@(EditingComposite ? _availableCategories : SelectableCategories.ToArray())" Cards="@(AndScope || EditingComposite ? [] : Cards)"
                RelevantIdentities="_categoryOptions.RelevantMetadataIdentities" CardLabel="card => CardSelectionLabel(card.Id)"
                OnChanged="change => ChangeRequirementTarget(position, change)" />
        </OperandContent>
        <QuantityContent>
            <label for="minCount@(Index)" class="form-label">@(UiText.Get("Ui.AtLeast"))</label>
            <input id="minCount@(Index)" class="form-control" type="number" min="0" step="1" value="@_draft.Values.Minimum"
                   @ref="_minimumInput"
                   @oninput="e => _draft.Values.Minimum = e.Value?.ToString() ?? string.Empty" />
        </QuantityContent>
        <AfterContent>
        <details class="requirement-bounds" open="@(_draft.Values.Maximum.Length > 0)">
            <summary class="control-focus-ring">@(string.IsNullOrEmpty(_draft.Values.Maximum) ? UiText.Get("Requirement.MaximumAny") : UiText.Format("Requirement.MaximumCount", _draft.Values.Maximum))</summary>
            <div class="requirement-max">
                <label for="maxCount@(Index)" class="form-label">@(UiText.Get("Ui.AtMost"))</label>
                <input id="maxCount@(Index)" class="form-control" type="number" min="0" step="1" placeholder="@(UiText.Get("Ui.Any"))"
                       title="@(UiText.Get("Ui.LeaveEmptyForAny"))" value="@_draft.Values.Maximum" @oninput="e => _draft.Values.Maximum = e.Value?.ToString() ?? string.Empty" />
                <small class="text-body-secondary">@(UiText.Get("Ui.LeaveEmptyForAnyNumberSetBothCountsTo0ToExcludeMatchingCards"))</small>
            </div>
        </details>
        </AfterContent>
    </RequirementEditForm>;

    [Parameter] public int Index { get; set; }
    [Parameter] public int Count { get; set; }
    [Parameter] public EventCallback<(int From, int To)> OnMove { get; set; }
    [Parameter] public Combo Combo { get; set; } = null!;
    [Parameter] public IReadOnlyList<Card> Cards { get; set; } = [];
    [Parameter] public IReadOnlyList<CategoryBase> CategoryBases { get; set; } = [];
    [Parameter] public IReadOnlySet<string> RelevantMetadataCategoryIdentities { get; set; } = new HashSet<string>(StringComparer.Ordinal);
    [Parameter] public IReadOnlyList<ComboGroup> ComboGroups { get; set; } = [];
    [Parameter] public IReadOnlyDictionary<string, int> CategoryColorIndices { get; set; } = new Dictionary<string, int>(StringComparer.Ordinal);
    [Parameter] public CategoryRenameNotice? CategoryRename { get; set; }

    [Parameter] public int ActiveComboIndex { get; set; }
    [Parameter] public EventCallback<int> ActiveComboIndexChanged { get; set; }

    [Parameter] public EventCallback<(int Index, Combo NewCombo)> OnReplaceCombo { get; set; }
    [Parameter] public EventCallback<int> OnRemoveCombo { get; set; }
    [Parameter] public EventCallback<int> OnDuplicateCombo { get; set; }

    [Parameter] public int HandSize { get; set; } = 5;

    private const int MaxHeaderBadges = 6;
    private CategoryCatalogOptions _categoryOptions = CategoryCatalogOptions.Empty;

    private string? _error;
    private readonly ComboEditorDraft _draft = new();
    private readonly Dictionary<int, RequirementPropertyPicker> _propertyPickers = [];
    private readonly Dictionary<int, string> _propertyErrors = [];
    private readonly Dictionary<string, CategoryBase> _numericCategories = new(StringComparer.Ordinal);
    private int _formVersion;
    private readonly List<object> _propertyKeys = [];
    private bool _focusAlternativeEntry;
    private Combo? _previousCombo;
    private int _previousCategoryRenameVersion;

    private string CategoryCssClass(CategoryBase category) => CategoryChipPalette.GetCssClass(category, CategoryColorIndices);

    // The shell blocks language reloads while this form owns unsubmitted state.
    private bool HasUnsubmittedEdit => _draft.Operation is not null
        || _draft.Values.Target.Identity.Length > 0 || _draft.Values.Minimum != "1" || _draft.Values.Maximum.Length > 0 || _propertyErrors.Count > 0;

    private bool AlternativeScope => _draft.Alternative is not null;
    private bool AndScope => _draft.Property is not null;
    private bool AuthoringScope => _draft.IsAuthoring;
    private IReadOnlyList<CategoryBase> _availableCategories => _categoryOptions.All;

    private IEnumerable<CategoryBase> SelectableCategories => _draft.Property?.Seed is { } seed
        ? _availableCategories.Where(category => !seed.Selector.CategoryIdentities.Contains(category.Identity, StringComparer.Ordinal))
        : _availableCategories;
    private string AlternativeRange(ComboAlternative alternative) => alternative.Category is { } category
        ? RequirementRangeFormatter.Format(category.MinCount, category.MaxCount, category.MaximumMode)
        : RequirementRangeFormatter.Format(alternative.Card!.MinCount, alternative.Card.MaxCount, alternative.Card.MaximumMode);

    private string AlternativeTargetLabel(ComboAlternative alternative) {
        string subject;

        if (alternative.Card is { } card) {
            subject = UiText.Format("Requirement.Card", CardSelectionLabel(card.CardId));
        }
        else {
            CategoryBase category = alternative.Category!.BaseCategory;
            string categoryKind = category.Source == CategorySource.Metadata ? UiText.Get("Ui.Property") : UiText.Get("Ui.Category");
            subject = UiText.Format("Requirement.Subject", categoryKind, DisplayLabels.Requirement(alternative.Category!));
        }

        return UiText.Format("Requirement.WithRange", subject, AlternativeRange(alternative));
    }

    private static string CategoryBadgeClass(ComboCategory category, bool showParentheses, bool interactive) {
        if (category.CategoryBases.Count == 1) { return "single-card-group"; }
        if (showParentheses) { return "composite-alternative same-card-group"; }

        return interactive ? "same-card-group centered-same-card-group" : "same-card-group";
    }

    private RenderFragment CategoryBadge(ComboCategory category, Func<string, Task>? changeOperator = null, IReadOnlyList<string>? allowedOperators = null, string? operatorError = null, bool showParentheses = true, Action<int>? editProperty = null, int? activeProperty = null) => @<span class="@CategoryBadgeClass(category, showParentheses, changeOperator is not null)">
        @if (category.CategoryBases.Count == 1) { @PropertyBadge(category, 0) }
        else {
            <ExpressionTerm Count="category.CategoryBases.Count" Compact="@(showParentheses && editProperty is null)" CenterOperands="@(!showParentheses && changeOperator is not null)" OperandKey="index => category.CategoryBases[index].Identity"
                AllowedOperators="@(allowedOperators ?? ["AND", "OR"])" Error="@operatorError"
                OnOperatorChanged="@(changeOperator is null ? default : EventCallback.Factory.Create(this, changeOperator))">
                <PrefixContent>@if (showParentheses && category.CategoryBases.Count > 1) { @ExpressionParenthesis(true) }</PrefixContent>
                <SuffixContent>@if (showParentheses && category.CategoryBases.Count > 1) { @ExpressionParenthesis(false) }</SuffixContent>
                <OperandContent Context="index">
                    @if (editProperty is not null) {
                        <ExpressionMember Label="@(UiText.Format("Ui.Edit0", DisplayLabels.Category(category.CategoryBases[index])))" Expanded="@(activeProperty == index)" OnEdit="() => editProperty(index)">@PropertyBadge(category, index)</ExpressionMember>
                    } else { @PropertyBadge(category, index) }
                </OperandContent>
            </ExpressionTerm>
        }
    </span>;

    private RenderFragment PropertyBadge(ComboCategory category, int index) => @<ExpressionBadge CssClass="@CategoryCssClass(category.CategoryBases[index])"
        Title="@(category.CategoryBases[index].Source == CategorySource.Metadata ? UiText.Get("Ui.CardProperty") : null)">
        @DisplayLabels.Category(category.CategoryBases[index])
        @if (index == category.CategoryBases.Count - 1) {
            <span class="same-card-range"> (@RequirementRangeFormatter.Format(category.MinCount, category.MaxCount, category.MaximumMode))</span>
        }
    </ExpressionBadge>;

    private RenderFragment CardBadge(ComboCard card) => @<ExpressionBadge CssClass="@($"combo-card-tag {(Cards.Any(row => row.Id == card.CardId) ? "" : "combo-missing-card")}")">
        @(UiText.Format("Requirement.Card", CardDisplayName(card.CardId))) <span class="same-card-range">(@RequirementRangeFormatter.Format(card.MinCount, card.MaxCount, card.MaximumMode))</span>
    </ExpressionBadge>;

    private RenderFragment AlternativeBadge(ComboAlternative alternative, bool showParentheses = true) => @<text>
        @if (alternative.Category is { } category) {
            @CategoryBadge(category, showParentheses: showParentheses)
        }
        else { @CardBadge(alternative.Card!) }
    </text>;

    private RenderFragment AlternativeGroupMarkup(ComboAlternativeGroup group) => @<span class="alternative-group">
        <ExpressionTerm Count="group.Alternatives.Count" Operator="OR" Compact="true">
            <PrefixContent>@ExpressionParenthesis(true)</PrefixContent>
            <SuffixContent>@ExpressionParenthesis(false)</SuffixContent>
            <OperandContent Context="index">@AlternativeBadge(group.Alternatives[index])</OperandContent>
        </ExpressionTerm>
    </span>;

    private static RenderFragment ExpressionParenthesis(bool opening) => @<span class="expression-parenthesis">
        <span class="visually-hidden">@(opening ? "(" : ")")</span>
        <svg viewBox="0 0 6 24" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <path d="@(opening ? "M5 1 Q1 12 5 23" : "M1 1 Q5 12 1 23")" fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke" />
        </svg>
    </span>;

    private void CancelScopedAuthoring() {
        _formVersion++;
        _propertyKeys.Clear();
        _propertyErrors.Clear();
        _connectorErrorKey = null;
        _connectorError = null;
        _focusAlternativeEntry = true;
        _draft.Cancel();
        _error = null;
    }

    private void BeginAlternativeDraft(ComboAlternativeAnchor anchor) {
        _draft.BeginAlternative(anchor);
        _error = null;
        _focusAlternativeEntry = true;
    }

    private void BeginAndDraft(ComboCategory seed, ComboDraftLocation location, ComboAlternativeGroup? group) {
        _draft.BeginProperty(seed, location, group);
        _error = null;
        _focusAlternativeEntry = true;
    }

    private Task CommitAnd() {
        if (_draft.Property is not { } draft || !AndTargetIsCurrent) {
            CancelScopedAuthoring();
            return Task.CompletedTask;
        }

        if (!int.TryParse(_draft.Values.Minimum, out int minimum) || minimum < 0 || !TryMaximum(minimum, out int maximum)) {
            _error = UiText.Get("Ui.EnterValidMinimumAndMaximumCounts");
            return Task.CompletedTask;
        }

        CategoryBase? category = FindRequirementCategory(_draft.Values.Target.CategoryIdentity);
        if (category is not null && draft.Seed.CategoryBases.Any(existing => existing.Identity == category.Identity)) { category = null; }
        if (category is null) {
            _error = UiText.Get("Ui.SelectACategoryToAddAsAnANDCondition");
            return Task.CompletedTask;
        }

        ComboCategory updatedRequirement = ComboCategory.SameCard(
            draft.Seed.CategoryBases.Append(category),
            minimum,
            maximum,
            MaximumMode
        );
        ComboAlternative replacement = ComboAlternative.For(updatedRequirement);
        Combo updated = draft.Location.GroupIndex is int groupIndex
            ? ComboRequirementEditing.ReplaceAlternative(Combo, groupIndex, draft.Location.Index, replacement)
            : ComboRequirementEditing.Replace(Combo, draft.Location.Position, replacement);
        _returnRowKey = RowKey(replacement, draft.Location.Index, draft.Location.GroupIndex);
        CancelScopedAuthoring();
        return OnReplaceCombo.InvokeAsync((Index, updated));
    }

    private Task CommitAlternative() {
        if (_draft.Alternative is not { } draft || !AlternativeTargetIsCurrent) {
            CancelScopedAuthoring();

            return Task.CompletedTask;
        }

        if (!int.TryParse(_draft.Values.Minimum, out int minimum) || minimum < 0 || !TryMaximum(minimum, out int maximum)) {
            _error = UiText.Get("Ui.EnterValidMinimumAndMaximumCounts");

            return Task.CompletedTask;
        }

        ComboAlternative leaf;

        if (_draft.Values.Target.Kind == ComboDraftTargetKind.Card && Cards.Any(card => card.Id == _draft.Values.Target.CardId)) {
            leaf = ComboAlternative.For(new ComboCard(_draft.Values.Target.CardId, minimum, maximum, MaximumMode));
        }
        else if (_draft.Values.Target.Kind == ComboDraftTargetKind.Category && FindRequirementCategory(_draft.Values.Target.CategoryIdentity) is { } category) {
            leaf = ComboAlternative.For(new ComboCategory(category, minimum, maximum, MaximumMode));
        }
        else {
            _error = UiText.Get("Ui.SelectATargetForThisAlternative");

            return Task.CompletedTask;
        }

        Combo updated = Combo;
        int insertedIndex = draft.InsertIndex ?? (draft.Anchor as ComboAlternativeGroupAnchor)?.Group.Alternatives.Count ?? 1;

        if (draft.Anchor is ComboAlternativeGroupAnchor groupAnchor) {
            ComboAlternativeGroup currentGroup = groupAnchor.Group;
            int groupIndex = groupAnchor.GroupIndex;
            List<ComboAlternative> alternatives = currentGroup.Alternatives.ToList();
            alternatives.Insert(insertedIndex, leaf);
            updated = ComboRequirementEditing.WithAlternatives(Combo, groupIndex, alternatives);
        }
        else if (draft.Anchor is ComboAlternativeSeedAnchor seedAnchor) {
            ComboAlternative seed = seedAnchor.Seed;
            ComboRequirementPosition position = seedAnchor.Location.Position;
            int authoredPosition = Combo.RequirementOrder.ToList().IndexOf(position);
            updated = ComboRequirementEditing.AppendGroup(Combo.WithoutRequirement(position), [seed, leaf], authoredPosition);
        }

        int savedGroup = (draft.Anchor as ComboAlternativeGroupAnchor)?.GroupIndex ?? updated.AlternativeGroups.Count - 1;
        _returnRowKey = $"alternative:{savedGroup}:{insertedIndex}";
        if (draft.TermIdentity is { } term) {
            TransferRowIdentities(updated);
            _termIdentities[RowIdentity(leaf, insertedIndex, savedGroup)] = term;
        }
        CancelScopedAuthoring();

        return OnReplaceCombo.InvokeAsync((Index, updated));
    }

    private bool AlternativeTargetIsCurrent => _draft.Alternative?.Anchor switch {
        ComboAlternativeGroupAnchor anchor => anchor.GroupIndex >= 0
            && anchor.GroupIndex < Combo.AlternativeGroups.Count
            && ReferenceEquals(Combo.AlternativeGroups[anchor.GroupIndex], anchor.Group),
        ComboAlternativeSeedAnchor anchor => anchor.Location.Find(Combo) is { } current && SameRequirement(current, anchor.Seed),
        _ => false
    };

    private bool AndTargetIsCurrent => _draft.Property is { } draft
        && draft.Location.Find(Combo)?.Category is { } current
        && ReferenceEquals(current, draft.Seed)
        && (draft.Location.GroupIndex is not int group || ReferenceEquals(Combo.AlternativeGroups[group], draft.Group));

    private Task RemoveAlternative(
        ComboAlternativeGroup group,
        int groupIndex,
        ComboAlternative alternative,
        int leafIndex
    ) {
        bool isCurrentGroup = groupIndex >= 0
            && groupIndex < Combo.AlternativeGroups.Count
            && ReferenceEquals(Combo.AlternativeGroups[groupIndex], group);

        if (!isCurrentGroup) {
            return Task.CompletedTask;
        }

        bool isCurrentAlternative = leafIndex >= 0
            && leafIndex < group.Alternatives.Count
            && ReferenceEquals(group.Alternatives[leafIndex], alternative);

        if (!isCurrentAlternative) {
            return Task.CompletedTask;
        }

        Combo updated = ComboRequirementEditing.RemoveAlternative(Combo, groupIndex, leafIndex);

        if (_draft.Alternative?.Anchor is ComboAlternativeGroupAnchor anchor && anchor.GroupIndex == groupIndex && ReferenceEquals(anchor.Group, group)) {
            CancelScopedAuthoring();
        }

        return OnReplaceCombo.InvokeAsync((Index, updated));
    }

    private string ComboDisplayName => string.IsNullOrWhiteSpace(Combo.Name) ? UiText.Format("Ui.Combo0", Index + 1) : Combo.Name;

    private ComboGroup? AssignedGroup => Combo.GroupId is { Length: > 0 } groupId
        ? ComboGroups.FirstOrDefault(group => group.Id == groupId)
        : null;

    private bool HasSelectedConstraint => _draft.Values.Target.Kind == ComboDraftTargetKind.Card
        ? Combo.Cards.Any(card => card.CardId == _draft.Values.Target.CardId)
        : Combo.Categories.Any(category => category.CategoryBases.Count == 1 && category.BaseCategory.Identity == _draft.Values.Target.CategoryIdentity);

    private int ConstraintCount => Combo.RequirementCount;
    private int HiddenHeaderCategoriesCount => Math.Max(0, ConstraintCount - MaxHeaderBadges);

    private RequirementMaximumMode MaximumMode => string.IsNullOrWhiteSpace(_draft.Values.Maximum)
        ? RequirementMaximumMode.HandSize
        : RequirementMaximumMode.Fixed;

    private string CardDisplayName(string cardId) {
        int index = Cards.ToList().FindIndex(card => card.Id == cardId);

        if (index < 0) {
            return UiText.Format("Ui.MissingCard0", cardId[..Math.Min(8, cardId.Length)]);
        }

        string cardName = DisplayLabels.Card(Cards[index], CardInfoService);

        return string.IsNullOrWhiteSpace(cardName) ? UiText.Get("Ui.UnnamedCard") : cardName;
    }

    private string CardSelectionLabel(string cardId) {
        int index = Cards.ToList().FindIndex(card => card.Id == cardId);

        if (index < 0) {
            return CardDisplayName(cardId);
        }

        return $"{CardDisplayName(cardId)} #{index + 1}";
    }

    private Task ToggleCombo() {
        int next = ActiveComboIndex == Index ? -1 : Index;

        return ActiveComboIndexChanged.InvokeAsync(next);
    }

    private Task Rename(string? name) {
        Combo newCombo = Combo.WithName(string.IsNullOrWhiteSpace(name) ? null : name);

        return OnReplaceCombo.InvokeAsync((Index, newCombo));
    }

    private Task ChangeActive(object? value) {
        if (!bool.TryParse(value?.ToString(), out bool active)) {
            return Task.CompletedTask;
        }

        return OnReplaceCombo.InvokeAsync((Index, Combo.WithActive(active)));
    }

    private Task AssignGroup(string? groupId) =>
        OnReplaceCombo.InvokeAsync((Index, Combo.WithGroup(string.IsNullOrEmpty(groupId) ? null : groupId)));

    private Task AddConstraint() {
        if (PropertyError is not null) { _error = PropertyError; return Task.CompletedTask; }
        if (_draft.Editing is not null) {
            return CommitEdit();
        }

        if (AndScope) {
            return CommitAnd();
        }

        if (AlternativeScope) {
            return CommitAlternative();
        }

        if (_draft.Values.Target.Kind == ComboDraftTargetKind.Card) {
            return AddCard();
        }

        if (string.IsNullOrWhiteSpace(_draft.Values.Target.CategoryIdentity)) {
            _error = UiText.Get("Ui.PleaseSelectACategoryToAdd");

            return Task.CompletedTask;
        }

        CategoryBase? categoryBase = FindRequirementCategory(_draft.Values.Target.CategoryIdentity);

        if (categoryBase is null) {
            _error = UiText.Get("Ui.SelectedCategoryNotFound");

            return Task.CompletedTask;
        }

        if (!int.TryParse(_draft.Values.Minimum, out int minimum) || minimum < 0) {
            _error = UiText.Get("Ui.MinimumCountMustBeANonNegativeWholeNumber");

            return Task.CompletedTask;
        }

        if (!TryMaximum(minimum, out int maximum)) {
            _error = UiText.Get("Ui.MaximumCountMustBeAWholeNumberAtLeastEqualToMinimumCount");

            return Task.CompletedTask;
        }

        List<ComboCategory> newCategories = Combo.Categories.ToList();
        int existingIndex = newCategories.FindIndex(category => category.CategoryBases.Count == 1 && category.BaseCategory.Identity == categoryBase.Identity);
        ComboCategory constraint = new(categoryBase, minimum, maximum, MaximumMode);

        if (existingIndex >= 0) {
            newCategories[existingIndex] = constraint;
        }
        else {
            newCategories.Add(constraint);
        }

        Combo newCombo = Combo.WithCategories(newCategories);
        _draft.Values.Target = ComboDraftTarget.Category(string.Empty);
        _error = null;
        ResetEditorDefaults();
        FinishNewRequirement($"category:{(existingIndex >= 0 ? existingIndex : newCategories.Count - 1)}");

        return OnReplaceCombo.InvokeAsync((Index, newCombo));
    }

    private Task AddCard() {
        if (string.IsNullOrEmpty(_draft.Values.Target.CardId) || !Cards.Any(card => card.Id == _draft.Values.Target.CardId)) {
            _error = UiText.Get("Ui.PleaseSelectACardToAdd");

            return Task.CompletedTask;
        }

        if (!int.TryParse(_draft.Values.Minimum, out int minimum) || minimum < 0) {
            _error = UiText.Get("Ui.MinimumCountMustBeANonNegativeWholeNumber");

            return Task.CompletedTask;
        }

        if (!TryMaximum(minimum, out int maximum)) {
            _error = UiText.Get("Ui.MaximumCountMustBeAWholeNumberAtLeastEqualToMinimumCount");

            return Task.CompletedTask;
        }

        List<ComboCard> newCards = Combo.Cards.ToList();
        int existingIndex = newCards.FindIndex(card => card.CardId == _draft.Values.Target.CardId);
        ComboCard constraint = new(_draft.Values.Target.CardId, minimum, maximum, MaximumMode);

        if (existingIndex >= 0) {
            newCards[existingIndex] = constraint;
        }
        else {
            newCards.Add(constraint);
        }

        _draft.Values.Target = ComboDraftTarget.Card(string.Empty);
        _error = null;
        ResetEditorDefaults();
        FinishNewRequirement($"card:{(existingIndex >= 0 ? existingIndex : newCards.Count - 1)}");
        return OnReplaceCombo.InvokeAsync((Index, Combo.WithCards(newCards)));
    }

    private Task RemoveCard(ComboCard card, int index) {
        bool isCurrentCard = index >= 0
            && index < Combo.Cards.Count
            && ReferenceEquals(Combo.Cards[index], card);

        if (!isCurrentCard) {
            return Task.CompletedTask;
        }

        if (_draft.Alternative?.Anchor is ComboAlternativeSeedAnchor anchor && ReferenceEquals(anchor.Seed.Card, card) && anchor.Location.Index == index) {
            CancelScopedAuthoring();
        }

        return OnReplaceCombo.InvokeAsync((Index, Combo.WithoutRequirement(new(ComboRequirementKind.Card, index))));
    }

    private void OnSelectCard(string? value) {
        _draft.Values.Target = ComboDraftTarget.Card(value ?? string.Empty);
        _error = null;
        ComboCard? existing = AlternativeScope || _draft.Editing is not null ? null : Combo.Cards.FirstOrDefault(card => card.CardId == _draft.Values.Target.CardId);

        if (existing is not null) {
            _draft.Values.Minimum = existing.MinCount.ToString();
            _draft.Values.Maximum = existing.MaximumMode == RequirementMaximumMode.HandSize ? string.Empty : existing.MaxCount.ToString();
        }
    }

    private Task RemoveCategory(ComboCategory category, int index) {
        bool isCurrentCategory = index >= 0
            && index < Combo.Categories.Count
            && ReferenceEquals(Combo.Categories[index], category);

        if (!isCurrentCategory) {
            return Task.CompletedTask;
        }

        if (_draft.Alternative?.Anchor is ComboAlternativeSeedAnchor anchor && ReferenceEquals(anchor.Seed.Category, category) && anchor.Location.Index == index) {
            CancelScopedAuthoring();
        }

        return OnReplaceCombo.InvokeAsync((Index, Combo.WithoutRequirement(new(ComboRequirementKind.Category, index))));
    }

    private void OnSelectCategory(string? value) {
        _draft.Values.Target = ComboDraftTarget.Category(value ?? string.Empty);
        _error = null;

        if (AndScope) {
            return;
        }

        ComboCategory? existing = AlternativeScope || _draft.Editing is not null
            ? null
            : Combo.Categories.FirstOrDefault(category => category.CategoryBases.Count == 1 && category.BaseCategory.Identity == _draft.Values.Target.CategoryIdentity);

        if (existing is not null) {
            _draft.Values.Minimum = existing.MinCount.ToString();
            _draft.Values.Maximum = existing.MaximumMode == RequirementMaximumMode.HandSize ? string.Empty : existing.MaxCount.ToString();
        }
    }

    private void ResetEditorDefaults() {
        _draft.Values.Minimum = "1";
        _draft.Values.Maximum = string.Empty;
    }

    private bool TryMaximum(int minimum, out int maximum) {
        if (MaximumMode == RequirementMaximumMode.HandSize) {
            maximum = HandSize;
            return true;
        }

        return int.TryParse(_draft.Values.Maximum, out maximum) && maximum >= minimum && maximum >= 0;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (_focusConnector is { } connectorKey) {
            _focusConnector = null;
            if (_connectors.TryGetValue(connectorKey, out ExpressionSeparator? connector)) {
                await connector.FocusAsync();
            }
        }
        if (_focusMinimum) {
            _focusMinimum = false;
            await _minimumInput.FocusAsync();
        }

        if (_focusAlternativeEntry) {
            _focusAlternativeEntry = false;
            if (_returnRowKey is { } member && _alternativeButtons.TryGetValue(member, out ExpressionMember? memberButton) && HasInlineAlternativeButton(member)) {
                _returnRowKey = null;
                await memberButton.FocusAsync(preventScroll: true);
            }
            else if (_returnRowKey is { } key && _rowButtons.TryGetValue(VisibleRowKey(key), out ExpressionRow? button) && RowExists(key)) {
                _returnRowKey = null;
                await button.FocusAsync(preventScroll: true);
            }
            else if (_draft.IsNewRequirement || _draft.Editing is not null || AuthoringScope) {
                if (_propertyPickers.TryGetValue(0, out RequirementPropertyPicker? picker)) { await picker.FocusAsync(); }
            }
            else if (_newRequirementButton is not null) { await _newRequirementButton.FocusAsync(); }
        }

    }

    protected override void OnInitialized() {
        ResetEditorDefaults();
    }

    protected override void OnParametersSet() {
        ReconcileTermIdentities();
        _categoryOptions = CategoryCatalog.BuildOptions(CategoryBases, Cards, [Combo], RelevantMetadataCategoryIdentities);
        if (CategoryRename is CategoryRenameNotice rename && rename.Version != _previousCategoryRenameVersion) {
            string oldIdentity = $"user:{rename.OldName}";
            string newIdentity = $"user:{rename.NewName}";
            _draft.Values.RenameCategory(oldIdentity, newIdentity);
            _draft.SuspendedValues?.RenameCategory(oldIdentity, newIdentity);

            if (_draft.Alternative?.Anchor is ComboAlternativeSeedAnchor anchor
                && anchor.Seed.Category is { } seed && seed.Selector.CategoryIdentities.Contains(oldIdentity)) {
                ComboAlternative? replacement = anchor.Location.Find(Combo);
                bool isCurrentRenamedSeed = ReferenceEquals(_previousCombo, Combo)
                    && replacement?.Category is { } renamed
                    && renamed.Selector.Equals(seed.Selector.RenameCategory(oldIdentity, newIdentity))
                    && renamed.MinCount == seed.MinCount && renamed.MaxCount == seed.MaxCount
                    && renamed.MaximumMode == seed.MaximumMode;
                if (isCurrentRenamedSeed) {
                    _draft.Alternative.Anchor = anchor with { Seed = replacement! };
                }
            }

            if (_draft.Property is { } propertyDraft && ReferenceEquals(_previousCombo, Combo)) {
                ComboAlternativeGroup? replacementGroup = propertyDraft.Location.GroupIndex is int groupIndex
                    ? Combo.AlternativeGroups.ElementAtOrDefault(groupIndex) : null;
                ComboCategory? replacement = propertyDraft.Location.Find(Combo)?.Category;
                ComboCategory propertySeed = propertyDraft.Seed;
                CardSelector renamed = propertySeed.Selector.RenameCategory(oldIdentity, newIdentity);
                if (replacement is not null && replacement.Selector.Equals(renamed)
                    && replacement.MinCount == propertySeed.MinCount && replacement.MaxCount == propertySeed.MaxCount
                    && replacement.MaximumMode == propertySeed.MaximumMode) {
                    propertyDraft.Seed = replacement;
                    propertyDraft.Group = replacementGroup;
                }
            }
            _previousCategoryRenameVersion = rename.Version;
        }

        if (AuthoringScope && !AlternativeScope && !AndTargetIsCurrent) {
            CancelScopedAuthoring();
        }

        if (AlternativeScope && !AlternativeTargetIsCurrent) {
            CancelScopedAuthoring();
        }
        ReconcileEditingRequirement();
        _previousCombo = Combo;

        // Hand size affects effective bounds only; leave committed values and drafts intact.
    }
}
