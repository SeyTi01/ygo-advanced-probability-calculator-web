@using YGOProbabilityCalculatorBlazor.Models
@using YGOProbabilityCalculatorBlazor.Components.Shared

<div class="accordion-item combo-editor @(Combo.Active ? "" : "entry-inactive")">
    <div class="accordion-header entry-editor-header combo-editor-header">
        <h2 class="entry-heading">
            <button class="accordion-button flex-grow-1 @(Index == ActiveComboIndex ? "" : "collapsed")"
                    type="button"
                    aria-expanded="@(Index == ActiveComboIndex ? "true" : "false")"
                    aria-controls="combo@(Index)"
                    @onclick="ToggleCombo">
                <span class="combo-header-content">
                    <span class="combo-header-identity">
                        <span class="combo-header-name">@ComboDisplayName</span>
                        @if (AssignedGroup is { } assignedGroup) {
                            <small class="combo-group-membership text-body-secondary" aria-label="@($"Group: {assignedGroup.Name}")">
                                <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false">
                                    <path d="M2 2.5A1.5 1.5 0 0 1 3.5 1h9A1.5 1.5 0 0 1 14 2.5v1A1.5 1.5 0 0 1 12.5 5h-9A1.5 1.5 0 0 1 2 3.5zm1 0v1a.5.5 0 0 0 .5.5h9a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5h-9a.5.5 0 0 0-.5.5m-1 4A1.5 1.5 0 0 1 3.5 5h9A1.5 1.5 0 0 1 14 6.5v1A1.5 1.5 0 0 1 12.5 9h-9A1.5 1.5 0 0 1 2 7.5zm1 0v1a.5.5 0 0 0 .5.5h9a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5h-9a.5.5 0 0 0-.5.5m-1 4A1.5 1.5 0 0 1 3.5 9h9a1.5 1.5 0 0 1 1.5 1.5v1a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 11.5zm1 0v1a.5.5 0 0 0 .5.5h9a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5h-9a.5.5 0 0 0-.5.5" fill="currentColor"/>
                                </svg>
                                <span>@assignedGroup.Name</span>
                            </small>
                        }
                    </span>

                    <span class="combo-header-requirements">
                        @if (ConstraintCount > 0) {
                            @foreach (ComboRequirementPosition position in Combo.RequirementOrder.Take(MaxHeaderBadges)) {
                                <span class="expression-term">
                                    @if (position != Combo.RequirementOrder[0]) { <span class="expression-and" aria-hidden="true">+</span> }
                                    @if (position.Kind == ComboRequirementKind.Category) { @CategoryBadge(Combo.Categories[position.Index]) }
                                    else if (position.Kind == ComboRequirementKind.Card) { @CardBadge(Combo.Cards[position.Index]) }
                                    else { @AlternativeGroupMarkup(Combo.AlternativeGroups[position.Index]) }
                                </span>
                            }
                            @if (HiddenHeaderCategoriesCount > 0) {
                                <span class="badge bg-secondary ms-1">+@HiddenHeaderCategoriesCount more</span>
                            }
                        }
                        else {
                            <span class="text-muted ms-2">(no requirements)</span>
                        }
                        @if (!Combo.Active) {
                            <span class="badge text-bg-secondary ms-2">Inactive</span>
                        }
                    </span>
                </span>
            </button>

        </h2>
        <div class="entry-actions">
            <RowActionMenu Kind="combo" ItemLabel="@($"combo {ComboDisplayName}, row {Index + 1}")"
                           Index="Index" Count="Count" Active="Combo.Active"
                           OnMove="OnMove" OnDuplicate="() => OnDuplicateCombo.InvokeAsync(Index)"
                           OnToggle="() => ChangeActive(!Combo.Active)"
                           OnRemove="() => OnRemoveCombo.InvokeAsync(Index)" />
        </div>
    </div>

    <div id="combo@(Index)" class="accordion-collapse collapse @(Index == ActiveComboIndex ? "show" : "")">
        <div class="accordion-body">
            @if (_error is not null) {
                <DismissibleAlert Message="@_error" OnDismiss="@(() => _error = null)"/>
            }
            @if (Combo.AllCards.Any(card => !Cards.Any(row => row.Id == card.CardId))) {
                <p class="text-danger" role="status">Missing card reference. Remove the missing requirement, then add another card if needed.</p>
            }
            <div class="combo-name-row mb-3">
                <div class="combo-name-field">
                    <label for="comboName@(Index)" class="form-label">Name</label>
                    <input id="comboName@(Index)" class="form-control"
                           value="@(Combo.Name ?? string.Empty)"
                           @oninput="e => Rename(e.Value?.ToString())"/>
                </div>
            </div>

            <div class="requirement-list expanded-expression" aria-label="Combo requirements">
                @if (ConstraintCount > 0) {
                    <p class="requirement-explanation text-body-secondary">+ separates physical card requirements; AND/OR describe one card.</p>
                }
                @foreach (ComboRequirementPosition position in Combo.RequirementOrder) {
                    @if (position != Combo.RequirementOrder[0]) { @RequirementSeparator(position) }
                    @if (position.Kind == ComboRequirementKind.Category) {
                        @RequirementRow(ComboAlternative.For(Combo.Categories[position.Index]), position.Index, null)
                    }
                    else if (position.Kind == ComboRequirementKind.Card) {
                        @RequirementRow(ComboAlternative.For(Combo.Cards[position.Index]), position.Index, null)
                    }
                    else {
                        int groupIndex = position.Index;
                        ComboAlternativeGroup group = Combo.AlternativeGroups[groupIndex];
                        <ExpressionGroup Label="@($"Alternative group {groupIndex + 1}")">
                            @foreach ((int start, int count) in AlternativeTerms(group)) {
                                @if (start > 0) { @GroupSeparator(groupIndex) }
                                @if (count == 1 && IsComposite(group.Alternatives[start])) {
                                    @RequirementRow(group.Alternatives[start], start, groupIndex)
                                }
                                else { @AlternativeTerm(group, groupIndex, start, count) }
                            }
                        </ExpressionGroup>
                    }
                }
                @if (ShowNewRequirementRow) {
                    @if (ConstraintCount > 0) { <ExpressionSeparator Operator="AND" Symbol="+" AllowedOperators="@(new[] { "+" })" /> }
                    <ExpressionRow Label="Edit new requirement" Expanded="_editingNewRequirement" OnEdit="ToggleNewRequirement"
                                   @ref="_newRequirementRow" data-new-requirement="true">
                        <ChildContent><span class="text-body-secondary">Choose a card, category or property</span></ChildContent>
                        <EditorContent>@if (_editingNewRequirement) { @RequirementForm() }</EditorContent>
                    </ExpressionRow>
                }
            </div>
            @if (!ShowNewRequirementRow) {
                <button type="button" class="btn btn-sm btn-outline-secondary add-top-level-group" title="Add a separate-copy requirement"
                        @ref="_newRequirementButton" @onclick="BeginTopLevelRequirement">+ Add requirement</button>
            }

            <div class="combo-footer">
                <div class="combo-group-field">
                    <label for="comboGroup@(Index)" class="form-label">Result group</label>
                    <select id="comboGroup@(Index)" class="form-select form-select-sm"
                            aria-label="@($"Group for {ComboDisplayName}")" value="@Combo.GroupId"
                            @onchange="e => AssignGroup(e.Value?.ToString())">
                        <option value="">Ungrouped</option>
                        @foreach (ComboGroup group in ComboGroups) {
                            <option value="@group.Id">@group.Name</option>
                        }
                    </select>
                </div>
            </div>

        </div>
    </div>
</div>

@code {
    private RenderFragment RequirementSeparator(ComboRequirementPosition right) => @<ExpressionSeparator Operator="AND" Symbol="+" AllowedOperators="PeerOperators(right)" Error="@(ConnectorError($"peer:{right}"))" OnOperatorChanged="operation => BeginPeerConversion(right, operation)" />;

    private RenderFragment RequirementRow(ComboAlternative requirement, int index, int? groupIndex) => @<ExpressionRow
        @key="RowIdentity(requirement, index, groupIndex)" Label="@($"Edit {AlternativeTargetLabel(requirement)}")" Expanded="IsOpenRow(requirement, index, groupIndex)"
        InteractiveSummary="@(requirement.Category?.CategoryBases.Count > 1)"
        @ref="_rowButtons[RowKey(requirement, index, groupIndex)]" data-requirement="@RowKey(requirement, index, groupIndex)"
        OnEdit="() => BeginEdit(requirement, index, groupIndex)">
        <ChildContent>
            @if (requirement.Category is { } category) { @CategoryBadge(category, operation => ConvertSameCard(requirement, index, groupIndex, operation), SameCardOperators(requirement, index, groupIndex), ConnectorError($"same:{RowKey(requirement, index, groupIndex)}"), showParentheses: false) }
            else { @CardBadge(requirement.Card!) }
        </ChildContent>
        <EditorContent>
            @if (IsOpenRow(requirement, index, groupIndex)) { @RequirementForm() }
        </EditorContent>
    </ExpressionRow>;

    private RenderFragment GroupSeparator(int groupIndex, bool inline = false) => @<ExpressionSeparator Operator="OR" Inline="inline"
        AllowedOperators="GroupOperators(groupIndex)" Error="@ConnectorError($"group:{groupIndex}")"
        @ref="_connectors[GroupKey(groupIndex)]" OnOperatorChanged="operation => ChangeGroupOperator(groupIndex, operation)" />;

    private RenderFragment AlternativeTerm(ComboAlternativeGroup group, int groupIndex, int start, int count) => @<ExpressionRow
        @key="RowIdentity(group.Alternatives[start], start, groupIndex)" Label="@($"Edit alternatives in OR group {groupIndex + 1}")"
        Expanded="@Enumerable.Range(start, count).Any(index => IsOpenRow(group.Alternatives[index], index, groupIndex))"
        InteractiveSummary="true" @ref="_rowButtons[RowKey(group.Alternatives[start], start, groupIndex)]"
        OnEdit="() => ToggleAlternativeTerm(group, groupIndex, start, count)">
        <ChildContent>
            <ExpressionTerm Count="count" Operator="OR" OperandKey="offset => RowIdentity(group.Alternatives[start + offset], start + offset, groupIndex)">
                <SeparatorContent>@GroupSeparator(groupIndex, inline: true)</SeparatorContent>
                <OperandContent Context="offset">
                    @{ int leafIndex = start + offset; ComboAlternative leaf = group.Alternatives[leafIndex]; }
                    <ExpressionMember @ref="_alternativeButtons[RowKey(leaf, leafIndex, groupIndex)]" data-requirement="@RowKey(leaf, leafIndex, groupIndex)"
                        Label="@($"Edit {AlternativeTargetLabel(leaf)}")" Expanded="IsOpenRow(leaf, leafIndex, groupIndex)" OnEdit="() => BeginEdit(leaf, leafIndex, groupIndex)">
                        @AlternativeBadge(leaf)
                    </ExpressionMember>
                </OperandContent>
            </ExpressionTerm>
        </ChildContent>
        <EditorContent>
            @if (Enumerable.Range(start, count).Any(index => IsOpenRow(group.Alternatives[index], index, groupIndex))) { @RequirementForm() }
        </EditorContent>
    </ExpressionRow>;

    private RenderFragment RequirementForm() => @<ExpressionForm OnSubmit="AddConstraint" OnKeyDown="HandleRequirementKeyDown">
        <div class="requirement-form-heading">
            <strong>@(_editingRequirement is not null ? "Edit requirement" : AndScope ? "Another property · same card" : AlternativeScope ? "Add an alternative · OR" : "Add requirement")</strong>
            @if (AuthoringScope || _editingRequirement is not null || _editingNewRequirement) {
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelRequirement">Cancel</button>
            }
        </div>
        @if (AuthoringScope) {
            <p class="alternative-scope text-body-secondary">@ScopeLabel</p>
        }
        @if (_editingRequirement is not null && _draftProperties.Count > 1) {
            <div class="property-edit-list" role="group" aria-label="Properties on the same card">
                @for (int propertyIndex = 0; propertyIndex < _draftProperties.Count; propertyIndex++) {
                    int currentProperty = propertyIndex;
                    @if (propertyIndex > 0) { <ExpressionSeparator Operator="AND" /> }
                    <div class="property-edit-row">
                        <select class="form-select" aria-label="@($"Same-card property {currentProperty + 1}")"
                                value="@_draftProperties[currentProperty].Identity"
                                @onchange="e => ChangeProperty(currentProperty, e.Value?.ToString())">
                            @foreach (CategoryBase category in _availableCategories) {
                                <option value="@category.Identity">@category.Name</option>
                            }
                        </select>
                        <button type="button" class="btn btn-outline-secondary" aria-label="@($"Remove property {currentProperty + 1}")"
                                @onclick="() => RemoveDraftProperty(currentProperty)">×</button>
                    </div>
                }
                <small class="text-body-secondary">Every property must match the same card.</small>
            </div>
        }
        <div class="requirement-fields @(_editingRequirement is not null && _draftProperties.Count > 1 ? "composite-fields" : "")">
            @if (_draftProperties.Count <= 1 || _editingRequirement is null) {
                <div class="requirement-selector">
                    <label for="comboTarget@(Index)" class="form-label">@(AndScope ? "Property or category" : "Card, category or property")</label>
                    <select id="comboTarget@(Index)" @ref="_alternativeEntryTarget" class="form-select" value="@SelectedTarget" @onchange="e => SelectTarget(e.Value?.ToString())">
                        <option value="">Choose…</option>
                        @if (_editingRequirement?.Card is { } missing && !Cards.Any(card => card.Id == missing.CardId)) {
                            <option value="@($"card:{missing.CardId}")">@CardDisplayName(missing.CardId)</option>
                        }
                        @if (!AndScope && AlphabeticalCards.Any()) {
                            <optgroup label="Cards">
                                @foreach (Card card in AlphabeticalCards) { <option value="@($"card:{card.Id}")">@CardSelectionLabel(card.Id)</option> }
                            </optgroup>
                        }
                        @if (SelectableUserCategories.Any()) {
                            <optgroup label="Categories">
                                @foreach (CategoryBase category in SelectableUserCategories) { <option value="@category.Identity">@category.Name</option> }
                            </optgroup>
                        }
                        @if (SelectableRelevantProperties.Any()) {
                            <optgroup label="Relevant properties">
                                @foreach (CategoryBase category in SelectableRelevantProperties) { <option value="@category.Identity">@category.Name</option> }
                            </optgroup>
                        }
                        <optgroup label="Common properties">
                            @foreach (CategoryBase category in SelectableCommonProperties) { <option value="@category.Identity">@category.Name</option> }
                        </optgroup>
                    </select>
                </div>
            }
            <div class="requirement-min">
                <label for="minCount@(Index)" class="form-label">At least</label>
                <input id="minCount@(Index)" class="form-control" type="number" min="0" step="1" value="@_minCount"
                       @ref="_minimumInput"
                       @onkeydown="HandleCountKeyDown" @onkeydown:stopPropagation
                       @oninput="e => _minCount = e.Value?.ToString() ?? string.Empty" />
            </div>
            <div class="requirement-submit">
                <button type="button" class="btn btn-primary" @onclick="AddConstraint">@(_editingRequirement is not null ? "Save" : AndScope ? "Add property" : AlternativeScope ? "Add alternative" : HasSelectedConstraint ? "Update requirement" : "Add")</button>
            </div>
        </div>
        <details class="requirement-bounds" open="@(_maxCount.Length > 0)">
            <summary>Maximum: @(string.IsNullOrEmpty(_maxCount) ? "Any" : _maxCount)</summary>
            <div class="requirement-max">
                <label for="maxCount@(Index)" class="form-label">At most</label>
                <input id="maxCount@(Index)" class="form-control" type="number" min="0" step="1" placeholder="Any"
                       @onkeydown="HandleCountKeyDown" @onkeydown:stopPropagation
                       title="Leave empty for Any" value="@_maxCount" @oninput="e => _maxCount = e.Value?.ToString() ?? string.Empty" />
                <small class="text-body-secondary">Leave empty for any number. Set both counts to 0 to exclude matching cards.</small>
            </div>
        </details>
        @if (_editingRequirement is { } editing) {
            <div class="requirement-context-actions">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-action="alternative" @onclick="ExtendWithAlternative">@(EditingHasChanges ? "Save & add alternative (OR)" : "Add alternative (OR)")</button>
                @if (_selectedKind == "Category") {
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-action="property" @onclick="ExtendWithProperty">@(EditingHasChanges ? "Save & add property (AND)" : "Add property (AND)")</button>
                }
                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="DeleteEditingRequirement">@( _editingGroupIndex is not null ? "Remove alternative" : "Remove requirement")</button>
            </div>
        }
    </ExpressionForm>;

    [Parameter] public int Index { get; set; }
    [Parameter] public int Count { get; set; }
    [Parameter] public EventCallback<(int From, int To)> OnMove { get; set; }
    [Parameter] public Combo Combo { get; set; } = null!;
    [Parameter] public IReadOnlyList<Card> Cards { get; set; } = [];
    [Parameter] public IReadOnlyList<CategoryBase> CategoryBases { get; set; } = [];
    [Parameter] public IReadOnlySet<string> RelevantMetadataCategoryIdentities { get; set; } = new HashSet<string>(StringComparer.Ordinal);
    [Parameter] public IReadOnlyList<ComboGroup> ComboGroups { get; set; } = [];
    [Parameter] public IReadOnlyDictionary<string, int> CategoryColorIndices { get; set; } = new Dictionary<string, int>(StringComparer.Ordinal);
    [Parameter] public CategoryRenameNotice? CategoryRename { get; set; }

    [Parameter] public int ActiveComboIndex { get; set; }
    [Parameter] public EventCallback<int> ActiveComboIndexChanged { get; set; }

    [Parameter] public EventCallback<(int Index, Combo NewCombo)> OnReplaceCombo { get; set; }
    [Parameter] public EventCallback<int> OnRemoveCombo { get; set; }
    [Parameter] public EventCallback<int> OnDuplicateCombo { get; set; }

    [Parameter] public int HandSize { get; set; } = 5;

    private const int MaxHeaderBadges = 6;
    private CategoryCatalogOptions _categoryOptions = CategoryCatalogOptions.Empty;

    private string? _error;
    private string _selectedCategory = string.Empty;
    private string _selectedCardId = string.Empty;
    private string _selectedKind = "Category";
    private string _minCount = "1";
    private string _maxCount = string.Empty;
    private ElementReference _alternativeEntryTarget;
    private bool _focusAlternativeEntry;
    private (string Kind, string Category, string Card, string Min, string Max)? _suspendedDraft;
    private ComboAlternativeGroup? _alternativeGroup;
    private int? _alternativeGroupIndex;
    private ComboAlternative? _alternativeSeed;
    private int? _alternativeSeedIndex;
    private ComboCategory? _andSeed;
    private int? _andSeedIndex;
    private ComboAlternativeGroup? _andGroup;
    private int? _andGroupIndex;
    private int? _andAlternativeIndex;
    private Combo? _previousCombo;
    private int _previousCategoryRenameVersion;

    private string CategoryCssClass(CategoryBase category) => CategoryChipPalette.GetCssClass(category, CategoryColorIndices);

    private bool AlternativeScope => _alternativeGroupIndex is not null || _alternativeSeed is not null;
    private bool AndScope => _andSeed is not null;
    private bool AuthoringScope => AlternativeScope || AndScope;
    private IReadOnlyList<CategoryBase> _availableCategories => _categoryOptions.All;

    private IEnumerable<CategoryBase> SelectableCategories => AndScope && _andSeed is { } seed
        ? _availableCategories.Where(category => !seed.Selector.CategoryIdentities.Contains(category.Identity, StringComparer.Ordinal))
        : _availableCategories;
    private IEnumerable<CategoryBase> SelectableUserCategories => SelectableCategories
        .Where(static category => category.Source == CategorySource.User);
    private IEnumerable<CategoryBase> SelectableRelevantProperties => SelectableCategories
        .Where(category => category.Source == CategorySource.Metadata && _categoryOptions.RelevantMetadataIdentities.Contains(category.Identity));
    private IEnumerable<CategoryBase> SelectableCommonProperties => SelectableCategories
        .Where(category => CategoryCatalog.IsCommonMetadata(category) && !_categoryOptions.RelevantMetadataIdentities.Contains(category.Identity));
    private string ScopeLabel {
        get {
            if (_andSeed is { } andSeed) {
                int alternativeNumber = (_andAlternativeIndex ?? 0) + 1;
                return _andGroupIndex is int groupIndex
                    ? $"OR group {groupIndex + 1}, alternative {alternativeNumber}: {andSeed.DisplayName} ({RequirementRangeFormatter.Format(andSeed.MinCount, andSeed.MaxCount, andSeed.MaximumMode)})"
                    : $"requirement {(_andSeedIndex ?? 0) + 1}: {andSeed.DisplayName} ({RequirementRangeFormatter.Format(andSeed.MinCount, andSeed.MaxCount, andSeed.MaximumMode)})";
            }

            if (_alternativeSeed is ComboAlternative seed) {
                int requirementOffset = seed.Category is not null ? 0 : Combo.Categories.Count;
                return $"requirement {requirementOffset + _alternativeSeedIndex + 1}: {AlternativeTargetLabel(seed)}";
            }

            return $"OR group {_alternativeGroupIndex + 1}";
        }
    }

    private string AlternativeLabel(ComboAlternative alternative) =>
        alternative.Category?.DisplayName ?? $"Card: {CardDisplayName(alternative.Card!.CardId)}";

    private string AlternativeRange(ComboAlternative alternative) => alternative.Category is { } category
        ? RequirementRangeFormatter.Format(category.MinCount, category.MaxCount, category.MaximumMode)
        : RequirementRangeFormatter.Format(alternative.Card!.MinCount, alternative.Card.MaxCount, alternative.Card.MaximumMode);

    private string AlternativeTargetLabel(ComboAlternative alternative) {
        string subject;

        if (alternative.Card is { } card) {
            subject = $"Card: {CardSelectionLabel(card.CardId)}";
        }
        else {
            CategoryBase category = alternative.Category!.BaseCategory;
            string categoryKind = category.Source == CategorySource.Metadata ? "Property" : "Category";
            subject = $"{categoryKind}: {alternative.Category!.DisplayName}";
        }

        return $"{subject} ({AlternativeRange(alternative)})";
    }

    private RenderFragment CategoryBadge(ComboCategory category, Func<string, Task>? changeOperator = null, IReadOnlyList<string>? allowedOperators = null, string? operatorError = null, bool showParentheses = true) => @<span class="@(category.CategoryBases.Count > 1 ? (showParentheses ? "composite-alternative same-card-group" : "same-card-group") : null)">
        @if (showParentheses && category.CategoryBases.Count > 1) { @ExpressionParenthesis(true) }
        <ExpressionTerm Count="category.CategoryBases.Count" Compact="showParentheses" OperandKey="index => category.CategoryBases[index].Identity"
            AllowedOperators="@(allowedOperators ?? ["AND", "OR"])" Error="@operatorError"
            OnOperatorChanged="@(changeOperator is null ? default : EventCallback.Factory.Create(this, changeOperator))">
            <OperandContent Context="index">
                @{ CategoryBase conjunct = category.CategoryBases[index]; }
                <ExpressionBadge CssClass="@CategoryCssClass(conjunct)" Title="@(conjunct.Source == CategorySource.Metadata ? "Card property" : null)">
                    @conjunct.Name
                    @if (index == category.CategoryBases.Count - 1) {
                        <span class="same-card-range"> (@RequirementRangeFormatter.Format(category.MinCount, category.MaxCount, category.MaximumMode))</span>
                    }
                </ExpressionBadge>
            </OperandContent>
        </ExpressionTerm>
        @if (showParentheses && category.CategoryBases.Count > 1) { @ExpressionParenthesis(false) }
    </span>;

    private RenderFragment CardBadge(ComboCard card) => @<ExpressionBadge CssClass="@($"combo-card-tag {(Cards.Any(row => row.Id == card.CardId) ? "" : "combo-missing-card")}")">
        Card: @CardDisplayName(card.CardId) <span class="same-card-range">(@RequirementRangeFormatter.Format(card.MinCount, card.MaxCount, card.MaximumMode))</span>
    </ExpressionBadge>;

    private RenderFragment AlternativeBadge(ComboAlternative alternative) => @<text>
        @if (alternative.Category is { } category) {
            @CategoryBadge(category)
        }
        else { @CardBadge(alternative.Card!) }
    </text>;

    private RenderFragment AlternativeGroupMarkup(ComboAlternativeGroup group) => @<span class="alternative-group">
        @ExpressionParenthesis(true)
        <ExpressionTerm Count="group.Alternatives.Count" Operator="OR" Compact="true">
            <OperandContent Context="index">@AlternativeBadge(group.Alternatives[index])</OperandContent>
        </ExpressionTerm>
        @ExpressionParenthesis(false)
    </span>;

    private static RenderFragment ExpressionParenthesis(bool opening) => @<span class="expression-parenthesis">
        <span class="visually-hidden">@(opening ? "(" : ")")</span>
        <svg viewBox="0 0 6 24" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <path d="@(opening ? "M5 1 Q1 12 5 23" : "M1 1 Q5 12 1 23")" fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke" />
        </svg>
    </span>;

    private void CancelScopedAuthoring() {
        _connectorErrorKey = null;
        _connectorError = null;
        _focusAlternativeEntry = true;
        _editingNewRequirement = false;
        _editingRequirement = null;
        _editingIndex = null;
        _editingGroupIndex = null;
        _draftProperties.Clear();
        _alternativeGroup = null;
        _alternativeGroupIndex = null;
        _alternativeSeed = null;
        _alternativeSeedIndex = null;
        _andSeed = null;
        _andSeedIndex = null;
        _andGroup = null;
        _andGroupIndex = null;
        _andAlternativeIndex = null;
        _selectedCategory = string.Empty;
        _selectedCardId = string.Empty;
        ResetEditorDefaults();

        if (_suspendedDraft is { } draft) {
            (_selectedKind, _selectedCategory, _selectedCardId, _minCount, _maxCount) = draft;
            _suspendedDraft = null;
        }

        _error = null;
    }

    private void CancelAlternative() => CancelScopedAuthoring();

    private void BeginAlternativeDraft(
        ComboAlternative? seed,
        int? seedIndex,
        ComboAlternativeGroup? group,
        int? groupIndex
    ) {
        _suspendedDraft ??= (_selectedKind, _selectedCategory, _selectedCardId, _minCount, _maxCount);
        _andSeed = null;
        _andSeedIndex = null;
        _andGroup = null;
        _andGroupIndex = null;
        _andAlternativeIndex = null;
        _alternativeSeed = seed;
        _alternativeSeedIndex = seedIndex;
        _alternativeGroup = group;
        _alternativeGroupIndex = groupIndex;
        _selectedCategory = string.Empty;
        _selectedCardId = string.Empty;
        ResetEditorDefaults();
        _error = null;
        _focusAlternativeEntry = true;
    }

    private void BeginAndDraft(
        ComboCategory seed,
        int? seedIndex,
        ComboAlternativeGroup? group,
        int? groupIndex,
        int? alternativeIndex
    ) {
        _suspendedDraft ??= (_selectedKind, _selectedCategory, _selectedCardId, _minCount, _maxCount);
        _alternativeGroup = null;
        _alternativeGroupIndex = null;
        _alternativeSeed = null;
        _alternativeSeedIndex = null;
        _andSeed = seed;
        _andSeedIndex = seedIndex;
        _andGroup = group;
        _andGroupIndex = groupIndex;
        _andAlternativeIndex = alternativeIndex;
        _selectedKind = "Category";
        _selectedCategory = string.Empty;
        _selectedCardId = string.Empty;
        _minCount = seed.MinCount.ToString();
        _maxCount = seed.MaximumMode == RequirementMaximumMode.HandSize ? string.Empty : seed.MaxCount.ToString();
        _error = null;
        _focusAlternativeEntry = true;
    }

    private Task CommitAnd() {
        if (!AndScope || !AndTargetIsCurrent) {
            CancelScopedAuthoring();

            return Task.CompletedTask;
        }

        if (!int.TryParse(_minCount, out int minimum) || minimum < 0 || !TryMaximum(minimum, out int maximum)) {
            _error = "Enter valid minimum and maximum counts.";

            return Task.CompletedTask;
        }

        CategoryBase? category = SelectableCategories.FirstOrDefault(candidate => candidate.Identity == _selectedCategory);

        if (category is null) {
            _error = "Select a category to add as an AND condition.";

            return Task.CompletedTask;
        }

        ComboCategory updatedRequirement = ComboCategory.SameCard(
            _andSeed!.CategoryBases.Append(category),
            minimum,
            maximum,
            MaximumMode
        );
        Combo updated = Combo;

        if (_andGroup is ComboAlternativeGroup group && _andGroupIndex is int groupIndex && _andAlternativeIndex is int alternativeIndex) {
            List<ComboAlternativeGroup> groups = Combo.AlternativeGroups.ToList();
            List<ComboAlternative> alternatives = groups[groupIndex].Alternatives.ToList();
            alternatives[alternativeIndex] = ComboAlternative.For(updatedRequirement);
            groups[groupIndex] = new ComboAlternativeGroup(alternatives);
            updated = Combo.WithAlternativeGroups(groups);
        }
        else if (_andSeedIndex is int seedIndex) {
            List<ComboCategory> categories = Combo.Categories.ToList();
            categories[seedIndex] = updatedRequirement;
            updated = Combo.WithCategories(categories);
        }
        else {
            CancelScopedAuthoring();

            return Task.CompletedTask;
        }

        _returnRowKey = _andGroupIndex is int savedGroup
            ? $"alternative:{savedGroup}:{_andAlternativeIndex}" : $"category:{_andSeedIndex}";
        CancelScopedAuthoring();

        return OnReplaceCombo.InvokeAsync((Index, updated));
    }

    private Task CommitAlternative() {
        if (!AlternativeScope || !AlternativeTargetIsCurrent) {
            CancelAlternative();

            return Task.CompletedTask;
        }

        if (!int.TryParse(_minCount, out int minimum) || minimum < 0 || !TryMaximum(minimum, out int maximum)) {
            _error = "Enter valid minimum and maximum counts.";

            return Task.CompletedTask;
        }

        ComboAlternative leaf;

        if (_selectedKind == "Card" && Cards.Any(card => card.Id == _selectedCardId)) {
            leaf = ComboAlternative.For(new ComboCard(_selectedCardId, minimum, maximum, MaximumMode));
        }
        else if (_selectedKind == "Category" && _availableCategories.FirstOrDefault(category => category.Identity == _selectedCategory) is { } category) {
            leaf = ComboAlternative.For(new ComboCategory(category, minimum, maximum, MaximumMode));
        }
        else {
            _error = "Select a target for this alternative.";

            return Task.CompletedTask;
        }

        Combo updated = Combo;
        List<ComboAlternativeGroup> groups = Combo.AlternativeGroups.ToList();

        if (_alternativeGroup is ComboAlternativeGroup currentGroup && _alternativeGroupIndex is int groupIndex) {
            List<ComboAlternative> alternatives = currentGroup.Alternatives.ToList();
            alternatives.Add(leaf);
            groups[groupIndex] = new ComboAlternativeGroup(alternatives);
        }
        else if (_alternativeSeed is { } seed) {
            if (seed.Category is not null) {
                updated = updated.WithoutRequirement(new(ComboRequirementKind.Category, _alternativeSeedIndex!.Value));
            }
            else {
                updated = updated.WithoutRequirement(new(ComboRequirementKind.Card, _alternativeSeedIndex!.Value));
            }

            groups.Add(new ComboAlternativeGroup([seed, leaf]));
        }

        int? authoredPosition = _alternativeSeed is { } originalSeed && _alternativeSeedIndex is int originalIndex
            ? Combo.RequirementOrder.ToList().IndexOf(new(originalSeed.Category is not null ? ComboRequirementKind.Category : ComboRequirementKind.Card, originalIndex))
            : null;
        updated = updated.WithAlternativeGroups(groups);
        if (authoredPosition is int position) {
            updated = updated.WithRequirementAt(new(ComboRequirementKind.Group, groups.Count - 1), position);
        }
        int savedGroup = _alternativeGroupIndex ?? groups.Count - 1;
        _returnRowKey = $"alternative:{savedGroup}:{groups[savedGroup].Alternatives.Count - 1}";
        CancelAlternative();

        return OnReplaceCombo.InvokeAsync((Index, updated));
    }

    private bool AlternativeTargetIsCurrent {
        get {
            if (_alternativeGroup is ComboAlternativeGroup currentGroup && _alternativeGroupIndex is int groupIndex) {
                return groupIndex >= 0
                    && groupIndex < Combo.AlternativeGroups.Count
                    && ReferenceEquals(Combo.AlternativeGroups[groupIndex], currentGroup);
            }

            if (_alternativeSeedIndex is not int seedIndex || seedIndex < 0) {
                return false;
            }

            if (_alternativeSeed?.Category is ComboCategory category) {
                return seedIndex < Combo.Categories.Count
                    && ReferenceEquals(Combo.Categories[seedIndex], category);
            }

            return _alternativeSeed?.Card is ComboCard card
                && seedIndex < Combo.Cards.Count
                && ReferenceEquals(Combo.Cards[seedIndex], card);
        }
    }

    private bool AndTargetIsCurrent {
        get {
            if (_andGroup is ComboAlternativeGroup group && _andGroupIndex is int groupIndex && _andAlternativeIndex is int alternativeIndex) {
                return groupIndex >= 0
                    && groupIndex < Combo.AlternativeGroups.Count
                    && ReferenceEquals(Combo.AlternativeGroups[groupIndex], group)
                    && alternativeIndex >= 0
                    && alternativeIndex < group.Alternatives.Count
                    && ReferenceEquals(group.Alternatives[alternativeIndex].Category, _andSeed);
            }

            return _andSeedIndex is int seedIndex
                && seedIndex >= 0
                && seedIndex < Combo.Categories.Count
                && ReferenceEquals(Combo.Categories[seedIndex], _andSeed);
        }
    }

    private Task RemoveAlternative(
        ComboAlternativeGroup group,
        int groupIndex,
        ComboAlternative alternative,
        int leafIndex
    ) {
        List<ComboAlternativeGroup> groups = Combo.AlternativeGroups.ToList();

        bool isCurrentGroup = groupIndex >= 0
            && groupIndex < groups.Count
            && ReferenceEquals(groups[groupIndex], group);

        if (!isCurrentGroup) {
            return Task.CompletedTask;
        }

        bool isCurrentAlternative = leafIndex >= 0
            && leafIndex < group.Alternatives.Count
            && ReferenceEquals(group.Alternatives[leafIndex], alternative);

        if (!isCurrentAlternative) {
            return Task.CompletedTask;
        }

        ComboAlternative[] remaining = group.Alternatives.Where((_, index) => index != leafIndex).ToArray();
        Combo updated = Combo;

        if (remaining.Length == 0) {
            groups.RemoveAt(groupIndex);
            updated = updated.WithoutRequirement(new(ComboRequirementKind.Group, groupIndex));
        }
        else if (remaining.Length == 1) {
            groups.RemoveAt(groupIndex);
            updated = updated.WithoutRequirement(new(ComboRequirementKind.Group, groupIndex));
            if (remaining[0].Category is { } category) {
                updated = updated.WithCategories(updated.Categories.Append(category));
            }
            else {
                updated = updated.WithCards(updated.Cards.Append(remaining[0].Card!));
            }
        }
        else {
            groups[groupIndex] = new ComboAlternativeGroup(remaining);
        }

        if (_alternativeGroupIndex == groupIndex && ReferenceEquals(_alternativeGroup, group)) {
            CancelAlternative();
        }

        updated = updated.WithAlternativeGroups(groups);
        if (remaining.Length == 1) {
            ComboRequirementKind kind = remaining[0].Category is not null ? ComboRequirementKind.Category : ComboRequirementKind.Card;
            int index = kind == ComboRequirementKind.Category ? updated.Categories.Count - 1 : updated.Cards.Count - 1;
            updated = updated.WithRequirementAt(new(kind, index), Combo.RequirementOrder.ToList().IndexOf(new(ComboRequirementKind.Group, groupIndex)));
        }
        return OnReplaceCombo.InvokeAsync((Index, updated));
    }

    private string ComboDisplayName => string.IsNullOrWhiteSpace(Combo.Name) ? $"Combo {Index + 1}" : Combo.Name;

    private ComboGroup? AssignedGroup => Combo.GroupId is { Length: > 0 } groupId
        ? ComboGroups.FirstOrDefault(group => group.Id == groupId)
        : null;

    private bool HasSelectedConstraint => _selectedKind == "Card"
        ? Combo.Cards.Any(card => card.CardId == _selectedCardId)
        : Combo.Categories.Any(category => category.Selector.Kind == CardSelectorKind.Category && category.BaseCategory.Identity == _selectedCategory);

    private int ConstraintCount => Combo.RequirementCount;
    private IEnumerable<Card> AlphabeticalCards => CardOrdering.Alphabetize(Cards);
    private int HiddenHeaderCategoriesCount => Math.Max(0, ConstraintCount - MaxHeaderBadges);

    private RequirementMaximumMode MaximumMode => string.IsNullOrWhiteSpace(_maxCount)
        ? RequirementMaximumMode.HandSize
        : RequirementMaximumMode.Fixed;

    private string CardDisplayName(string cardId) {
        int index = Cards.ToList().FindIndex(card => card.Id == cardId);

        if (index < 0) {
            return $"Missing card ({cardId[..Math.Min(8, cardId.Length)]})";
        }

        string? cardName = Cards[index].Name;

        return string.IsNullOrWhiteSpace(cardName) ? "Unnamed card" : cardName;
    }

    private string CardSelectionLabel(string cardId) {
        int index = Cards.ToList().FindIndex(card => card.Id == cardId);

        if (index < 0) {
            return CardDisplayName(cardId);
        }

        return $"{CardDisplayName(cardId)} #{index + 1}";
    }

    private Task ToggleCombo() {
        int next = ActiveComboIndex == Index ? -1 : Index;

        return ActiveComboIndexChanged.InvokeAsync(next);
    }

    private Task Rename(string? name) {
        Combo newCombo = Combo.WithName(string.IsNullOrWhiteSpace(name) ? null : name);

        return OnReplaceCombo.InvokeAsync((Index, newCombo));
    }

    private Task ChangeActive(object? value) {
        if (!bool.TryParse(value?.ToString(), out bool active)) {
            return Task.CompletedTask;
        }

        return OnReplaceCombo.InvokeAsync((Index, Combo.WithActive(active)));
    }

    private Task AssignGroup(string? groupId) =>
        OnReplaceCombo.InvokeAsync((Index, Combo.WithGroup(string.IsNullOrEmpty(groupId) ? null : groupId)));

    private Task AddConstraint() {
        if (_editingRequirement is not null) {
            return CommitEdit();
        }

        if (AndScope) {
            return CommitAnd();
        }

        if (AlternativeScope) {
            return CommitAlternative();
        }

        if (_selectedKind == "Card") {
            return AddCard();
        }

        if (string.IsNullOrWhiteSpace(_selectedCategory)) {
            _error = "Please select a category to add.";

            return Task.CompletedTask;
        }

        CategoryBase? categoryBase = _availableCategories.FirstOrDefault(category => category.Identity == _selectedCategory);

        if (categoryBase is null) {
            _error = "Selected category not found.";

            return Task.CompletedTask;
        }

        if (!int.TryParse(_minCount, out int minimum) || minimum < 0) {
            _error = "Minimum count must be a non-negative whole number.";

            return Task.CompletedTask;
        }

        if (!TryMaximum(minimum, out int maximum)) {
            _error = "Maximum count must be a whole number at least equal to minimum count.";

            return Task.CompletedTask;
        }

        List<ComboCategory> newCategories = Combo.Categories.ToList();
        int existingIndex = newCategories.FindIndex(category => category.Selector.Kind == CardSelectorKind.Category && category.BaseCategory.Identity == categoryBase.Identity);
        ComboCategory constraint = new(categoryBase, minimum, maximum, MaximumMode);

        if (existingIndex >= 0) {
            newCategories[existingIndex] = constraint;
        }
        else {
            newCategories.Add(constraint);
        }

        Combo newCombo = Combo.WithCategories(newCategories);
        _selectedCategory = string.Empty;
        _error = null;
        ResetEditorDefaults();
        FinishNewRequirement($"category:{(existingIndex >= 0 ? existingIndex : newCategories.Count - 1)}");

        return OnReplaceCombo.InvokeAsync((Index, newCombo));
    }

    private Task AddCard() {
        if (string.IsNullOrEmpty(_selectedCardId) || !Cards.Any(card => card.Id == _selectedCardId)) {
            _error = "Please select a card to add.";

            return Task.CompletedTask;
        }

        if (!int.TryParse(_minCount, out int minimum) || minimum < 0) {
            _error = "Minimum count must be a non-negative whole number.";

            return Task.CompletedTask;
        }

        if (!TryMaximum(minimum, out int maximum)) {
            _error = "Maximum count must be a whole number at least equal to minimum count.";

            return Task.CompletedTask;
        }

        List<ComboCard> newCards = Combo.Cards.ToList();
        int existingIndex = newCards.FindIndex(card => card.CardId == _selectedCardId);
        ComboCard constraint = new(_selectedCardId, minimum, maximum, MaximumMode);

        if (existingIndex >= 0) {
            newCards[existingIndex] = constraint;
        }
        else {
            newCards.Add(constraint);
        }

        _selectedCardId = string.Empty;
        _error = null;
        ResetEditorDefaults();
        FinishNewRequirement($"card:{(existingIndex >= 0 ? existingIndex : newCards.Count - 1)}");
        return OnReplaceCombo.InvokeAsync((Index, Combo.WithCards(newCards)));
    }

    private Task RemoveCard(ComboCard card, int index) {
        bool isCurrentCard = index >= 0
            && index < Combo.Cards.Count
            && ReferenceEquals(Combo.Cards[index], card);

        if (!isCurrentCard) {
            return Task.CompletedTask;
        }

        if (ReferenceEquals(_alternativeSeed?.Card, card) && _alternativeSeedIndex == index) {
            CancelAlternative();
        }

        return OnReplaceCombo.InvokeAsync((Index, Combo.WithoutRequirement(new(ComboRequirementKind.Card, index))));
    }

    private void OnSelectCard(string? value) {
        _selectedCardId = value ?? string.Empty;
        _error = null;
        ComboCard? existing = AlternativeScope || _editingRequirement is not null ? null : Combo.Cards.FirstOrDefault(card => card.CardId == _selectedCardId);

        if (existing is not null) {
            _minCount = existing.MinCount.ToString();
            _maxCount = existing.MaximumMode == RequirementMaximumMode.HandSize ? string.Empty : existing.MaxCount.ToString();
        }
    }

    private Task RemoveCategory(ComboCategory category, int index) {
        bool isCurrentCategory = index >= 0
            && index < Combo.Categories.Count
            && ReferenceEquals(Combo.Categories[index], category);

        if (!isCurrentCategory) {
            return Task.CompletedTask;
        }

        if (ReferenceEquals(_alternativeSeed?.Category, category) && _alternativeSeedIndex == index) {
            CancelAlternative();
        }

        return OnReplaceCombo.InvokeAsync((Index, Combo.WithoutRequirement(new(ComboRequirementKind.Category, index))));
    }

    private void OnSelectCategory(string? value) {
        _selectedCategory = value ?? string.Empty;
        _error = null;

        if (AndScope) {
            return;
        }

        ComboCategory? existing = AlternativeScope || _editingRequirement is not null
            ? null
            : Combo.Categories.FirstOrDefault(category => category.Selector.Kind == CardSelectorKind.Category && category.BaseCategory.Identity == _selectedCategory);

        if (existing is not null) {
            _minCount = existing.MinCount.ToString();
            _maxCount = existing.MaximumMode == RequirementMaximumMode.HandSize ? string.Empty : existing.MaxCount.ToString();
        }
    }

    private void ResetEditorDefaults() {
        _minCount = "1";
        _maxCount = string.Empty;
    }

    private bool TryMaximum(int minimum, out int maximum) {
        if (MaximumMode == RequirementMaximumMode.HandSize) {
            maximum = HandSize;
            return true;
        }

        return int.TryParse(_maxCount, out maximum) && maximum >= minimum && maximum >= 0;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (_focusConnector is { } connectorKey) {
            _focusConnector = null;
            if (_connectors.TryGetValue(connectorKey, out ExpressionSeparator? connector)) {
                await connector.FocusAsync();
            }
        }
        if (_focusMinimum) {
            _focusMinimum = false;
            await _minimumInput.FocusAsync();
        }

        if (_focusAlternativeEntry) {
            _focusAlternativeEntry = false;
            if (_returnRowKey is { } member && _alternativeButtons.TryGetValue(member, out ExpressionMember? memberButton) && HasInlineAlternativeButton(member)) {
                _returnRowKey = null;
                await memberButton.FocusAsync(preventScroll: true);
            }
            else if (_returnRowKey is { } key && _rowButtons.TryGetValue(VisibleRowKey(key), out ExpressionRow? button) && RowExists(key)) {
                _returnRowKey = null;
                await button.FocusAsync(preventScroll: true);
            }
            else if (_editingNewRequirement || _editingRequirement is not null || AuthoringScope) {
                await _alternativeEntryTarget.FocusAsync();
            }
            else if (ShowNewRequirementRow && _newRequirementRow is not null) {
                await _newRequirementRow.FocusAsync(preventScroll: true);
            }
            else {
                await _newRequirementButton.FocusAsync(preventScroll: true);
            }
        }

    }

    protected override void OnInitialized() {
        ResetEditorDefaults();
    }

    protected override void OnParametersSet() {
        _categoryOptions = CategoryCatalog.BuildOptions(CategoryBases, Cards, [Combo], RelevantMetadataCategoryIdentities);
        if (CategoryRename is CategoryRenameNotice rename && rename.Version != _previousCategoryRenameVersion) {
            if (_selectedCategory.Equals($"user:{rename.OldName}", StringComparison.Ordinal)) {
                _selectedCategory = $"user:{rename.NewName}";
            }

            if (_suspendedDraft is { } draft && draft.Category == $"user:{rename.OldName}") {
                _suspendedDraft = (draft.Kind, $"user:{rename.NewName}", draft.Card, draft.Min, draft.Max);
            }

            if (_alternativeSeed?.Category is ComboCategory seed && seed.Selector.CategoryIdentities.Contains($"user:{rename.OldName}")) {
                int index = _alternativeSeedIndex ?? -1;
                bool isCurrentRenamedSeed = ReferenceEquals(_previousCombo, Combo)
                    && index >= 0
                    && index < Combo.Categories.Count
                    && Combo.Categories[index].Selector.Equals(seed.Selector.RenameCategory($"user:{rename.OldName}", $"user:{rename.NewName}"))
                    && Combo.Categories[index].MinCount == seed.MinCount
                    && Combo.Categories[index].MaxCount == seed.MaxCount
                    && Combo.Categories[index].MaximumMode == seed.MaximumMode;

                if (isCurrentRenamedSeed) {
                    _alternativeSeed = ComboAlternative.For(Combo.Categories[index]);
                }
            }

            if (_andSeed is { } andSeed && ReferenceEquals(_previousCombo, Combo)) {
                ComboAlternativeGroup? replacementGroup = _andGroupIndex is int andGroup
                    ? Combo.AlternativeGroups.ElementAtOrDefault(andGroup)
                    : null;
                ComboCategory? replacement = replacementGroup is not null
                    ? replacementGroup.Alternatives.ElementAtOrDefault(_andAlternativeIndex ?? -1)?.Category
                    : Combo.Categories.ElementAtOrDefault(_andSeedIndex ?? -1);
                CardSelector renamed = andSeed.Selector.RenameCategory($"user:{rename.OldName}", $"user:{rename.NewName}");
                if (replacement is not null && replacement.Selector.Equals(renamed)
                    && replacement.MinCount == andSeed.MinCount && replacement.MaxCount == andSeed.MaxCount
                    && replacement.MaximumMode == andSeed.MaximumMode) {
                    _andSeed = replacement;
                    _andGroup = replacementGroup;
                }
            }
            _previousCategoryRenameVersion = rename.Version;
        }

        if (AuthoringScope && !AlternativeScope && !AndTargetIsCurrent) {
            CancelScopedAuthoring();
        }

        if (AlternativeScope && !AlternativeTargetIsCurrent) {
            CancelScopedAuthoring();
        }
        ReconcileEditingRequirement();
        _previousCombo = Combo;

        // Hand size affects effective bounds only; leave committed values and drafts intact.
    }
}
