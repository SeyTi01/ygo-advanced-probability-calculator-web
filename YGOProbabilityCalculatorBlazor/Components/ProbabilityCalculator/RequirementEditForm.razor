<ExpressionForm OnSubmit="OnSubmit" OnKeyDown="OnKeyDown" StopKeyPropagation="true">
    <div class="requirement-form-heading">
        <strong>@Title</strong>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="OnCancel">@(UiText.Get("Ui.Cancel"))</button>
    </div>
    <div class="requirement-edit-grid @(OperandCount > 1 ? "requirement-edit-multiple" : "") @(QuantityContent is null ? "requirement-edit-no-quantity" : "")">
        <div class="requirement-inputs">
            @for (int index = 0; index < OperandCount; index++) {
                int position = index;
                @if (index > 0) { <ExpressionSeparator Operator="@Operator" AllowedOperators="AllowedOperators" InputLabel="@(UiText.Get("Requirement.RowOperator"))" OnOperatorChanged="ChangeOperator" /> }
                <div class="requirement-operand" @key="OperandKey?.Invoke(index)">
                    @OperandContent(index)
                    @if (OnRemoveOperand.HasDelegate && OperandCount > 1) {
                        <button type="button" class="btn btn-outline-secondary" aria-label="@(UiText.Format("Ui.RemoveProperty0", index + 1))" @onclick="() => OnRemoveOperand.InvokeAsync(position)">×</button>
                    }
                </div>
            }
        </div>
        @if (QuantityContent is not null) { <div class="requirement-quantity">@QuantityContent</div> }
        <div class="requirement-submit">
            <button type="submit" class="btn btn-primary" @ref="_submit" disabled="@(Error is not null)" @onclick="OnSubmit" @onclick:preventDefault>@SubmitLabel</button>
        </div>
    </div>
    @AfterContent
    @if (Error is not null) { <div class="text-danger small mt-2" role="alert">@Error</div> }
    @if (ShowActions) {
        <div class="requirement-context-actions">
            <RequirementActions AllowedOperators="ActionOperators" OnAddAlternative="OnAddAlternative"
                OnAddProperty="OnAddProperty" OnRemove="OnRemoveRequirement" />
        </div>
    }
</ExpressionForm>

@code {
    [Parameter] public string Mode { get; set; } = "edit";
    [Parameter] public bool UpdateExisting { get; set; }
    [Parameter] public bool ShowActions { get; set; }
    [Parameter] public IReadOnlyList<string> ActionOperators { get; set; } = ["AND", "OR"];
    [Parameter] public EventCallback OnAddAlternative { get; set; }
    [Parameter] public EventCallback OnAddProperty { get; set; }
    [Parameter] public EventCallback OnRemoveRequirement { get; set; }
    private string Title => Mode switch {
        "AND" => UiText.Get("Ui.AnotherPropertySameCard"),
        "OR" => UiText.Get("Ui.AddAnAlternativeOR"),
        "add" => UiText.Get("Ui.AddRequirement.2d4936b2"),
        _ => UiText.Get("Ui.EditRequirement")
    };
    private string SubmitLabel => UpdateExisting ? UiText.Get("Ui.UpdateRequirement") : Mode switch {
        "AND" => UiText.Get("Ui.AddProperty"),
        "OR" => UiText.Get("Ui.AddAlternative"),
        "add" => UiText.Get("Ui.Add"),
        _ => UiText.Get("Ui.Save")
    };
    [Parameter] public string Operator { get; set; } = "AND";
    [Parameter] public IReadOnlyList<string> AllowedOperators { get; set; } = ["AND", "OR"];
    [Parameter] public string? Error { get; set; }
    [Parameter] public Func<int, object>? OperandKey { get; set; }
    [Parameter] public int OperandCount { get; set; } = 1;
    [Parameter, EditorRequired] public RenderFragment<int> OperandContent { get; set; } = default!;
    [Parameter] public RenderFragment? QuantityContent { get; set; }
    [Parameter] public RenderFragment? AfterContent { get; set; }
    [Parameter] public EventCallback OnSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback<Microsoft.AspNetCore.Components.Web.KeyboardEventArgs> OnKeyDown { get; set; }
    [Parameter] public EventCallback<string> OnOperatorChanged { get; set; }
    [Parameter] public EventCallback<int> OnRemoveOperand { get; set; }

    private ElementReference _submit;

    private Task ChangeOperator(string operation) => OnOperatorChanged.InvokeAsync(operation);

    public ValueTask FocusAsync() => _submit.FocusAsync();
}
