@using YGOProbabilityCalculatorBlazor.Models
@using Microsoft.AspNetCore.Components.Web
<div class="requirement-property-picker">
    <label for="@Id" class="form-label">@Label</label>
    <select id="@Id" class="form-select" aria-label="@AccessibleLabel" value="@Selection" @onchange="Select" @ref="_target">
        <option value="">Choose…</option>
        @if (Cards.Count > 0) {
            <optgroup label="Cards">@foreach (Card card in CardOrdering.Alphabetize(Cards)) { <option value="@($"card:{card.Id}")">@(CardLabel?.Invoke(card) ?? card.Name)</option> }</optgroup>
        }
        @if (Value.StartsWith("card:", StringComparison.Ordinal) && !Cards.Any(card => Value == $"card:{card.Id}")) { <option value="@Value">Missing card</option> }
        @if (Selectable.Any(category => category.Source == CategorySource.User)) {
            <optgroup label="Categories">@foreach (CategoryBase category in Selectable.Where(category => category.Source == CategorySource.User)) { <option value="@category.Identity">@category.Name</option> }</optgroup>
        }
        @if (Selectable.Any(category => category.Source == CategorySource.Metadata && (RelevantIdentities.Contains(category.Identity) || !CategoryCatalog.IsCommonMetadata(category)))) {
            <optgroup label="Relevant properties">@foreach (CategoryBase category in Selectable.Where(category => category.Source == CategorySource.Metadata && (RelevantIdentities.Contains(category.Identity) || !CategoryCatalog.IsCommonMetadata(category)))) { <option value="@category.Identity">@category.Name</option> }</optgroup>
        }
        <optgroup label="Common properties">
            @foreach (CategoryBase category in Selectable.Where(category => category.Source == CategorySource.Metadata && CategoryCatalog.IsCommonMetadata(category) && !RelevantIdentities.Contains(category.Identity))) { <option value="@category.Identity">@category.Name</option> }
            <option value="numeric:level">Level</option><option value="numeric:rank">Rank</option><option value="numeric:link">Link</option>
        </optgroup>
        @if (Selection.Length > 0 && !Selection.StartsWith("numeric:", StringComparison.Ordinal) && !Selection.StartsWith("card:", StringComparison.Ordinal) && !Selectable.Any(category => category.Identity == Selection)) { <option value="@Selection">@Value</option> }
    </select>
    @if (_property is { } property) {
        <div class="requirement-numeric-fields">
            <div><label for="@(Id + "-comparison")" class="form-label">Comparison</label>
                <select id="@(Id + "-comparison")" class="form-select" aria-label="Comparison" value="@_comparison" @onchange="ChangeComparison"><option value="exact">Exactly</option><option value="minimum">At least</option><option value="maximum">At most</option><option value="range">Between</option></select></div>
            <div><label for="@(Id + "-number")" class="form-label">@NumberLabel</label>
                <input id="@(Id + "-number")" class="form-control" type="number" min="0" max="2147483647" step="1" aria-label="@NumberLabel" value="@_number" @oninput="ChangeNumber" @ref="_numberInput" /></div>
            @if (_comparison == "range") { <div><label for="@(Id + "-maximum")" class="form-label">Maximum @property</label><input id="@(Id + "-maximum")" class="form-control" type="number" min="0" max="2147483647" step="1" aria-label="@($"Maximum {property}")" value="@_maximum" @oninput="ChangeMaximum" /></div> }
        </div>
    }
</div>

@code {
    public sealed record Change(string Value, CategoryBase? Category, string? Error = null);
    [Parameter] public string Id { get; set; } = "requirement-target";
    [Parameter] public string Label { get; set; } = "Category or property";
    [Parameter] public string? AccessibleLabel { get; set; }
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public IReadOnlyList<CategoryBase> Categories { get; set; } = [];
    [Parameter] public IReadOnlyList<Card> Cards { get; set; } = [];
    [Parameter] public Func<Card, string>? CardLabel { get; set; }
    [Parameter] public IReadOnlySet<string> RelevantIdentities { get; set; } = new HashSet<string>();
    [Parameter] public EventCallback<Change> OnChanged { get; set; }

    private ElementReference _target;
    private ElementReference _numberInput;
    private string? _previousValue;
    private NumericPropertyKind? _property;
    private string _comparison = "exact";
    private string _number = "5";
    private string _maximum = "5";
    private bool _objectiveOnly;
    private bool _focusNumber;
    private string NumberLabel => _comparison switch {
        "minimum" or "range" => $"Minimum {_property}",
        "maximum" => $"Maximum {_property}",
        _ => _property.ToString()!
    };
    private string Selection => _property is { } property ? "numeric:" + property.ToString().ToLowerInvariant() : Value;
    private IEnumerable<CategoryBase> Selectable => Categories.Where(category => !NumericPropertyRange.TryFromIdentity(category.Identity, out _));

    protected override void OnParametersSet() {
        if (_previousValue == Value) { return; }
        _previousValue = Value;
        _property = null;
        if (NumericPropertyRange.TryFromIdentity(Value, out NumericPropertyRange? range)) {
            _property = range.Property;
            _objectiveOnly = range.ObjectiveOnly;
            _comparison = range.Minimum == range.Maximum ? "exact" : range.Maximum is null ? "minimum" : range.Minimum is null ? "maximum" : "range";
            _number = (range.Minimum ?? range.Maximum)!.Value.ToString();
            _maximum = (range.Maximum ?? range.Minimum)!.Value.ToString();
        }
    }

    private async Task Select(ChangeEventArgs args) {
        string value = args.Value?.ToString() ?? "";
        _property = null;
        _objectiveOnly = false;
        if (value.StartsWith("numeric:", StringComparison.Ordinal) && Enum.TryParse(value[8..], true, out NumericPropertyKind property)) {
            _property = property;
            _comparison = "exact";
            _number = property == NumericPropertyKind.Link ? "1" : "5";
            _maximum = _number;
            _focusNumber = true;
            await PublishNumeric();
        }
        else { await OnChanged.InvokeAsync(new(value, Categories.FirstOrDefault(category => category.Identity == value))); }
    }
    private Task ChangeComparison(ChangeEventArgs args) { _comparison = args.Value?.ToString() ?? "exact"; return PublishNumeric(); }
    private Task ChangeNumber(ChangeEventArgs args) { _number = args.Value?.ToString() ?? ""; return PublishNumeric(); }
    private Task ChangeMaximum(ChangeEventArgs args) { _maximum = args.Value?.ToString() ?? ""; return PublishNumeric(); }
    private Task PublishNumeric() {
        if (!int.TryParse(_number, out int number) || number < 0
            || _comparison == "range" && (!int.TryParse(_maximum, out int maximum) || maximum < number)) {
            return OnChanged.InvokeAsync(new(Value, null, "Enter a non-negative whole number or an ordered range."));
        }
        int? lower = _comparison == "maximum" ? null : number;
        int? upper = _comparison == "minimum" ? null : _comparison == "range" ? int.Parse(_maximum) : number;
        NumericPropertyRange range = new(_property!.Value, lower, upper, _objectiveOnly);
        CategoryBase category = range.ToCategory();
        _previousValue = category.Identity;
        return OnChanged.InvokeAsync(new(category.Identity, category));
    }
    public ValueTask FocusAsync(bool number = false) => number && _property is not null ? _numberInput.FocusAsync() : _target.FocusAsync();
    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (_focusNumber) { _focusNumber = false; await _numberInput.FocusAsync(); }
    }
}
