@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject YGOProbabilityCalculatorBlazor.Services.Interface.ICardInfoService CardInfoService
@using YGOProbabilityCalculatorBlazor.Models
@using Microsoft.AspNetCore.Components.Web
<div class="requirement-property-picker">
    <label for="@(Id + "-trigger")" class="form-label">@Label</label>
    <button id="@(Id + "-trigger")" type="button" class="form-select requirement-picker-trigger" aria-label="@(AccessibleLabel ?? Label)"
        aria-expanded="@(_open ? "true" : "false")" aria-controls="@(Id + "-panel")" aria-haspopup="listbox" @onclick="Toggle" @onkeydown="TriggerKeyDown" @ref="_trigger">@SelectedLabel</button>
    <div id="@(Id + "-panel")" class="requirement-picker-panel surface-panel" hidden="@(!_open)" @ref="_panel" @onkeydown="PanelKeyDown" @onkeydown:stopPropagation>
        @if (BrowseGroups.Count() > 2) {
            <div class="requirement-groups" role="group" aria-label="@(UiText.Get("Requirement.Groups"))">
                @foreach (string group in BrowseGroups) {
                    <button type="button" class="btn btn-sm @(_group == group ? "btn-secondary" : "btn-outline-secondary")" aria-pressed="@(_group == group ? "true" : "false")"
                        @onclick="() => FilterGroup(group)">@GroupLabel(group)</button>
                }
            </div>
        }
    <select id="@Id" class="form-select requirement-options" size="8" aria-label="@(AccessibleLabel ?? Label)" value="@Selection" @onchange="Select" @onclick="Choose" @ref="_target">
        <option value="" hidden disabled selected="@(Selection.Length == 0)"></option>
        @foreach (IGrouping<string, PickerOption> group in VisibleOptions.GroupBy(option => option.Section)) {
            @if (group.Key.Length == 0) {
                @foreach (PickerOption option in group) { <option value="@option.Value" selected="@(option.Value == Selection)">@option.Label</option> }
            }
            else {
                <optgroup label="@group.Key">@foreach (PickerOption option in group) { <option value="@option.Value" selected="@(option.Value == Selection)">@option.Label</option> }</optgroup>
            }
        }
    </select>
    </div>
    @if (_property is { } property) {
        <div class="requirement-numeric-fields">
            <div><label for="@(Id + "-comparison")" class="form-label">@(UiText.Get("Ui.Comparison"))</label>
                <select id="@(Id + "-comparison")" class="form-select" aria-label="@(UiText.Get("Ui.Comparison"))" value="@_comparison" @onchange="ChangeComparison"><option value="exact">@(UiText.Get("Ui.Exactly"))</option><option value="minimum">@(UiText.Get("Ui.AtLeast"))</option><option value="maximum">@(UiText.Get("Ui.AtMost"))</option><option value="range">@(UiText.Get("Ui.Between"))</option></select></div>
            <div><label for="@(Id + "-number")" class="form-label">@NumberLabel</label>
                <input id="@(Id + "-number")" class="form-control" type="number" min="0" max="2147483647" step="1" aria-label="@NumberLabel" value="@_number" @oninput="ChangeNumber" @ref="_numberInput" /></div>
            @if (_comparison == "range") { <div><label for="@(Id + "-maximum")" class="form-label">@(UiText.Format("Requirement.MaximumProperty", DisplayLabels.NumericProperty(property)))</label><input id="@(Id + "-maximum")" class="form-control" type="number" min="0" max="2147483647" step="1" aria-label="@(UiText.Format("Ui.Maximum0", DisplayLabels.NumericProperty(property)))" value="@_maximum" @oninput="ChangeMaximum" /></div> }
        </div>
    }
</div>

@code {
    public sealed record Change(string Value, CategoryBase? Category, string? Error = null);
    [Parameter] public bool AllowAny { get; set; }
    [Parameter] public string Id { get; set; } = "requirement-target";
    [Parameter] public string Label { get; set; } = UiText.Get("Ui.Requirement");
    [Parameter] public string? AccessibleLabel { get; set; }
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public IReadOnlyList<CategoryBase> Categories { get; set; } = [];
    [Parameter] public IReadOnlyList<Card> Cards { get; set; } = [];
    [Parameter] public Func<Card, string>? CardLabel { get; set; }
    [Parameter] public IReadOnlySet<string> RelevantIdentities { get; set; } = new HashSet<string>();
    [Parameter] public EventCallback<Change> OnChanged { get; set; }

    private sealed record PickerOption(string Value, string Label, string Group, string Section);
    private string _group = "all";
    private ElementReference _trigger;
    private ElementReference _panel;
    private DotNetObjectReference<RequirementPropertyPicker>? _reference;
    private bool _open;
    private bool _attach;
    private bool _focusChoices;
    private readonly Dictionary<string, double> _groupScrollPositions = [];
    private bool _restoreGroupScroll;
    private string SelectedLabel => Options.FirstOrDefault(option => option.Value == Selection)?.Label ?? UiText.Get("Ui.Choose");
    private IEnumerable<string> BrowseGroups => new[] { "all", "cards", "categories", "properties" }
        .Where(group => group == "all" || Options.Any(option => option.Group == group));
    private string GroupLabel(string group) => UiText.Get(group switch {
        "cards" => "Ui.Cards", "categories" => "Ui.Categories", "properties" => "Requirement.Properties", _ => "Requirement.All"
    });
    private IEnumerable<PickerOption> Options {
        get {
            if (AllowAny) { yield return new("any", UiText.Get("Ui.Anycardclearfilter"), "all", ""); }
            foreach (Card card in CardOrdering.Alphabetize(Cards)) {
                yield return new($"card:{card.Id}", CardLabel?.Invoke(card) ?? DisplayLabels.Card(card, CardInfoService), "cards", UiText.Get("Ui.Cards"));
            }
            if (Value.StartsWith("card:", StringComparison.Ordinal) && !Cards.Any(card => Value == $"card:{card.Id}")) {
                yield return new(Value, UiText.Get("Ui.MissingCard"), "cards", "");
            }
            foreach (CategoryBase category in Selectable.OrderBy(category => category.Source == CategorySource.User ? 0
                : RelevantIdentities.Contains(category.Identity) || !CategoryCatalog.IsCommonMetadata(category) ? 1 : 2)) {
                bool user = category.Source == CategorySource.User;
                bool relevant = RelevantIdentities.Contains(category.Identity) || !CategoryCatalog.IsCommonMetadata(category);
                yield return new(category.Identity, DisplayLabels.Category(category), user ? "categories" : "properties",
                    UiText.Get(user ? "Ui.Categories" : relevant ? "Ui.RelevantProperties" : "Ui.CommonProperties"));
            }
            foreach (string property in new[] { "level", "rank", "link" }) {
                yield return new("numeric:" + property, UiText.Get("Ui." + char.ToUpperInvariant(property[0]) + property[1..]), "properties", UiText.Get("Ui.CommonProperties"));
            }
            if (Selection.Length > 0 && Selection != "any" && !Selection.StartsWith("numeric:", StringComparison.Ordinal)
                && !Selection.StartsWith("card:", StringComparison.Ordinal) && !Selectable.Any(category => category.Identity == Selection)) {
                yield return new(Selection, Value, "categories", "");
            }
        }
    }
    private IEnumerable<PickerOption> VisibleOptions => Options.Where(option =>
        _group == "all" || option.Group == _group || option.Value == "any");
    private async Task FilterGroup(string group) {
        if (_group == group) { return; }
        _groupScrollPositions[_group] = await JS.InvokeAsync<double>("workspaceMenus.getScroll", _target);
        _group = group;
        _focusChoices = _restoreGroupScroll = true;
    }
    private Task Toggle() => _open ? Close() : Open();
    private Task Open() { _open = _attach = _focusChoices = _restoreGroupScroll = true; return Task.CompletedTask; }
    private Task TriggerKeyDown(KeyboardEventArgs args) => args.Key is "ArrowDown" or "ArrowUp" ? Open() : Task.CompletedTask;
    private Task PanelKeyDown(KeyboardEventArgs args) => args.Key is "Escape" or "Enter" ? Close() : Task.CompletedTask;
    private Task Choose() => Close();
    private async Task Close() {
        _groupScrollPositions[_group] = await JS.InvokeAsync<double>("workspaceMenus.getScroll", _target);
        _open = false;
        await JS.InvokeVoidAsync("workspaceMenus.close", _panel, _trigger, false);
        if (_focusNumber) { _focusNumber = false; await _numberInput.FocusAsync(); }
    }
    [JSInvokable]
    public async Task Dismiss() {
        _groupScrollPositions[_group] = await JS.InvokeAsync<double>("workspaceMenus.getScroll", _target);
        _open = false;
        StateHasChanged();
    }
    public async ValueTask DisposeAsync() {
        try { await JS.InvokeVoidAsync("workspaceMenus.dispose", _panel); }
        catch (Exception exception) when (exception is JSDisconnectedException or OperationCanceledException) { }
        _reference?.Dispose();
    }

    private ElementReference _target;
    private ElementReference _numberInput;
    private string? _previousValue;
    private NumericPropertyKind? _property;
    private string _comparison = "exact";
    private string _number = "5";
    private string _maximum = "5";
    private bool _objectiveOnly;
    private bool _focusNumber;
    private string NumberLabel => _comparison switch {
        "minimum" or "range" => UiText.Format("Ui.Minimum0", DisplayLabels.NumericProperty(_property!.Value)),
        "maximum" => UiText.Format("Ui.Maximum0", DisplayLabels.NumericProperty(_property!.Value)),
        _ => DisplayLabels.NumericProperty(_property!.Value)
    };
    private string Selection => _property is { } property ? "numeric:" + property.ToString().ToLowerInvariant() : Value;
    private IEnumerable<CategoryBase> Selectable => Categories.Where(category => !NumericPropertyRange.TryFromIdentity(category.Identity, out _));

    protected override void OnParametersSet() {
        if (!BrowseGroups.Contains(_group)) { _group = "all"; }
        if (_previousValue == Value) { return; }
        _previousValue = Value;
        _property = null;
        if (NumericPropertyRange.TryFromIdentity(Value, out NumericPropertyRange? range)) {
            _property = range.Property;
            _objectiveOnly = range.ObjectiveOnly;
            _comparison = range.Minimum == range.Maximum ? "exact" : range.Maximum is null ? "minimum" : range.Minimum is null ? "maximum" : "range";
            _number = (range.Minimum ?? range.Maximum)!.Value.ToString();
            _maximum = (range.Maximum ?? range.Minimum)!.Value.ToString();
        }
    }

    private async Task Select(ChangeEventArgs args) {
        string value = args.Value?.ToString() ?? "";
        _property = null;
        _objectiveOnly = false;
        if (value.StartsWith("numeric:", StringComparison.Ordinal) && Enum.TryParse(value[8..], true, out NumericPropertyKind property)) {
            _property = property;
            _comparison = "exact";
            _number = property == NumericPropertyKind.Link ? "1" : "5";
            _maximum = _number;
            _focusNumber = true;
            await PublishNumeric();
        }
        else { await OnChanged.InvokeAsync(new(value, Categories.FirstOrDefault(category => category.Identity == value))); }
    }
    private Task ChangeComparison(ChangeEventArgs args) { _comparison = args.Value?.ToString() ?? "exact"; return PublishNumeric(); }
    private Task ChangeNumber(ChangeEventArgs args) { _number = args.Value?.ToString() ?? ""; return PublishNumeric(); }
    private Task ChangeMaximum(ChangeEventArgs args) { _maximum = args.Value?.ToString() ?? ""; return PublishNumeric(); }
    private Task PublishNumeric() {
        if (!int.TryParse(_number, out int number) || number < 0
            || _comparison == "range" && (!int.TryParse(_maximum, out int maximum) || maximum < number)) {
            return OnChanged.InvokeAsync(new(Value, null, UiText.Get("Ui.EnterANonNegativeWholeNumberOrAnOrderedRange")));
        }
        int? lower = _comparison == "maximum" ? null : number;
        int? upper = _comparison == "minimum" ? null : _comparison == "range" ? int.Parse(_maximum) : number;
        NumericPropertyRange range = new(_property!.Value, lower, upper, _objectiveOnly);
        CategoryBase category = range.ToCategory();
        _previousValue = category.Identity;
        return OnChanged.InvokeAsync(new(category.Identity, category));
    }
    public ValueTask FocusAsync(bool number = false) => number && _property is not null ? _numberInput.FocusAsync() : _trigger.FocusAsync();
    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (_attach) {
            _attach = false;
            _reference ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("workspaceMenus.open", _panel, _trigger, _reference, false, true);
        }
        if (_focusChoices && _open) { _focusChoices = false; await _target.FocusAsync(); }
        if (_restoreGroupScroll && _open) {
            _restoreGroupScroll = false;
            await JS.InvokeVoidAsync("workspaceMenus.restoreScroll", _target, _groupScrollPositions.GetValueOrDefault(_group));
        }
        if (_focusNumber && !_open) { _focusNumber = false; await _numberInput.FocusAsync(); }
    }
}
