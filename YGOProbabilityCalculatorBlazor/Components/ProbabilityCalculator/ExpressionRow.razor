<div class="@(CenterContent ? "requirement-row requirement-row-centered" : "requirement-row")">
    @if (InteractiveSummary) {
        <div class="requirement-interactive-summary @(HideEditLabel ? "requirement-summary-full-box" : null)" @onclick="OnEdit">
            @if (HideEditLabel) {
                <button type="button" class="requirement-edit requirement-edit-overlay control-focus-ring" @attributes="AdditionalAttributes" aria-label="@Label"
                        title="@Label" aria-expanded="@Expanded.ToString().ToLowerInvariant()" @onclick="OnEdit" @onclick:stopPropagation @ref="_button"></button>
            }
            <span class="requirement-description">@ChildContent</span>
            @if (!HideEditLabel) {
                <button type="button" class="requirement-edit control-focus-ring" @attributes="AdditionalAttributes" aria-label="@Label"
                        aria-expanded="@Expanded.ToString().ToLowerInvariant()" @onclick="OnEdit" @onclick:stopPropagation @ref="_button">@(UiText.Get("Ui.Edit"))</button>
            }
        </div>
    }
    else {
        <button type="button" class="requirement-edit control-focus-ring" @attributes="AdditionalAttributes" aria-label="@Label"
                title="@(HideEditLabel ? Label : null)" aria-expanded="@Expanded.ToString().ToLowerInvariant()" @onclick="OnEdit" @ref="_button">
            <span class="requirement-description">@ChildContent</span>
            @if (!HideEditLabel) { <span class="requirement-edit-label">@(UiText.Get("Ui.Edit"))</span> }
        </button>
    }
    @if (Controls is not null) { <div class="expression-row-controls">@Controls</div> }
    @EditorContent
</div>

@code {
    [Parameter] public string Label { get; set; } = UiText.Get("Ui.EditRequirement");
    [Parameter] public bool Expanded { get; set; }
    [Parameter] public bool InteractiveSummary { get; set; }
    [Parameter] public bool CenterContent { get; set; }
    [Parameter] public bool HideEditLabel { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? EditorContent { get; set; }
    [Parameter] public RenderFragment? Controls { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private ElementReference _button;

    public ValueTask FocusAsync(bool preventScroll = false) => _button.FocusAsync(preventScroll);
}
