@using YGOProbabilityCalculatorBlazor.Models

<section class="category-rule-editor border rounded p-3 mt-3" aria-label="@(UiText.Format("Category.RuleLabel", Category.Name))" @onkeydown="KeyDown">
    <h5 class="fs-6" tabindex="-1" @ref="_heading">@(UiText.Format("Category.RuleHeading", Category.Name))</h5>
    @for (int index = 0; index < _alternatives.Count; index++) {
        int branch = index;
        @if (index > 0) { <ExpressionSeparator Operator="OR" AllowedOperators="AlternativeOperators(branch)" OnOperatorChanged="operation => ChangeAlternativeOperator(branch, operation)" /> }
        <div class="d-flex flex-wrap align-items-center gap-2 border rounded p-2">
            @for (int term = 0; term < _alternatives[index].Count; term++) {
                RuleProperty property = _alternatives[index][term];
                @if (term > 0) { <ExpressionSeparator Operator="AND" AllowedOperators="PropertyOperators(branch)" OnOperatorChanged="operation => ChangePropertyOperator(branch, operation)" /> }
                @if (NumericPropertyRange.TryFromSelector(property.Selector, out _)) {
                    <div @key="property" class="category-rule-numeric">
                        <RequirementPropertyPicker @ref="property.Picker" Id="@property.Id" Value="@property.Identity" Label="@(UiText.Get("Ui.Property"))" Categories="_properties"
                            OnChanged="change => ChangeProperty(property, change)" />
                        <ChipRemoveButton Class="category-remove-button" aria-label="@(UiText.Format("Ui.RemoveProperty0FromAlternative1", Label(property), index + 1))"
                            OnClick="() => Remove(branch, property)" />
                        @if (property.Error is not null) { <div class="text-danger small" role="alert">@property.Error</div> }
                    </div>
                }
                else {
                    <span @key="property" class="badge category-tag card-property-tag text-wrap category-rule-term @CardPropertyColorPalette.GetCssClass(property.Identity[9..])">
                        @Label(property)
                        <ChipRemoveButton Class="category-remove-button ms-1" aria-label="@(UiText.Format("Ui.RemoveProperty0FromAlternative1", Label(property), index + 1))"
                                          title="@(UiText.Format("Ui.RemoveProperty0FromAlternative1", Label(property), index + 1))"
                                OnClick="() => Remove(branch, property)" />
                    </span>
                }
            }
            @if (_alternatives[index].Count < CategoryMembership.MaximumPropertiesPerAlternative) {
                <RequirementPropertyPicker @key="(_alternatives[index], _additionVersion)" Id="@($"rule-add-property-{index}")" Label="@(UiText.Get("Ui.AddPropertyAND"))"
                    AccessibleLabel="@(UiText.Format("Ui.AddANDPropertyToAlternative0", index + 1))" Categories="_properties"
                    OnChanged="change => AddProperty(branch, change)" />
            }
        </div>
    }
    @if (_alternatives.Count < CategoryMembership.MaximumAlternatives) {
        <RequirementPropertyPicker @key="_additionVersion" Id="rule-add-alternative" Label="@(_alternatives.Count == 0 ? UiText.Get("Ui.ChooseAProperty") : UiText.Get("Ui.AddAlternativeOR"))"
            AccessibleLabel="@(UiText.Get("Ui.AddRuleAlternative"))" Categories="_properties" OnChanged="AddAlternative" />
    }
    @if (_operatorError is not null) { <p class="small text-danger" role="alert">@_operatorError</p> }
    <div class="small mt-3" role="status" aria-live="polite">
        @if (Draft is null) {
            <span>@(UiText.Get("Ui.0MatchingEntries"))</span>
        }
        else {
            <strong>@(_matches.Length == 1 ? UiText.Format("Category.OneMatch", _matches.Length, _matches.Sum(card => (long)card.Copies)) : UiText.Format("Category.ManyMatches", _matches.Length, _matches.Sum(card => (long)card.Copies)))</strong>
            @if (_matches.Length > 0) {
                <div class="category-rule-preview mt-1">@string.Join(", ", _matches.Select(card => card.Name ?? UiText.Get("Ui.UnnamedCard")))</div>
            }
        }
    </div>
    <div class="d-flex flex-wrap gap-2 mt-3">
        <button type="button" class="btn btn-primary btn-sm" disabled="@(Draft is null || HasErrors)" @onclick="Apply">@(UiText.Get("Ui.ApplyRule"))</button>
        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="OnCancel">@(UiText.Get("Ui.Cancel"))</button>
        @if (Category.Rule is not null) {
            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => OnApply.InvokeAsync((CardSelector?)null)">@(UiText.Get("Ui.RemoveRule"))</button>
        }
    </div>
</section>

@code {
    [Parameter] public CategoryBase Category { get; set; } = null!;
    [Parameter] public IEnumerable<Card> Cards { get; set; } = [];
    [Parameter] public IEnumerable<CategoryBase> CategoryBases { get; set; } = [];
    [Parameter] public EventCallback<CardSelector?> OnApply { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private sealed class RuleProperty(CardSelector selector) {
        public CardSelector Selector { get; set; } = selector;
        public string Id { get; } = "rule-property-" + Guid.NewGuid().ToString("N");
        public string? Error { get; set; }
        public RequirementPropertyPicker? Picker;
        public string Identity => NumericPropertyRange.TryFromSelector(Selector, out NumericPropertyRange? range)
            && Selector.Kind != CardSelectorKind.Category ? range.Identity : Selector.CategoryIdentities[0];
    }

    private int _additionVersion;
    private RuleProperty? _focusProperty;
    private bool HasErrors => _alternatives.SelectMany(branch => branch).Any(property => property.Error is not null);
    private readonly List<List<RuleProperty>> _alternatives = [];
    private CategoryBase[] _properties = [];
    private Card[] _matches = [];
    private ElementReference _heading;
    private CardSelector? Draft { get; set; }
    private string? _operatorError;

    protected override void OnInitialized() {
        IEnumerable<CardSelector> alternatives = Category.Rule is not { } rule ? [] : rule.Kind == CardSelectorKind.AnyOf ? rule.AuthoredTerms : [rule];
        foreach (CardSelector alternative in alternatives) {
            _alternatives.Add((alternative.Kind == CardSelectorKind.AllOf ? alternative.AuthoredTerms : [alternative]).Select(term => new RuleProperty(term)).ToList());
        }
        UpdatePreview();
    }

    protected override void OnParametersSet() {
        // Retain draft terms even when the last card providing a contextual property disappears.
        IEnumerable<string> identities = _alternatives.SelectMany(alternative => alternative).SelectMany(property => property.Selector.CategoryIdentities);
        _properties = CategoryCatalog.Build(CategoryBases, Cards, [])
            .Where(category => category.Source == CategorySource.Metadata)
            .Concat(identities.Select(identity => new CategoryBase(Uri.UnescapeDataString(identity[9..]), CategorySource.Metadata, identity[9..])))
            .DistinctBy(category => category.Identity).ToArray();
        UpdatePreview();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) {
            await _heading.FocusAsync();
        }

        if (_focusProperty?.Picker is { } picker) {
            _focusProperty = null;
            await picker.FocusAsync(number: true);
        }
    }

    private string Label(RuleProperty property) => DrawEffectPresentation.DescribeSelector(property.Selector, _properties);

    private void AddAlternative(RequirementPropertyPicker.Change change) {
        if (_alternatives.Count >= CategoryMembership.MaximumAlternatives || change.Error is not null || change.Category is null) { return; }
        RuleProperty property = new(NumericPropertyRange.SelectorFor(change.Category));
        _alternatives.Add([property]);
        _focusProperty = property;
        _additionVersion++;
        _operatorError = null;
        UpdatePreview();
    }

    private void AddProperty(int branch, RequirementPropertyPicker.Change change) {
        if (_alternatives[branch].Count >= CategoryMembership.MaximumPropertiesPerAlternative || change.Error is not null || change.Category is null) { return; }
        CardSelector selector = NumericPropertyRange.SelectorFor(change.Category);
        if (_alternatives[branch].Any(property => property.Selector.Equals(selector))) { return; }
        RuleProperty property = new(selector);
        _alternatives[branch].Add(property);
        _focusProperty = property;
        _additionVersion++;
        _operatorError = null;
        UpdatePreview();
    }

    private void ChangeProperty(RuleProperty property, RequirementPropertyPicker.Change change) {
        property.Error = change.Error;
        if (change.Error is null && change.Category is not null && change.Value != property.Identity) {
            property.Selector = NumericPropertyRange.SelectorFor(change.Category);
        }
        UpdatePreview();
    }

    private void Remove(int branch, RuleProperty property) {
        _alternatives[branch].Remove(property);
        if (_alternatives[branch].Count == 0) { _alternatives.RemoveAt(branch); }
        _operatorError = null;
        UpdatePreview();
    }

    private Task Apply() => Draft is null || HasErrors ? Task.CompletedTask : OnApply.InvokeAsync(Draft);

    private void UpdatePreview() {
        Draft = _alternatives.Count == 0 ? null : CardSelector.AnyOfSelectors(_alternatives.Select(branch => CardSelector.AllOfSelectors(branch.Select(property => property.Selector))));
        _matches = Draft is null ? [] : Cards.Where(card => Draft.Matches(card)).ToArray();
    }

    private void ChangeAlternativeOperator(int right, string operation) {
        if (operation != "AND" || !CanReverseAlternative(right)) { return; }
        List<RuleProperty> combined = _alternatives[right - 1].Concat(_alternatives[right]).DistinctBy(property => property.Selector).ToList();
        if (combined.Count > CategoryMembership.MaximumPropertiesPerAlternative) {
            _operatorError = UiText.Get("Ui.TheANDGroupWouldExceed16PropertiesRemoveAPropertyBeforeCombining");
            return;
        }
        _alternatives[right - 1] = combined;
        _alternatives.RemoveAt(right);
        _operatorError = null;
        UpdatePreview();
    }

    private void ChangePropertyOperator(int branch, string operation) {
        if (operation != "OR" || !CanReverseProperty(branch)) { return; }
        List<RuleProperty> properties = _alternatives[branch];
        if (_alternatives.Count - 1 + properties.Count > CategoryMembership.MaximumAlternatives) {
            _operatorError = UiText.Get("Ui.TheORGroupWouldExceed16AlternativesRemoveAnAlternativeBeforeSplitting");
            return;
        }
        _alternatives.RemoveAt(branch);
        _alternatives.InsertRange(branch, properties.Select(property => new List<RuleProperty> { property }));
        _operatorError = null;
        UpdatePreview();
    }

    private IReadOnlyList<string> AlternativeOperators(int right) => CanReverseAlternative(right) ? ["AND", "OR"] : ["OR"];
    private IReadOnlyList<string> PropertyOperators(int branch) => CanReverseProperty(branch) ? ["AND", "OR"] : ["AND"];

    private static List<List<RuleProperty>> NormalizeAlternatives(List<List<RuleProperty>> alternatives) {
        CardSelector rule = CardSelector.AnyOfSelectors(alternatives.Select(branch => CardSelector.AllOfSelectors(branch.Select(property => property.Selector))));
        IEnumerable<CardSelector> branches = rule.Kind == CardSelectorKind.AnyOf ? rule.AuthoredTerms : [rule];
        RuleProperty[] properties = alternatives.SelectMany(branch => branch).ToArray();
        return branches.Select(branch => (branch.Kind == CardSelectorKind.AllOf ? branch.AuthoredTerms : [branch])
            .Select(selector => properties.First(property => property.Selector.Equals(selector))).ToList()).ToList();
    }

    private bool SameAlternatives(List<List<RuleProperty>> restored) => _alternatives.Count == restored.Count
        && _alternatives.Zip(restored).All(pair => pair.First.Select(property => property.Selector).SequenceEqual(pair.Second.Select(property => property.Selector)));

    private bool CanReverseAlternative(int right) {
        if (right <= 0 || right >= _alternatives.Count || _alternatives[right - 1].Count != 1 || _alternatives[right].Count != 1
            || _alternatives[right - 1][0].Selector.Equals(_alternatives[right][0].Selector)) { return false; }
        List<RuleProperty> combined = [.. _alternatives[right - 1], .. _alternatives[right]];
        List<List<RuleProperty>> changed = _alternatives.Select(branch => branch.ToList()).ToList();
        changed[right - 1] = combined;
        changed.RemoveAt(right);
        changed = NormalizeAlternatives(changed);
        int index = changed.FindIndex(branch => branch.Select(property => property.Selector).SequenceEqual(combined.Select(property => property.Selector)));
        if (index < 0) { return false; }
        changed.RemoveAt(index);
        changed.InsertRange(index, combined.Select(property => new List<RuleProperty> { property }));
        return SameAlternatives(changed);
    }

    private bool CanReverseProperty(int branch) {
        List<RuleProperty> properties = _alternatives[branch];
        if (properties.Count != 2 || _alternatives.Count + 1 > CategoryMembership.MaximumAlternatives) { return false; }
        List<List<RuleProperty>> changed = _alternatives.Select(value => value.ToList()).ToList();
        changed.RemoveAt(branch);
        changed.InsertRange(branch, properties.Select(property => new List<RuleProperty> { property }));
        changed = NormalizeAlternatives(changed);
        int index = changed.FindIndex(value => value.Count == 1 && value[0].Selector.Equals(properties[0].Selector));
        if (index < 0 || index + 1 >= changed.Count || changed[index + 1].Count != 1 || !changed[index + 1][0].Selector.Equals(properties[1].Selector)) { return false; }
        changed[index] = properties.ToList();
        changed.RemoveAt(index + 1);
        return SameAlternatives(changed);
    }

    private Task KeyDown(KeyboardEventArgs args) => args.Key == "Escape" ? OnCancel.InvokeAsync() : Task.CompletedTask;
}
