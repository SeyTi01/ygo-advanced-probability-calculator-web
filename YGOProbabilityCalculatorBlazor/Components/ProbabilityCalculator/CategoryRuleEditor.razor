@using YGOProbabilityCalculatorBlazor.Models

<section class="category-rule-editor border rounded p-3 mt-3" aria-label="Rule for @Category.Name" @onkeydown="KeyDown">
    <h5 class="fs-6" tabindex="-1" @ref="_heading">Properties for @Category.Name</h5>
    @for (int index = 0; index < _alternatives.Count; index++) {
        int branch = index;
        @if (index > 0) { <ExpressionSeparator Operator="OR" AllowedOperators="AlternativeOperators(branch)" OnOperatorChanged="operation => ChangeAlternativeOperator(branch, operation)" /> }
        <div class="d-flex flex-wrap align-items-center gap-2 border rounded p-2">
            @for (int term = 0; term < _alternatives[index].Count; term++) {
                string identity = _alternatives[index][term];
                @if (term > 0) { <ExpressionSeparator Operator="AND" AllowedOperators="PropertyOperators(branch)" OnOperatorChanged="operation => ChangePropertyOperator(branch, operation)" /> }
                <span class="badge category-tag card-property-tag text-wrap category-rule-term @CardPropertyColorPalette.GetCssClass(identity[9..])">
                    @Label(identity)
                    <ChipRemoveButton Class="category-remove-button ms-1" aria-label="@($"Remove property {Label(identity)} from alternative {index + 1}")"
                                      title="@($"Remove property {Label(identity)} from alternative {index + 1}")"
                            OnClick="() => Remove(branch, identity)" />
                </span>
            }
            <select class="form-select form-select-sm category-rule-select" value="" aria-label="Add AND property to alternative @(index + 1)"
                    disabled="@(_alternatives[index].Count >= CategoryMembership.MaximumPropertiesPerAlternative)"
                    @onchange="args => AddProperty(branch, args.Value?.ToString())">
                <option value="">Add property (AND)…</option>
                @foreach (CategoryBase property in _properties.Where(property => !_alternatives[branch].Contains(property.Identity))) {
                    <option value="@property.Identity">@property.Name</option>
                }
            </select>
        </div>
    }
    <select class="form-select form-select-sm mt-2" value="" aria-label="Add rule alternative"
            disabled="@(_alternatives.Count >= CategoryMembership.MaximumAlternatives)"
            @onchange="args => AddAlternative(args.Value?.ToString())">
        <option value="">@(_alternatives.Count == 0 ? "Choose a property…" : "Add alternative (OR)…")</option>
        @foreach (CategoryBase property in _properties) {
            <option value="@property.Identity">@property.Name</option>
        }
    </select>
    @if (_operatorError is not null) { <p class="small text-danger" role="alert">@_operatorError</p> }
    <div class="small mt-3" role="status" aria-live="polite">
        @if (Draft is null) {
            <span>0 matching entries</span>
        }
        else {
            <strong>@_matches.Length matching @(_matches.Length == 1 ? "entry" : "entries") (@_matches.Sum(card => (long)card.Copies) copies)</strong>
            @if (_matches.Length > 0) {
                <div class="category-rule-preview mt-1">@string.Join(", ", _matches.Select(card => card.Name ?? "Unnamed card"))</div>
            }
        }
    </div>
    <div class="d-flex flex-wrap gap-2 mt-3">
        <button type="button" class="btn btn-primary btn-sm" disabled="@(Draft is null)" @onclick="() => OnApply.InvokeAsync(Draft)">Apply rule</button>
        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="OnCancel">Cancel</button>
        @if (Category.Rule is not null) {
            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => OnApply.InvokeAsync((CardSelector?)null)">Remove rule</button>
        }
    </div>
</section>

@code {
    [Parameter] public CategoryBase Category { get; set; } = null!;
    [Parameter] public IEnumerable<Card> Cards { get; set; } = [];
    [Parameter] public IEnumerable<CategoryBase> CategoryBases { get; set; } = [];
    [Parameter] public EventCallback<CardSelector?> OnApply { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private readonly List<List<string>> _alternatives = [];
    private CategoryBase[] _properties = [];
    private Card[] _matches = [];
    private ElementReference _heading;
    private CardSelector? Draft { get; set; }
    private string? _operatorError;

    protected override void OnInitialized() {
        IEnumerable<CardSelector> alternatives = Category.Rule is not { } rule ? [] : rule.Kind == CardSelectorKind.AnyOf ? rule.AuthoredTerms : [rule];
        foreach (CardSelector alternative in alternatives) {
            _alternatives.Add(alternative.AuthoredTerms.SelectMany(term => term.CategoryIdentities).ToList());
        }
        UpdatePreview();
    }

    protected override void OnParametersSet() {
        // Retain draft terms even when the last card providing a contextual property disappears.
        IEnumerable<string> identities = _alternatives.SelectMany(alternative => alternative);
        _properties = CategoryCatalog.Build(CategoryBases, Cards, [])
            .Where(category => category.Source == CategorySource.Metadata)
            .Concat(identities.Select(identity => new CategoryBase(Uri.UnescapeDataString(identity[9..]), CategorySource.Metadata, identity[9..])))
            .DistinctBy(category => category.Identity).ToArray();
        UpdatePreview();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) {
            await _heading.FocusAsync();
        }
    }

    private string Label(string identity) => _properties.FirstOrDefault(property => property.Identity == identity)?.Name ?? Uri.UnescapeDataString(identity[9..]);

    private void AddAlternative(string? identity) {
        if (_alternatives.Count >= CategoryMembership.MaximumAlternatives || !_properties.Any(property => property.Identity == identity)) {
            return;
        }
        _alternatives.Add([identity!]);
        _operatorError = null;
        UpdatePreview();
    }

    private void AddProperty(int branch, string? identity) {
        if (_alternatives[branch].Count >= CategoryMembership.MaximumPropertiesPerAlternative
            || !_properties.Any(property => property.Identity == identity) || _alternatives[branch].Contains(identity!)) {
            return;
        }
        _alternatives[branch].Add(identity!);
        _operatorError = null;
        UpdatePreview();
    }

    private void Remove(int branch, string identity) {
        _alternatives[branch].Remove(identity);
        if (_alternatives[branch].Count == 0) {
            _alternatives.RemoveAt(branch);
        }
        _operatorError = null;
        UpdatePreview();
    }

    private void UpdatePreview() {
        Draft = _alternatives.Count == 0 ? null : CardSelector.AnyOfSelectors(_alternatives.Select(CardSelector.AllOf));
        _matches = Draft is null ? [] : Cards.Where(card => Draft.Matches(card)).ToArray();
    }

    private void ChangeAlternativeOperator(int right, string operation) {
        if (operation != "AND" || !CanReverseAlternative(right)) { return; }
        List<string> combined = _alternatives[right - 1].Concat(_alternatives[right]).Distinct(StringComparer.Ordinal).ToList();
        if (combined.Count > CategoryMembership.MaximumPropertiesPerAlternative) {
            _operatorError = "The AND group would exceed 16 properties. Remove a property before combining.";
            return;
        }
        _alternatives[right - 1] = combined;
        _alternatives.RemoveAt(right);
        _operatorError = null;
        UpdatePreview();
    }

    private void ChangePropertyOperator(int branch, string operation) {
        if (operation != "OR" || !CanReverseProperty(branch)) { return; }
        List<string> properties = _alternatives[branch];
        if (_alternatives.Count - 1 + properties.Count > CategoryMembership.MaximumAlternatives) {
            _operatorError = "The OR group would exceed 16 alternatives. Remove an alternative before splitting.";
            return;
        }
        _alternatives.RemoveAt(branch);
        _alternatives.InsertRange(branch, properties.Select(property => new List<string> { property }));
        _operatorError = null;
        UpdatePreview();
    }

    private IReadOnlyList<string> AlternativeOperators(int right) => CanReverseAlternative(right) ? ["AND", "OR"] : ["OR"];
    private IReadOnlyList<string> PropertyOperators(int branch) => CanReverseProperty(branch) ? ["AND", "OR"] : ["AND"];

    private static List<List<string>> NormalizeAlternatives(List<List<string>> alternatives) {
        CardSelector rule = CardSelector.AnyOfSelectors(alternatives.Select(CardSelector.AllOf));
        IEnumerable<CardSelector> branches = rule.Kind == CardSelectorKind.AnyOf ? rule.AuthoredTerms : [rule];
        return branches.Select(branch => branch.AuthoredTerms.SelectMany(term => term.CategoryIdentities).ToList()).ToList();
    }

    private bool SameAlternatives(List<List<string>> restored) => _alternatives.Count == restored.Count
        && _alternatives.Zip(restored).All(pair => pair.First.SequenceEqual(pair.Second, StringComparer.Ordinal));

    private bool CanReverseAlternative(int right) {
        if (right <= 0 || right >= _alternatives.Count || _alternatives[right - 1].Count != 1 || _alternatives[right].Count != 1
            || _alternatives[right - 1][0] == _alternatives[right][0]) { return false; }
        List<string> combined = [.. _alternatives[right - 1], .. _alternatives[right]];
        List<List<string>> changed = _alternatives.Select(branch => branch.ToList()).ToList();
        changed[right - 1] = combined;
        changed.RemoveAt(right);
        changed = NormalizeAlternatives(changed);
        int index = changed.FindIndex(branch => branch.SequenceEqual(combined, StringComparer.Ordinal));
        if (index < 0) { return false; }
        changed.RemoveAt(index);
        changed.InsertRange(index, combined.Select(property => new List<string> { property }));
        return SameAlternatives(changed);
    }

    private bool CanReverseProperty(int branch) {
        List<string> properties = _alternatives[branch];
        if (properties.Count != 2 || _alternatives.Count + 1 > CategoryMembership.MaximumAlternatives) { return false; }
        List<List<string>> changed = _alternatives.Select(value => value.ToList()).ToList();
        changed.RemoveAt(branch);
        changed.InsertRange(branch, properties.Select(property => new List<string> { property }));
        changed = NormalizeAlternatives(changed);
        int index = changed.FindIndex(value => value.Count == 1 && value[0] == properties[0]);
        if (index < 0 || index + 1 >= changed.Count || changed[index + 1].Count != 1 || changed[index + 1][0] != properties[1]) { return false; }
        changed[index] = properties.ToList();
        changed.RemoveAt(index + 1);
        return SameAlternatives(changed);
    }

    private Task KeyDown(KeyboardEventArgs args) => args.Key == "Escape" ? OnCancel.InvokeAsync() : Task.CompletedTask;
}
