@using YGOProbabilityCalculatorBlazor.Models
@using YGOProbabilityCalculatorBlazor.Components.Shared

<LanguageDraftBoundary Name="combos" Capture="CaptureLanguageDraft" Restore="RestoreLanguageDraft" OnRestored="StateHasChanged" />
<div class="mb-4">
    <h4>@(UiText.Get("Ui.Combos"))</h4>
    <div class="accordion" id="combosAccordion">
        @for (int index = 0; index < Combos.Count; index++) {
            <ComboEditor @key="_editorKeys[Combos[index]]"
                Index="index"
                Combo="Combos[index]"
                Cards="Cards"
                CategoryBases="_categoryOptions.All"
                RelevantMetadataCategoryIdentities="_categoryOptions.RelevantMetadataIdentities"
                ComboGroups="ComboGroups"
                CategoryColorIndices="CategoryColorIndices"
                CategoryRename="CategoryRename"
                ActiveComboIndex="ActiveComboIndex"
                ActiveComboIndexChanged="ActiveComboIndexChanged"
                OnReplaceCombo="ReplaceCombo"
                OnRemoveCombo="OnRemoveCombo"
                OnDuplicateCombo="DuplicateCombo"
                Count="Combos.Count"
                OnMove="OnMoveCombo"
                HandSize="HandSize"
            />
        }
    </div>

    <div class="mt-3">
        <button id="addCombo" type="button" class="btn combo-add-action" aria-label="@(UiText.Get("Ui.AddCombo"))" title="@(UiText.Get("Ui.AddCombo"))" @onclick="() => OnAddNewCombo.InvokeAsync()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14" /></svg> @(UiText.Get("Ui.Combo"))
        </button>
    </div>

    <details class="combo-group-management workspace-management">
        <summary>@(UiText.Get("Ui.ComboGroups")) <span class="text-body-secondary">@(UiText.Get("Ui.OrganizeCombos"))</span></summary>
        <div class="mb-4">
            <div class="editor-add-row">
                <div class="editor-select-field">
                    <input class="form-control" type="text"
                           aria-label="@(UiText.Get("Ui.NewComboGroupName"))" placeholder="@(UiText.Get("Ui.GroupName"))"
                           @bind="_newGroupName" @bind:event="oninput"
                           @onkeyup="HandleAddGroupKeyUp" />
                </div>
                <div class="editor-add-action">
                    <button class="btn btn-primary" type="button" aria-label="@(UiText.Get("Ui.AddComboGroup"))" disabled="@string.IsNullOrWhiteSpace(_newGroupName)" @onclick="AddGroup">@(UiText.Get("Ui.Add"))</button>
                </div>
            </div>
            @if (_groupError is not null) {
                <div class="mt-2 combo-group-validation-alert">
                    <DismissibleAlert Message="@_groupError" OnDismiss="@(() => _groupError = null)" />
                </div>
            }
            @if (_pendingRemoval is { } pending) {
                <DeletionConfirmation @key="pending.Id" Label="@(UiText.Get("Ui.ConfirmGroupDeletion"))"
                    Message="@(UiText.Format("Ui.Delete0AllMemberCombosIncludingInactiveOnesRemainInTheirCurrentOrderAndBecomeUngrouped", pending.Name))"
                    OnConfirm="ConfirmGroupRemoval" OnCancel="CancelGroupRemoval" />
            }
            <div class="mt-2">
                @for (int index = 0; index < ComboGroups.Count; index++) {
                    ComboGroup group = ComboGroups[index];
                    <span class="badge me-2 category-chip category-tag combo-group-chip" @key="group.Id">
                        @if (_editingGroupId == group.Id) {
                            <input @ref="_groupRenameInputReference"
                                   class="form-control form-control-sm category-rename-input"
                                   aria-label="@(UiText.Format("Ui.NewNameForGroup0", group.Name))"
                                   @bind="_editingGroupName"
                                   @bind:event="oninput"
                                   @onkeydown="HandleGroupRenameKeyDown" />
                            <button type="button" class="category-icon-button"
                                    aria-label="@(UiText.Get("Ui.SaveGroupName"))" title="@(UiText.Get("Ui.SaveGroupName"))"
                                    @onclick="SaveGroupName">
                                <svg class="category-action-icon" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2.5"
                                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                            </button>
                            <ReorderControls LanguageKey="@($"group:{group.Id}")" Horizontal="true" Index="index" Count="ComboGroups.Count" ItemLabel="@(UiText.Format("Ui.Group0", group.Name))" OnMove="OnMoveGroup" />
                            <button type="button" class="category-icon-button"
                                    aria-label="@(UiText.Get("Ui.CancelGroupEdit"))" title="@(UiText.Get("Ui.CancelGroupEdit"))"
                                    @onclick="CancelGroupRename">
                                <svg class="category-action-icon" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2.5"
                                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="m6 6 12 12M6 18 18 6"></path>
                                </svg>
                            </button>
                        }
                        else {
                            <button @ref="_groupNameButtonReferences[group.Id]"
                                    type="button" class="category-name-trigger"
                                    aria-label="@(UiText.Format("Ui.EditGroup0", group.Name))"
                                    title="@(UiText.Format("Ui.EditGroup0", group.Name))"
                                    @onclick="() => BeginGroupRename(group)">@group.Name</button>
                        }
                        <ChipRemoveButton Class="category-delete-button"
                                aria-label="@(UiText.Format("Ui.RemoveGroup0", group.Name))"
                                title="@(UiText.Format("Ui.DeleteGroup0", group.Name))"
                                OnClick="() => RemoveGroup(group)" />
                    </span>
                }
            </div>
        </div>
    </details>
</div>

@code {
    [Parameter] public IReadOnlyList<Combo> Combos { get; set; } = [];
    [Parameter] public IReadOnlyList<Card> Cards { get; set; } = [];
    [Parameter] public IReadOnlyList<ComboGroup> ComboGroups { get; set; } = [];
    [Parameter] public IReadOnlyList<CategoryBase> CategoryBases { get; set; } = [];
    [Parameter] public IReadOnlyDictionary<string, int> CategoryColorIndices { get; set; } = new Dictionary<string, int>(StringComparer.Ordinal);
    [Parameter] public CategoryRenameNotice? CategoryRename { get; set; }
    [Parameter] public bool DeferNameEditRendering { get; set; }

    [Parameter] public int HandSize { get; set; } = 5;
    [Parameter] public int ActiveComboIndex { get; set; } = -1;
    [Parameter] public EventCallback<int> ActiveComboIndexChanged { get; set; }

    [Parameter] public EventCallback<(int Index, Combo NewCombo)> OnReplaceCombo { get; set; }
    [Parameter] public EventCallback<int> OnRemoveCombo { get; set; }
    [Parameter] public EventCallback<int> OnDuplicateCombo { get; set; }
    [Parameter] public EventCallback OnAddNewCombo { get; set; }
    [Parameter] public EventCallback<string> OnAddGroup { get; set; }
    [Parameter] public EventCallback<(string Id, string Name)> OnRenameGroup { get; set; }
    [Parameter] public EventCallback<string> OnRemoveGroup { get; set; }
    [Parameter] public EventCallback<(int From, int To)> OnMoveGroup { get; set; }
    [Parameter] public EventCallback<(int From, int To)> OnMoveCombo { get; set; }

    private CategoryCatalogOptions _categoryOptions = CategoryCatalogOptions.Empty;
    private bool _skipParameterRender;
    private readonly EditorKeys<Combo> _editorKeys = new();
    private readonly Dictionary<string, ElementReference> _groupNameButtonReferences = new(StringComparer.Ordinal);
    private string _newGroupName = string.Empty;
    private string? _groupError;
    private string? _editingGroupId;
    private string? _editingGroupName;
    private ElementReference _groupRenameInputReference;
    private bool _focusGroupRenameInput;
    private string? _pendingGroupNameFocus;
    private ComboGroup? _pendingRemoval;

    protected override void OnParametersSet() {
        _skipParameterRender = DeferNameEditRendering;
        _editorKeys.Synchronize(Combos);
        _categoryOptions = CategoryCatalog.BuildOptions(CategoryBases, Cards, Combos);

        if (_editingGroupId is string id && !ComboGroups.Any(group => group.Id == id)) {
            ClearGroupRename();
        }
    }

    protected override bool ShouldRender() {
        bool render = !_skipParameterRender;
        _skipParameterRender = false;

        return render;
    }

    public Task ReplaceCombo((int Index, Combo NewCombo) payload) {
        _editorKeys.Replace(Combos[payload.Index], payload.NewCombo);
        return OnReplaceCombo.InvokeAsync(payload);
    }

    private Task DuplicateCombo(int index) => OnDuplicateCombo.InvokeAsync(index);

    private async Task AddGroup() {
        string name = _newGroupName.Trim();

        if (!ValidateName(name)) {
            return;
        }

        await OnAddGroup.InvokeAsync(name);
        _newGroupName = string.Empty;
        _groupError = null;
    }

    private Task HandleAddGroupKeyUp(KeyboardEventArgs e) =>
        e.Key == "Enter" ? AddGroup() : Task.CompletedTask;

    private void BeginGroupRename(ComboGroup group) {
        _pendingRemoval = null;
        _editingGroupId = group.Id;
        _editingGroupName = group.Name;
        _groupError = null;
        _pendingGroupNameFocus = null;
        _focusGroupRenameInput = true;
    }

    private async Task SaveGroupName() {
        if (_editingGroupId is not string id) {
            return;
        }

        string name = _editingGroupName?.Trim() ?? string.Empty;

        if (!ValidateName(name, id)) {
            return;
        }

        ComboGroup? group = ComboGroups.FirstOrDefault(item => item.Id == id);

        if (group is null) {
            ClearGroupRename();

            return;
        }

        _groupError = null;
        _pendingRemoval = null;

        if (!string.Equals(name, group.Name, StringComparison.Ordinal)) {
            await OnRenameGroup.InvokeAsync((id, name));
        }

        _pendingGroupNameFocus = id;
        ClearGroupRename();
    }

    private void CancelGroupRename() {
        _pendingGroupNameFocus = _editingGroupId;
        ClearGroupRename();
    }

    private void ClearGroupRename() {
        _editingGroupId = null;
        _editingGroupName = null;
        _focusGroupRenameInput = false;
    }

    private Task HandleGroupRenameKeyDown(KeyboardEventArgs e) {
        if (e.Key == "Enter") {
            return SaveGroupName();
        }

        if (e.Key == "Escape") {
            CancelGroupRename();
        }

        return Task.CompletedTask;
    }

    private async Task RemoveGroup(ComboGroup group) {
        if (Combos.Any(combo => combo.GroupId == group.Id)) {
            _pendingRemoval = group;
            return;
        }
        await DeleteGroup(group);
    }

    private async Task ConfirmGroupRemoval() {
        if (_pendingRemoval is { } group) {
            await DeleteGroup(group);
        }
    }

    private void CancelGroupRemoval() {
        _pendingGroupNameFocus = _pendingRemoval?.Id;
        _pendingRemoval = null;
        if (_editingGroupId is not null) {
            _focusGroupRenameInput = true;
            _pendingGroupNameFocus = null;
        }
    }

    private async Task DeleteGroup(ComboGroup group) {
        _pendingRemoval = null;
        if (_editingGroupId == group.Id) {
            ClearGroupRename();
        }

        await OnRemoveGroup.InvokeAsync(group.Id);
    }

    private bool ValidateName(string name, string? excludingId = null) {
        if (string.IsNullOrWhiteSpace(name)) {
            _groupError = UiText.Get("Ui.GroupNameCannotBeEmpty");
        }
        else {
            bool hasDuplicateName = ComboGroups.Any(group => group.Id != excludingId && string.Equals(group.Name, name, StringComparison.OrdinalIgnoreCase));
            _groupError = hasDuplicateName ? UiText.Get("Ui.AGroupWithThatNameAlreadyExists") : null;
        }

        return _groupError is null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (_focusGroupRenameInput) {
            _focusGroupRenameInput = false;
            await _groupRenameInputReference.FocusAsync();

            return;
        }

        if (_pendingGroupNameFocus is string id && _groupNameButtonReferences.TryGetValue(id, out ElementReference button)) {
            _pendingGroupNameFocus = null;
            await button.FocusAsync();
        }
    }

    private string CaptureLanguageDraft() => LanguageDraftState.Pack((_newGroupName, _editingGroupId, _editingGroupName, _pendingRemoval?.Id, _groupError));
    private void RestoreLanguageDraft(string json) {
        (string name, string? editing, string? editingName, string? removal, string? error) = LanguageDraftState.Unpack<(string, string?, string?, string?, string?)>(json);
        _newGroupName = name; _editingGroupId = editing; _editingGroupName = editingName; _groupError = error;
        _pendingRemoval = ComboGroups.FirstOrDefault(group => group.Id == removal);
        _skipParameterRender = false;
    }
}
