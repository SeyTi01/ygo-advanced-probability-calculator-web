@using System.Globalization
@using Microsoft.JSInterop
@using YGOProbabilityCalculatorBlazor.Services.Interface
@inject IJSRuntime JavaScriptRuntime
@implements IAsyncDisposable

@if (Result is not null) {
    <div class="probability-result-export-toolbar">
        <button id="@_copyButtonId"
                type="button"
                class="@CopyButtonClass"
                title="Copy a summary of these results"
                disabled="@(!CanCopy)"
                aria-describedby="@(!CanCopy ? _unavailableMessageId : null)"
                @onclick="CopyResultsAsync">
            <span class="probability-result-copy-icon-slot" aria-hidden="true">
                @if (_copySucceeded) {
                    <svg class="probability-result-copy-success-icon" viewBox="0 0 16 16" focusable="false">
                        <path d="m2.5 8.25 3.25 3.25 7.75-7.75" />
                    </svg>
                }
                else {
                    <svg class="probability-result-copy-rest-icon" viewBox="0 0 16 16" focusable="false">
                        <path d="M5.25 3.25h6.5c.83 0 1.5.67 1.5 1.5v8c0 .83-.67 1.5-1.5 1.5h-6.5c-.83 0-1.5-.67-1.5-1.5v-8c0-.83.67-1.5 1.5-1.5Z" />
                        <path d="M3.5 11.75H3c-.83 0-1.5-.67-1.5-1.5v-8c0-.83.67-1.5 1.5-1.5h6.5c.83 0 1.5.67 1.5 1.5v.5" />
                    </svg>
                }
            </span>
            <span>Copy results</span>
        </button>
        @if (!CanCopy) {
            <small id="@_unavailableMessageId" class="visually-hidden">
                @CopyUnavailableMessage
            </small>
        }
        @if (_feedback is { } feedback) {
            <span class="visually-hidden" role="status" aria-live="polite">@feedback</span>
        }
    </div>

    @if (_fallbackText is { } fallbackText) {
        <div class="alert alert-secondary probability-result-copy-fallback"
             role="group"
             aria-labelledby="@_fallbackHeadingId">
            <div class="probability-result-copy-fallback-heading">
                <label id="@_fallbackHeadingId" for="@_fallbackTextId">Result summary</label>
                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        title="Close manual copy text"
                        aria-label="Close copy fallback"
                        @onclick="DismissFallback">
                    Close
                </button>
            </div>
            <p id="@_fallbackInstructionId" class="form-text mb-1">
                Clipboard copying was unavailable. Select the text below and copy it manually.
            </p>
            <textarea id="@_fallbackTextId"
                      class="form-control probability-result-copy-text"
                      rows="7"
                      readonly
                      spellcheck="false"
                      aria-describedby="@_fallbackInstructionId">@fallbackText</textarea>
        </div>
    }
}

@code {
    private const string ClipboardModulePath = "./js/probabilityResultExport.js";
    private static readonly TimeSpan CopySuccessDuration = TimeSpan.FromMilliseconds(1750);

    private readonly string _copyButtonId = $"copy-results-{Guid.NewGuid():N}";
    private readonly string _unavailableMessageId = $"copy-unavailable-{Guid.NewGuid():N}";
    private readonly string _fallbackHeadingId = $"copy-fallback-heading-{Guid.NewGuid():N}";
    private readonly string _fallbackInstructionId = $"copy-fallback-instruction-{Guid.NewGuid():N}";
    private readonly string _fallbackTextId = $"copy-fallback-text-{Guid.NewGuid():N}";

    private IJSObjectReference? _clipboardModule;
    private ProbabilityCalculationResult? _observedResult;
    private int _observedHandSize;
    private bool _observedIsStale;
    private bool _observedIsCalculating;
    private bool _hasObservedParameters;
    private bool _disposed;
    private bool _focusFallbackAfterRender;
    private bool _focusCopyButtonAfterRender;
    private bool _copySucceeded;
    private long _validityVersion;
    private long _copyAttemptVersion;
    private long _successResetVersion;
    private ITimer? _successResetTimer;
    private string? _fallbackText;
    private string? _feedback;

    [Parameter, EditorRequired]
    public ProbabilityCalculationResult? Result { get; set; }

    [Parameter]
    public int HandSize { get; set; }

    [Parameter]
    public bool IsStale { get; set; }

    [Parameter]
    public bool IsCalculating { get; set; }

    [Parameter]
    public TimeProvider FeedbackTimeProvider { get; set; } = TimeProvider.System;

    private bool CanCopy => Result is not null && HandSize >= 1 && !IsCalculating;
    private string CopyButtonClass => _copySucceeded
        ? "btn btn-sm btn-outline-success d-inline-flex align-items-center gap-2"
        : "btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-2";

    private string CopyUnavailableMessage => IsCalculating
        ? "Wait for the calculation to finish before copying results."
        : "The original result context is unavailable.";

    protected override void OnParametersSet() {
        bool parametersUnchanged = _hasObservedParameters
            && ReferenceEquals(_observedResult, Result)
            && _observedHandSize == HandSize
            && _observedIsStale == IsStale
            && _observedIsCalculating == IsCalculating;

        if (parametersUnchanged) {
            return;
        }

        _hasObservedParameters = true;
        _observedResult = Result;
        _observedHandSize = HandSize;
        _observedIsStale = IsStale;
        _observedIsCalculating = IsCalculating;
        _validityVersion++;
        _copyAttemptVersion++;
        CancelSuccessReset();
        _fallbackText = null;
        _feedback = null;
        _copySucceeded = false;
        _focusFallbackAfterRender = false;
        _focusCopyButtonAfterRender = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) {
            try {
                IJSObjectReference module = await JavaScriptRuntime.InvokeAsync<IJSObjectReference>("import", ClipboardModulePath);

                if (_disposed) {
                    await module.DisposeAsync();
                    return;
                }

                _clipboardModule = module;
            }
            catch (Exception exception) when (IsJavaScriptFailure(exception)) {
                _clipboardModule = null;
            }
        }

        if (_clipboardModule is null) {
            _focusFallbackAfterRender = false;
            _focusCopyButtonAfterRender = false;
            return;
        }

        if (_focusFallbackAfterRender) {
            _focusFallbackAfterRender = false;

            try {
                await _clipboardModule.InvokeVoidAsync("focusElementById", _fallbackTextId);
            }
            catch (Exception exception) when (IsJavaScriptFailure(exception)) {
                // The textarea remains selectable if focus cannot be moved programmatically.
            }
        }
        else if (_focusCopyButtonAfterRender) {
            _focusCopyButtonAfterRender = false;

            try {
                await _clipboardModule.InvokeVoidAsync("focusElementById", _copyButtonId);
            }
            catch (Exception exception) when (IsJavaScriptFailure(exception)) {
                // Closing the fallback must not affect whether the summary can be copied.
            }
        }
    }

    private async Task CopyResultsAsync() {
        if (!CanCopy || Result is not { } result) {
            return;
        }

        // Capture the accepted result, hand size, culture, and text before any interop await.
        int handSize = HandSize;
        bool stale = IsStale;
        CultureInfo culture = CultureInfo.CurrentCulture;
        long version = _validityVersion;
        long attemptVersion = ++_copyAttemptVersion;
        string summary = ProbabilityResultSummaryFormatter.Format(result, handSize, culture);

        if (stale) {
            summary = "Previous result — current inputs have changed.\n" + summary;
        }

        CancelSuccessReset();
        _copySucceeded = false;
        _feedback = null;
        _fallbackText = null;

        if (_clipboardModule is null) {
            ShowFallbackIfCurrent(version, attemptVersion, result, handSize, summary);

            return;
        }

        bool copied;
        try {
            copied = await _clipboardModule.InvokeAsync<bool>("copyText", summary);
        }
        catch (Exception exception) when (IsJavaScriptFailure(exception)) {
            ShowFallbackIfCurrent(version, attemptVersion, result, handSize, summary);

            return;
        }

        if (!IsCurrentSnapshot(version, attemptVersion, result, handSize)) {
            return;
        }

        if (copied) {
            _copySucceeded = true;
            _feedback = "Results copied.";
            StartSuccessReset(version, attemptVersion, result, handSize);
        }
        else {
            ShowFallbackIfCurrent(version, attemptVersion, result, handSize, summary);
        }
    }

    private void StartSuccessReset(
        long version,
        long attemptVersion,
        ProbabilityCalculationResult result,
        int handSize
    ) {
        CancelSuccessReset();
        long resetVersion = ++_successResetVersion;
        SuccessResetState state = new(resetVersion, version, attemptVersion, result, handSize);
        _successResetTimer = FeedbackTimeProvider.CreateTimer(OnSuccessResetTimer, state, CopySuccessDuration, Timeout.InfiniteTimeSpan);
    }

    private void OnSuccessResetTimer(object? state) {
        if (state is not SuccessResetState resetState) {
            return;
        }

        _ = ResetSuccessFeedbackAsync(resetState);
    }

    private async Task ResetSuccessFeedbackAsync(SuccessResetState resetState) {
        try {
            await InvokeAsync(() => {
                bool isCurrentSuccess = !_disposed &&
                    resetState.ResetVersion == _successResetVersion &&
                    IsCurrentSnapshot(resetState.ValidityVersion, resetState.AttemptVersion, resetState.Result, resetState.HandSize) &&
                    _copySucceeded;

                if (!isCurrentSuccess) {
                    return;
                }

                _successResetTimer?.Dispose();
                _successResetTimer = null;
                _copySucceeded = false;
                StateHasChanged();
            });
        }
        catch (Exception exception) when (_disposed && exception is InvalidOperationException) {
            // Renderer teardown may race the timer completion.
        }
        catch (OperationCanceledException) when (_disposed) {
            // The renderer may cancel the dispatched update during teardown.
        }
    }

    private void CancelSuccessReset() {
        _successResetVersion++;
        ITimer? resetTimer = _successResetTimer;
        _successResetTimer = null;
        resetTimer?.Dispose();
    }

    private void ShowFallbackIfCurrent(
        long version,
        long attemptVersion,
        ProbabilityCalculationResult result,
        int handSize,
        string summary
    ) {
        if (!IsCurrentSnapshot(version, attemptVersion, result, handSize)) {
            return;
        }

        _fallbackText = summary;
        _focusFallbackAfterRender = true;
    }

    private bool IsCurrentSnapshot(long version, long attemptVersion, ProbabilityCalculationResult result, int handSize) =>
        !_disposed &&
        version == _validityVersion &&
        attemptVersion == _copyAttemptVersion &&
        CanCopy &&
        ReferenceEquals(Result, result) &&
        HandSize == handSize;

    private void DismissFallback() {
        _fallbackText = null;
        _focusCopyButtonAfterRender = CanCopy;
    }

    private static bool IsJavaScriptFailure(Exception exception) =>
        exception is JSException or OperationCanceledException or InvalidOperationException;

    private sealed record SuccessResetState(
        long ResetVersion,
        long ValidityVersion,
        long AttemptVersion,
        ProbabilityCalculationResult Result,
        int HandSize
    );

    public async ValueTask DisposeAsync() {
        if (_disposed) {
            return;
        }

        _disposed = true;
        _validityVersion++;
        _copyAttemptVersion++;
        _copySucceeded = false;
        CancelSuccessReset();

        if (_clipboardModule is null) {
            return;
        }

        try {
            await _clipboardModule.DisposeAsync();
        }
        catch (Exception exception) when (IsJavaScriptFailure(exception)) {
            // Disposal may race a pending clipboard call or a disconnected renderer.
        }
    }
}
