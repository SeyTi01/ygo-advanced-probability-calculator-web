@using YGOProbabilityCalculatorBlazor.Models
@using YGOProbabilityCalculatorBlazor.Components.Shared

<div class="accordion-item card-editor @(Card.Active ? "" : "entry-inactive")">
    <div class="accordion-header entry-editor-header">
        <h2 class="entry-heading">
            <button class="accordion-button flex-grow-1 @(Index == ActiveCardIndex ? "" : "collapsed")"
                    type="button"
                    aria-expanded="@(Index == ActiveCardIndex ? "true" : "false")"
                    aria-controls="card@(Index)"
                    @onclick="ToggleCard">
                <CardArtwork CardId="@Card.Id" ExternalCardId="@(Card.ExternalCardId ?? 0)"
                             Name="@CardDisplayName" Thumbnail="true" />
                <span class="card-header-content">
                    <span class="card-header-name">@CardDisplayName <span class="card-copies">(@Card.Copies)</span></span>

                    @if (Card.DrawCount is { } drawCount) {
                        <span class="badge text-bg-secondary ms-1">Draw @drawCount</span>
                    }

                    @if (UserCategories.Any() || ManualProperties.Any()) {
                        @foreach (CategoryBase category in UserCategories) {
                            <span class="badge category-tag ms-1 @CategoryColorPalette.GetCssClass(category.Name, CategoryColorIndices)">@category.Name</span>
                        }
                        @foreach (CategoryBase property in ManualProperties) {
                            <span class="badge category-tag card-property-tag ms-1 manual-property-header-badge @CardPropertyColorPalette.GetCssClass(property)">@property.Name</span>
                        }
                    }
                    @if (!Card.Active) {
                        <span class="badge text-bg-secondary ms-2">Inactive</span>
                    }
                </span>
            </button>

        </h2>
        <div class="entry-actions">
            <ReorderControls Index="Index" Count="Count" ItemLabel="@($"card {CardDisplayName}, row {Index + 1}")" OnMove="OnMove" />
            <label for="cardActive@(Index)" class="entry-editor-active-toggle">
                <input id="cardActive@(Index)" class="form-check-input entry-editor-active-checkbox" type="checkbox"
                       checked="@Card.Active"
                       aria-label="@ActiveToggleLabel"
                       title="@ActiveToggleTitle"
                       @onchange="e => ChangeActive(e.Value)"/>
            </label>

            <button class="btn btn-danger entry-editor-delete" type="button" aria-label="Remove card" title="Remove card" @onclick="() => OnRemoveCard.InvokeAsync(Index)">
                <span class="entry-editor-delete-face">
                    <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false">
                        <path d="M6 2h4l1 1h3v1H2V3h3l1-1zM4 5h8l-.7 9H4.7z"/>
                        <path d="M6 6h1v6H6zm3 0h1v6H9z" fill="var(--bs-danger)"/>
                    </svg>
                </span>
            </button>
        </div>
    </div>

    <div id="card@(Index)" class="accordion-collapse collapse @(Index == ActiveCardIndex ? "show" : "")">
        <div class="accordion-body">
            @if (_error is not null) {
                <DismissibleAlert Message="@_error" OnDismiss="@(() => _error = null)"/>
            }
            <div class="card-expanded-identity mb-3">
                @if (Index == ActiveCardIndex) {
                    <CardArtwork CardId="@Card.Id" ExternalCardId="@(Card.ExternalCardId ?? 0)" Name="@CardDisplayName" />
                }
                <div class="card-identity-fields">
                    <div class="card-name-field">
                        <label for="cardName@(Index)" class="form-label">Name</label>
                        <input id="cardName@(Index)" class="form-control"
                               value="@(Card.Name ?? string.Empty)"
                               @oninput="e => Rename(e.Value?.ToString())"/>
                    </div>
                    <div class="card-copies-field">
                        <label for="cardCopies@(Index)" class="form-label">Copies</label>
                        <input id="cardCopies@(Index)" class="form-control" type="number" min="1"
                               value="@Card.Copies"
                               @oninput="e => ChangeCopies(e.Value)"/>
                    </div>
                </div>

            </div>
            <div class="mb-3">
                <label for="cardDraw@(Index)" class="form-label">Draw effect</label>
                <select id="cardDraw@(Index)" class="form-select form-select-sm w-auto"
                        value="@(Card.DrawCount?.ToString() ?? string.Empty)"
                        aria-describedby="cardDrawHelp@(Index)" @onchange="e => ChangeDrawCount(e.Value)">
                    <option value="">None</option>
                    <option value="1">Draw 1</option>
                    <option value="2">Draw 2</option>
                    <option value="3">Draw 3</option>
                </select>
                <div id="cardDrawHelp@(Index)" class="form-text">
                    Once per card entry: the first copy drawn resolves automatically and is consumed;
                    later copies stay in hand. Separate entries resolve independently.
                    If a draw cannot be completed, that outcome fails.
                </div>
            </div>
            <div class="editor-add-row mb-3">
                <div class="editor-select-field">
                    <label for="cardCategory@(Index)" class="form-label">Category</label>
                    <select id="cardCategory@(Index)" class="form-select"
                            value="@_selectedCategory"
                            @onchange="e => _selectedCategory = e.Value?.ToString() ?? string.Empty">
                        <option value="">Select category…</option>
                        <optgroup label="User categories">
                            @foreach (CategoryBase categoryBase in CategoryBases.Where(category => category.Source == CategorySource.User)) {
                                <option value="@categoryBase.Identity">@categoryBase.Name</option>
                            }
                        </optgroup>
                        <optgroup label="Card properties">
                            @foreach (CategoryBase categoryBase in CategoryBases.Where(category => category.Source == CategorySource.Metadata && !Card.Categories.Contains(category))) {
                                <option value="@categoryBase.Identity">@categoryBase.Name</option>
                            }
                        </optgroup>
                    </select>
                </div>
                <div class="d-flex align-items-end">
                    <button class="btn btn-primary w-100" @onclick="AddCategory">Add</button>
                </div>
            </div>

            <div>
                @foreach (CategoryBase category in UserCategories) {
                    <span class="badge me-2 category-tag @CategoryColorPalette.GetCssClass(category.Name, CategoryColorIndices)">
                        @category.Name
                        <button type="button"
                                class="btn-close category-remove-button ms-1"
                                aria-label="@($"Remove category {category.Name} from card {CardDisplayName}")"
                                title="@($"Remove category {category.Name} from card {CardDisplayName}")"
                                @onclick="() => RemoveCategory(category.Identity)">
                        </button>
                    </span>
                }
            </div>
            @if (EffectiveMetadataProperties.Length > 0) {
                <details class="card-property-inspector mt-3">
                    <summary class="small fw-semibold">Card properties (@EffectiveMetadataProperties.Length)</summary>
                    <div class="mt-2">
                        @if (DetectedProperties.Length > 0) {
                            <div class="detected-card-properties mb-2">
                                <div class="form-text mb-1">Detected from card data</div>
                                <div class="d-flex flex-wrap">
                                    @foreach (CategoryBase property in DetectedProperties) {
                                        <span class="badge category-tag card-property-tag me-2 mb-1 detected-card-property @CardPropertyColorPalette.GetCssClass(property)">@property.Name</span>
                                    }
                                </div>
                            </div>
                        }
                        @if (ManualProperties.Length > 0) {
                            <div class="manual-card-properties">
                                <div class="form-text mb-1">Added manually</div>
                                <div class="d-flex flex-wrap">
                                    @foreach (CategoryBase property in ManualProperties) {
                                        <span class="badge category-tag card-property-tag me-2 mb-1 manual-card-property @CardPropertyColorPalette.GetCssClass(property)">
                                            @property.Name
                                            <button type="button" class="btn-close category-remove-button ms-1"
                                                    aria-label="@($"Remove manually added card property {property.Name} from card {CardDisplayName}")"
                                                    title="@($"Remove manually added card property {property.Name} from card {CardDisplayName}")"
                                                    @onclick="() => RemoveManualProperty(property.MetadataKey!)">
                                            </button>
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </details>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int Index { get; set; }
    [Parameter] public int Count { get; set; }
    [Parameter] public EventCallback<(int From, int To)> OnMove { get; set; }
    [Parameter] public Card Card { get; set; } = null!;
    [Parameter] public IReadOnlyList<CategoryBase> CategoryBases { get; set; } = [];
    [Parameter] public IReadOnlyDictionary<string, int> CategoryColorIndices { get; set; } = new Dictionary<string, int>(StringComparer.Ordinal);
    [Parameter] public CategoryRenameNotice? CategoryRename { get; set; }

    [Parameter] public int ActiveCardIndex { get; set; }
    [Parameter] public EventCallback<int> ActiveCardIndexChanged { get; set; }

    [Parameter] public EventCallback<(int Index, Card NewCard)> OnReplaceCard { get; set; }
    [Parameter] public EventCallback<int> OnRemoveCard { get; set; }

    private CategoryBase[] UserCategories => Card.Categories
        .Where(category => category.Source == CategorySource.User)
        .ToArray();

    private CategoryBase[] EffectiveMetadataProperties => Card.Categories
        .Where(category => category.Source == CategorySource.Metadata)
        .DistinctBy(category => category.Identity)
        .ToArray();

    private CategoryBase[] DetectedProperties => EffectiveMetadataProperties
        .Where(category => !Card.ManualMetadataCategoryKeys.Contains(category.MetadataKey!))
        .ToArray();

    private CategoryBase[] ManualProperties => EffectiveMetadataProperties
        .Where(category => Card.ManualMetadataCategoryKeys.Contains(category.MetadataKey!))
        .ToArray();

    private string? _error;
    private string _selectedCategory = string.Empty;
    private int _previousCategoryRenameVersion;

    private string CardDisplayName => string.IsNullOrWhiteSpace(Card.Name) ? $"Card {Index + 1}" : Card.Name;
    private string ActiveToggleLabel => $"Active card {CardDisplayName}";
    private string ActiveToggleTitle => $"Toggle {CardDisplayName} active state";

    private Task ToggleCard() {
        int next = ActiveCardIndex == Index ? -1 : Index;

        return ActiveCardIndexChanged.InvokeAsync(next);
    }

    private Task Rename(string? name) {
        Card newCard = Card.WithName(string.IsNullOrWhiteSpace(name) ? null : name);

        return OnReplaceCard.InvokeAsync((Index, newCard));
    }

    private Task ChangeActive(object? value) {
        if (!bool.TryParse(value?.ToString(), out bool active)) {
            return Task.CompletedTask;
        }

        return OnReplaceCard.InvokeAsync((Index, Card.WithActive(active)));
    }

    private Task ChangeCopies(object? value) {
        if (!int.TryParse(value?.ToString(), out int copies) || copies < 1) {
            _error = "Number of copies must be at least 1.";

            return Task.CompletedTask;
        }

        _error = null;
        Card newCard = Card.WithCopies(copies);

        return OnReplaceCard.InvokeAsync((Index, newCard));
    }

    private Task ChangeDrawCount(object? value) {
        string? text = value?.ToString();
        int? drawCount = null;
        if (!string.IsNullOrEmpty(text)) {
            if (!int.TryParse(text, out int count) || count is < 1 or > 3) {
                _error = "Choose None, Draw 1, Draw 2, or Draw 3.";
                return Task.CompletedTask;
            }

            drawCount = count;
        }

        _error = null;
        return OnReplaceCard.InvokeAsync((Index, Card.WithDrawCount(drawCount)));
    }

    private Task AddCategory() {
        if (string.IsNullOrWhiteSpace(_selectedCategory)) {
            _error = "Please select a category to add.";

            return Task.CompletedTask;
        }

        CategoryBase? chosen = CategoryBases.FirstOrDefault(category => category.Identity == _selectedCategory);

        if (chosen is null) {
            _error = "Selected category not found.";

            return Task.CompletedTask;
        }

        if (Card.Categories.Any(category => category.Identity == chosen.Identity)) {
            _error = "This category is already added to the card.";

            return Task.CompletedTask;
        }

        _error = null;

        Card newCard = chosen.Source == CategorySource.Metadata
            ? Card.WithManualMetadataCategory(chosen)
            : Card.WithCategories(Card.Categories.Concat([chosen]));

        _selectedCategory = string.Empty;

        return OnReplaceCard.InvokeAsync((Index, newCard));
    }

    private Task RemoveCategory(string categoryIdentity) {
        List<CategoryBase> newCategories = Card.Categories
            .Where(category => category.Source != CategorySource.User || category.Identity != categoryIdentity)
            .ToList();

        Card newCard = Card.WithCategories(newCategories);

        return OnReplaceCard.InvokeAsync((Index, newCard));
    }

    private Task RemoveManualProperty(string key) => OnReplaceCard.InvokeAsync((Index, Card.WithoutManualMetadataCategory(key)));

    protected override void OnParametersSet() {
        if (CategoryRename is not { } rename || rename.Version == _previousCategoryRenameVersion) {
            return;
        }

        if (_selectedCategory.Equals($"user:{rename.OldName}", StringComparison.Ordinal)) {
            _selectedCategory = $"user:{rename.NewName}";
        }

        _previousCategoryRenameVersion = rename.Version;
    }

}
