@using YGOProbabilityCalculatorBlazor.Models
@using YGOProbabilityCalculatorBlazor.Components.Shared
@using YGOProbabilityCalculatorBlazor.Services.DeckImport
@using YGOProbabilityCalculatorBlazor.Services.Interface
@using Microsoft.AspNetCore.Components.Web

<div class="accordion-item card-editor @(Card.Active ? "" : "entry-inactive")">
    <div class="accordion-header entry-editor-header">
        <h2 class="entry-heading">
            <button class="accordion-button flex-grow-1 @(Index == ActiveCardIndex ? "" : "collapsed")"
                    type="button"
                    aria-expanded="@(Index == ActiveCardIndex ? "true" : "false")"
                    aria-controls="card@(Index)"
                    @onclick="ToggleCard">
                <CardArtwork CardId="@Card.Id" ExternalCardId="@(Card.ExternalCardId ?? 0)"
                             Name="@CardDisplayName" Thumbnail="true" />
                <span class="card-header-content">
                    <span class="card-header-name">@CardDisplayName <span class="card-copies">(@Card.Copies)</span></span>

                    @if (DrawPresentation.HeaderText is { } drawSummary) {
                        <span class="badge text-bg-secondary ms-1">@drawSummary</span>
                    }

                    @if (ManualUserCategories.Any() || ManualProperties.Any()) {
                        @foreach (CategoryBase category in ManualUserCategories) {
                            <span class="badge category-tag ms-1 @CategoryColorPalette.GetCssClass(category.Name, CategoryColorIndices)">@category.Name</span>
                        }
                        @foreach (CategoryBase property in ManualProperties) {
                            <span class="badge category-tag card-property-tag ms-1 manual-property-header-badge @CardPropertyColorPalette.GetCssClass(property)">@property.Name</span>
                        }
                    }
                    @if (!Card.Active) {
                        <span class="badge text-bg-secondary ms-2">Inactive</span>
                    }
                </span>
            </button>

        </h2>
        <div class="entry-actions">
            <RowActionMenu Kind="card" ItemLabel="@($"card {CardDisplayName}, row {Index + 1}")"
                           Index="Index" Count="Count" Active="Card.Active"
                           OnMove="OnMove" OnDuplicate="() => OnDuplicateCard.InvokeAsync(Index)"
                           OnToggle="() => ChangeActive(!Card.Active)"
                           OnRemove="() => OnRemoveCard.InvokeAsync(Index)" />
        </div>
    </div>

    <div id="card@(Index)" class="accordion-collapse collapse @(Index == ActiveCardIndex ? "show" : "")">
        <div class="accordion-body">
            @if (_error is not null) {
                <DismissibleAlert Message="@_error" OnDismiss="@(() => _error = null)"/>
            }
            <div class="card-expanded-identity mb-3">
                @if (Index == ActiveCardIndex) {
                    <CardArtwork CardId="@Card.Id" ExternalCardId="@(Card.ExternalCardId ?? 0)" Name="@CardDisplayName" />
                }
                <div class="card-identity-fields">
                    <div class="card-name-field">
                        <label for="cardName@(Index)" class="form-label">Name</label>
                        <CardSearchInput Id="@($"cardName{Index}")" Identity="@Card.Id" Value="@(Card.Name ?? string.Empty)"
                                         ResultsId="@($"cardSearchResults{Index}")" OptionPrefix="@($"cardSearchOption{Index}")"
                                         OnInput="RenameFromSearch" OnSelected="SelectCard" OnFinished="OnNameEditFinished" />
                    </div>
                    <div class="card-copies-field">
                        <label for="cardCopies@(Index)" class="form-label">Copies</label>
                        <input id="cardCopies@(Index)" class="form-control" type="number" min="1"
                               value="@Card.Copies"
                               @oninput="e => ChangeCopies(e.Value)"/>
                    </div>
                </div>

            </div>
            <div class="mb-3">
                <label for="cardDraw@(Index)" class="form-label">Draw effect</label>
                <div class="d-flex flex-wrap align-items-center gap-3">
                    <select id="cardDraw@(Index)" class="form-select form-select-sm w-auto"
                            value="@(Card.DrawCount?.ToString() ?? string.Empty)"
                            aria-describedby="@DrawEffectDescriptionIds" @onchange="e => ChangeDrawCount(e.Value)">
                        <option value="">None</option>
                        <option value="1">Draw 1</option>
                        <option value="2">Draw 2</option>
                        <option value="3">Draw 3</option>
                    </select>
                    @if (Card.DrawCount is not null) {
                        <div class="form-check form-switch mb-0">
                            <input id="cardDrawOnce@(Index)" class="form-check-input" type="checkbox" role="switch"
                                   checked="@Card.DrawOncePerTurn" aria-describedby="@DrawEffectDescriptionIds"
                                   @onchange="e => ChangeDrawOncePerTurn(e.Value)" />
                            <label for="cardDrawOnce@(Index)" class="form-check-label">Once per turn</label>
                        </div>
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <label for="cardCost@(Index)" class="form-label mb-0">Before drawing</label>
                            <select id="cardCost@(Index)" class="form-select form-select-sm w-auto"
                                    value="@Card.PreDrawRemovalCount" aria-describedby="@DrawEffectDescriptionIds"
                                    @onchange="e => ChangePreDrawRemovalCount(e.Value)">
                                <option value="0">None</option>
                                <option value="1">Remove 1</option>
                                <option value="2">Remove 2</option>
                            </select>
                        </div>
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <label for="cardDiscard@(Index)" class="form-label mb-0">After drawing</label>
                            <select id="cardDiscard@(Index)" class="form-select form-select-sm w-auto"
                                    value="@Card.PostDrawDiscardCount" aria-describedby="@DrawEffectDescriptionIds"
                                    @onchange="e => ChangePostDrawDiscardCount(e.Value)">
                                <option value="0">None</option>
                                <option value="1">Remove 1</option>
                                <option value="2">Remove 2</option>
                            </select>
                        </div>
                    }
                </div>
                @if (DrawPresentation.InactiveMessage is { } inactiveMessage) {
                    <p class="form-text mb-1" id="cardDrawModeHelp@(Index)" role="note">@inactiveMessage</p>
                }
                @if (Card.PreDrawRemovalCount > 0) {
                    <div class="mt-2 small">Before drawing: remove from hand</div>
                    <PostDrawSelectorEditor Id="@($"cardCostEligibility{Index}")" Selector="Card.PreDrawSelector"
                                            CategoryBases="CategoryBases"
                                            RelevantMetadataCategoryIdentities="RelevantMetadataCategoryIdentities"
                                            CategoryColorIndices="CategoryColorIndices"
                                            UnavailableMessage="If unavailable: retain source without activating."
                                            OnChanged="selector => OnReplaceCard.InvokeAsync((Index, Card.WithPreDrawSelector(selector)))" />
                }
                @if (Card.PostDrawDiscardCount > 0) {
                    <div class="mt-2 small">After drawing: remove from hand</div>
                    <PostDrawSelectorEditor Id="@($"cardEligibility{Index}")" Selector="Card.PostDrawSelector"
                                            CategoryBases="CategoryBases"
                                            RelevantMetadataCategoryIdentities="RelevantMetadataCategoryIdentities"
                                            CategoryColorIndices="CategoryColorIndices"
                                            OnChanged="selector => OnReplaceCard.InvokeAsync((Index, Card.WithPostDrawSelector(selector)))" />
                }
                <div id="cardDrawHelp@(Index)" class="form-text">
                    @if (Card.DrawCount is null) {
                        <span>Choose a draw amount to enable an automatic draw effect.</span>
                    }
                    else if (!DrawEffectsEnabled) {
                        <span>Stored draw settings are retained and apply when Draw effects are on.</span>
                    }
                    else if (ConditionalEffectsEnabled && Card.PreDrawRemovalCount > 0) {
                        <span>Check the full draw batch and hand cost before activating. If either is unavailable, keep the source and OPT unused; cost-blocked sources retry after another activation. Keep active combo pieces first, then usable draw cards. Only hand costs are modeled.</span>
                    }
                    else if (Card.DrawOncePerTurn) {
                        <span>The first copy drawn resolves automatically and is consumed; later copies stay in hand. Separate entries resolve independently.</span>
                    }
                    else {
                        <span>Every copy drawn resolves automatically and is consumed, including copies drawn by another effect.</span>
                    }
                    @if (Card.DrawCount is not null && DrawEffectsEnabled) {
                        <span> The effect activates only when the full draw amount is available; otherwise it stays in hand.</span>
                    }
                    @if (Card.PostDrawDiscardCount > 0) {
                        @if (DrawEffectsEnabled && ConditionalEffectsEnabled) {
                            <span> Remove eligible cards immediately after drawing, keeping active combo requirements first, then usable draw cards. This deterministic policy does not optimize play.</span>
                        }
                    }
                </div>
            </div>
            <div class="editor-add-row mb-3">
                <div class="editor-select-field">
                    <label for="cardCategory@(Index)" class="form-label">Category</label>
                    <select id="cardCategory@(Index)" class="form-select"
                            value="@_selectedCategory"
                            @onchange="e => _selectedCategory = e.Value?.ToString() ?? string.Empty">
                        <option value="">Select category…</option>
                        @if (AvailableUserCategoryOptions.Any()) {
                            <optgroup label="User categories">
                                @foreach (CategoryBase categoryBase in AvailableUserCategoryOptions) {
                                    <option value="@categoryBase.Identity">@categoryBase.Name</option>
                                }
                            </optgroup>
                        }
                        @if (AvailableRelevantPropertyOptions.Any()) {
                            <optgroup label="Relevant properties">
                                @foreach (CategoryBase categoryBase in AvailableRelevantPropertyOptions) {
                                    <option value="@categoryBase.Identity">@categoryBase.Name</option>
                                }
                            </optgroup>
                        }
                        @if (AvailableCommonPropertyOptions.Any()) {
                            <optgroup label="Common properties">
                                @foreach (CategoryBase categoryBase in AvailableCommonPropertyOptions) {
                                    <option value="@categoryBase.Identity">@categoryBase.Name</option>
                                }
                            </optgroup>
                        }
                    </select>
                </div>
                <div class="d-flex align-items-end">
                    <button class="btn btn-primary w-100" @onclick="AddCategory">Add</button>
                </div>
            </div>

            <div>
                @foreach (CategoryBase category in UserCategories) {
                    <span class="badge me-2 category-tag @CategoryColorPalette.GetCssClass(category.Name, CategoryColorIndices)">
                        @category.Name
                        @if (category.Rule is not null) {
                            bool automatic = CategoryMembership.IsAutomatic(Card, category);
                            bool manual = Card.Categories.Contains(category);
                            string provenance = (automatic, manual) switch {
                                (true, true) => "Automatic + manual",
                                (true, false) => "Automatic",
                                _ => "Manual"
                            };
                            <small class="ms-1">@provenance</small>
                            @if (!manual) {
                                <button type="button" class="btn btn-sm btn-link text-reset p-0 ms-1"
                                        title="Keep this inclusion even if the rule changes"
                                        aria-label="@($"Include {category.Name} manually on card {CardDisplayName}")"
                                        @onclick="() => IncludeManually(category)">Keep manually</button>
                            }
                        }
                        @if (Card.Categories.Contains(category)) {
                            <button type="button" class="btn-close category-remove-button ms-1"
                                    aria-label="@($"Remove category {category.Name} from card {CardDisplayName}")"
                                    title="@(category.Rule is null ? $"Remove category {category.Name} from card {CardDisplayName}" : "Remove manual inclusion; automatic matches remain")"
                                    @onclick="() => RemoveCategory(category.Identity)"></button>
                        }
                    </span>
                }
            </div>
            @if (UserCategories.Any(category => category.Rule is not null)) {
                <div class="form-text">Automatic memberships follow the category rule. Edit it under Categories; removing a manual inclusion keeps any automatic match.</div>
            }
            @if (EffectiveMetadataProperties.Length > 0) {
                <details class="card-property-inspector mt-3">
                    <summary class="small fw-semibold">Card properties (@EffectiveMetadataProperties.Length)</summary>
                    <div class="mt-2">
                        @if (DetectedProperties.Length > 0) {
                            <div class="detected-card-properties mb-2">
                                <div class="form-text mb-1">Detected from card data</div>
                                <div class="d-flex flex-wrap">
                                    @foreach (CategoryBase property in DetectedProperties) {
                                        <span class="badge category-tag card-property-tag me-2 mb-1 detected-card-property @CardPropertyColorPalette.GetCssClass(property)">@property.Name</span>
                                    }
                                </div>
                            </div>
                        }
                        @if (ManualProperties.Length > 0) {
                            <div class="manual-card-properties">
                                <div class="form-text mb-1">Added manually</div>
                                <div class="d-flex flex-wrap">
                                    @foreach (CategoryBase property in ManualProperties) {
                                        <span class="badge category-tag card-property-tag me-2 mb-1 manual-card-property @CardPropertyColorPalette.GetCssClass(property)">
                                            @property.Name
                                            <button type="button" class="btn-close category-remove-button ms-1"
                                                    aria-label="@($"Remove manually added card property {property.Name} from card {CardDisplayName}")"
                                                    title="@($"Remove manually added card property {property.Name} from card {CardDisplayName}")"
                                                    @onclick="() => RemoveManualProperty(property.MetadataKey!)">
                                            </button>
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </details>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int Index { get; set; }
    [Parameter] public int Count { get; set; }
    [Parameter] public EventCallback<(int From, int To)> OnMove { get; set; }
    [Parameter] public Card Card { get; set; } = null!;
    [Parameter] public bool DrawEffectsEnabled { get; set; } = true;
    [Parameter] public bool ConditionalEffectsEnabled { get; set; }
    [Parameter] public IReadOnlyList<CategoryBase> CategoryBases { get; set; } = [];
    [Parameter] public IReadOnlySet<string> RelevantMetadataCategoryIdentities { get; set; } = new HashSet<string>(StringComparer.Ordinal);
    [Parameter] public IReadOnlyDictionary<string, int> CategoryColorIndices { get; set; } = new Dictionary<string, int>(StringComparer.Ordinal);
    [Parameter] public CategoryRenameNotice? CategoryRename { get; set; }

    [Parameter] public int ActiveCardIndex { get; set; }
    [Parameter] public EventCallback<int> ActiveCardIndexChanged { get; set; }

    [Parameter] public EventCallback<(int Index, Card NewCard)> OnReplaceCard { get; set; }
    [Parameter] public Func<(int Index, Card NewCard), Task>? OnRenameCard { get; set; }
    [Parameter] public EventCallback OnNameEditFinished { get; set; }
    [Parameter] public EventCallback<int> OnDuplicateCard { get; set; }
    [Parameter] public EventCallback<int> OnRemoveCard { get; set; }

    private Task IncludeManually(CategoryBase category) =>
        OnReplaceCard.InvokeAsync((Index, Card.WithCategories(Card.Categories.Append(category))));

    private IEnumerable<CategoryBase> ManualUserCategories => Card.Categories
        .Where(category => category.Source == CategorySource.User);

    private CategoryBase[] UserCategories => CategoryMembership.EffectiveCategories(Card, CategoryBases)
        .Where(category => category.Source == CategorySource.User)
        .Select(category => CategoryBases.FirstOrDefault(definition => definition.Identity == category.Identity) ?? category)
        .ToArray();

    private IEnumerable<CategoryBase> AvailableUserCategoryOptions => CategoryBases
        .Where(static category => category.Source == CategorySource.User);

    private IEnumerable<CategoryBase> AvailableRelevantPropertyOptions => CategoryBases
        .Where(category => category.Source == CategorySource.Metadata
            && RelevantMetadataCategoryIdentities.Contains(category.Identity)
            && !Card.Categories.Contains(category));

    private IEnumerable<CategoryBase> AvailableCommonPropertyOptions => CategoryBases
        .Where(category => CategoryCatalog.IsCommonMetadata(category)
            && !RelevantMetadataCategoryIdentities.Contains(category.Identity)
            && !Card.Categories.Contains(category));

    private CategoryBase[] EffectiveMetadataProperties => Card.Categories
        .Where(category => category.Source == CategorySource.Metadata)
        .DistinctBy(category => category.Identity)
        .ToArray();

    private CategoryBase[] DetectedProperties => EffectiveMetadataProperties
        .Where(category => !Card.ManualMetadataCategoryKeys.Contains(category.MetadataKey!))
        .ToArray();

    private CategoryBase[] ManualProperties => EffectiveMetadataProperties
        .Where(category => Card.ManualMetadataCategoryKeys.Contains(category.MetadataKey!))
        .ToArray();

    private string? _error;
    private string _selectedCategory = string.Empty;
    private int _previousCategoryRenameVersion;
    private RenderParameters? _previousRenderParameters;
    private Dictionary<string, int> _previousCategoryColors = new(StringComparer.Ordinal);
    private bool _skipParameterRender;

    private sealed record RenderParameters(
        Card Card,
        int Index,
        int Count,
        int ActiveCardIndex,
        bool DrawEffectsEnabled,
        bool ConditionalEffectsEnabled,
        IReadOnlyList<CategoryBase> CategoryBases,
        IReadOnlySet<string> RelevantMetadataCategoryIdentities,
        IReadOnlyDictionary<string, int> CategoryColorIndices,
        CategoryRenameNotice? CategoryRename
    );

    private string CardDisplayName => string.IsNullOrWhiteSpace(Card.Name) ? $"Card {Index + 1}" : Card.Name;
    private DrawEffectPresentation DrawPresentation =>
        DrawEffectPresentation.ForCard(Card, DrawEffectsEnabled, ConditionalEffectsEnabled);
    private string DrawEffectDescriptionIds => DrawPresentation.InactiveMessage is null
        ? $"cardDrawHelp{Index}"
        : $"cardDrawHelp{Index} cardDrawModeHelp{Index}";
    private Task ToggleCard() {
        int next = ActiveCardIndex == Index ? -1 : Index;

        return ActiveCardIndexChanged.InvokeAsync(next);
    }

    private async Task RenameFromSearch(string query) {
        Card newCard = Card.WithName(string.IsNullOrWhiteSpace(query) ? null : query);
        if (string.Equals(Card.Name, newCard.Name, StringComparison.Ordinal)) {
            return;
        }

        if (OnRenameCard is not null) {
            Card = newCard;
            await OnRenameCard((Index, newCard));
            StateHasChanged();
        }
        else {
            await OnReplaceCard.InvokeAsync((Index, newCard));
        }
    }

    private Task SelectCard(CardInfo selectedCard) {
        Card replacement = Card.WithObjectiveMetadata(CardPropertyProvider.GetCategories(selectedCard), selectedCard.Id)
            .WithName(selectedCard.Name);
        Card newCard = CuratedDrawEffectPresets.ApplyForExplicitSelection(replacement, Card, selectedCard);

        return OnReplaceCard.InvokeAsync((Index, newCard));
    }

    private Task ChangeActive(object? value) {
        if (!bool.TryParse(value?.ToString(), out bool active)) {
            return Task.CompletedTask;
        }

        return OnReplaceCard.InvokeAsync((Index, Card.WithActive(active)));
    }

    private Task ChangeCopies(object? value) {
        if (!int.TryParse(value?.ToString(), out int copies) || copies < 1) {
            _error = "Number of copies must be at least 1.";

            return Task.CompletedTask;
        }

        _error = null;
        Card newCard = Card.WithCopies(copies);

        return OnReplaceCard.InvokeAsync((Index, newCard));
    }

    private Task ChangeDrawCount(object? value) {
        string? text = value?.ToString();
        int? drawCount = null;
        if (!string.IsNullOrEmpty(text)) {
            if (!int.TryParse(text, out int count) || count is < 1 or > 3) {
                _error = "Choose None, Draw 1, Draw 2, or Draw 3.";
                return Task.CompletedTask;
            }

            drawCount = count;
        }

        _error = null;
        return OnReplaceCard.InvokeAsync((Index, Card.WithDrawCount(drawCount)));
    }

    private Task ChangeDrawOncePerTurn(object? value) => value is bool oncePerTurn
        ? OnReplaceCard.InvokeAsync((Index, Card.WithDrawOncePerTurn(oncePerTurn)))
        : Task.CompletedTask;

    private Task ChangePreDrawRemovalCount(object? value) {
        if (!int.TryParse(value?.ToString(), out int count) || count is < 0 or > 2 || Card.DrawCount is null) {
            _error = "Choose None, Remove 1, or Remove 2 with a draw effect.";
            return Task.CompletedTask;
        }
        _error = null;
        return OnReplaceCard.InvokeAsync((Index, Card.WithPreDrawRemovalCount(count)));
    }

    private Task ChangePostDrawDiscardCount(object? value) {
        if (!int.TryParse(value?.ToString(), out int count) || count is < 0 or > 2 || Card.DrawCount is null) {
            _error = "Choose None, Remove 1, or Remove 2 with a draw effect.";
            return Task.CompletedTask;
        }

        _error = null;
        return OnReplaceCard.InvokeAsync((Index, Card.WithPostDrawDiscardCount(count)));
    }

    private Task AddCategory() {
        if (string.IsNullOrWhiteSpace(_selectedCategory)) {
            _error = "Please select a category to add.";

            return Task.CompletedTask;
        }

        CategoryBase? chosen = CategoryBases.FirstOrDefault(category => category.Identity == _selectedCategory);

        if (chosen is null) {
            _error = "Selected category not found.";

            return Task.CompletedTask;
        }

        if (Card.Categories.Any(category => category.Identity == chosen.Identity)) {
            _error = "This category is already added to the card.";

            return Task.CompletedTask;
        }

        _error = null;

        Card newCard = chosen.Source == CategorySource.Metadata
            ? Card.WithManualMetadataCategory(chosen)
            : Card.WithCategories(Card.Categories.Concat([chosen]));

        _selectedCategory = string.Empty;

        return OnReplaceCard.InvokeAsync((Index, newCard));
    }

    private Task RemoveCategory(string categoryIdentity) {
        List<CategoryBase> newCategories = Card.Categories
            .Where(category => category.Source != CategorySource.User || category.Identity != categoryIdentity)
            .ToList();

        Card newCard = Card.WithCategories(newCategories);

        return OnReplaceCard.InvokeAsync((Index, newCard));
    }

    private Task RemoveManualProperty(string key) => OnReplaceCard.InvokeAsync((Index, Card.WithoutManualMetadataCategory(key)));

    protected override void OnParametersSet() {
        RenderParameters parameters = new(
            Card,
            Index,
            Count,
            ActiveCardIndex,
            DrawEffectsEnabled,
            ConditionalEffectsEnabled,
            CategoryBases,
            RelevantMetadataCategoryIdentities,
            CategoryColorIndices,
            CategoryRename
        );
        bool colorsUnchanged = CategoryColorIndices.Count == _previousCategoryColors.Count
            && CategoryColorIndices.All(color => _previousCategoryColors.TryGetValue(color.Key, out int previous) && previous == color.Value);
        _skipParameterRender = parameters == _previousRenderParameters && colorsUnchanged;
        _previousRenderParameters = parameters;
        _previousCategoryColors = new(CategoryColorIndices, StringComparer.Ordinal);

        if (CategoryRename is not { } rename || rename.Version == _previousCategoryRenameVersion) {
            return;
        }

        if (_selectedCategory.Equals($"user:{rename.OldName}", StringComparison.Ordinal)) {
            _selectedCategory = $"user:{rename.NewName}";
        }

        _previousCategoryRenameVersion = rename.Version;
    }

    protected override bool ShouldRender() {
        bool render = !_skipParameterRender;
        _skipParameterRender = false;

        return render;
    }

}
