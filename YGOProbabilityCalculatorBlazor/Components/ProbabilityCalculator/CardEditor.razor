@using YGOProbabilityCalculatorBlazor.Models
@using YGOProbabilityCalculatorBlazor.Components.Shared

<div class="accordion-item @(Card.Active ? "" : "entry-inactive")">
    <h2 class="accordion-header d-flex entry-editor-header">
        <button class="accordion-button flex-grow-1 @(Index == ActiveCardIndex ? "" : "collapsed")"
                type="button"
                aria-expanded="@(Index == ActiveCardIndex ? "true" : "false")"
                aria-controls="card@(Index)"
                @onclick="ToggleCard">
            <span>@CardDisplayName</span>
            <span class="ms-2">(@Card.Copies)</span>

            @if (Card.Categories.Any()) {
                <span class="ms-2">-</span>
                @foreach (var cat in Card.Categories) {
                    <span class="badge category-tag ms-1 @CategoryColorPalette.GetCssClass(cat.Name, CategoryColorIndices)">@cat.Name</span>
                }
            }
            @if (!Card.Active) {
                <span class="badge text-bg-secondary ms-2">Inactive</span>
            }
        </button>

        <div class="d-flex align-items-center mx-2 mb-0 flex-shrink-0 entry-editor-active-toggle">
            <input id="cardActive@(Index)" class="form-check-input entry-editor-active-checkbox" type="checkbox"
                   checked="@Card.Active"
                   aria-label="@ActiveToggleLabel"
                   title="@ActiveToggleTitle"
                   @onchange="e => ChangeActive(e.Value)"/>
        </div>

        <button class="btn btn-danger align-self-center" type="button" aria-label="Remove card" title="Remove card" @onclick="() => OnRemoveCard.InvokeAsync(Index)">
            <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false">
                <path d="M6 2h4l1 1h3v1H2V3h3l1-1zM4 5h8l-.7 9H4.7z"/>
                <path d="M6 6h1v6H6zm3 0h1v6H9z" fill="var(--bs-danger)"/>
            </svg>
        </button>
    </h2>

    <div id="card@(Index)" class="accordion-collapse collapse @(Index == ActiveCardIndex ? "show" : "")">
        <div class="accordion-body">
            @if (error is not null) {
                <DismissibleAlert Message="@error" OnDismiss="@(() => error = null)"/>
            }
            <div class="row mb-3">
                <div class="col-6">
                    <label for="cardName@(Index)" class="form-label">Name</label>
                    <input id="cardName@(Index)" class="form-control"
                           value="@(Card.Name ?? string.Empty)"
                           @oninput="e => Rename(e.Value?.ToString())"/>
                </div>
                <div class="col-3">
                    <label for="cardCopies@(Index)" class="form-label">Copies</label>
                    <input id="cardCopies@(Index)" class="form-control" type="number" min="1"
                           value="@Card.Copies"
                           @oninput="e => ChangeCopies(e.Value)"/>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-8">
                    <label for="cardCategory@(Index)" class="form-label">Category</label>
                    <select id="cardCategory@(Index)" class="form-select"
                            value="@selectedCategory"
                            @onchange="e => selectedCategory = e.Value?.ToString() ?? string.Empty">
                        <option value="">Select category…</option>
                        @foreach (var cb in CategoryBases) {
                            <option value="@cb.Name">@cb.Name</option>
                        }
                    </select>
                </div>
                <div class="col-4 d-flex align-items-end">
                    <button class="btn btn-primary w-100" @onclick="AddCategory">Add</button>
                </div>
            </div>

            <div>
                @foreach (var cat in Card.Categories) {
                    <span class="badge me-2 category-tag @CategoryColorPalette.GetCssClass(cat.Name, CategoryColorIndices)">
                        @cat.Name
                        <button type="button"
                                class="btn-close category-remove-button ms-1"
                                aria-label="@($"Remove category {cat.Name} from card {CardDisplayName}")"
                                title="@($"Remove category {cat.Name} from card {CardDisplayName}")"
                                @onclick="() => RemoveCategory(cat.Name)">
                        </button>
                    </span>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int Index { get; set; }
    [Parameter] public Card Card { get; set; } = null!;
    [Parameter] public IReadOnlyList<CategoryBase> CategoryBases { get; set; } = [];
    [Parameter] public IReadOnlyDictionary<string, int> CategoryColorIndices { get; set; } = new Dictionary<string, int>(StringComparer.Ordinal);
    [Parameter] public CategoryRenameNotice? CategoryRename { get; set; }

    [Parameter] public int ActiveCardIndex { get; set; }
    [Parameter] public EventCallback<int> ActiveCardIndexChanged { get; set; }

    [Parameter] public EventCallback<(int Index, Card NewCard)> OnReplaceCard { get; set; }
    [Parameter] public EventCallback<int> OnRemoveCard { get; set; }

    private string? error;
    private string selectedCategory = string.Empty;
    private int previousCategoryRenameVersion;
    private string CardDisplayName => string.IsNullOrWhiteSpace(Card.Name) ? $"Card {Index + 1}" : Card.Name;
    private string ActiveToggleLabel => $"Active card {CardDisplayName}";
    private string ActiveToggleTitle => $"Toggle {CardDisplayName} active state";

    private Task ToggleCard() {
        var next = ActiveCardIndex == Index ? -1 : Index;
        return ActiveCardIndexChanged.InvokeAsync(next);
    }

    private Task Rename(string? name) {
        var newCard = Card.WithName(string.IsNullOrWhiteSpace(name) ? null : name);
        return OnReplaceCard.InvokeAsync((Index, newCard));
    }

    private Task ChangeActive(object? value) {
        if (!bool.TryParse(value?.ToString(), out var active)) return Task.CompletedTask;
        return OnReplaceCard.InvokeAsync((Index, Card.WithActive(active)));
    }

    private Task ChangeCopies(object? value) {
        if (!int.TryParse(value?.ToString(), out var copies) || copies < 1) {
            error = "Number of copies must be at least 1.";
            return Task.CompletedTask;
        }
        error = null;
        var newCard = Card.WithCopies(copies);
        return OnReplaceCard.InvokeAsync((Index, newCard));
    }

    private Task AddCategory() {
        if (string.IsNullOrWhiteSpace(selectedCategory)) {
            error = "Please select a category to add.";
            return Task.CompletedTask;
        }

        var chosen = CategoryBases.FirstOrDefault(c => c.Name == selectedCategory);
        if (chosen is null) {
            error = "Selected category not found.";
            return Task.CompletedTask;
        }
        if (Card.Categories.Any(c => c.Name == chosen.Name)) {
            error = "This category is already added to the card.";
            return Task.CompletedTask;
        }
        error = null;

        var newCats = Card.Categories.Concat([chosen]).ToList();
        var newCard = Card.WithCategories(newCats);
        selectedCategory = string.Empty;
        return OnReplaceCard.InvokeAsync((Index, newCard));
    }

    private Task RemoveCategory(string categoryName) {
        var newCats = Card.Categories.Where(c => c.Name != categoryName).ToList();
        var newCard = Card.WithCategories(newCats);
        return OnReplaceCard.InvokeAsync((Index, newCard));
    }

    protected override void OnParametersSet() {
        if (CategoryRename is not { } rename || rename.Version == previousCategoryRenameVersion) return;

        if (selectedCategory.Equals(rename.OldName, StringComparison.Ordinal))
            selectedCategory = rename.NewName;

        previousCategoryRenameVersion = rename.Version;
    }

}
