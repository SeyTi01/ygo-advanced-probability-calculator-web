<button type="button" class="expression-member control-focus-ring" @attributes="AdditionalAttributes" aria-label="@Label"
        aria-expanded="@Expanded.ToString().ToLowerInvariant()" @onclick="OnEdit" @onclick:stopPropagation @ref="_button">@ChildContent</button>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public bool Expanded { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private ElementReference _button;

    public ValueTask FocusAsync(bool preventScroll = false) => _button.FocusAsync(preventScroll);
}
