@implements IDisposable
<button type="button" class="expression-member control-focus-ring" @attributes="AdditionalAttributes" aria-label="@Label"
        aria-expanded="@Expanded.ToString().ToLowerInvariant()" @onclick="Edit" @onclick:stopPropagation @ref="_button">@ChildContent</button>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public bool Expanded { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private ElementReference _button;
    [CascadingParameter] public ExpressionRow? Row { get; set; }

    private Task Edit() {
        Row?.RememberMember(this);
        return OnEdit.InvokeAsync();
    }

    public void Dispose() => Row?.ForgetMember(this);

    public ValueTask FocusAsync(bool preventScroll = false) => _button.FocusAsync(preventScroll);
}
