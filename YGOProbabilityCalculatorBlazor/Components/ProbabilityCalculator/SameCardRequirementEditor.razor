@using YGOProbabilityCalculatorBlazor.Models

<div class="border rounded p-2 mt-2 mb-3" role="group" aria-label="Same-card requirement">
    <div class="small mb-2">Each card must match every category below. One shared range applies.</div>
    @for (int index = 0; index < _categories.Count; index++) {
        int current = index;
        <div class="d-flex align-items-center gap-2 mb-2">
            @if (index > 0) { <span class="small">AND</span> }
            <select class="form-select form-select-sm" style="min-width:0" aria-label="Conjunct @(index + 1)"
                    value="@_categories[index].Identity" @onchange="e => Change(current, e.Value?.ToString())">
                @foreach (CategoryBase category in Available) {
                    <option value="@category.Identity">@category.Name</option>
                }
            </select>
            <button type="button" class="btn-close flex-shrink-0" aria-label="Remove conjunct @(index + 1)"
                    title="Remove conjunct" disabled="@(_categories.Count == 1)" @onclick="() => _categories.RemoveAt(current)"></button>
        </div>
    }
    <select class="form-select form-select-sm mb-2" aria-label="Add AND category" value="" @onchange="Add">
        <option value="">Add AND category/property…</option>
        @foreach (CategoryBase category in Available) {
            <option value="@category.Identity">@category.Name</option>
        }
    </select>
    <div class="d-flex flex-wrap align-items-end gap-2">
        <label class="small">Min<input class="form-control form-control-sm" style="width:5rem" aria-label="Same-card minimum" type="number" min="0" @bind="_minimum" /></label>
        <label class="small">Max<input class="form-control form-control-sm" style="width:5rem" aria-label="Same-card maximum" type="number" min="0" placeholder="Any" title="Leave empty for Any" @bind="_maximum" /></label>
        <button type="button" class="btn btn-sm btn-primary" @onclick="Apply">Apply AND</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="OnCancel">Cancel</button>
    </div>
    @if (_error is not null) { <div class="text-danger small mt-1" role="alert">@_error</div> }
</div>

@code {
    [Parameter] public ComboCategory Requirement { get; set; } = null!;
    [Parameter] public IReadOnlyList<CategoryBase> CategoryBases { get; set; } = [];
    [Parameter] public CategoryRenameNotice? CategoryRename { get; set; }
    [Parameter] public EventCallback<ComboCategory> OnApply { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private List<CategoryBase> _categories = [];
    private string _minimum = "1";
    private string _maximum = "";
    private string? _error;
    private int _renameVersion;
    private IEnumerable<CategoryBase> Available => CategoryBases.Concat(_categories).DistinctBy(category => category.Identity);

    protected override void OnInitialized() {
        _categories = Requirement.CategoryBases.ToList();
        _minimum = Requirement.MinCount.ToString();
        _maximum = Requirement.MaximumMode == RequirementMaximumMode.HandSize ? "" : Requirement.MaxCount.ToString();
        _renameVersion = CategoryRename?.Version ?? 0;
    }

    protected override void OnParametersSet() {
        if (CategoryRename is { } rename && rename.Version != _renameVersion) {
            _categories = _categories.Select(category => category.Identity == $"user:{rename.OldName}"
                ? new CategoryBase(rename.NewName) : category).ToList();
            _renameVersion = rename.Version;
        }
    }

    private void Change(int index, string? identity) {
        if (Available.FirstOrDefault(category => category.Identity == identity) is { } category) {
            _categories[index] = category;
        }
    }

    private void Add(ChangeEventArgs args) {
        if (Available.FirstOrDefault(category => category.Identity == args.Value?.ToString()) is { } category
            && !_categories.Any(existing => existing.Identity == category.Identity)) {
            _categories.Add(category);
        }
    }

    private Task Apply() {
        bool any = string.IsNullOrWhiteSpace(_maximum);
        int maximum = 0;
        if (!int.TryParse(_minimum, out int minimum) || minimum < 0
            || (!any && (!int.TryParse(_maximum, out maximum) || maximum < minimum))) {
            _error = "Enter valid minimum and maximum counts.";
            return Task.CompletedTask;
        }
        return OnApply.InvokeAsync(ComboCategory.SameCard(_categories, minimum, maximum,
            any ? RequirementMaximumMode.HandSize : RequirementMaximumMode.Fixed));
    }
}
