@using YGOProbabilityCalculatorBlazor.Services.Interface

@if (Certificate is { } certificate) {
    <details class="search-availability small mt-2">
        <summary>@(certificate.Status == SearchAvailabilityStatus.Exact ? "" : UiText.Get("Ui.DeckSearchAvailability"))@SearchAvailabilityPresentation.Summary(certificate)</summary>
        <p class="mb-1 mt-2">@certificate.Detail</p>
        <p class="text-body-secondary mb-1">@(UiText.Get("Ui.BoundscertifyonlyDecksearchtargetsurvivalunderthefixedmodeleddrawremovalpolicynotfullgameplayoroptimalplayProbabilityrangesareavailableoneachresult"))</p>
    </details>
}

@code {
    [Parameter] public SearchAvailabilityCertificate? Certificate { get; set; }
}
