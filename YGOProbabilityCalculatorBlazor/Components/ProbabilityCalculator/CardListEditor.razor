@using YGOProbabilityCalculatorBlazor.Models

<div class="mb-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
        <h4 class="mb-0">Deck (@ActiveCopies)</h4>
        <button class="btn btn-outline-secondary btn-sm"
                type="button"
                aria-label="Sort deck A–Z"
                title="Sort deck A–Z"
                @onclick="OnSortAlphabetically">
            Sort A–Z
        </button>
    </div>
    <div class="accordion" id="cardsAccordion">
        @for (var index = 0; index < Cards.Count; index++) {
            <CardEditor @key="editorKeys[Cards[index]]"
                Index="index"
                Card="Cards[index]"
                CategoryBases="availableCategories"
                CategoryColorIndices="CategoryColorIndices"
                CategoryRename="CategoryRename"
                ActiveCardIndex="ActiveCardIndex"
                ActiveCardIndexChanged="ActiveCardIndexChanged"
                OnReplaceCard="ReplaceCard"
                OnRemoveCard="OnRemoveCard"
                Count="Cards.Count"
                OnMove="OnMoveCard"
            />
        }
    </div>

    <div class="mt-3">
        <button class="btn btn-primary" @onclick="() => OnAddNewCard.InvokeAsync()">Add New Card</button>
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<Card> Cards { get; set; } = [];
    [Parameter] public IReadOnlyList<CategoryBase> CategoryBases { get; set; } = [];
    [Parameter] public IReadOnlyList<Combo> Combos { get; set; } = [];
    [Parameter] public IReadOnlyDictionary<string, int> CategoryColorIndices { get; set; } = new Dictionary<string, int>(StringComparer.Ordinal);
    [Parameter] public CategoryRenameNotice? CategoryRename { get; set; }

    [Parameter] public int ActiveCardIndex { get; set; } = -1;
    [Parameter] public EventCallback<int> ActiveCardIndexChanged { get; set; }

    [Parameter] public EventCallback<(int Index, Card NewCard)> OnReplaceCard { get; set; }
    [Parameter] public EventCallback<int> OnRemoveCard { get; set; }
    [Parameter] public EventCallback OnAddNewCard { get; set; }
    [Parameter] public EventCallback<(int From, int To)> OnMoveCard { get; set; }
    [Parameter] public EventCallback OnSortAlphabetically { get; set; }

    private readonly EditorKeys<Card> editorKeys = new();
    private IReadOnlyList<CategoryBase> availableCategories = [];
    private long ActiveCopies => Cards.Where(card => card.Active).Sum(card => (long)card.Copies);

    protected override void OnParametersSet() {
        editorKeys.Synchronize(Cards);
        availableCategories = CategoryCatalog.Build(CategoryBases, Cards, Combos);
    }

    private Task ReplaceCard((int Index, Card NewCard) payload) {
        editorKeys.Replace(Cards[payload.Index], payload.NewCard);
        return OnReplaceCard.InvokeAsync(payload);
    }
}
