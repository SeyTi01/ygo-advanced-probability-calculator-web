@using YGOProbabilityCalculatorBlazor.Models
@using YGOProbabilityCalculatorBlazor.Components.Shared
@implements IHandleEvent

<div class="mb-4">
    <div class="deck-header d-flex flex-wrap align-items-center justify-content-between mb-3">
        <h4 class="mb-0">Deck (@ActiveCopies)</h4>
        <div class="deck-loading-status">
            <SessionLoadingStatus RequestVersion="LoadingSessionVersion" />
        </div>
        <button class="btn btn-outline-secondary btn-sm"
                type="button"
                aria-label="Sort deck A–Z"
                title="Sort deck A–Z"
                @onclick="OnSortAlphabetically">
            Sort A–Z
        </button>
    </div>
    <CardQuickAdd @key="ResetVersion" OnAdd="OnAddCard" />
    <div class="accordion" id="cardsAccordion">
        @for (int index = 0; index < Cards.Count; index++) {
            <CardEditor @key="_editorKeys[Cards[index]]"
                Index="index"
                Card="Cards[index]" Deck="Cards"
                DrawEffectsEnabled="DrawEffectsEnabled"
                CategoryBases="_categoryOptions.All"
                RelevantMetadataCategoryIdentities="_categoryOptions.RelevantMetadataIdentities"
                CategoryColorIndices="CategoryColorIndices"
                CategoryRename="CategoryRename"
                ActiveCardIndex="ActiveCardIndex"
                ActiveCardIndexChanged="ActiveCardIndexChanged"
                OnReplaceCard="ReplaceCard"
                OnRenameCard="NameChangeHandler"
                OnNameEditFinished="OnNameEditFinished"
                OnRemoveCard="OnRemoveCard"
                OnDuplicateCard="OnDuplicateCard"
                Count="Cards.Count"
                OnMove="OnMoveCard"
            />
        }
    </div>


</div>

@code {
    [Parameter] public IReadOnlyList<Card> Cards { get; set; } = [];
    [Parameter] public IReadOnlyList<CategoryBase> CategoryBases { get; set; } = [];
    [Parameter] public IReadOnlyList<Combo> Combos { get; set; } = [];
    [Parameter] public bool DrawEffectsEnabled { get; set; } = true;
    [Parameter] public bool DeferNameEditRendering { get; set; }
    [Parameter] public long? LoadingSessionVersion { get; set; }
    [Parameter] public IReadOnlyDictionary<string, int> CategoryColorIndices { get; set; } = new Dictionary<string, int>(StringComparer.Ordinal);
    [Parameter] public CategoryRenameNotice? CategoryRename { get; set; }

    [Parameter] public int ActiveCardIndex { get; set; } = -1;
    [Parameter] public EventCallback<int> ActiveCardIndexChanged { get; set; }

    [Parameter] public EventCallback<(int Index, Card NewCard)> OnReplaceCard { get; set; }
    [Parameter] public Func<(int Index, Card NewCard), Task>? OnRenameCard { get; set; }
    [Parameter] public EventCallback OnNameEditFinished { get; set; }
    [Parameter] public EventCallback<int> OnRemoveCard { get; set; }
    [Parameter] public EventCallback<Card> OnAddCard { get; set; }
    [Parameter] public EventCallback<int> OnDuplicateCard { get; set; }
    [Parameter] public int ResetVersion { get; set; }
    [Parameter] public EventCallback<(int From, int To)> OnMoveCard { get; set; }
    [Parameter] public EventCallback OnSortAlphabetically { get; set; }

    private readonly EditorKeys<Card> _editorKeys = new();
    private CategoryCatalogOptions _categoryOptions = CategoryCatalogOptions.Empty;
    private bool _skipParameterRender;
    private long? _loadingSessionVersion;
    private Func<(int Index, Card NewCard), Task>? NameChangeHandler => OnRenameCard is null ? null : RenameCard;

    // These callbacks forward edits to the owning calculator, which renders
    // the updated list. A second render here rebuilds the same editor tree.
    Task IHandleEvent.HandleEventAsync(EventCallbackWorkItem callback, object? arg) => callback.InvokeAsync(arg);

    private long ActiveCopies => Cards.Where(card => card.Active).Sum(card => (long)card.Copies);

    protected override void OnParametersSet() {
        _skipParameterRender = DeferNameEditRendering && LoadingSessionVersion == _loadingSessionVersion;
        _loadingSessionVersion = LoadingSessionVersion;
        _editorKeys.Synchronize(Cards);

        CategoryCatalogOptions options = CategoryCatalog.BuildOptions(CategoryBases, Cards, Combos);

        // Name edits do not change selector choices. Retain their references so
        // unchanged rows can skip rendering their (also collapsed) editor bodies.
        if (!_categoryOptions.All.Select(category => (category.Identity, category.Name, category.Rule?.Signature))
                .SequenceEqual(options.All.Select(category => (category.Identity, category.Name, category.Rule?.Signature)))
            || !_categoryOptions.RelevantMetadataIdentities.SetEquals(options.RelevantMetadataIdentities)) {
            _categoryOptions = options;
        }
    }

    protected override bool ShouldRender() {
        bool render = !_skipParameterRender;
        _skipParameterRender = false;

        return render;
    }

    public Task ReplaceCard((int Index, Card NewCard) payload) {
        _editorKeys.Replace(Cards[payload.Index], payload.NewCard);

        return OnReplaceCard.InvokeAsync(payload);
    }

    private Task RenameCard((int Index, Card NewCard) payload) {
        _editorKeys.Replace(Cards[payload.Index], payload.NewCard);

        return OnRenameCard?.Invoke(payload) ?? Task.CompletedTask;
    }
}
