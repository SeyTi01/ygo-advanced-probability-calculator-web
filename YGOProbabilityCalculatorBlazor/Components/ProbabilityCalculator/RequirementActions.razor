@if (AllowedOperators.Contains("OR")) {
    <button type="button" class="btn btn-sm btn-outline-secondary" data-action="alternative" aria-describedby="@(_hintId + "-or")" data-operator-hint="@(_hintId + "-or")" @onclick="OnAddAlternative">@(UiText.Get("Ui.AddOR"))</button>
    <OperatorHint Id="@(_hintId + "-or")" Operator="OR" />
}
@if (AllowedOperators.Contains("AND")) {
    <button type="button" class="btn btn-sm btn-outline-secondary" data-action="property" aria-describedby="@(_hintId + "-and")" data-operator-hint="@(_hintId + "-and")" @onclick="OnAddProperty">@(UiText.Get("Ui.AddAND"))</button>
    <OperatorHint Id="@(_hintId + "-and")" Operator="AND" />
}
<button type="button" class="btn btn-sm btn-outline-danger" aria-label="@(UiText.Get("Ui.RemoveRequirement"))"
        @onclick="OnRemove">@(UiText.Get("Ui.Remove"))</button>

@code {
    private readonly string _hintId = $"operator-hint-{Guid.NewGuid():N}";
    [Parameter] public IReadOnlyList<string> AllowedOperators { get; set; } = ["AND", "OR"];
    [Parameter] public EventCallback OnAddAlternative { get; set; }
    [Parameter] public EventCallback OnAddProperty { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }
}
