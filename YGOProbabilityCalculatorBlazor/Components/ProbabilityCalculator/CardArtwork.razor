@using YGOProbabilityCalculatorBlazor.Services.Interface
@using YGOProbabilityCalculatorBlazor.Services.DeckImport
@using Microsoft.JSInterop
@using Microsoft.Extensions.DependencyInjection
@implements IAsyncDisposable
@inject IServiceProvider Services
@inject IJSRuntime JS

<span @ref="_footprint" class="card-artwork @(Thumbnail ? "card-artwork-thumbnail" : "card-artwork-preview")">
    @if (_url is not null) {
        <img src="@_url" alt="@(Thumbnail ? string.Empty : $"Card artwork for {Name}")"
             width="268" height="391" decoding="async" />
    }
    else {
        <svg viewBox="0 0 24 35" aria-hidden="true" focusable="false">
            <rect x="3" y="3" width="18" height="29" rx="1" fill="none" stroke="currentColor" />
            <path d="M6 8h12v12H6zm0 16h12m-12 3h8" fill="none" stroke="currentColor" />
        </svg>
    }
</span>

@code {
    [Parameter] public string CardId { get; set; } = string.Empty;
    [Parameter] public int ExternalCardId { get; set; }
    [Parameter] public string Name { get; set; } = string.Empty;
    [Parameter] public bool Thumbnail { get; set; }

    private ElementReference _footprint;
    private IJSObjectReference? _module;
    private Task<IJSObjectReference>? _moduleTask;
    private DotNetObjectReference<CardArtwork>? _bridge;
    private int? _registration;
    private (string, int) _identity;
    private int _version;
    private bool _disposed;
    private bool _changed;
    private string? _url;

    protected override void OnParametersSet() {
        if (_identity == (CardId, ExternalCardId)) {
            return;
        }

        _identity = (CardId, ExternalCardId);
        _version++;
        _url = null;
        _changed = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (_disposed || (!firstRender && !_changed)) {
            return;
        }

        int currentVersion = _version;
        _changed = false;

        if (_module is null && ExternalCardId <= 0) {
            return;
        }

        _module ??= await (_moduleTask ??= JS.InvokeAsync<IJSObjectReference>("import", "./js/card-artwork.mjs").AsTask());

        if (_module is null || _disposed || currentVersion != _version) {
            return;
        }

        if (_registration is int previousRegistrationId) {
            await _module.InvokeVoidAsync("unobserve", previousRegistrationId);
        }

        _registration = null;

        if (ExternalCardId <= 0) {
            return;
        }

        _bridge ??= DotNetObjectReference.Create(this);
        int registrationId = await _module.InvokeAsync<int>("observe", _footprint, _bridge, ExternalCardId, currentVersion);

        if (_disposed || currentVersion != _version) {
            await _module.InvokeVoidAsync("unobserve", registrationId);
        }
        else {
            _registration = registrationId;
        }
    }

    [JSInvokable]
    public async Task<ArtworkResolution> ResolveArtwork(int requestVersion) {
        if (_disposed || requestVersion != _version) {
            return new(null, null);
        }

        int externalId = ExternalCardId;

        try {
            return new(await Services.GetRequiredService<ICardArtworkService>().GetArtworkUrlAsync(externalId), null);
        }
        catch (CardArtworkLookupException exception) {
            return new(null, Math.Max(0, exception.RetryAfter.TotalMilliseconds));
        }
        catch {
            return new(null, 60000);
        }
    }

    [JSInvokable]
    public Task ArtworkReady(int requestVersion, string? source) => InvokeAsync(() => {
        if (_disposed || requestVersion != _version) {
            return;
        }

        // Only our numeric retained-image route is a display source, including mocks.
        bool isAllowedArtworkSource = source is not null
            && Uri.TryCreate(source, UriKind.Absolute, out Uri? uri)
            && uri.GetLeftPart(UriPartial.Authority) == CardArtworkService.ArtworkOrigin
            && System.Text.RegularExpressions.Regex.IsMatch(uri.PathAndQuery, @"^/small/[1-9]\d{0,9}\.jpg$");

        _url = isAllowedArtworkSource ? source : null;
        StateHasChanged();
    });

    public async ValueTask DisposeAsync() {
        if (_disposed) {
            return;
        }

        _disposed = true;
        _version++;

        try {
            if (_moduleTask is not null) {
                _module ??= await _moduleTask;
            }

            if (_module is not null && _registration is int registrationId) {
                await _module.InvokeVoidAsync("unobserve", registrationId);
            }

            if (_module is not null) {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) {
        }
        finally {
            _bridge?.Dispose();
        }
    }

    public sealed record ArtworkResolution(string? Url, double? RetryAfter);
}
