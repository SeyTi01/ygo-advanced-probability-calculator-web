@using YGOProbabilityCalculatorBlazor.Services.Interface
@using YGOProbabilityCalculatorBlazor.Services.DeckImport
@using Microsoft.JSInterop
@using Microsoft.Extensions.DependencyInjection
@implements IAsyncDisposable
@inject IServiceProvider Services
@inject IJSRuntime JS

<span @ref="footprint" class="card-artwork @(Thumbnail ? "card-artwork-thumbnail" : "card-artwork-preview")">
    @if (url is not null) {
        <img src="@url" alt="@(Thumbnail ? string.Empty : $"Card artwork for {Name}")"
             width="268" height="391" decoding="async" />
    }
    else {
        <svg viewBox="0 0 24 35" aria-hidden="true" focusable="false">
            <rect x="3" y="3" width="18" height="29" rx="1" fill="none" stroke="currentColor" />
            <path d="M6 8h12v12H6zm0 16h12m-12 3h8" fill="none" stroke="currentColor" />
        </svg>
    }
</span>

@code {
    [Parameter] public string CardId { get; set; } = string.Empty;
    [Parameter] public int ExternalCardId { get; set; }
    [Parameter] public string Name { get; set; } = string.Empty;
    [Parameter] public bool Thumbnail { get; set; }
    private ElementReference footprint;
    private IJSObjectReference? module;
    private Task<IJSObjectReference>? moduleTask;
    private DotNetObjectReference<CardArtwork>? bridge;
    private int? registration;
    private (string, int) identity;
    private int version;
    private bool disposed, changed;
    private string? url;

    protected override void OnParametersSet() {
        if (identity == (CardId, ExternalCardId)) return;
        identity = (CardId, ExternalCardId);
        version++; url = null; changed = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (disposed || (!firstRender && !changed)) return;
        var currentVersion = version;
        changed = false;
        if (module is null && ExternalCardId <= 0) return;
        module ??= await (moduleTask ??= JS.InvokeAsync<IJSObjectReference>("import", "./js/card-artwork.mjs").AsTask());
        if (module is null || disposed || currentVersion != version) return;
        if (registration is { } old) await module.InvokeVoidAsync("unobserve", old);
        registration = null;
        if (ExternalCardId <= 0) return;
        bridge ??= DotNetObjectReference.Create(this);
        var id = await module.InvokeAsync<int>("observe", footprint, bridge, ExternalCardId, currentVersion);
        if (disposed || currentVersion != version) await module.InvokeVoidAsync("unobserve", id);
        else registration = id;
    }

    [JSInvokable]
    public async Task<ArtworkResolution> ResolveArtwork(int requestVersion) {
        if (disposed || requestVersion != version) return new(null, null);
        var externalId = ExternalCardId;
        try { return new(await Services.GetRequiredService<ICardArtworkService>().GetArtworkUrlAsync(externalId), null); }
        catch (CardArtworkLookupException ex) { return new(null, Math.Max(0, ex.RetryAfter.TotalMilliseconds)); }
        catch { return new(null, 60000); }
    }

    [JSInvokable]
    public Task ArtworkReady(int requestVersion, string? source) => InvokeAsync(() => {
        if (disposed || requestVersion != version) return;
        // Only our numeric retained-image route is a display source, including mocks.
        url = source is not null && Uri.TryCreate(source, UriKind.Absolute, out var uri) &&
            uri.GetLeftPart(UriPartial.Authority) == CardArtworkService.ArtworkOrigin &&
            System.Text.RegularExpressions.Regex.IsMatch(uri.PathAndQuery, @"^/small/[1-9]\d{0,9}\.jpg$") ? source : null;
        StateHasChanged();
    });

    public async ValueTask DisposeAsync() {
        if (disposed) return;
        disposed = true; version++;
        try {
            if (moduleTask is not null) module ??= await moduleTask;
            if (module is not null && registration is { } id) await module.InvokeVoidAsync("unobserve", id);
            if (module is not null) await module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        finally { bridge?.Dispose(); }
    }
    public sealed record ArtworkResolution(string? Url, double? RetryAfter);
}
