@using YGOProbabilityCalculatorBlazor.Services.Interface
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="calculation-settings-menu" @onkeydown="HandleKeyDown" @onkeydown:stopPropagation="true">
    <button @ref="_trigger"
            type="button"
            class="btn btn-outline-secondary calculation-settings-trigger"
            aria-label="Calculation settings"
            title="Calculation settings"
            aria-haspopup="dialog"
            aria-expanded="@(_isOpen ? "true" : "false")"
            aria-controls="calculationSettingsPanel"
            @onclick="ToggleMenu">
        <span aria-hidden="true">⚙</span>
    </button>

    <section @ref="_panel" id="calculationSettingsPanel"
             class="calculation-settings-panel"
             role="dialog"
             aria-labelledby="calculationSettingsHeading"
             hidden="@(!_isOpen)">
        <h2 id="calculationSettingsHeading" class="h6 fw-bold text-center mb-3">Calculation settings</h2>

        <section aria-labelledby="drawSimulationHeading">
            <h3 id="drawSimulationHeading" class="small fw-semibold mb-2">Draw simulation</h3>
            <label class="form-label mb-1" for="calculationModel">Calculation model</label>
            <select @ref="_drawEffectsInput" id="calculationModel" class="form-select"
                    value="@Model" aria-describedby="drawEffectsHelp" @onchange="OnModelChanged">
                <option value="Configured">Draw effects with costs/requirements (default)</option>
                <option value="Simplified">Draw effects without costs/requirements</option>
                <option value="OpeningHand">Ignore draw effects (opening hand only)</option>
            </select>
            <p id="drawEffectsHelp" class="form-text mb-0" role="note">@ModelHelp</p>
        </section>

        <div class="border-top mt-3 pt-3 calculation-settings-option">
            <label class="form-label mb-1" for="storageSafetyTier">Storage safety limit</label>
            <select id="storageSafetyTier"
                    class="form-select"
                    value="@StorageTier"
                    aria-describedby="storageSafetyHelp"
                    @onchange="OnStorageTierChanged">
                <option value="Standard">Standard (32,768 entries / 262,144 cells)</option>
                <option value="High">High (65,536 entries / 524,288 cells)</option>
                <option value="VeryHigh">Very high (131,072 entries / 1,048,576 cells)</option>
            </select>
            <p id="storageSafetyHelp" class="form-text mb-0">
                Limits apply per calculation structure, not to total browser memory. Higher limits may allow more complex exact calculations to complete and can use substantially more browser memory; they do not change probability accuracy.
            </p>
        </div>
    </section>
</div>

@code {
    [Parameter]
    public CalculationModel Model { get; set; } = CalculationModel.Configured;

    [Parameter]
    public EventCallback<CalculationModel> ModelChanged { get; set; }

    [Parameter]
    public CalculationStorageTier StorageTier { get; set; } = CalculationStorageTier.Standard;

    [Parameter]
    public EventCallback<CalculationStorageTier> StorageTierChanged { get; set; }

    private bool _isOpen;
    private bool _focusDrawEffectsAfterRender;
    private bool _focusTriggerAfterRender;
    private ElementReference _trigger;
    private ElementReference _panel;
    private DotNetObjectReference<CalculationSettingsMenu>? _reference;
    private ElementReference _drawEffectsInput;
    private string ModelHelp => Model switch {
        CalculationModel.Configured => "Applies supported draws, once-per-turn limits, pre-draw costs, post-draw removals and filters.",
        CalculationModel.OpeningHand => "Draws are ignored; configured draw cards still occupy hand slots. Card settings are preserved.",
        _ => "Hypothetical: ignores both pre-draw costs and post-draw removals. Cost-dependent cards such as Trade-In may draw unconditionally, giving misleading, often optimistic deck-building probabilities."
    };

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (_focusDrawEffectsAfterRender) {
            _focusDrawEffectsAfterRender = false;
            await _drawEffectsInput.FocusAsync();
            _reference ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("workspaceMenus.watchOutside", _panel, _trigger, _reference);
        }
        else if (_focusTriggerAfterRender) {
            _focusTriggerAfterRender = false;
            await JS.InvokeVoidAsync("workspaceMenus.dispose", _panel);
            await _trigger.FocusAsync();
        }
    }

    [JSInvokable]
    public async Task Dismiss() {
        _isOpen = false;
        _focusDrawEffectsAfterRender = false;
        _focusTriggerAfterRender = false;
        await JS.InvokeVoidAsync("workspaceMenus.dispose", _panel);
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync() {
        try {
            await JS.InvokeVoidAsync("workspaceMenus.dispose", _panel);
        }
        catch (Exception exception) when (exception is JSDisconnectedException or OperationCanceledException) {
        }
        _reference?.Dispose();
    }

    private Task ToggleMenu() {
        _isOpen = !_isOpen;
        _focusDrawEffectsAfterRender = _isOpen;
        _focusTriggerAfterRender = !_isOpen;
        return Task.CompletedTask;
    }

    public Task Open() {
        _isOpen = true;
        _focusDrawEffectsAfterRender = true;
        return InvokeAsync(StateHasChanged);
    }

    private Task HandleKeyDown(KeyboardEventArgs eventArgs) {
        if (!_isOpen || eventArgs.Key != "Escape") {
            return Task.CompletedTask;
        }

        _isOpen = false;
        _focusTriggerAfterRender = true;
        return Task.CompletedTask;
    }

    private Task OnModelChanged(ChangeEventArgs eventArgs) {
        if (!Enum.TryParse(eventArgs.Value?.ToString(), out CalculationModel model) || !Enum.IsDefined(model)) {
            return Task.CompletedTask;
        }

        return ModelChanged.InvokeAsync(model);
    }

    private Task OnStorageTierChanged(ChangeEventArgs eventArgs) {
        if (!Enum.TryParse(eventArgs.Value?.ToString(), ignoreCase: false, out CalculationStorageTier tier) ||
            !Enum.IsDefined(tier)) {
            return Task.CompletedTask;
        }

        return StorageTierChanged.InvokeAsync(tier);
    }
}
