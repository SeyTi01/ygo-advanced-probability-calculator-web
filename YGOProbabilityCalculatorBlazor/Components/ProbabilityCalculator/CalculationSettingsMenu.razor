@inject YGOProbabilityCalculatorBlazor.Services.Interface.ICardInfoService CardInfoService
@using YGOProbabilityCalculatorBlazor.Services.Interface
@using Microsoft.JSInterop
@using YGOProbabilityCalculatorBlazor.Models
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="calculation-settings-menu" @onkeydown="HandleKeyDown" @onkeydown:stopPropagation="true">
    <button @ref="_trigger"
            type="button"
            class="btn btn-outline-secondary calculation-settings-trigger"
            aria-label="@(UiText.Get("Ui.CalculationSettings"))"
            title="@(UiText.Get("Ui.CalculationSettings"))"
            aria-haspopup="dialog"
            aria-expanded="@(_isOpen ? "true" : "false")"
            aria-controls="calculationSettingsPanel"
            @onclick="ToggleMenu">
        <span aria-hidden="true">⚙</span>
    </button>

    <section @ref="_panel" id="calculationSettingsPanel"
             class="calculation-settings-panel"
             role="dialog"
             aria-labelledby="calculationSettingsHeading"
             hidden="@(!_isOpen)">
        <h2 id="calculationSettingsHeading" class="h6 fw-bold text-center mb-3">@(UiText.Get("Ui.CalculationSettings"))</h2>

        <section aria-labelledby="drawSimulationHeading">
            <h3 id="drawSimulationHeading" class="small fw-semibold mb-2">@(UiText.Get("Ui.CardSimulation"))</h3>
            <label class="form-label mb-1" for="calculationModel">@(UiText.Get("Ui.CalculationModel"))</label>
            <select @ref="_drawEffectsInput" id="calculationModel" class="form-select"
                    value="@(Model == CalculationModel.Fast && Strategy == FastExecutionStrategy.FastOnly ? "FastOnly" : Model.ToString())" aria-describedby="@(Model == CalculationModel.OpeningHand ? null : "drawEffectsHelp")" @onchange="OnModelChanged">
                <option value="OpeningHand">@(UiText.Get("Ui.NoEffectSimulation"))</option>
                <option value="Fast">@(UiText.Get("Ui.Progressivedefault"))</option>
                <option value="FastOnly">@(UiText.Get("Ui.FastOnly"))</option>
                <option value="Exact">@(UiText.Get("Ui.ExactOnly"))</option>
            </select>
            @if (Model != CalculationModel.OpeningHand) {
                <p id="drawEffectsHelp" class="form-text mb-0" role="note">@ModelHelp</p>
            }
            <div class="mt-3">
                <label class="form-label mb-1" for="drawActivationPriority">@(UiText.Get("Ui.DrawActivationPriority"))</label>
                <select id="drawActivationPriority" class="form-select" value="@Priority.Mode" @onchange="OnPriorityModeChanged">
                    <option value="EncounterOrder">@(UiText.Get("Ui.Encounterorderdefault"))</option>
                    <option value="CustomPriority">@(UiText.Get("Ui.CustomPriority"))</option>
                </select>
                @if (Priority.Mode == DrawActivationMode.CustomPriority) {
                    @if (_entries.Length == 0) {
                        <p class="form-text mb-0">@(UiText.Get("Ui.NoDrawEffectsConfigured"))</p>
                    }
                    @foreach (bool searchPhase in new[] { false, true }) {
                        Card[] entries = _entries.Where(card => (card.Search is not null) == searchPhase).ToArray();
                        if (entries.Length == 0) {
                            continue;
                        }

                        string heading = searchPhase ? "searchPriorityHeading" : "drawPriorityHeading";
                        <h4 id="@heading" class="small fw-semibold mt-2">@UiText.Get(searchPhase ? "Priority.SearchEffects" : "Priority.DrawEffects")</h4>
                        <ol class="draw-priority-list" aria-labelledby="@heading">
                            @for (int i = 0; i < entries.Length; i++) {
                                Card entry = entries[i];
                                int index = i;
                                string label = EntryLabel(entry);
                                <li @key="entry.Id" data-priority-id="@entry.Id" tabindex="-1" @ref="_entryElements[entry.Id]">
                                    <span class="draw-priority-name">
                                        @label
                                    </span>
                                    <button type="button" class="btn btn-outline-secondary" disabled="@(i == 0)"
                                            aria-label="@(UiText.Format("Move.Up", label))" title="@(UiText.Get("Ui.MoveUp"))" @onclick="() => MovePriority(entries, index, -1)">↑</button>
                                    <button type="button" class="btn btn-outline-secondary" disabled="@(i == entries.Length - 1)"
                                            aria-label="@(UiText.Format("Move.Down", label))" title="@(UiText.Get("Ui.MoveDown"))" @onclick="() => MovePriority(entries, index, 1)">↓</button>
                                    <MoveToPosition Index="index" Count="entries.Length" ItemLabel="@label" OnMove="move => MovePriorityTo(entries, move)" />
                                </li>
                            }
                        </ol>
                    }
                    <details class="small mt-2">
                        <summary>@(UiText.Get("Ui.AboutPriority"))</summary>
                        <p class="form-text mb-0">@(UiText.Get("Ui.ChoosesTheHighestLegalEffectAfterEachCompletedResolutionIncludingNewlyDrawnEffects"))</p>
                    </details>
                }
            </div>
        </section>

        <div class="border-top mt-3 pt-3 calculation-settings-option">
            <label class="form-label mb-1" for="storageSafetyTier">@(UiText.Get("Ui.StorageSafetyLimit"))</label>
            <select id="storageSafetyTier"
                    class="form-select"
                    value="@StorageTier"
                    aria-describedby="storageSafetyHelp"
                    @onchange="OnStorageTierChanged">
                <option value="Standard">@(UiText.Get("Ui.Standard32768entries262144cells"))</option>
                <option value="High">@(UiText.Get("Ui.High65536entries524288cells"))</option>
                <option value="VeryHigh">@(UiText.Get("Ui.Veryhigh131072entries1048576cells"))</option>
            </select>
            <p id="storageSafetyHelp" class="form-text mb-0">@(UiText.Get("Ui.Higherlimitsmayallowmorecomplexexactcalculationstocompleteandcanusesubstantiallymorebrowsermemorytheydonotchangeprobabilityaccuracy"))</p>
        </div>
    </section>
</div>

@code {
    [Parameter]
    public CalculationModel Model { get; set; } = CalculationModel.Fast;

    [Parameter]
    public EventCallback<CalculationModel> ModelChanged { get; set; }

    [Parameter]
    public CalculationStorageTier StorageTier { get; set; } = CalculationStorageTier.Standard;

    [Parameter]
    public EventCallback<CalculationStorageTier> StorageTierChanged { get; set; }

    [Parameter]
    public DrawActivationPriority Priority { get; set; } = DrawActivationPriority.Default;

    [Parameter]
    public EventCallback<DrawActivationPriority> PriorityChanged { get; set; }

    [Parameter]
    public IReadOnlyList<Card> Cards { get; set; } = [];

    [Parameter] public FastExecutionStrategy Strategy { get; set; }
    [Parameter] public EventCallback<FastExecutionStrategy> StrategyChanged { get; set; }

    private Card[] _entries = [];
    private readonly Dictionary<string, ElementReference> _entryElements = new(StringComparer.Ordinal);
    private string? _focusPriorityId;

    protected override void OnParametersSet() {
        Dictionary<string, int> ranks = Priority.CardIds.Select((id, index) => (id, index))
            .ToDictionary(entry => entry.id, entry => entry.index, StringComparer.Ordinal);
        _entries = Cards.Where(card => card.HasEffect && card.Active && card.Copies > 0 && card.SimulationEnabled)
            .OrderBy(card => ranks.GetValueOrDefault(card.Id, int.MaxValue))
            .ThenBy(card => card.Id, StringComparer.Ordinal).ToArray();
        HashSet<string> visible = _entries.Select(card => card.Id).ToHashSet(StringComparer.Ordinal);
        foreach (string removed in _entryElements.Keys.Where(id => !visible.Contains(id)).ToArray()) {
            _entryElements.Remove(removed);
        }
    }

    private string EntryLabel(Card entry) {
        string label = DisplayLabels.Card(entry, CardInfoService);
        string name = string.IsNullOrWhiteSpace(label) ? UiText.Get("Ui.UnnamedCard") : label;
        Card[] sameName = Cards.Where(card => DisplayLabels.Card(card, CardInfoService) == label)
            .OrderBy(card => card.Id, StringComparer.Ordinal).ToArray();
        if (sameName.Length > 1) {
            name = UiText.Format("Ui.0Entry1", name, Array.IndexOf(sameName, entry) + 1);
        }
        return name;
    }

    private Task OnPriorityModeChanged(ChangeEventArgs eventArgs) {
        if (!Enum.TryParse(eventArgs.Value?.ToString(), out DrawActivationMode mode) || !Enum.IsDefined(mode)) {
            return Task.CompletedTask;
        }
        return PriorityChanged.InvokeAsync(new DrawActivationPriority(mode, Priority.CardIds));
    }

    private Task MovePriority(Card[] entries, int index, int offset) {
        _focusPriorityId = entries[index].Id;
        return MovePriorityTo(entries, (index, index + offset));
    }

    private Task MovePriorityTo(Card[] entries, (int From, int To) move) {
        List<string> ids = entries.Select(card => card.Id).ToList();
        if (!ListMove.TryMove(ids, move.From, move.To)) {
            return Task.CompletedTask;
        }
        // Reorder only active slots so dormant effects keep their authored position.
        HashSet<string> visible = ids.ToHashSet(StringComparer.Ordinal);
        int next = 0;
        string[] ordered = Priority.ForWorkspace(Cards).CardIds
            .Select(id => visible.Contains(id) ? ids[next++] : id).ToArray();
        return PriorityChanged.InvokeAsync(new DrawActivationPriority(Priority.Mode, ordered));
    }

    private bool _isOpen;
    private bool _focusDrawEffectsAfterRender;
    private bool _focusTriggerAfterRender;
    private ElementReference _trigger;
    private ElementReference _panel;
    private DotNetObjectReference<CalculationSettingsMenu>? _reference;
    private ElementReference _drawEffectsInput;
    private string? ModelHelp => Model switch {
        CalculationModel.Fast => Strategy == FastExecutionStrategy.FastOnly
            ? UiText.Get("Ui.CalculatesProbabilitiesQuicklyButResultsMayBeApproximate")
            : UiText.Get("Ui.ShowsFastFirstThenAttemptsExact"),
        CalculationModel.Exact => UiText.Get("Ui.CalculatesPhysicalDeckSearchSurvivalExactlyWithoutAWorkCutoffSubjectToStorageLimitsAndCa"),
        CalculationModel.OpeningHand => null,
        _ => throw new ArgumentOutOfRangeException(nameof(Model))
    };

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (_focusPriorityId is { } id && _entryElements.TryGetValue(id, out ElementReference element)) {
            _focusPriorityId = null;
            await element.FocusAsync();
        }
        if (_focusDrawEffectsAfterRender) {
            _focusDrawEffectsAfterRender = false;
            await _drawEffectsInput.FocusAsync();
            _reference ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("workspaceMenus.watchOutside", _panel, _trigger, _reference);
        }
        else if (_focusTriggerAfterRender) {
            _focusTriggerAfterRender = false;
            await JS.InvokeVoidAsync("workspaceMenus.dispose", _panel);
            await _trigger.FocusAsync();
        }
    }

    [JSInvokable]
    public async Task Dismiss() {
        _isOpen = false;
        _focusDrawEffectsAfterRender = false;
        _focusTriggerAfterRender = false;
        await JS.InvokeVoidAsync("workspaceMenus.dispose", _panel);
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync() {
        try {
            await JS.InvokeVoidAsync("workspaceMenus.dispose", _panel);
        }
        catch (Exception exception) when (exception is JSDisconnectedException or OperationCanceledException) {
        }
        _reference?.Dispose();
    }

    private Task ToggleMenu() {
        _isOpen = !_isOpen;
        _focusDrawEffectsAfterRender = _isOpen;
        _focusTriggerAfterRender = !_isOpen;
        return Task.CompletedTask;
    }

    public Task Open() {
        _isOpen = true;
        _focusDrawEffectsAfterRender = true;
        return InvokeAsync(StateHasChanged);
    }

    private Task HandleKeyDown(KeyboardEventArgs eventArgs) {
        if (!_isOpen || eventArgs.Key != "Escape") {
            return Task.CompletedTask;
        }

        _isOpen = false;
        _focusTriggerAfterRender = true;
        return Task.CompletedTask;
    }

    private async Task OnModelChanged(ChangeEventArgs eventArgs) {
        string? selection = eventArgs.Value?.ToString();
        if (selection == "FastOnly") {
            await ModelChanged.InvokeAsync(CalculationModel.Fast);
            await StrategyChanged.InvokeAsync(FastExecutionStrategy.FastOnly);
            return;
        }
        if (!Enum.TryParse(eventArgs.Value?.ToString(), out CalculationModel model) || !Enum.IsDefined(model)) {
            return;
        }

        await ModelChanged.InvokeAsync(model);
        await StrategyChanged.InvokeAsync(FastExecutionStrategy.Progressive);
    }

    private Task OnStorageTierChanged(ChangeEventArgs eventArgs) {
        if (!Enum.TryParse(eventArgs.Value?.ToString(), ignoreCase: false, out CalculationStorageTier tier) ||
            !Enum.IsDefined(tier)) {
            return Task.CompletedTask;
        }

        return StorageTierChanged.InvokeAsync(tier);
    }
}
