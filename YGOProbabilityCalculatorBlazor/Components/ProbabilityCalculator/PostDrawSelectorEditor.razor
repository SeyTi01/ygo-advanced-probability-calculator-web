@using YGOProbabilityCalculatorBlazor.Models
@using YGOProbabilityCalculatorBlazor.Services.DeckImport

<div class="mt-2">
    @if (HasVerifiedPredicate(Selector)) {
        <div class="small" role="note">@DrawEffectPresentation.DescribeSelector(Selector, CategoryBases)</div>
        <button type="button" class="btn btn-link btn-sm p-0" @onclick="Clear">@(Selector.Kind == CardSelectorKind.Not && Selector.Children[0].Kind == CardSelectorKind.Any ? UiText.Get("Ui.ReplaceEmptyFilter") : UiText.Get("Ui.ReplaceVerifiedFilter"))</button>
    }
    else if (!Grouped || Selector.Kind == CardSelectorKind.Any) {
        <RequirementPropertyPicker Id="@Id" Label="@(UiText.Get("Ui.Eligible"))" AccessibleLabel="@(UiText.Get("Ui.Eligible"))" AllowAny="true" Categories="Available"
            RelevantIdentities="_categoryOptions.RelevantMetadataIdentities" OnChanged="AddProperty" />
    }
    @if (Grouped && Selector.Kind != CardSelectorKind.Any && !HasVerifiedPredicate(Selector)) {
        <button type="button" class="btn btn-link btn-sm p-0" @onclick="Clear">@(UiText.Get("Ui.Anycardclearfilter"))</button>
    }
    @if (Selector.Kind != CardSelectorKind.Any && !HasVerifiedPredicate(Selector)) {
        <div class="mt-2" aria-label="@(UiText.Get("Ui.GroupedEligibilityFilter"))">
            <SelectorExpressionEditor Path="@Id" Selector="Selector" Available="GroupedAvailable" CategoryColorIndices="CategoryColorIndices"
                                      RelevantMetadataIdentities="_categoryOptions.RelevantMetadataIdentities" CategoryRename="CategoryRename" OnEditingChanged="OnEditingChanged"
                                      OnChanged="PublishGrouped" OnRemove="Clear" OnValidation="Validate" />
        </div>
    }
    @if (_error is not null) { <div class="text-danger small" role="alert">@_error</div> }
    @if (ShowHelp) {
        <div class="form-text">@UiText.Format("Effect.UnavailableWithConfiguredDraws", UnavailableMessage)</div>
    }
</div>

@code {
    [Parameter] public bool ShowHelp { get; set; } = true;
    [Parameter] public string UnavailableMessage { get; set; } = UiText.Get("Ui.IfUnavailableFailBranch");
    [Parameter] public string Id { get; set; } = "removalSelector";
    [Parameter] public CardSelector Selector { get; set; } = CardSelector.Any;
    [Parameter] public IReadOnlyList<CategoryBase> CategoryBases { get; set; } = [];
    [Parameter] public IReadOnlySet<string> RelevantMetadataCategoryIdentities { get; set; } = new HashSet<string>(StringComparer.Ordinal);
    [Parameter] public IReadOnlyDictionary<string, int> CategoryColorIndices { get; set; } = new Dictionary<string, int>(StringComparer.Ordinal);
    [Parameter] public EventCallback<CardSelector> OnChanged { get; set; }
    [Parameter] public EventCallback<string?> OnError { get; set; }
    [Parameter] public CategoryRenameNotice? CategoryRename { get; set; }
    [Parameter] public EventCallback<bool> OnEditingChanged { get; set; }

    private readonly Dictionary<CardSelector, string> _validationErrors = [];
    private string? _error;
    private static bool HasVerifiedPredicate(CardSelector selector) => selector.Kind is CardSelectorKind.Objective or CardSelectorKind.Not
        || selector.Children.Any(HasVerifiedPredicate);

    private bool Grouped => Selector.IsGrouped;

    private Task Clear() => PublishGrouped(CardSelector.Any);

    private async Task PublishGrouped(CardSelector selector) {
        _error = null;
        foreach (CardSelector invalid in _validationErrors.Keys.Where(invalid => !Contains(selector, invalid)).ToArray()) {
            _validationErrors.Remove(invalid);
        }
        await OnChanged.InvokeAsync(selector);
        await OnError.InvokeAsync(_validationErrors.Values.FirstOrDefault());
    }

    private Task Validate((CardSelector Selector, string? Message) validation) {
        if (validation.Message is null) { _validationErrors.Remove(validation.Selector); }
        else { _validationErrors[validation.Selector] = validation.Message; }
        return OnError.InvokeAsync(_validationErrors.Values.FirstOrDefault());
    }

    private static bool Contains(CardSelector root, CardSelector value) => root.Equals(value)
        || root.Children.Any(child => Contains(child, value));

    private CardSelector[] Alternatives => Selector.Kind == CardSelectorKind.Any ? [] : Selector.Kind == CardSelectorKind.AnyOf ? Selector.AuthoredTerms.ToArray() : [Selector];

    private CategoryCatalogOptions _categoryOptions = CategoryCatalogOptions.Empty;

    private CategoryBase[] Available => _categoryOptions.All.Concat(CuratedDrawEffectPresets.FilterProperties)
        .DistinctBy(static category => category.Identity).ToArray();

    private CategoryBase[] GroupedAvailable => Available
        .Concat(Selector.CategoryIdentities.Where(identity => identity.StartsWith("metadata:", StringComparison.Ordinal))
            .Select(identity => new CategoryBase(MetadataFallbackLabel(identity), CategorySource.Metadata, identity[9..])))
        .DistinctBy(static category => category.Identity).ToArray();

    private static string MetadataFallbackLabel(string identity) => System.Globalization.CultureInfo.InvariantCulture.TextInfo
        .ToTitleCase(Uri.UnescapeDataString(identity[(identity.LastIndexOf(':') + 1)..]));

    private Task AddProperty(RequirementPropertyPicker.Change change) {
        if (change.Value == "any") { return Clear(); }
        if (change.Error is not null || change.Category is null) { return Task.CompletedTask; }
        CardSelector added = NumericPropertyRange.SelectorFor(change.Category);
        return Apply(() => Selector.Kind == CardSelectorKind.Any ? added : CardSelector.AnyOfSelectors([.. Alternatives, added]));
    }

    private async Task Apply(Func<CardSelector> create) {
        try {
            await PublishGrouped(create());
        }
        catch (ArgumentException) {
            _error = UiText.Get("Ui.FilterIsTooLargeOrTooDeeplyGrouped");
        }
    }

    protected override void OnParametersSet() =>
        _categoryOptions = CategoryCatalog.BuildOptions(CategoryBases, [], [], RelevantMetadataCategoryIdentities);
}
