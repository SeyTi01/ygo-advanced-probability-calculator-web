@using YGOProbabilityCalculatorBlazor.Models
@using YGOProbabilityCalculatorBlazor.Services.DeckImport

<div class="mt-2">
    @if (HasVerifiedPredicate(Selector)) {
        <div class="small" role="note">@DrawEffectPresentation.DescribeSelector(Selector, CategoryBases)</div>
        <button type="button" class="btn btn-link btn-sm p-0" @onclick="Clear">@(Selector.Kind == CardSelectorKind.Not && Selector.Children[0].Kind == CardSelectorKind.Any ? "Replace empty filter" : "Replace verified filter")</button>
    }
    else if (!Grouped || Selector.Kind == CardSelectorKind.Any) {
        <label for="@Id" class="form-label mb-1">Eligible</label>
        <select id="@Id" class="form-select form-select-sm" value="" @onchange="Change">
            <option value="">@(Selector.Kind == CardSelectorKind.Any ? "Any card" : "Add OR category/property…")</option>
            @if (Selector.Kind != CardSelectorKind.Any) {
                <option value="any">Any card (clear filter)</option>
            }
            <option value="level-at-least">Level >=</option>
            @if (Available.Any(static category => category.Source == CategorySource.User)) {
                <optgroup label="User categories">
                    @foreach (CategoryBase category in Available.Where(static category => category.Source == CategorySource.User)) {
                        <option value="@category.Identity">@category.Name</option>
                    }
                </optgroup>
            }
            @if (RelevantMetadata.Length > 0) {
                <optgroup label="Relevant properties">
                    @foreach (CategoryBase category in RelevantMetadata) {
                        <option value="@category.Identity">@category.Name</option>
                    }
                </optgroup>
            }
            @if (RemainingCommonMetadata.Length > 0) {
                <optgroup label="Common properties">
                    @foreach (CategoryBase category in RemainingCommonMetadata) {
                        <option value="@category.Identity">@category.Name</option>
                    }
                </optgroup>
            }
        </select>
    }
    @if (Selector.Kind != CardSelectorKind.Any && Grouped && !HasVerifiedPredicate(Selector)) {
        <div class="form-label mb-1">Eligible</div>
        <div class="mt-2" aria-label="Grouped eligibility filter">
            <SelectorExpressionEditor @ref="_expressionEditor" Selector="Selector" Available="GroupedAvailable" CategoryColorIndices="CategoryColorIndices"
                                      CategoryRename="CategoryRename" OnEditingChanged="OnEditingChanged"
                                      Options="GroupedOptions" OnChanged="PublishGrouped" OnRemove="Clear" OnValidation="Validate" />
        </div>
    }
    else if (Selector.Kind != CardSelectorKind.Any && !HasVerifiedPredicate(Selector)) {
        <div class="d-flex flex-wrap align-items-center gap-1 mt-2" aria-label="Removal filter">
            @for (int index = 0; index < Alternatives.Length; index++) {
                int branch = index;
                CardSelector alternative = Alternatives[index];
                @if (index > 0) { <ExpressionSeparator Operator="OR" OnOperatorChanged="operation => BeginGroupOperator(Selector, operation)" /> }
                <div class="d-inline-flex flex-wrap align-items-center gap-1 border rounded p-1" style="max-width:100%">
                    @{ string[] identities = OrderedIdentities(alternative); }
                    @for (int conjunct = 0; conjunct < identities.Length; conjunct++) {
                        string identity = identities[conjunct];
                        string label = Label(identity);
                        @if (conjunct > 0) { <ExpressionSeparator Operator="AND" OnOperatorChanged="operation => BeginGroupOperator(alternative, operation)" /> }
                        <span class="badge category-tag draw-selector-chip text-wrap d-inline-flex align-items-center @ChipCssClass(identity)">
                            <span>@label</span>
                            <ChipRemoveButton Class="category-remove-button ms-1"
                                    aria-label="@($"Remove eligibility {label}")" title="@($"Remove eligibility {label}")"
                                    OnClick="() => Remove(branch, identity)" />
                        </span>
                    }
                    <select class="form-select form-select-sm" style="width:auto;max-width:100%" aria-label="Add AND eligibility to alternative @(index + 1)"
                            value="" @onchange="e => AddAnd(branch, e.Value?.ToString())">
                        <option value="">Add AND…</option>
                        @foreach (CategoryBase category in Available) {
                            <option value="@category.Identity">@category.Name</option>
                        }
                    </select>
                </div>
            }
        </div>
    }
    @if (Selector.Kind != CardSelectorKind.Any && !Grouped) {
        <button type="button" class="btn btn-link btn-sm p-0 mt-1" @onclick="() => _grouped = true">Edit groups</button>
    }
    @if (_error is not null) { <div class="text-danger small" role="alert">@_error</div> }
    @if (ShowHelp) {
        <div class="form-text">@UnavailableMessage Applied only with configured draw effects.</div>
    }
</div>

@code {
    [Parameter] public bool ShowHelp { get; set; } = true;
    [Parameter] public string UnavailableMessage { get; set; } = "If unavailable: fail branch.";
    [Parameter] public string Id { get; set; } = "removalSelector";
    [Parameter] public CardSelector Selector { get; set; } = CardSelector.Any;
    [Parameter] public IReadOnlyList<CategoryBase> CategoryBases { get; set; } = [];
    [Parameter] public IReadOnlySet<string> RelevantMetadataCategoryIdentities { get; set; } = new HashSet<string>(StringComparer.Ordinal);
    [Parameter] public IReadOnlyDictionary<string, int> CategoryColorIndices { get; set; } = new Dictionary<string, int>(StringComparer.Ordinal);
    [Parameter] public EventCallback<CardSelector> OnChanged { get; set; }
    [Parameter] public EventCallback<string?> OnError { get; set; }
    [Parameter] public CategoryRenameNotice? CategoryRename { get; set; }
    [Parameter] public EventCallback<bool> OnEditingChanged { get; set; }

    private readonly Dictionary<CardSelector, string> _validationErrors = [];
    private bool _grouped;
    private SelectorExpressionEditor? _expressionEditor;
    private (CardSelector Target, string Operation)? _pendingGroupOperator;
    private string? _error;
    private static bool HasVerifiedPredicate(CardSelector selector) => selector.Kind is CardSelectorKind.Objective or CardSelectorKind.Not
        || selector.Children.Any(HasVerifiedPredicate);

    private void BeginGroupOperator(CardSelector target, string operation) {
        _grouped = true;
        _pendingGroupOperator = (target, operation);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (_pendingGroupOperator is { } pending && _expressionEditor is not null) {
            _pendingGroupOperator = null;
            await _expressionEditor.EditGroupOperatorAsync(pending.Target, pending.Operation);
        }
    }

    private bool Grouped => _grouped || Selector.IsGrouped;

    private RenderFragment GroupedOptions => @<text>
        <option value="level-at-least">Level >=</option>
        @foreach (IGrouping<string, CategoryBase> group in GroupedAvailable.GroupBy(category => category.Source == CategorySource.User
            ? "User categories" : _categoryOptions.RelevantMetadataIdentities.Contains(category.Identity) ? "Relevant properties" : "Common properties")) {
            <optgroup label="@group.Key">
                @foreach (CategoryBase category in group) { <option value="@category.Identity">@GroupOptionLabel(category)</option> }
            </optgroup>
        }
    </text>;

    private static string GroupOptionLabel(CategoryBase category) {
        int colon = category.Name.IndexOf(':');
        return category.Source == CategorySource.Metadata && colon > 0 ? category.Name[(colon + 1)..].Trim() : category.Name;
    }

    private Task Clear() => PublishGrouped(CardSelector.Any);

    private async Task PublishGrouped(CardSelector selector) {
        _error = null;
        foreach (CardSelector invalid in _validationErrors.Keys.Where(invalid => !Contains(selector, invalid)).ToArray()) {
            _validationErrors.Remove(invalid);
        }
        await OnChanged.InvokeAsync(selector);
        await OnError.InvokeAsync(_validationErrors.Values.FirstOrDefault());
    }

    private Task Validate((CardSelector Selector, string? Message) validation) {
        if (validation.Message is null) { _validationErrors.Remove(validation.Selector); }
        else { _validationErrors[validation.Selector] = validation.Message; }
        return OnError.InvokeAsync(_validationErrors.Values.FirstOrDefault());
    }

    private static bool Contains(CardSelector root, CardSelector value) => root.Equals(value)
        || root.Children.Any(child => Contains(child, value));

    private CardSelector[] Alternatives => Selector.Kind == CardSelectorKind.Any ? [] : Selector.Kind == CardSelectorKind.AnyOf ? Selector.AuthoredTerms.ToArray() : [Selector];

    private CategoryCatalogOptions _categoryOptions = CategoryCatalogOptions.Empty;

    private CategoryBase[] Available => _categoryOptions.All.Concat(CuratedDrawEffectPresets.FilterProperties)
        .DistinctBy(static category => category.Identity).ToArray();

    private CategoryBase[] GroupedAvailable => Available
        .Concat(Selector.CategoryIdentities.Where(identity => identity.StartsWith("metadata:", StringComparison.Ordinal))
            .Select(identity => new CategoryBase(MetadataFallbackLabel(identity), CategorySource.Metadata, identity[9..])))
        .DistinctBy(static category => category.Identity).ToArray();

    private static string MetadataFallbackLabel(string identity) => System.Globalization.CultureInfo.InvariantCulture.TextInfo
        .ToTitleCase(Uri.UnescapeDataString(identity[(identity.LastIndexOf(':') + 1)..]));

    private CategoryBase[] RelevantMetadata => Available
        .Where(category => category.Source == CategorySource.Metadata
            && (!CategoryCatalog.IsCommonMetadata(category) || _categoryOptions.RelevantMetadataIdentities.Contains(category.Identity)))
        .ToArray();

    private CategoryBase[] RemainingCommonMetadata => Available
        .Where(category => CategoryCatalog.IsCommonMetadata(category)
            && !_categoryOptions.RelevantMetadataIdentities.Contains(category.Identity))
        .ToArray();

    private string Label(string identity) {
        CategoryBase? category = Available.FirstOrDefault(candidate => candidate.Identity == identity);
        if (category is not null) {
            return category.Name;
        }

        if (identity.StartsWith("user:", StringComparison.Ordinal)) {
            return identity["user:".Length..];
        }

        return identity.StartsWith("metadata:", StringComparison.Ordinal)
            ? Uri.UnescapeDataString(identity["metadata:".Length..])
            : identity;
    }

    private string ChipCssClass(string identity) => Available.FirstOrDefault(category => category.Identity == identity) is { } category
        ? CategoryChipPalette.GetCssClass(category, CategoryColorIndices)
        : CategoryChipPalette.GetFallbackCssClass(identity);

    private Task Change(ChangeEventArgs args) {
        string? identity = args.Value?.ToString();
        if (identity == "any") {
            return Clear();
        }
        if (identity == "level-at-least") {
            _grouped = true;
            return Apply(() => Selector.Kind == CardSelectorKind.Any ? CardSelector.LevelAtLeast(5)
                : CardSelector.AnyOfSelectors([Selector, CardSelector.LevelAtLeast(5)]));
        }
        if (!Available.Any(category => category.Identity == identity)) {
            return Task.CompletedTask;
        }
        return Apply(() => CardSelector.AnyOfSelectors(Alternatives.Append(new CardSelector(CardSelectorKind.Category, [identity!]))));
    }

    private async Task Apply(Func<CardSelector> create) {
        try {
            await PublishGrouped(create());
        }
        catch (ArgumentException) {
            _error = "Filter is too large or too deeply grouped.";
        }
    }

    private static string[] OrderedIdentities(CardSelector selector) => selector.AuthoredTerms.SelectMany(term => term.CategoryIdentities).ToArray();

    private Task AddAnd(int branch, string? identity) {
        if (!Available.Any(category => category.Identity == identity)) {
            return Task.CompletedTask;
        }
        return Apply(() => {
            CardSelector[] alternatives = Alternatives;
            alternatives[branch] = CardSelector.AllOf(OrderedIdentities(alternatives[branch]).Append(identity!));
            return CardSelector.AnyOfSelectors(alternatives);
        });
    }

    private Task Remove(int branch, string identity) {
        List<CardSelector> alternatives = Alternatives.ToList();
        string[] remaining = OrderedIdentities(alternatives[branch]).Where(category => category != identity).ToArray();
        if (remaining.Length == 0) {
            alternatives.RemoveAt(branch);
        }
        else {
            alternatives[branch] = CardSelector.AllOf(remaining);
        }
        return PublishGrouped(alternatives.Count == 0 ? CardSelector.Any : CardSelector.AnyOfSelectors(alternatives));
    }

    protected override void OnParametersSet() =>
        _categoryOptions = CategoryCatalog.BuildOptions(CategoryBases, [], [], RelevantMetadataCategoryIdentities);
}
