<div class="expression-separator @(Operator == "OR" ? "alternative-separator" : "requirement-and-separator") @(Inline ? "expression-inline-separator" : "") @(Symbol == "+" ? "expression-copy-separator" : "")" role="@(OnAdd.HasDelegate ? null : OnOperatorChanged.HasDelegate ? "group" : "separator")" aria-label="@(OnAdd.HasDelegate ? null : Label)">
    @if (OnAdd.HasDelegate) {
        <button type="button" class="expression-add-button @AddButtonClass control-focus-ring" aria-label="@InputLabel" title="@InputLabel"
                aria-expanded="@(AddExpanded?.ToString().ToLowerInvariant())" @ref="_control" @onclick="OnAdd">@(Symbol ?? Operator)</button>
    }
    else if (OnOperatorChanged.HasDelegate) {
        <select id="@InputId" class="expression-operator control-focus-ring" @ref="_control" aria-invalid="@(Error is not null ? "true" : null)" aria-label="@(InputLabel ?? UiText.Format("Ui.Change0Operator", Symbol ?? Operator))" @bind:get="Symbol ?? Operator" @bind:set="Change">
            @foreach (string choice in AllowedOperators) {
                <option value="@choice">@choice</option>
            }
        </select>
    }
    else {
        <span aria-hidden="true">@(Symbol ?? Operator)</span>
    }
    @if (Error is not null) { <small class="expression-operator-error text-danger" role="alert">@Error</small> }
</div>

@code {
    [Parameter] public string Operator { get; set; } = "AND";
    [Parameter] public string? Symbol { get; set; }
    [Parameter] public bool Inline { get; set; }
    [Parameter] public string? AccessibleLabel { get; set; }
    [Parameter] public string? InputId { get; set; }
    [Parameter] public string? InputLabel { get; set; }
    [Parameter] public string? AddButtonClass { get; set; }
    [Parameter] public bool? AddExpanded { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public IReadOnlyList<string> AllowedOperators { get; set; } = ["AND", "OR"];
    [Parameter] public EventCallback<string> OnOperatorChanged { get; set; }
    [Parameter] public EventCallback OnAdd { get; set; }
    private ElementReference _control;
    public ValueTask FocusAsync() => _control.FocusAsync(preventScroll: true);
    private string Label => AccessibleLabel ?? ((Symbol ?? Operator) switch {
        "+" => UiText.Get("Ui.SeparateCardRequirements"),
        "OR" => UiText.Get("Ui.ORAnyAlternative"),
        _ => UiText.Get("Ui.ANDSameCardProperties")
    });
    private Task Change(string value) => AllowedOperators.Contains(value)
        ? OnOperatorChanged.InvokeAsync(value) : Task.CompletedTask;
}
