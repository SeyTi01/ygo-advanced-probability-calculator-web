@using YGOProbabilityCalculatorBlazor.Models
@using YGOProbabilityCalculatorBlazor.Components.Shared

<div class="mb-4">
    <h4>Categories</h4>
    <div class="row">
        <div class="col-4">
            <input @bind="newCategoryName"
                   @bind:event="oninput"
                   @onkeyup="@(async e => {
                                 if (e.Key == "Enter") await AddCategoryBase();
                             })"
                   class="form-control"
                   aria-label="Category name"
                   placeholder="Category name"/>
        </div>
        <div class="col-2">
            <button class="btn btn-primary" @onclick="AddCategoryBase">Add Category</button>
        </div>
    </div>

    @if (categoryError is not null) {
        <div class="mt-2 category-validation-alert">
            <DismissibleAlert Message="@categoryError" OnDismiss="@(() => categoryError = null)"/>
        </div>
    }

    <div class="mt-2">
        @foreach (var category in CategoryBases) {
            <span class="badge me-2 category-chip category-tag @CategoryColorPalette.GetCssClass(category.Name, CategoryColorIndices)">
                @if (ReferenceEquals(editingCategory, category)) {
                    <input @ref="renameInputReference"
                           class="form-control form-control-sm category-rename-input"
                           aria-label="@($"New name for category {category.Name}")"
                           @bind="editingCategoryName"
                           @bind:event="oninput"
                           @onkeydown="HandleRenameKeyDown"/>
                    <button type="button" class="category-icon-button"
                            aria-label="Save category name"
                            title="Save category name"
                            @onclick="SaveCategoryName">
                        <svg class="category-action-icon" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2.5"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                    </button>
                    <button type="button" class="category-icon-button"
                            aria-label="Cancel category rename"
                            title="Cancel category rename"
                            @onclick="CancelCategoryRename">
                        <svg class="category-action-icon" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2.5"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M19 12H5m0 0 7-7m-7 7 7 7"></path>
                        </svg>
                    </button>
                }
                else {
                    <button @ref="categoryNameButtonReferences[category.Name]"
                            type="button"
                            class="category-name-trigger"
                            aria-label="@($"Rename category {category.Name}")"
                            title="Rename category"
                            @onclick="() => BeginCategoryRename(category)">@category.Name</button>
                }
                <button type="button" class="btn-close category-delete-button"
                        aria-label="@($"Remove category {category.Name}")"
                        title="@($"Remove category {category.Name}")"
                        @onclick="() => RemoveCategoryBase(category)"></button>
            </span>
        }
    </div>
</div>

@code {

    [Parameter] public required List<CategoryBase> CategoryBases { get; set; }
    [Parameter] public IReadOnlyDictionary<string, int> CategoryColorIndices { get; set; } = new Dictionary<string, int>(StringComparer.Ordinal);
    [Parameter] public required IEnumerable<Card> Cards { get; set; } = [];
    [Parameter] public required IEnumerable<Combo> Combos { get; set; } = [];

    [Parameter] public EventCallback OnCategoriesChanged { get; set; }
    [Parameter] public EventCallback<(CategoryBase OldCategory, CategoryBase NewCategory)> OnRenameCategory { get; set; }

    private string? newCategoryName;
    private string? categoryError;
    private CategoryBase? editingCategory;
    private string? editingCategoryName;
    private ElementReference renameInputReference;
    private readonly Dictionary<string, ElementReference> categoryNameButtonReferences = new(StringComparer.Ordinal);
    private bool focusRenameInput;
    private string? pendingCategoryNameFocus;

    private async Task AddCategoryBase() {
        if (string.IsNullOrWhiteSpace(newCategoryName)) {
            categoryError = "Category name cannot be empty.";
            return;
        }

        try {
            if (CategoryBases.Any(c => c.Name.Equals(newCategoryName, StringComparison.OrdinalIgnoreCase))) {
                categoryError = "A category with this name already exists.";
                return;
            }

            var categoryBase = new CategoryBase(newCategoryName);
            CategoryBases.Add(categoryBase);

            newCategoryName = string.Empty;
            categoryError = null;
            await OnCategoriesChanged.InvokeAsync();
        }
        catch (ArgumentException ex) {
            categoryError = ex.Message;
        }
    }

    private async Task RemoveCategoryBase(CategoryBase category) {
        var usedInCombos = Combos.Any(c => c.Categories.Any(cc => cc.BaseCategory == category));
        var usedInCards = Cards.Any(c => c.Categories.Contains(category));
        if (usedInCombos || usedInCards) {
            categoryError = "This category is still used by a card or combo.";
            return;
        }
        CategoryBases.Remove(category);
        if (ReferenceEquals(editingCategory, category)) CancelCategoryRename();
        categoryError = null;
        await OnCategoriesChanged.InvokeAsync();
    }

    private void BeginCategoryRename(CategoryBase category) {
        editingCategory = category;
        editingCategoryName = category.Name;
        categoryError = null;
        pendingCategoryNameFocus = null;
        focusRenameInput = true;
    }

    private void CancelCategoryRename() {
        pendingCategoryNameFocus = editingCategory?.Name;
        ClearCategoryRename();
    }

    private void ClearCategoryRename() {
        editingCategory = null;
        editingCategoryName = null;
        categoryError = null;
    }

    private async Task SaveCategoryName() {
        if (editingCategory is null) return;

        if (string.IsNullOrWhiteSpace(editingCategoryName)) {
            categoryError = "Category name cannot be empty.";
            return;
        }

        if (CategoryBases.Any(c => !ReferenceEquals(c, editingCategory) &&
                                   c.Name.Equals(editingCategoryName, StringComparison.OrdinalIgnoreCase))) {
            categoryError = "A category with this name already exists.";
            return;
        }

        var oldCategory = editingCategory;
        var newCategory = new CategoryBase(editingCategoryName);
        await OnRenameCategory.InvokeAsync((oldCategory, newCategory));
        pendingCategoryNameFocus = newCategory.Name;
        ClearCategoryRename();
        await OnCategoriesChanged.InvokeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (focusRenameInput) {
            focusRenameInput = false;
            await renameInputReference.FocusAsync();
            return;
        }

        if (pendingCategoryNameFocus is { } name && categoryNameButtonReferences.TryGetValue(name, out var button)) {
            pendingCategoryNameFocus = null;
            await button.FocusAsync();
        }
    }

    private Task HandleRenameKeyDown(KeyboardEventArgs e) {
        if (e.Key == "Enter") return SaveCategoryName();
        if (e.Key == "Escape") CancelCategoryRename();
        return Task.CompletedTask;
    }
}
