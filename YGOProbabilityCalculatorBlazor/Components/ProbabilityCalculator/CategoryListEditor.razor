@using YGOProbabilityCalculatorBlazor.Models
@using YGOProbabilityCalculatorBlazor.Components.Shared

<div class="mb-4">
    <div class="editor-add-row">
        <div class="editor-select-field">
            <input @bind="_newCategoryName"
                   @bind:event="oninput"
                   @onkeyup="@(async e => {
                                 if (e.Key == "Enter") {
                                     await AddCategoryBase();
                                 }
                             })"
                   class="form-control"
                   aria-label="Category name"
                   placeholder="Category name"/>
        </div>
        <div class="editor-add-action">
            <button class="btn btn-primary" disabled="@string.IsNullOrWhiteSpace(_newCategoryName)" @onclick="AddCategoryBase">Add</button>
        </div>
    </div>

    @if (_categoryError is not null) {
        <div class="mt-2 category-validation-alert">
            <DismissibleAlert Message="@_categoryError" OnDismiss="@(() => _categoryError = null)"/>
        </div>
    }

    <div class="mt-2">
        @for (int index = 0; index < CategoryBases.Count; index++) {
            CategoryBase category = CategoryBases[index];
            if (category.Source != CategorySource.User) {
                continue;
            }

            <span @key="category" class="badge me-2 category-chip category-tag @CategoryColorPalette.GetCssClass(category.Name, CategoryColorIndices)">
                @if (ReferenceEquals(_editingCategory, category)) {
                    <input @ref="_renameInputReference"
                           class="form-control form-control-sm category-rename-input"
                           aria-label="@($"New name for category {category.Name}")"
                           @bind="_editingCategoryName"
                           @bind:event="oninput"
                           @onkeydown="HandleRenameKeyDown"/>
                    <button type="button" class="category-icon-button"
                            aria-label="Save category name"
                            title="Save category name"
                            @onclick="SaveCategoryName">
                        <svg class="category-action-icon" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2.5"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                    </button>
                    <ReorderControls Horizontal="true" Index="index" Count="CategoryBases.Count" ItemLabel="@($"category {category.Name}")" OnMove="OnMoveCategory" />
                    <button type="button" class="category-icon-button"
                            aria-label="Cancel category edit"
                            title="Cancel category edit"
                            @onclick="CancelCategoryRename">
                        <svg class="category-action-icon" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2.5"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="m6 6 12 12M6 18 18 6"></path>
                        </svg>
                    </button>
                    <button type="button" class="category-name-trigger category-rule-trigger" aria-label="@(category.Rule is null ? "Define by properties" : "Edit rule")" @onclick="() => OpenRule(category)">
                        @(category.Rule is null ? "Define by properties" : "Edit rule")
                    </button>
                    <button type="button" class="category-icon-button category-color-picker-trigger"
                            aria-label="@($"Choose color for category {category.Name}")"
                            title="@($"Choose color for category {category.Name}")"
                            aria-expanded="@(_colorPickerExpanded ? "true" : "false")"
                            aria-controls="@($"categoryColorPalette{index}")"
                            @onclick="ToggleColorPicker">
                        <span class="category-color-trigger-swatch @CategoryColorPalette.GetCssClass(category.Name, CategoryColorIndices)" aria-hidden="true"></span>
                    </button>
                }
                else {
                    <button @ref="_categoryNameButtonReferences[category.Name]"
                            type="button"
                            class="category-name-trigger"
                            aria-label="@($"Edit category {category.Name}")"
                            title="@($"Edit category {category.Name}")"
                            @onclick="() => BeginCategoryRename(category)">@category.Name</button>
                }
                <ChipRemoveButton Class="category-delete-button"
                        aria-label="@($"Remove category {category.Name}")"
                        title="@($"Delete category {category.Name}")"
                        OnClick="() => RemoveCategoryBase(category)" />
            </span>
            @if ((ReferenceEquals(_editingCategory, category) || ReferenceEquals(_ruleCategory, category)) && category.Rule is not null) {
                <CategoryRuleSummary Category="category" CategoryBases="CategoryBases" />
            }
            @if (ReferenceEquals(_editingCategory, category) && _colorPickerExpanded) {
                <div id="categoryColorPalette@(index)" class="category-color-palette mt-2" role="group"
                     aria-label="@($"Choose a color for category {category.Name}")">
                    @foreach (CategoryColorOption color in CategoryColorPalette.Options) {
                        bool isSelected = SelectedColorIndex(category) == color.Index;
                        <button type="button" class="category-color-swatch @color.CssClass"
                                aria-label="@($"Set {category.Name} color to {color.Name}")"
                                title="@($"Set {category.Name} color to {color.Name}")"
                                aria-pressed="@(isSelected ? "true" : "false")"
                                @onclick="() => ChangeCategoryColor(category, color.Index)">
                            @if (isSelected) {
                                <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                                    <path d="m3 8 3.1 3.1L13 4.6"></path>
                                </svg>
                            }
                        </button>
                    }
                </div>
            }
        }
    </div>
    @if (_ruleCategory is not null) {
        <CategoryRuleEditor @key="_ruleCategory" Category="_ruleCategory" Cards="Cards" CategoryBases="CategoryBases"
                            OnApply="ApplyRule" OnCancel="CloseRule" />
    }
</div>

@code {

    [Parameter] public required List<CategoryBase> CategoryBases { get; set; }
    [Parameter] public IReadOnlyDictionary<string, int> CategoryColorIndices { get; set; } = new Dictionary<string, int>(StringComparer.Ordinal);
    [Parameter] public required IEnumerable<Card> Cards { get; set; } = [];
    [Parameter] public required IEnumerable<Combo> Combos { get; set; } = [];

    [Parameter] public EventCallback OnCategoriesChanged { get; set; }
    [Parameter] public EventCallback<(string CategoryName, int ColorIndex)> OnCategoryColorChanged { get; set; }
    [Parameter] public EventCallback<(int From, int To)> OnMoveCategory { get; set; }
    [Parameter] public EventCallback<(CategoryBase OldCategory, CategoryBase NewCategory)> OnRenameCategory { get; set; }

    [Parameter] public EventCallback<(CategoryBase Category, CardSelector? Rule)> OnRuleChanged { get; set; }

    private CategoryBase? _ruleCategory;
    private string? _ruleRenameDraft;
    private string? _ruleCategoryName;

    private void OpenRule(CategoryBase category) {
        _ruleRenameDraft = _editingCategoryName != category.Name ? _editingCategoryName : null;
        _ruleCategoryName = category.Name;
        _ruleCategory = category;
        ClearCategoryRename();
    }

    private Task CloseRule() {
        _pendingCategoryNameFocus = _ruleCategoryName;
        _ruleCategory = null;
        if (_ruleRenameDraft is not null) {
            _editingCategory = CategoryBases.FirstOrDefault(category => category.Name == _ruleCategoryName);
            _editingCategoryName = _ruleRenameDraft;
            _focusRenameInput = _editingCategory is not null;
            _pendingCategoryNameFocus = null;
        }
        _ruleRenameDraft = null;
        _ruleCategoryName = null;
        return Task.CompletedTask;
    }

    private async Task ApplyRule(CardSelector? rule) {
        if (_ruleCategory is null) {
            return;
        }
        await OnRuleChanged.InvokeAsync((_ruleCategory, rule));
        await CloseRule();
    }

    protected override void OnParametersSet() {
        if (_ruleCategory is not null && !CategoryBases.Any(category => ReferenceEquals(category, _ruleCategory))) {
            _ruleCategory = null;
        }
    }

    private string? _newCategoryName;
    private string? _categoryError;
    private CategoryBase? _editingCategory;
    private string? _editingCategoryName;
    private ElementReference _renameInputReference;
    private readonly Dictionary<string, ElementReference> _categoryNameButtonReferences = new(StringComparer.Ordinal);
    private bool _focusRenameInput;
    private string? _pendingCategoryNameFocus;
    private bool _colorPickerExpanded;

    private int SelectedColorIndex(CategoryBase category) =>
        CategoryColorIndices.TryGetValue(category.Name, out int colorIndex) && CategoryColorPalette.IsValidIndex(colorIndex)
            ? colorIndex
            : 0;

    private void ToggleColorPicker() => _colorPickerExpanded = !_colorPickerExpanded;

    private Task ChangeCategoryColor(CategoryBase category, int colorIndex) {
        if (category.Source != CategorySource.User || !CategoryColorPalette.IsValidIndex(colorIndex)) {
            return Task.CompletedTask;
        }

        _colorPickerExpanded = false;

        return OnCategoryColorChanged.InvokeAsync((category.Name, colorIndex));
    }

    private async Task AddCategoryBase() {
        if (string.IsNullOrWhiteSpace(_newCategoryName)) {
            _categoryError = "Category name cannot be empty.";

            return;
        }

        try {
            bool hasDuplicateName = CategoryBases.Any(category =>
                category.Source == CategorySource.User
                && category.Name.Equals(_newCategoryName, StringComparison.OrdinalIgnoreCase));

            if (hasDuplicateName) {
                _categoryError = "A category with this name already exists.";

                return;
            }

            CategoryBase categoryBase = new(_newCategoryName);
            CategoryBases.Add(categoryBase);

            _newCategoryName = string.Empty;
            _categoryError = null;
            await OnCategoriesChanged.InvokeAsync();
        }
        catch (ArgumentException exception) {
            _categoryError = exception.Message;
        }
    }

    private async Task RemoveCategoryBase(CategoryBase category) {
        bool isUsedInCombo = Combos.Any(combo => combo.AllCategories.Any(constraint => constraint.Selector.CategoryIdentities.Contains(category.Identity)));
        bool isUsedOnCard = Cards.Any(card => card.Categories.Any(cardCategory => cardCategory.Identity == category.Identity)
            || card.PreDrawSelector.CategoryIdentities.Contains(category.Identity)
            || (card.Search?.Selector.CategoryIdentities.Contains(category.Identity) ?? false)
            || card.PostDrawSelector.CategoryIdentities.Contains(category.Identity));

        if (isUsedInCombo || isUsedOnCard) {
            _categoryError = "This category is still used by a card or combo.";

            return;
        }

        CategoryBases.Remove(category);

        if (ReferenceEquals(_editingCategory, category)) {
            CancelCategoryRename();
        }

        _categoryError = null;
        await OnCategoriesChanged.InvokeAsync();
    }

    private void BeginCategoryRename(CategoryBase category) {
        _ruleCategory = null;
        _editingCategory = category;
        _editingCategoryName = category.Name;
        _colorPickerExpanded = false;
        _categoryError = null;
        _pendingCategoryNameFocus = null;
        _focusRenameInput = true;
    }

    private void CancelCategoryRename() {
        _pendingCategoryNameFocus = _editingCategory?.Name;
        _colorPickerExpanded = false;
        ClearCategoryRename();
    }

    private void ClearCategoryRename() {
        _editingCategory = null;
        _editingCategoryName = null;
        _colorPickerExpanded = false;
        _categoryError = null;
    }

    private async Task SaveCategoryName() {
        if (_editingCategory is null) {
            return;
        }

        if (string.IsNullOrWhiteSpace(_editingCategoryName)) {
            _categoryError = "Category name cannot be empty.";

            return;
        }

        bool hasDuplicateName = CategoryBases.Any(category =>
            category.Source == CategorySource.User
            && !ReferenceEquals(category, _editingCategory)
            && category.Name.Equals(_editingCategoryName, StringComparison.OrdinalIgnoreCase));

        if (hasDuplicateName) {
            _categoryError = "A category with this name already exists.";

            return;
        }

        CategoryBase oldCategory = _editingCategory;
        CategoryBase newCategory = new(_editingCategoryName, rule: oldCategory.Rule);
        await OnRenameCategory.InvokeAsync((oldCategory, newCategory));
        _pendingCategoryNameFocus = newCategory.Name;
        ClearCategoryRename();
        await OnCategoriesChanged.InvokeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (_focusRenameInput) {
            _focusRenameInput = false;
            await _renameInputReference.FocusAsync();

            return;
        }

        if (_pendingCategoryNameFocus is string name && _categoryNameButtonReferences.TryGetValue(name, out ElementReference button)) {
            _pendingCategoryNameFocus = null;
            await button.FocusAsync();
        }
    }

    private Task HandleRenameKeyDown(KeyboardEventArgs e) {
        if (e.Key == "Enter") {
            return SaveCategoryName();
        }

        if (e.Key == "Escape") {
            CancelCategoryRename();
        }

        return Task.CompletedTask;
    }
}
