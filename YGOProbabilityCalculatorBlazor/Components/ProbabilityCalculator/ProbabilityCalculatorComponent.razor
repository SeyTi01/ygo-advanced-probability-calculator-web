@using YGOProbabilityCalculatorBlazor.Models
@using YGOProbabilityCalculatorBlazor.Services.Interface
@using YGOProbabilityCalculatorBlazor.Components.Shared
@using YGOProbabilityCalculatorBlazor.Services.BackgroundCalculation
@implements IAsyncDisposable
@inject IDeckImportService _deckImportService
@inject ISessionService _sessionService
@inject ILegacyCardMetadataEnricher _legacyMetadataEnricher
@inject ICardInfoService _cardInfoService
@inject IPendingSessionService _pendingSessionService
@inject IBackgroundCalculator _backgroundCalculator
@inject IJSRuntime SessionLoadingJS

<LocalizedCardNames Cards="_cards" OnChanged="revision => _cardDisplayNamesRevision = revision" />
<div class="calculator-workspace" @oninput="ObserveWorkspaceEdit">
    <div class="session-controls">
        <div class="session-toolbar">
            <ActionMenu @ref="_importMenu" Text="@(UiText.Get("Ui.Import"))" Label="@(UiText.Get("Ui.ImportDeck"))">
                <label class="menu-command session-file-action" for="fileInput">
                    @(UiText.Get("Ui.ImportYDK"))
                    <InputFile OnChange="ImportDeckFromMenu" accept=".ydk" class="session-file-input" id="fileInput" aria-label="@(UiText.Get("Ui.ImportYDK"))"/>
                </label>
                <button type="button" class="menu-command" @onclick="OpenYdkeFromMenu" disabled="@_isYdkeImportOpen">@(UiText.Get("Ui.ImportYDKe"))</button>
            </ActionMenu>
            <button type="button" class="btn btn-outline-secondary session-action" aria-label="@(UiText.Get("Ui.SaveSession"))" @onclick="SaveCurrentSession">@(UiText.Get("Ui.Save"))</button>
            <label class="btn btn-outline-secondary session-file-action session-action" for="sessionFileInput">
                @(UiText.Get("Ui.Load"))
                <InputFile OnChange="@LoadSessionFile" accept=".json" class="session-file-input" id="sessionFileInput" aria-label="@(UiText.Get("Ui.LoadSession"))"/>
            </label>
            <SessionShareButton Compact="true" Snapshot="@_sessionService.SerializeSession(CaptureSession())" Capture="@(() => _sessionService.SerializeSession(CaptureSession()))" />
            <ActionMenu @ref="_workspaceMenu" Text="@(UiText.Get("Ui.More"))" Label="@(UiText.Get("Ui.MoreWorkspaceActions"))">
                <button type="button" class="menu-command menu-remove" @onclick="ClearFromMenu">@(UiText.Get("Ui.ClearWorkspace"))</button>
            </ActionMenu>
        </div>

        <div class="calculation-controls">
            <div class="hand-size-control">
                <label for="handSize">@(UiText.Get("Ui.HandSize"))</label>
                <input type="number"
                       id="handSize"
                       class="form-control"
                       @bind="_handSize"
                       @bind:after="OnHandSizeChanged"
                       min="1"/>
            </div>
            <CalculationSettingsMenu Model="SelectedModel" ModelChanged="OnModelChanged" Strategy="_fastStrategy" StrategyChanged="OnStrategyChanged"
                                      Priority="_drawActivationPriority" PriorityChanged="OnDrawActivationPriorityChanged" Cards="_cards"
                                      StorageTier="_storageTier"
                                      StorageTierChanged="OnStorageTierChanged" />
        </div>
    </div>
    <div class="session-secondary">
        @if (_isClearWorkspaceConfirmationOpen) {
            <div class="clear-workspace-confirmation" role="group" aria-label="@(UiText.Get("Ui.ConfirmClearingWorkspace"))">
                <span>@(UiText.Get("Ui.Clearthecurrentdeckcategoriesandcombos"))</span>
                <button type="button" class="btn btn-danger" @onclick="ClearWorkspace">@(UiText.Get("Ui.Clear"))</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="CancelClearWorkspace">@(UiText.Get("Ui.Cancel"))</button>
            </div>
        }
        @if (_isYdkeImportOpen) {
            <form class="ydke-import-form"
                  aria-label="@(UiText.Get("Ui.YDKeDeckImport"))"
                  @onsubmit="ImportYdkeAsync"
                  @onsubmit:preventDefault="true">
                <label for="ydkeCodeInput" class="visually-hidden">@(UiText.Get("Ui.YDKeDeckCode"))</label>
                <input id="ydkeCodeInput"
                       class="form-control"
                       type="text"
                       autocomplete="off"
                       aria-label="@(UiText.Get("Ui.YDKeDeckCode"))"
                       placeholder="@(UiText.Get("Ui.PasteYdke"))"
                       @bind="_ydkeCode"
                       @bind:event="oninput"/>
                <button type="submit" class="btn btn-primary">@(UiText.Get("Ui.Import"))</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="CancelYdkeImport">@(UiText.Get("Ui.Cancel"))</button>
            </form>
        }
    </div>
    @if (_importError is not null) {
        <DismissibleAlert Message="@_importError" OnDismiss="@(() => _importError = null)"/>
    }

    @if (_sharedFragment is not null) {
        <section class="alert alert-secondary mt-3" aria-label="@(UiText.Get("Ui.SharedSession"))">
            <p class="mb-2" role="status">@(_sharedError ?? UiText.Get("Ui.ASharedSessionIsAvailable"))</p>
            <p class="mb-2">@(UiText.Get("Ui.LoadingReplacesThisWorkspaceIncludingEditorDraftsAndAnySavedRecoveryDraftYouCanDismissTh"))</p>
            <div class="d-flex flex-wrap gap-2">
                @if (_sharedJson is not null) {
                    <button type="button" class="btn btn-primary" disabled="@(_sharedLoading || _sharingRecovery?.InspectionComplete != true)" @onclick="LoadSharedSessionAsync">@(UiText.Get("Ui.LoadSharedSession"))</button>
                }
                <button type="button" class="btn btn-secondary" @onclick="DismissSharedSession">@(UiText.Get("Ui.DismissSharedLink"))</button>
            </div>
            <p class="form-text mb-0">@(UiText.Get("Ui.LinksAreNotEncryptedAnyoneWithThisLinkOrAccessToBrowserHistoryCanReadTheSession"))</p>
        </section>
    }
    @if (_sessionInitialized) {
        <SessionRecovery @ref="_sharingRecovery" Session="CaptureSession()" ReplacementVersion="_autosaveReplacementVersion" EditVersion="_workspaceEditVersion" ApplyRecovery="ApplyRecoveryAsync" ApplyRecoveryPayload="ApplyRecoveryPayloadAsync" Suspended="@(_sharedFragment is not null || LanguageWorkspace?.Restoring == true)" OnInspectionComplete="RecoveryInspected" />
    }

    <CardListEditor CardDisplayNamesRevision="_cardDisplayNamesRevision" @ref="_cardListEditor"
        LoadingSessionVersion="_loadingSessionVersion"
        Cards="_cards"
        Combos="_combos"
        DrawEffectsEnabled="@(SelectedModel != CalculationModel.OpeningHand)"
        CategoryBases="_categoryBases"
        CategoryColorIndices="_categoryColorIndices"
        CategoryRename="_categoryRename"
        ActiveCardIndex="_activeCardIndex"
        ActiveCardIndexChanged="SetActiveCardIndex"
        DeferNameEditRendering="_deferNameEditRendering"
        OnReplaceCard="ReplaceCard"
        OnRenameCard="RenameCard"
        OnNameEditFinished="FinishNameEdit"
        OnRemoveCard="@(i => RemoveCard(i))"
        OnAddCard="AddCard"
        OnDuplicateCard="DuplicateCard"
        ResetVersion="_sessionVersion"
        OnMoveCard="MoveCard"
        OnSortAlphabetically="SortCardsAlphabetically"
    />

    <details class="category-management workspace-management">
        <summary>@(UiText.Get("Ui.Categories")) <span class="text-body-secondary">@(UiText.Get("Ui.ManageCardRoles"))</span></summary>
        <CategoryListEditor @key="_sessionVersion"
            OnCategoriesChanged="HandleCategoriesChanged"
            OnRuleChanged="ChangeCategoryRule"
            OnCategoryColorChanged="SetCategoryColor"
            OnRenameCategory="RenameCategoryBase"
            OnRemoveCategory="RemoveCategory"
            CategoryBases="_categoryBases"
            CategoryColorIndices="_categoryColorIndices"
            Combos="_combos"
            Cards="_cards"
            OnMoveCategory="MoveCategory"
        />
    </details>

    <ComboListEditor @ref="_comboListEditor" @key="ComboListKey"
        Combos="_combos"
        Cards="_cards"
        ComboGroups="_comboGroups"
        CategoryBases="_categoryBases"
        CategoryColorIndices="_categoryColorIndices"
        CategoryRename="_categoryRename"
        ActiveComboIndex="_activeComboIndex"
        ActiveComboIndexChanged="SetActiveComboIndex"
        DeferNameEditRendering="_deferNameEditRendering"
        OnReplaceCombo="ReplaceCombo"
        OnRemoveCombo="@(i => RemoveCombo(i))"
        OnDuplicateCombo="DuplicateCombo"
        OnAddNewCombo="AddNewCombo"
        OnAddGroup="AddGroup"
        OnRenameGroup="RenameGroup"
        OnRemoveGroup="RemoveGroup"
        OnMoveGroup="MoveGroup"
        OnMoveCombo="MoveCombo"
        HandSize="_handSize"
    />

    <div class="results-section">
        <div class="calculation-controls">
            <div class="calculate-action">
                <button type="button"
                        @ref="_calculationAction"
                        class="btn btn-lg w-100 @(_calculation.IsCalculating ? "btn-outline-secondary" : "btn-primary")"
                        aria-label="@(_calculation.IsCalculating ? CalculationCancelLabel : null)"
                        title="@(_calculation.IsCalculating ? CalculationCancelLabel : null)"
                        aria-busy="@(_calculation.IsCalculating ? "true" : "false")"
                        @onclick="HandleCalculationAction"
                        disabled="@(!_calculation.IsCalculating && !CanCalculate)">
                    @if (_calculation.IsCalculating) {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span class="ms-1">@(UiText.Get("Ui.Cancel"))</span>
                    }
                    else {
                        <span>@(UiText.Get("Ui.Calculate"))</span>
                    }
                </button>
            </div>
            <div class="calculation-feedback-slot">
                <div class="exact-retry exact-retry-placeholder" aria-hidden="true">
                    <span class="btn btn-sm btn-outline-primary">@(UiText.Get("Ui.RecalculateUsingExact"))</span>
                </div>
                @if (CanRetryExact) {
                    <div class="exact-retry">
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="RequestExactRetry">@(UiText.Get("Ui.RecalculateUsingExact"))</button>
                    </div>
                }
            </div>
        </div>

        @if (CalculationUnavailableMessage is { } unavailableMessage) {
            <p class="form-text mt-2" role="status" aria-live="polite">@unavailableMessage</p>
        }

        @if (CanCalculate && ExecutionAssessment.ElevatedRisk) {
            <p class="form-text mt-3 mb-0 draw-complexity-notice" role="note">
                @UiText.Get("Result.DetailedDrawWarning")
                @if (_performanceCandidateIndices.Length > 0) {
                    <span>@(UiText.Format("Result.PerformanceContributors", PerformanceCandidates))</span>
                }
                else {
                    <span>@(UiText.Get("Ui.Costcandependoneffectcombinationsanddeckconstraintsnoindividualeffectisidentified"))</span>
                }
            </p>
        }
        @if (_errorMessage is not null) {
            <div class="calculation-error mt-3 mb-3">
                <DismissibleAlert Message="@_errorMessage" OnDismiss="DismissCalculationError"/>
            </div>
        }

        <div class="@(_pinnedResult is null ? null : "result-panels")">
        @if (_calculation.Result is { } result) {
            <section class="alert alert-primary mt-3 probability-results"
                     role="region"
                     aria-labelledby="probabilityResultsHeading">
                <div class="probability-results-heading">
                    <div class="probability-result-title">
                        <h5 id="probabilityResultsHeading">@(_pinnedResult is null ? UiText.Get("Result.Heading") : UiText.Get("Ui.CurrentResult"))</h5>
                        <small class="probability-result-status-slot text-body-secondary fw-normal" role="status" aria-live="polite">
                            <span class="probability-result-status-placeholder" aria-hidden="true">
                                <span class="probability-result-status-chip probability-result-status-neutral">@(UiText.Get("Ui.InputsChanged"))</span>
                            </span>
                            @if (_calculation.IsPreliminary || _calculation.IsStale) {
                                <span class="probability-result-status probability-result-status-chip @(_calculation.IsPreliminary ? "probability-result-status-preliminary" : "probability-result-status-neutral")">
                                    @if (_calculation.IsPreliminary) {
                                        <span>@(UiText.Get("Ui.Preliminary"))</span>
                                    }
                                    else {
                                        <span>@(UiText.Get("Ui.InputsChanged"))</span>
                                    }
                                </span>
                            }
                            else {
                                <span class="visually-hidden">@(UiText.Get("Ui.ResultReady"))</span>
                            }
                        </small>
                    </div>
                    <button type="button" class="btn btn-outline-primary pin-result-action" disabled="@(!CanPin)"
                            aria-label="@(_pinnedResult is null ? UiText.Get("Ui.PinResult") : UiText.Get("Ui.ReplacePinWithCurrentResult"))"
                            title="@(_pinnedResult is null ? UiText.Get("Ui.PinResult") : UiText.Get("Ui.ReplacePinWithCurrentResult"))"
                            aria-describedby="@(!CanPin ? "pinUnavailableReason" : null)" @onclick="PinCurrentResult">
                        <PinIcon />
                    </button>
                    <span id="pinUnavailableReason" class="visually-hidden">@PinUnavailableReason</span>
                    <ProbabilityResultExport Result="result"
                                             ModelDescription="@(_calculation.Snapshot?.Context.ModeDescription)"
                                             HandSize="@(_calculation.Snapshot?.Context.HandSize ?? 0)"
                                             IsStale="_calculation.IsStale"
                                             IsCalculating="_calculation.IsCalculating" />
                </div>
                <CalculationAccuracyResult Contract="result.Contract" Context="_calculation.Snapshot?.Context"
                    ModeDescription="@(_calculation.Snapshot?.Context.ModeDescription)" />
                <div class="combo-probability-row probability-total">
                    <span class="combo-probability-name">@(UiText.Get("Ui.AnyActiveCombo"))</span>
                    <div class="result-value-group">
                        <ProbabilityValue Probability="result.TotalProbability" Contract="result.Contract" Certificate="result.SearchAvailability" ValueClass="probability-total-value" />
                    </div>
                </div>
                @{
                    List<GroupProbabilityResult> groupResults = (result.GroupProbabilities ?? [])
                        .Where(group => group.ActiveComboCount > 0)
                        .ToList();
                    HashSet<string> renderedGroupIds = groupResults
                        .Select(group => group.GroupId)
                        .ToHashSet(StringComparer.Ordinal);
                    List<ComboProbabilityResult> ungroupedComboResults = result.ComboProbabilities
                        .Where(comboResult => comboResult.GroupId is null || !renderedGroupIds.Contains(comboResult.GroupId))
                        .ToList();
                }
                @if (groupResults.Count > 0) {
                    <div class="probability-groups @(ungroupedComboResults.Count == 0 ? "probability-groups-last" : null)">
                        @foreach (GroupProbabilityResult group in groupResults) {
                            List<ComboProbabilityResult> groupComboResults = result.ComboProbabilities
                                .Where(comboResult => comboResult.GroupId == group.GroupId)
                                .ToList();
                            <section class="probability-group-container">
                                <h6 class="combo-probability-row probability-group probability-group-heading">
                                    <span class="combo-probability-name">
                                        @group.GroupName <small class="text-body-secondary fw-normal">@UiText.Format("Result.ActiveCount", group.ActiveComboCount)</small>
                                    </span>
                                    <span class="result-value-group">
                                        <ProbabilityValue Probability="group.Probability" Contract="result.Contract" Certificate="result.SearchAvailability" Row="ProbabilityRow.Group" Index="@ProbabilityPresentation.GroupIndex(result.GroupProbabilities, group.GroupId)" />
                                    </span>
                                </h6>
                                @if (groupComboResults.Count > 0) {
                                    <ol class="combo-probability-list probability-group-members">
                                        @foreach (ComboProbabilityResult comboResult in groupComboResults) {
                                            <li class="combo-probability-item">
                                                <div class="combo-probability-row">
                                                    <span class="combo-probability-name">@ComboResultDisplayName(comboResult)</span>
                                                    <span class="result-value-group">
                                                        <ProbabilityValue Probability="comboResult.Probability" Contract="result.Contract" Certificate="result.SearchAvailability" Row="ProbabilityRow.Combo" Index="comboResult.ComboIndex" />
                                                    </span>
                                                </div>
                                            </li>
                                        }
                                    </ol>
                                }
                            </section>
                        }
                    </div>
                }
                @if (ungroupedComboResults.Count > 0) {
                    <h6 class="@(groupResults.Count > 0 ? "fw-bold" : null)">@(groupResults.Count > 0 ? UiText.Get("Ui.UngroupedCombos") : UiText.Get("Ui.IndividualCombos"))</h6>
                    <ol class="combo-probability-list probability-ungrouped-combos">
                        @foreach (ComboProbabilityResult comboResult in ungroupedComboResults) {
                            <li class="combo-probability-item">
                                <div class="combo-probability-row">
                                    <span class="combo-probability-name">@ComboResultDisplayName(comboResult)</span>
                                    <span class="result-value-group">
                                        <ProbabilityValue Probability="comboResult.Probability" Contract="result.Contract" Certificate="result.SearchAvailability" Row="ProbabilityRow.Combo" Index="comboResult.ComboIndex" />
                                    </span>
                                </div>
                            </li>
                        }
                    </ol>
                }
            </section>
        }
        @if (_pinnedResult is { } pinned) {
            <PinnedResultPanel Snapshot="pinned" OnClear="ClearPinnedResult" />
        }
        </div>
    </div>
</div>

@code {
    private long _cardDisplayNamesRevision;
    private ActionMenu? _importMenu;
    private ActionMenu? _workspaceMenu;

    private async Task ImportDeckFromMenu(InputFileChangeEventArgs args) {
        if (_importMenu is not null) {
            await _importMenu.Close();
        }

        await ImportDeckAsync(args);
    }

    private async Task OpenYdkeFromMenu() {
        if (_importMenu is not null) {
            await _importMenu.Close();
        }

        OpenYdkeImport();
    }

    private async Task ClearFromMenu() {
        if (_workspaceMenu is not null) {
            await _workspaceMenu.Close();
        }

        RequestClearWorkspace();
    }

    private readonly List<CategoryBase> _categoryBases = [];
    private readonly List<Card> _cards = [];
    private readonly List<Combo> _combos = [];
    private readonly List<ComboGroup> _comboGroups = [];
    private readonly Dictionary<string, int> _categoryColorIndices = new(StringComparer.Ordinal);

    private CardListEditor? _cardListEditor;
    private string ComboListKey => $"ComboList-{_sessionVersion}";

    private int _activeComboIndex = -1;
    private int _activeCardIndex = -1;

    private int _sessionVersion;
    private int _categoryRenameVersion;
    private CategoryRenameNotice? _categoryRename;
    private int _handSize = 5;
    private FastExecutionStrategy _fastStrategy;
    private CalculationModel _selectedModel = CalculationModel.Fast;
    private DrawActivationPriority _drawActivationPriority = DrawActivationPriority.Default;
    private CalculationStorageTier _storageTier = CalculationStorageTier.Standard;
    private readonly CalculationResultState _calculation = new();
    private bool _deferNameEditRendering;
    private bool _isClearWorkspaceConfirmationOpen;
    private bool _disposed;
    private string? _errorMessage;
    private string? _importError;
    private bool _isYdkeImportOpen;
    private string _ydkeCode = string.Empty;

    private int ActiveCardCount => _cards.Count(card => card.Active);
    private long ActiveCardCopies => _cards.Where(card => card.Active).Sum(card => (long)card.Copies);
    private int ActiveComboCount => _combos.Count(combo => combo.Active);

    private string? CalculationUnavailableMessage {
        get {
            if (_handSize < 1) {
                return UiText.Get("Ui.HandSizeMustBeAtLeast1");
            }

            bool hasMissingActiveCardReference = _combos.Any(combo => combo.Active && combo.AllCards.Any(requirement =>
                _cards.Count(card => card.Id == requirement.CardId) != 1));
            if (hasMissingActiveCardReference) {
                return UiText.Get("Ui.AnActiveComboHasAMissingCardReferenceRepairOrRemoveItOrDeactivateTheCombo");
            }

            if (ActiveCardCount == 0) {
                return UiText.Get("Ui.ActivateAtLeastOneCardToCalculate");
            }

            if (_cards.Any(card => card.Active && card.Copies < 1)) {
                return UiText.Get("Ui.EachActiveCardMustHaveAtLeastOneCopyOrBeDeactivated");
            }

            if (ActiveCardCopies > int.MaxValue) {
                return UiText.Get("Ui.TheActiveDeckIsTooLargeToCalculateReduceTheNumberOfCopiesOrDeactivateCards");
            }

            if (ActiveCardCopies < _handSize) {
                return UiText.Format("Ui.TheActiveDeckHas0CopiesFewerThanTheHandSizeOf1", ActiveCardCopies, _handSize);
            }

            if (ActiveComboCount == 0) {
                return UiText.Get("Ui.ActivateAtLeastOneComboToCalculate");
            }

            if (ActiveComboCount > IProbabilityCalculatorService.MaxComboCount) {
                return UiText.Format("Ui.CalculateWithAtMost0ActiveCombosDeactivateOrRemoveExtraCombos", IProbabilityCalculatorService.MaxComboCount);
            }

            if (_combos.Any(combo => combo.Active && combo.RequirementCount == 0)) {
                return UiText.Get("Ui.CompleteOrDeactivateEveryIncompleteActiveComboBeforeCalculating");
            }

            return null;
        }
    }

    private bool CanCalculate => CalculationUnavailableMessage is null;

    private static string ComboResultDisplayName(ComboProbabilityResult result) =>
        string.IsNullOrWhiteSpace(result.ComboName)
            ? UiText.Format("Ui.UnnamedCombo0", result.ComboIndex + 1)
            : result.ComboName;

    private Task ReplaceCard((int Index, Card NewCard) payload) {
        (int index, Card newCard) = payload;
        _cards[index] = newCard;
        InvalidateCalculation();

        return Task.CompletedTask;
    }

    private async Task RenameCard((int Index, Card NewCard) payload) {
        bool visibleStatusChanged = _calculation.IsCalculating || _errorMessage is not null
            || (_calculation.Result is not null && !_calculation.IsStale);
        _cards[payload.Index] = payload.NewCard;
        InvalidateCalculation(reassess: false);

        if (visibleStatusChanged) {
            _deferNameEditRendering = true;
            StateHasChanged();
        }

        if (_sharingRecovery is not null) {
            await _sharingRecovery.CaptureEditAsync(CaptureSession(), _workspaceEditVersion);
        }
    }

    // The names in other selectors refresh at the end of editing. The owning
    // model and recovery snapshot have already received every input event.
    private void FinishNameEdit() => _deferNameEditRendering = false;

    private void SetActiveCardIndex(int index) {
        _deferNameEditRendering = false;
        _activeCardIndex = index;
    }

    private void SetActiveComboIndex(int index) {
        _deferNameEditRendering = false;
        _activeComboIndex = index;
    }

    private void MoveCategory((int From, int To) move) {
        if (ListMove.TryMove(_categoryBases, move.From, move.To)) {
            InvalidateCalculation();
        }
    }

    private void MoveCard((int From, int To) move) {
        if (!ListMove.TryMove(_cards, move.From, move.To)) {
            return;
        }

        _activeCardIndex = ListMove.AdjustActiveIndex(_activeCardIndex, move.From, move.To);
        InvalidateCalculation();
    }

    private void SortCardsAlphabetically() {
        string? activeCardId = _activeCardIndex >= 0 && _activeCardIndex < _cards.Count
            ? _cards[_activeCardIndex].Id
            : null;

        List<Card> sortedCards = CardOrdering.Alphabetize(_cards).ToList();

        if (_cards.SequenceEqual(sortedCards)) {
            return;
        }

        _cards.Clear();
        _cards.AddRange(sortedCards);
        _activeCardIndex = activeCardId is null
            ? -1
            : _cards.FindIndex(card => card.Id == activeCardId);

        InvalidateCalculation();
    }

    private void MoveCombo((int From, int To) move) {
        if (!ListMove.TryMove(_combos, move.From, move.To)) {
            return;
        }

        _activeComboIndex = ListMove.AdjustActiveIndex(_activeComboIndex, move.From, move.To);
        InvalidateCalculation();
    }

    private void MoveGroup((int From, int To) move) {
        if (ListMove.TryMove(_comboGroups, move.From, move.To)) {
            InvalidateCalculation();
        }
    }

    private void RemoveCard(int index) {
        if (index < 0 || index >= _cards.Count) {
            return;
        }

        _cards.RemoveAt(index);
        InvalidateCalculation();

        if (_activeCardIndex == index) {
            _activeCardIndex = -1;
        }
        else if (_activeCardIndex > index) {
            _activeCardIndex--;
        }
    }

    private void AddCard(Card card) {
        _cards.Add(card);
        InvalidateCalculation();
    }

    private void DuplicateCard(int index) {
        if (index < 0 || index >= _cards.Count) {
            return;
        }

        _cards.Insert(index + 1, _cards[index].Duplicate());

        if (_activeCardIndex > index) {
            _activeCardIndex++;
        }

        InvalidateCalculation();
    }

    private Task ReplaceCombo((int Index, Combo NewCombo) payload) {
        (int index, Combo newCombo) = payload;
        _combos[index] = newCombo;
        InvalidateCalculation();
        StateHasChanged();

        return Task.CompletedTask;
    }

    private void RemoveCombo(int index) {
        if (index < 0 || index >= _combos.Count) {
            return;
        }

        _combos.RemoveAt(index);
        InvalidateCalculation();

        if (_activeComboIndex == index) {
            _activeComboIndex = -1;
        }
        else if (_activeComboIndex > index) {
            _activeComboIndex--;
        }
    }

    private void AddNewCombo() {
        _combos.Add(new Combo(new List<ComboCategory>()));
        InvalidateCalculation();
        _activeComboIndex = _combos.Count - 1;
    }

    private void DuplicateCombo(int index) {
        if (index < 0 || index >= _combos.Count) {
            return;
        }

        Combo source = _combos[index];
        Combo duplicate = new(
            source.Categories.Select(
                category => ComboCategory.SameCard(
                    category.CategoryBases,
                    category.MinCount,
                    category.MaxCount,
                    category.MaximumMode
                )
            ),
            GetDuplicateComboName(source.Name),
            source.Active,
            source.GroupId,
            source.Cards.Select(
                card => new ComboCard(
                    card.CardId,
                    card.MinCount,
                    card.MaxCount,
                    card.MaximumMode
                )
            ),
            source.AlternativeGroups,
            source.RequirementOrder
        );

        int duplicateIndex = index + 1;
        _combos.Insert(duplicateIndex, duplicate);
        InvalidateCalculation();
        _activeComboIndex = duplicateIndex;
    }

    private string? GetDuplicateComboName(string? sourceName) {
        if (string.IsNullOrWhiteSpace(sourceName)) {
            return null;
        }

        HashSet<string> usedNames = _combos
            .Where(combo => !string.IsNullOrWhiteSpace(combo.Name))
            .Select(combo => combo.Name!)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        string baseName = $"{sourceName} copy";

        if (!usedNames.Contains(baseName)) {
            return baseName;
        }

        for (long suffix = 2L; ; suffix++) {
            string candidate = $"{baseName} {suffix}";

            if (!usedNames.Contains(candidate)) {
                return candidate;
            }
        }
    }

    private void AddGroup(string name) {
        _comboGroups.Add(new ComboGroup(Guid.NewGuid().ToString("N"), name));
        InvalidateCalculation();
        StateHasChanged();
    }

    private void RenameGroup((string Id, string Name) payload) {
        int index = _comboGroups.FindIndex(group => group.Id == payload.Id);

        if (index < 0) {
            return;
        }

        _comboGroups[index] = _comboGroups[index] with { Name = payload.Name };
        InvalidateCalculation();
        StateHasChanged();
    }

    private void RemoveGroup(string id) {
        if (_comboGroups.RemoveAll(group => group.Id == id) == 0) {
            return;
        }

        foreach (Combo combo in _combos.Where(combo => combo.GroupId == id)) {
            combo.GroupId = null;
        }

        InvalidateCalculation();
        StateHasChanged();
    }

    private ComboListEditor? _comboListEditor;

    private async Task RemoveCategory(CategoryBase category) {
        if (category.Source != CategorySource.User || !_categoryBases.Contains(category)) {
            return;
        }

        // Build and validate replacements before publishing any workspace mutation.
        Card[] cards = _cards.Select(card => CategoryRemoval.Remove(card, category.Identity)).ToArray();
        Combo[] combos = _combos.Select(combo => CategoryRemoval.Remove(combo, category.Identity)).ToArray();
        for (int index = 0; index < cards.Length; index++) {
            if (!ReferenceEquals(cards[index], _cards[index])) {
                await _cardListEditor!.ReplaceCard((index, cards[index]));
            }
        }
        for (int index = 0; index < combos.Length; index++) {
            if (!ReferenceEquals(combos[index], _combos[index])) {
                await _comboListEditor!.ReplaceCombo((index, combos[index]));
            }
        }
        _categoryBases.Remove(category);
        _categoryColorIndices.Remove(category.Name);
        InvalidateCalculation();
    }

    private async Task RenameCategoryBase((CategoryBase OldCategory, CategoryBase NewCategory) payload) {
        (CategoryBase oldCategory, CategoryBase newCategory) = payload;

        if (oldCategory.Source != CategorySource.User || newCategory.Source != CategorySource.User) {
            return;
        }

        int categoryBaseIndex = _categoryBases.FindIndex(category => ReferenceEquals(category, oldCategory));

        if (categoryBaseIndex < 0) {
            return;
        }

        if (_categoryColorIndices.Remove(oldCategory.Name, out int colorIndex)) {
            _categoryColorIndices[newCategory.Name] = colorIndex;
        }

        _categoryBases[categoryBaseIndex] = newCategory;

        for (int index = 0; index < _cards.Count; index++) {
            Card card = _cards[index];
            for (int categoryIndex = 0; categoryIndex < card.Categories.Count; categoryIndex++) {

                if (card.Categories[categoryIndex].Identity.Equals(oldCategory.Identity, StringComparison.Ordinal)) {
                    card.Categories[categoryIndex] = newCategory;
                }
            }
            if (card.PostDrawSelector.CategoryIdentities.Contains(oldCategory.Identity)
                || card.PreDrawSelector.CategoryIdentities.Contains(oldCategory.Identity)
                || (card.Search?.Selector.CategoryIdentities.Contains(oldCategory.Identity) ?? false)) {
                Card replacement = card.WithPostDrawSelector(card.PostDrawSelector.RenameCategory(oldCategory.Identity, newCategory.Identity))
                    .WithPreDrawSelector(card.PreDrawSelector.RenameCategory(oldCategory.Identity, newCategory.Identity));
                if (replacement.Search is { } search) {
                    replacement = replacement.WithSearch(search.RenameCategory(oldCategory.Identity, newCategory.Identity));
                }
                await _cardListEditor!.ReplaceCard((index, replacement.WithEffect(replacement.EffectPlan, card.EffectProfile)));
            }
        }

        foreach (Combo combo in _combos) {
            for (int categoryIndex = 0; categoryIndex < combo.Categories.Count; categoryIndex++) {
                ComboCategory constraint = combo.Categories[categoryIndex];

                if (constraint.Selector.CategoryIdentities.Contains(oldCategory.Identity)) {
                    combo.Categories[categoryIndex] = constraint.RenameCategory(oldCategory, newCategory);
                }
            }
        }

        foreach (Combo combo in _combos) {
            for (int groupIndex = 0; groupIndex < combo.AlternativeGroups.Count; groupIndex++) {
                ComboAlternativeGroup group = combo.AlternativeGroups[groupIndex];
                ComboAlternative[] alternatives = group.Alternatives
                    .Select(alternative => {
                        if (alternative.Category is { } category && category.Selector.CategoryIdentities.Contains(oldCategory.Identity)) {
                            return ComboAlternative.For(category.RenameCategory(oldCategory, newCategory));
                        }

                        return alternative;
                    })
                    .ToArray();

                combo.AlternativeGroups[groupIndex] = new ComboAlternativeGroup(alternatives);
            }
        }
        _categoryRename = new CategoryRenameNotice(++_categoryRenameVersion, oldCategory.Name, newCategory.Name);
    }

    private void ChangeCategoryRule((CategoryBase Category, CardSelector? Rule) change) {
        int index = _categoryBases.FindIndex(category => ReferenceEquals(category, change.Category));
        if (index < 0) {
            return;
        }

        _categoryBases[index] = new CategoryBase(change.Category.Name, rule: change.Rule);
        InvalidateCalculation();
    }

    private void HandleCategoriesChanged() {
        ReconcileCategoryColorIndices();
        InvalidateCalculation();
        StateHasChanged();
    }

    private Task SetCategoryColor((string CategoryName, int ColorIndex) change) {
        bool hasMatchingUserCategory = CategoryColorPalette.IsValidIndex(change.ColorIndex)
            && _categoryBases.Any(category => category.Source == CategorySource.User
                                              && category.Name.Equals(change.CategoryName, StringComparison.Ordinal));

        if (!hasMatchingUserCategory) {
            return Task.CompletedTask;
        }

        _categoryColorIndices[change.CategoryName] = change.ColorIndex;
        ObserveWorkspaceEdit();

        return Task.CompletedTask;
    }

    private void ReconcileCategoryColorIndices() {
        List<string> activeCategoryNames = _categoryBases.Concat(_cards.SelectMany(card => card.Categories))
            .Concat(_combos.SelectMany(combo => combo.AllCategories).SelectMany(category => category.CategoryBases))
            .Where(category => category.Source == CategorySource.User)
            .Select(category => category.Name)
            .Distinct(StringComparer.Ordinal)
            .ToList();

        HashSet<string> activeNames = activeCategoryNames.ToHashSet(StringComparer.Ordinal);

        foreach (string staleName in _categoryColorIndices.Keys.Where(name => !activeNames.Contains(name)).ToArray()) {
            _categoryColorIndices.Remove(staleName);
        }

        HashSet<int> assignedIndices = new();
        int assignedCategoryCount = 0;

        foreach (string categoryName in activeCategoryNames) {
            if (!_categoryColorIndices.TryGetValue(categoryName, out int existingIndex) ||
                !CategoryColorPalette.IsValidIndex(existingIndex)) {
                continue;
            }

            // Existing palette choices are intentional even when categories share a color.
            assignedIndices.Add(existingIndex);
            assignedCategoryCount++;
        }

        foreach (string categoryName in activeCategoryNames) {
            if (_categoryColorIndices.TryGetValue(categoryName, out int existingIndex) &&
                CategoryColorPalette.IsValidIndex(existingIndex)) {
                continue;
            }

            int nextIndex = CategoryColorPalette.FirstAvailableIndex(assignedIndices, assignedCategoryCount++);
            _categoryColorIndices[categoryName] = nextIndex;
            assignedIndices.Add(nextIndex);
        }
    }

    private void RestoreCategoryColorIndices(SessionState session) {
        _categoryColorIndices.Clear();

        if (session.CategoryColorIndices is not null) {
            foreach (KeyValuePair<string, int> categoryColorIndex in session.CategoryColorIndices) {
                if (!string.IsNullOrWhiteSpace(categoryColorIndex.Key) &&
                    CategoryColorPalette.IsValidIndex(categoryColorIndex.Value)) {
                    _categoryColorIndices[categoryColorIndex.Key] = categoryColorIndex.Value;
                }
            }
        }

        ReconcileCategoryColorIndices();
    }

    private string CalculationCancelLabel => _calculation.IsPreliminary ? UiText.Get("Ui.CancelExactUpgrade") : UiText.Get("Ui.CancelCalculation");

    private Task Calculate() => CalculateModel(SelectedModel);

    private async Task CalculateModel(CalculationModel model) {
        if (_disposed || _calculation.IsCalculating || !CanCalculate) {
            return;
        }

        using CalculationResultState.Run request = _calculation.Begin();
        try {
            _errorMessage = null;
            StateHasChanged();

            CalculationSnapshot snapshot = CalculationSnapshot.Capture(
                _cards,
                _combos,
                _handSize,
                _comboGroups,
                CalculationWorkPolicy.Interactive,
                null,
                CalculationStoragePolicy.ForTier(_storageTier),
                new(_drawActivationPriority, Mode: model),
                _categoryBases
            );
            snapshot = snapshot with { AllowAutomaticExact = _fastStrategy == FastExecutionStrategy.Progressive };
            PinnedCalculationContext resultContext = CaptureResultContext(model);
            Task PresentPreliminary(ProbabilityCalculationResult result) => InvokeAsync(() => {
                if (_calculation.TryAcceptPreliminary(request, resultContext, result)) {
                    StateHasChanged();
                }
            });
            ProbabilityCalculationResult result = _backgroundCalculator is IProgressiveBackgroundCalculator progressive
                ? await progressive.CalculateProgressivelyAsync(snapshot, PresentPreliminary, request.Token)
                : await _backgroundCalculator.CalculateAsync(snapshot, request.Token);
            _calculation.AcceptFinal(request, resultContext, result);
        }
        catch (OperationCanceledException) {
            // Cancellation, edits, replacement and disposal are quiet.
        }
        catch (Exception ex) when (request.HasPreliminary) {
            // A broken final transport/contract cannot invalidate completed
            // Fast values. Record the failed upgrade in the accuracy detail.
            AutomaticExactOutcome outcome = ex switch {
                ProbabilityCalculationLimitException { Reason: ProbabilityCalculationLimitReason.Work } => AutomaticExactOutcome.WorkLimit,
                ProbabilityCalculationLimitException { Reason: ProbabilityCalculationLimitReason.Storage } => AutomaticExactOutcome.StorageLimit,
                UnsupportedExactCalculationException => AutomaticExactOutcome.Unsupported,
                _ => AutomaticExactOutcome.Error
            };
            _calculation.RetainPreliminaryFailure(request, outcome);
        }
        catch (ProbabilityCalculationLimitException ex) {
            if (_calculation.Owns(request)) {
                _errorMessage = ex.Message + UiText.Get("Ui.NoProbabilityWasCalculatedForThisRequest");
            }
        }
        catch (UnsupportedExactCalculationException ex) {
            if (_calculation.Owns(request)) {
                _errorMessage = ex.Message + UiText.Get("Ui.NoProbabilityWasReturnedForThisRequest");
            }
        }
        catch (Exception ex) {
            if (_calculation.Owns(request)) {
                _errorMessage = UiText.Format("Ui.CalculationFailed0", ex.Message);
            }
        }
    }

    private Task HandleCalculationAction() {
        if (!_calculation.IsCalculating) {
            return Calculate();
        }

        _calculation.Stop();

        return Task.CompletedTask;
    }

    private void OnHandSizeChanged() => InvalidateCalculation();

    private void OnStrategyChanged(FastExecutionStrategy strategy) {
        if (_fastStrategy == strategy) {
            return;
        }
        _fastStrategy = strategy;
        InvalidateCalculation();
    }

    private void OnModelChanged(CalculationModel model) {
        if (!Enum.IsDefined(model)) {
            throw new ArgumentOutOfRangeException(nameof(model));
        }
        if (SelectedModel == model) {
            return;
        }

        _selectedModel = model;
        if (model != CalculationModel.Fast) {
            _fastStrategy = FastExecutionStrategy.Progressive;
        }
        InvalidateCalculation();
    }

    private void OnDrawActivationPriorityChanged(DrawActivationPriority priority) {
        _drawActivationPriority = priority.ForWorkspace(_cards);
        InvalidateCalculation();
    }

    private void OnStorageTierChanged(CalculationStorageTier tier) {
        if (_storageTier == tier) {
            return;
        }

        _storageTier = tier;
        InvalidateCalculation();
    }

    private void InvalidateCalculation(bool clearPreviousResult = false, bool reassess = true) {
        _drawActivationPriority = _drawActivationPriority.ForWorkspace(_cards);
        _deferNameEditRendering = false;
        _assessmentDirty |= reassess;
        ObserveWorkspaceEdit();
        _calculation.Invalidate(clearPreviousResult);

        _errorMessage = null;
    }
}
