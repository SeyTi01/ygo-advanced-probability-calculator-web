@using YGOProbabilityCalculatorBlazor.Models
@using YGOProbabilityCalculatorBlazor.Services.Interface
@using YGOProbabilityCalculatorBlazor.Components.Shared
@inject IDeckImportService _deckImportService
@inject ISessionService _sessionService
@inject ILegacyCardMetadataEnricher _legacyMetadataEnricher
@inject IPendingSessionService _pendingSessionService
@inject IProbabilityCalculatorService _probabilityCalculator

<div class="container">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <button class="btn btn-primary">
            <InputFile OnChange="@ImportDeckAsync" accept=".ydk" class="d-none" id="fileInput"/>
            <label for="fileInput" class="m-0" style="cursor: pointer;">Import Deck</label>
        </button>
        @if (!isYdkeImportOpen) {
            <button type="button" class="btn btn-outline-primary" @onclick="OpenYdkeImport">
                Import YDKe
            </button>
        }
        <button class="btn btn-secondary" @onclick="SaveCurrentSession">
            Save Session
        </button>
        <button class="btn btn-secondary">
            <InputFile OnChange="@LoadSessionFile" accept=".json" class="d-none" id="sessionFileInput"/>
            <label for="sessionFileInput" class="m-0" style="cursor: pointer;">Load Session</label>
        </button>
        @if (isYdkeImportOpen) {
            <form class="ydke-import-form d-flex flex-wrap align-items-center gap-2 w-100"
                  aria-label="YDKe deck import"
                  @onsubmit="ImportYdkeAsync"
                  @onsubmit:preventDefault="true">
                <label for="ydkeCodeInput" class="visually-hidden">YDKe deck code</label>
                <input id="ydkeCodeInput"
                       class="form-control flex-grow-1"
                       style="min-width: min(100%, 16rem); max-width: 40rem;"
                       type="text"
                       autocomplete="off"
                       aria-label="YDKe deck code"
                       placeholder="Paste ydke://..."
                       @bind="ydkeCode"
                       @bind:event="oninput"/>
                <button type="submit" class="btn btn-primary">Import</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="CancelYdkeImport">Cancel</button>
            </form>
        }
    </div>

    <div class="mb-4">
        <div class="d-flex align-items-center">
            <label for="handSize" class="me-2 mb-0">Hand Size:</label>
            <input type="number"
                   id="handSize"
                   class="form-control"
                   style="width: 80px;"
                   @bind="handSize"
                   @bind:after="OnHandSizeChanged"
                   min="1"/>
        </div>
    </div>
    @if (importError is not null) {
        <DismissibleAlert Message="@importError" OnDismiss="@(() => importError = null)"/>
    }

    <CategoryListEditor @key="sessionVersion"
        OnCategoriesChanged="HandleCategoriesChanged"
        OnCategoryColorChanged="SetCategoryColor"
        OnRenameCategory="RenameCategoryBase"
        CategoryBases="categoryBases"
        CategoryColorIndices="categoryColorIndices"
        Combos="combos"
        Cards="cards"
        OnMoveCategory="MoveCategory"
    />

    <CardListEditor
        Cards="cards"
        Combos="combos"
        CategoryBases="categoryBases"
        CategoryColorIndices="categoryColorIndices"
        CategoryRename="categoryRename"
        ActiveCardIndex="activeCardIndex"
        ActiveCardIndexChanged="@(i => activeCardIndex = i)"
        OnReplaceCard="ReplaceCard"
        OnRemoveCard="@(i => RemoveCard(i))"
        OnAddNewCard="AddNewCard"
        OnMoveCard="MoveCard"
    />

    <ComboListEditor
        Combos="combos"
        Cards="cards"
        ComboGroups="comboGroups"
        CategoryBases="categoryBases"
        CategoryColorIndices="categoryColorIndices"
        CategoryRename="categoryRename"
        ActiveComboIndex="activeComboIndex"
        ActiveComboIndexChanged="@(i => activeComboIndex = i)"
        OnReplaceCombo="ReplaceCombo"
        OnRemoveCombo="@(i => RemoveCombo(i))"
        OnDuplicateCombo="DuplicateCombo"
        OnAddNewCombo="AddNewCombo"
        OnAddGroup="AddGroup"
        OnRenameGroup="RenameGroup"
        OnRemoveGroup="RemoveGroup"
        OnMoveGroup="MoveGroup"
        OnMoveCombo="MoveCombo"
        HandSize="handSize"
    />

    <div class="results-section">
        <div class="col-12 col-sm-4 col-md-3">
            <button class="btn btn-primary btn-lg w-100"
                    @onclick="Calculate"
                    disabled="@(isCalculating || !CanCalculate)">
                @if (isCalculating) {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span class="ms-1">Calculating...</span>
                }
                else {
                    <span>Calculate</span>
                }
            </button>
        </div>

        @if (CalculationUnavailableMessage is { } unavailableMessage) {
            <p class="form-text mt-2" role="status" aria-live="polite">@unavailableMessage</p>
        }

        @if (errorMessage is not null) {
            <DismissibleAlert Message="@errorMessage" OnDismiss="@(() => errorMessage = null)"/>
        }

        @if (calculationResult is { } result) {
            <section class="alert alert-primary mt-3 probability-results"
                     role="region"
                     aria-labelledby="probabilityResultsHeading"
                     aria-live="polite">
                <h5 id="probabilityResultsHeading" class="d-flex align-items-center justify-content-between">
                    <span>Results</span>
                    @if (calculationResultIsStale) {
                        <small class="probability-result-status text-body-secondary fw-normal"
                               role="status"
                               aria-live="polite">Previous result · inputs changed</small>
                    }
                </h5>
                <div class="combo-probability-row probability-total">
                    <span class="combo-probability-name">Any active combo</span>
                    <strong class="combo-probability-value probability-total-value">@result.TotalProbability.ToString("P2")</strong>
                </div>
                @{
                    var groupResults = result.GroupProbabilities ?? Array.Empty<GroupProbabilityResult>();
                    var renderedGroupIds = groupResults.Select(group => group.GroupId).ToHashSet(StringComparer.Ordinal);
                    var ungroupedComboResults = result.ComboProbabilities
                        .Where(comboResult => comboResult.GroupId is null || !renderedGroupIds.Contains(comboResult.GroupId))
                        .ToList();
                }
                @if (groupResults.Count > 0) {
                    <div class="probability-groups">
                        @foreach (var group in groupResults) {
                            var groupComboResults = result.ComboProbabilities
                                .Where(comboResult => comboResult.GroupId == group.GroupId)
                                .ToList();
                            <section class="probability-group-container">
                                <h6 class="combo-probability-row probability-group probability-group-heading">
                                    <span class="combo-probability-name">
                                        @group.GroupName <small class="text-body-secondary fw-normal">(@group.ActiveComboCount active)</small>
                                    </span>
                                    <strong class="combo-probability-value">@group.Probability.ToString("P2")</strong>
                                </h6>
                                @if (groupComboResults.Count > 0) {
                                    <ol class="combo-probability-list probability-group-members">
                                        @foreach (var comboResult in groupComboResults) {
                                            <li class="combo-probability-item">
                                                <div class="combo-probability-row">
                                                    <span class="combo-probability-name">@ComboResultDisplayName(comboResult)</span>
                                                    <strong class="combo-probability-value">@comboResult.Probability.ToString("P2")</strong>
                                                </div>
                                            </li>
                                        }
                                    </ol>
                                }
                            </section>
                        }
                    </div>
                }
                @if (ungroupedComboResults.Count > 0 || groupResults.Count == 0) {
                    <h6>@(groupResults.Count > 0 ? "Ungrouped combos" : "Individual combos")</h6>
                    <ol class="combo-probability-list probability-ungrouped-combos">
                        @foreach (var comboResult in ungroupedComboResults) {
                            <li class="combo-probability-item">
                                <div class="combo-probability-row">
                                    <span class="combo-probability-name">@ComboResultDisplayName(comboResult)</span>
                                    <strong class="combo-probability-value">@comboResult.Probability.ToString("P2")</strong>
                                </div>
                            </li>
                        }
                    </ol>
                }
            </section>
        }
    </div>
</div>

@code {

    private readonly List<CategoryBase> categoryBases = [];
    private readonly List<Card> cards = [];
    private readonly List<Combo> combos = [];
    private readonly List<ComboGroup> comboGroups = [];
    private readonly Dictionary<string, int> categoryColorIndices = new(StringComparer.Ordinal);

    private int activeComboIndex = -1;
    private int activeCardIndex = -1;

    private int sessionVersion;
    private int categoryRenameVersion;
    private CategoryRenameNotice? categoryRename;
    private int handSize = 5;
    private bool isCalculating;
    private long calculationVersion;
    private string? errorMessage;
    private string? importError;
    private bool isYdkeImportOpen;
    private string ydkeCode = string.Empty;
    private ProbabilityCalculationResult? calculationResult;
    private bool calculationResultIsStale;

    private int ActiveCardCount => cards.Count(card => card.Active);
    private int ActiveCardCopies => cards.Where(card => card.Active).Sum(card => card.Copies);
    private int ActiveComboCount => combos.Count(combo => combo.Active);

    private string? CalculationUnavailableMessage {
        get {
            if (handSize < 1) return "Hand size must be at least 1.";
            if (combos.Any(combo => combo.Active && combo.Cards.Any(requirement =>
                cards.Count(card => card.Id == requirement.CardId) != 1)))
                return "An active combo has a missing card reference. Repair or remove it, or deactivate the combo.";
            if (ActiveCardCount == 0) return "Activate at least one card to calculate.";
            if (cards.Any(card => card.Active && card.Copies < 1))
                return "Each active card must have at least one copy, or be deactivated.";
            if (ActiveCardCopies < handSize)
                return $"The active deck has {ActiveCardCopies} copies, fewer than the hand size of {handSize}.";
            if (ActiveComboCount == 0) return "Activate at least one combo to calculate.";
            if (ActiveComboCount > IProbabilityCalculatorService.MaxComboCount)
                return $"Calculate with at most {IProbabilityCalculatorService.MaxComboCount} active combos. Deactivate or remove extra combos.";
            if (combos.Any(combo => combo.Active && combo.Categories.Count == 0 && combo.Cards.Count == 0))
                return "Complete or deactivate every incomplete active combo before calculating.";
            return null;
        }
    }

    private bool CanCalculate => CalculationUnavailableMessage is null;

    private static string ComboResultDisplayName(ComboProbabilityResult result) =>
        string.IsNullOrWhiteSpace(result.ComboName)
            ? $"Unnamed combo {result.ComboIndex + 1}"
            : result.ComboName;

    private Task ReplaceCard((int Index, Card NewCard) payload) {
        var (i, newCard) = payload;
        cards[i] = newCard;
        InvalidateCalculation();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void MoveCategory((int From, int To) move) {
        if (ListMove.TryMove(categoryBases, move.From, move.To)) InvalidateCalculation();
    }

    private void MoveCard((int From, int To) move) {
        if (!ListMove.TryMove(cards, move.From, move.To)) return;
        activeCardIndex = ListMove.AdjustActiveIndex(activeCardIndex, move.From, move.To);
        InvalidateCalculation();
    }

    private void MoveCombo((int From, int To) move) {
        if (!ListMove.TryMove(combos, move.From, move.To)) return;
        activeComboIndex = ListMove.AdjustActiveIndex(activeComboIndex, move.From, move.To);
        InvalidateCalculation();
    }

    private void MoveGroup((int From, int To) move) {
        if (ListMove.TryMove(comboGroups, move.From, move.To)) InvalidateCalculation();
    }

    private void RemoveCard(int index) {
        if (index < 0 || index >= cards.Count) return;
        cards.RemoveAt(index);
        InvalidateCalculation();
        if (activeCardIndex == index) activeCardIndex = -1;
        else if (activeCardIndex > index) activeCardIndex--;
    }

    private void AddNewCard() {
        cards.Add(new Card([]));
        InvalidateCalculation();
        activeCardIndex = cards.Count - 1;
    }

    private Task ReplaceCombo((int Index, Combo NewCombo) payload) {
        var (i, newCombo) = payload;
        combos[i] = newCombo;
        InvalidateCalculation();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void RemoveCombo(int index) {
        if (index < 0 || index >= combos.Count) return;
        combos.RemoveAt(index);
        InvalidateCalculation();
        if (activeComboIndex == index) activeComboIndex = -1;
        else if (activeComboIndex > index) activeComboIndex--;
    }

    private void AddNewCombo() {
        combos.Add(new Combo(new List<ComboCategory>()));
        InvalidateCalculation();
        activeComboIndex = combos.Count - 1;
    }

    private void DuplicateCombo(int index) {
        if (index < 0 || index >= combos.Count) return;

        var source = combos[index];
        var duplicate = new Combo(
            source.Categories.Select(category => new ComboCategory(
                category.BaseCategory,
                category.MinCount,
                category.MaxCount)),
            GetDuplicateComboName(source.Name),
            source.Active,
            source.GroupId,
            source.Cards.Select(card => new ComboCard(card.CardId, card.MinCount, card.MaxCount)));

        var duplicateIndex = index + 1;
        combos.Insert(duplicateIndex, duplicate);
        InvalidateCalculation();
        activeComboIndex = duplicateIndex;
    }

    private string? GetDuplicateComboName(string? sourceName) {
        if (string.IsNullOrWhiteSpace(sourceName)) return null;

        var usedNames = combos
            .Where(combo => !string.IsNullOrWhiteSpace(combo.Name))
            .Select(combo => combo.Name!)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        var baseName = $"{sourceName} copy";
        if (!usedNames.Contains(baseName)) return baseName;

        for (var suffix = 2L; ; suffix++) {
            var candidate = $"{baseName} {suffix}";
            if (!usedNames.Contains(candidate)) return candidate;
        }
    }

    private void AddGroup(string name) {
        comboGroups.Add(new ComboGroup(Guid.NewGuid().ToString("N"), name));
        InvalidateCalculation();
        StateHasChanged();
    }

    private void RenameGroup((string Id, string Name) payload) {
        var index = comboGroups.FindIndex(group => group.Id == payload.Id);
        if (index < 0) return;
        comboGroups[index] = comboGroups[index] with { Name = payload.Name };
        InvalidateCalculation();
        StateHasChanged();
    }

    private void RemoveGroup(string id) {
        if (comboGroups.RemoveAll(group => group.Id == id) == 0) return;
        foreach (var combo in combos.Where(combo => combo.GroupId == id))
            combo.GroupId = null;
        InvalidateCalculation();
        StateHasChanged();
    }

    private Task RenameCategoryBase((CategoryBase OldCategory, CategoryBase NewCategory) payload) {
        var (oldCategory, newCategory) = payload;
        if (oldCategory.Source != CategorySource.User || newCategory.Source != CategorySource.User) return Task.CompletedTask;
        var categoryIndex = categoryBases.FindIndex(category => ReferenceEquals(category, oldCategory));
        if (categoryIndex < 0) return Task.CompletedTask;

        if (categoryColorIndices.Remove(oldCategory.Name, out var colorIndex))
            categoryColorIndices[newCategory.Name] = colorIndex;

        categoryBases[categoryIndex] = newCategory;

        foreach (var card in cards) {
            for (var i = 0; i < card.Categories.Count; i++) {
                if (card.Categories[i].Identity.Equals(oldCategory.Identity, StringComparison.Ordinal))
                    card.Categories[i] = newCategory;
            }
        }

        foreach (var combo in combos) {
            for (var i = 0; i < combo.Categories.Count; i++) {
                var constraint = combo.Categories[i];
                if (constraint.BaseCategory.Identity.Equals(oldCategory.Identity, StringComparison.Ordinal)) {
                    combo.Categories[i] = new ComboCategory(
                        newCategory,
                        constraint.MinCount,
                        constraint.MaxCount);
                }
            }
        }

        categoryRename = new CategoryRenameNotice(++categoryRenameVersion, oldCategory.Name, newCategory.Name);
        return Task.CompletedTask;
    }

    private void HandleCategoriesChanged() {
        ReconcileCategoryColorIndices();
        OnCategoriesChanged();
        StateHasChanged();
    }

    private Task SetCategoryColor((string CategoryName, int ColorIndex) change) {
        if (!CategoryColorPalette.IsValidIndex(change.ColorIndex) ||
            !categoryBases.Any(category => category.Source == CategorySource.User &&
                category.Name.Equals(change.CategoryName, StringComparison.Ordinal)))
            return Task.CompletedTask;

        categoryColorIndices[change.CategoryName] = change.ColorIndex;
        return Task.CompletedTask;
    }

    private void ReconcileCategoryColorIndices() {
        var activeCategoryNames = categoryBases.Concat(cards.SelectMany(card => card.Categories))
            .Concat(combos.SelectMany(combo => combo.Categories).Select(category => category.BaseCategory))
            .Where(category => category.Source == CategorySource.User).Select(category => category.Name)
            .Distinct(StringComparer.Ordinal)
            .ToList();
        var activeNames = activeCategoryNames.ToHashSet(StringComparer.Ordinal);

        foreach (var staleName in categoryColorIndices.Keys.Where(name => !activeNames.Contains(name)).ToArray())
            categoryColorIndices.Remove(staleName);

        var assignedIndices = new HashSet<int>();
        var assignedCategoryCount = 0;
        foreach (var categoryName in activeCategoryNames) {
            if (!categoryColorIndices.TryGetValue(categoryName, out var existingIndex) ||
                !CategoryColorPalette.IsValidIndex(existingIndex))
                continue;

            // Existing palette choices are intentional even when categories share a color.
            assignedIndices.Add(existingIndex);
            assignedCategoryCount++;
        }

        foreach (var categoryName in activeCategoryNames) {
            if (categoryColorIndices.TryGetValue(categoryName, out var existingIndex) &&
                CategoryColorPalette.IsValidIndex(existingIndex))
                continue;

            var nextIndex = CategoryColorPalette.FirstAvailableIndex(assignedIndices, assignedCategoryCount++);
            categoryColorIndices[categoryName] = nextIndex;
            assignedIndices.Add(nextIndex);
        }
    }

    private void RestoreCategoryColorIndices(SessionState session) {
        categoryColorIndices.Clear();
        if (session.CategoryColorIndices is not null) {
            foreach (var (categoryName, colorIndex) in session.CategoryColorIndices) {
                if (!string.IsNullOrWhiteSpace(categoryName) && CategoryColorPalette.IsValidIndex(colorIndex))
                    categoryColorIndices[categoryName] = colorIndex;
            }
        }

        ReconcileCategoryColorIndices();
    }

    private async Task Calculate() {
        if (!CanCalculate) return;

        var requestVersion = calculationVersion;
        var activeCards = cards.Where(card => card.Active).ToList();
        var activeCombos = combos.Where(combo => combo.Active).ToList();
        var requestedGroups = comboGroups.ToList();
        var requestedHandSize = handSize;

        try {
            isCalculating = true;
            errorMessage = null;
            StateHasChanged();

            var result = await Task.Run(() => _probabilityCalculator.CalculateProbabilityResults(
                activeCards,
                activeCombos,
                requestedHandSize,
                requestedGroups
            ));
            if (requestVersion == calculationVersion) {
                calculationResult = result;
                calculationResultIsStale = false;
            }
        }
        catch (OperationCanceledException) {
            if (requestVersion == calculationVersion)
                errorMessage = "Calculation was cancelled.";
        }
        catch (ProbabilityCalculationLimitException ex) {
            if (requestVersion == calculationVersion)
                errorMessage = ex.Message;
        }
        catch (Exception ex) {
            if (requestVersion == calculationVersion)
                errorMessage = $"Calculation failed: {ex.Message}";
        }
        finally {
            isCalculating = false;
        }
    }

    private async Task ImportDeckAsync(InputFileChangeEventArgs e) {
        try {
            importError = null;
            var importedCards = await _deckImportService.ImportDeckFromYdkAsync(e.File);
            ReplaceImportedDeck(importedCards);
        }
        catch (Exception ex) {
            importError = $"Failed to import deck: {ex.Message}";
        }
    }

    private void OpenYdkeImport() {
        importError = null;
        ydkeCode = string.Empty;
        isYdkeImportOpen = true;
    }

    private void CancelYdkeImport() {
        importError = null;
        ydkeCode = string.Empty;
        isYdkeImportOpen = false;
    }

    private async Task ImportYdkeAsync() {
        try {
            importError = null;
            var importedCards = await _deckImportService.ImportDeckFromYdkeAsync(ydkeCode);
            ReplaceImportedDeck(importedCards);
            ydkeCode = string.Empty;
            isYdkeImportOpen = false;
        }
        catch (Exception ex) {
            importError = $"Failed to import deck: {ex.Message}";
        }
    }

    private void ReplaceImportedDeck(List<Card> importedCards) {
        cards.Clear();
        cards.AddRange(importedCards);
        InvalidateCalculation(clearPreviousResult: true);
        activeCardIndex = -1;
    }

    private async Task SaveSession(string fileName) {
        try {
            var session = new SessionState {
                Categories = categoryBases,
                Cards = cards,
                Combos = combos,
                ComboGroups = comboGroups,
                HandSize = handSize,
                CategoryColorIndices = new(categoryColorIndices, StringComparer.Ordinal)
            };

            await _sessionService.SaveSessionAsync(session, fileName);
        }
        catch (Exception ex) {
            errorMessage = $"Failed to save session: {ex.Message}";
        }
    }

    private async Task LoadSessionFile(InputFileChangeEventArgs e) {
        try {
            var file = e.File;
            using var streamReader = new StreamReader(file.OpenReadStream());
            var fileContent = await streamReader.ReadToEndAsync();

            var session = await _sessionService.LoadSessionAsync(fileContent);

            await RestoreSessionDataAsync(session);
            activeCardIndex = -1;
            activeComboIndex = -1;
            InvalidateCalculation(clearPreviousResult: true);
            sessionVersion++;
        }
        catch (Exception ex) {
            errorMessage = $"Failed to load session: {ex.Message}";
        }
    }

    private async Task SaveCurrentSession() {
        var fileName = $"calculator_session_{DateTime.Now:yyyyMMdd_HHmmss}.json";
        await SaveSession(fileName);
    }

    private async Task RestoreSessionDataAsync(SessionState session) {
        if (session.Cards.Select(card => card.Id).Distinct(StringComparer.Ordinal).Count() != session.Cards.Count)
            throw new InvalidOperationException("Session contains duplicate card IDs.");
        await _legacyMetadataEnricher.EnrichAsync(session);
        categoryBases.Clear();
        categoryBases.AddRange(session.Categories.Where(category => category.Source == CategorySource.User));

        cards.Clear();
        cards.AddRange(session.Cards);

        combos.Clear();
        combos.AddRange(session.Combos);
        comboGroups.Clear();
        comboGroups.AddRange(session.ComboGroups ?? []);

        RestoreCategoryColorIndices(session);
        handSize = session.HandSize;
    }

    private void OnHandSizeChanged() => InvalidateCalculation();

    private void OnCategoriesChanged() => InvalidateCalculation();

    private void InvalidateCalculation(bool clearPreviousResult = false) {
        calculationVersion++;
        if (clearPreviousResult) {
            calculationResult = null;
            calculationResultIsStale = false;
        }
        else if (calculationResult is not null) {
            calculationResultIsStale = true;
        }
        errorMessage = null;
    }

    protected override async Task OnInitializedAsync() {
        if (_pendingSessionService.PendingSession is { } session) {
            try {
                await RestoreSessionDataAsync(session);

                _pendingSessionService.PendingSession = null;
            }
            catch (Exception ex) {
                errorMessage = $"Failed to load example session: {ex.Message}";
            }
        }

        await base.OnInitializedAsync();
    }

}
