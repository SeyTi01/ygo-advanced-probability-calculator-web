<div class="requirement-or-group @(Nested ? "expression-group-nested" : null)" role="group" aria-label="@Label">
    @ChildContent
</div>

@code {
    [Parameter] public string Label { get; set; } = UiText.Get("Ui.AlternativeGroup");
    [Parameter] public bool Nested { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
