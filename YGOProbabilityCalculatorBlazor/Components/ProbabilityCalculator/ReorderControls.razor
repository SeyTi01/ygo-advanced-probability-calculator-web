<span class="reorder-controls" role="group" aria-label="Reorder @ItemLabel">
    <button @ref="_upButton" type="button" class="reorder-button" disabled="@(Index == 0)"
            aria-label="Move @ItemLabel @PreviousDirection" title="Move @ItemLabel @PreviousDirection"
            @onclick="() => Move(-1)">@PreviousGlyph</button>
    <button @ref="_downButton" type="button" class="reorder-button" disabled="@(Index >= Count - 1)"
            aria-label="Move @ItemLabel @NextDirection" title="Move @ItemLabel @NextDirection"
            @onclick="() => Move(1)">@NextGlyph</button>
</span>

@code {
    [Parameter] public int Index { get; set; }
    [Parameter] public int Count { get; set; }
    [Parameter] public string ItemLabel { get; set; } = string.Empty;
    [Parameter] public bool Horizontal { get; set; }
    [Parameter] public EventCallback<(int From, int To)> OnMove { get; set; }

    private ElementReference _upButton;
    private ElementReference _downButton;
    private int _pendingFocus;

    private string PreviousDirection => Horizontal ? "left" : "up";
    private string NextDirection => Horizontal ? "right" : "down";
    private string PreviousGlyph => Horizontal ? "◀" : "▲";
    private string NextGlyph => Horizontal ? "▶" : "▼";

    private async Task Move(int direction) {
        int target = Index + direction;

        if (target < 0 || target >= Count) {
            return;
        }

        _pendingFocus = direction;
        await OnMove.InvokeAsync((Index, target));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (_pendingFocus == 0) {
            return;
        }

        int direction = _pendingFocus;
        _pendingFocus = 0;

        if (direction < 0) {
            await (Index == 0 ? _downButton : _upButton).FocusAsync();
        }
        else {
            await (Index >= Count - 1 ? _upButton : _downButton).FocusAsync();
        }
    }
}
