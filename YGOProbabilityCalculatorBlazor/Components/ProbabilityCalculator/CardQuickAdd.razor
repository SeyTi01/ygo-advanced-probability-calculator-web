@using YGOProbabilityCalculatorBlazor.Models
@using YGOProbabilityCalculatorBlazor.Services.CardEffects
@inject YGOProbabilityCalculatorBlazor.Services.Interface.ICardInfoService CardInfoService

<div class="quick-add layout-section">
    <div class="quick-add-row layout-row layout-input-action" @oninput:stopPropagation="true">
        <CardSearchInput @ref="_search" Value="@_name" Label="@(UiText.Get("Ui.AddCardByName"))" Placeholder="@(UiText.Get("Card.SearchPlaceholder"))"
                         OnInput="NameChanged" OnSelected="AddCatalogCard" OnSubmit="AddManualCard" />
        <AddAction AccessibleLabel="@(UiText.Get("Ui.AddCard"))" Disabled="@string.IsNullOrWhiteSpace(_name)" OnClick="AddManualCard" />
    </div>
    @if (_status.Length > 0) {
        <span class="visually-hidden" role="status">@_status</span>
    }
</div>

@code {
    [Parameter] public EventCallback<Card> OnAdd { get; set; }
    private CardSearchInput? _search;
    private string _name = string.Empty;
    private string _status = string.Empty;

    private Task NameChanged(string value) {
        _name = value;
        StateHasChanged();

        return Task.CompletedTask;
    }

    private Task AddCatalogCard(CardInfo card) => Add(
        CardEffectRegistry.Default.CreateImportedCard(card, 1, card.Id),
        DisplayLabels.Card(card, CardInfoService)
    );

    private Task AddManualCard() => string.IsNullOrWhiteSpace(_name)
        ? Task.CompletedTask
        : Add(new Card([], name: _name.Trim()));

    private async Task Add(Card card, string? displayName = null) {
        await OnAdd.InvokeAsync(card);
        _status = UiText.Format("Ui.Added0", displayName ?? card.Name);
        _name = string.Empty;
        if (_search is not null) {
            await _search.ResetAsync();
        }
    }
}
