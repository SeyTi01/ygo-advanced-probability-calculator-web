<section class="alert alert-secondary mt-4 pinned-result" aria-labelledby="pinnedResultHeading">
    <div class="pinned-heading">
        <h5 id="pinnedResultHeading">@(UiText.Get("Ui.PinnedResult"))</h5>
        <button type="button" class="btn btn-sm btn-outline-secondary result-icon-action" title="@(UiText.Get("Ui.UnpinResult"))" aria-label="@(UiText.Get("Ui.UnpinResult"))" @onclick="OnClear"><PinIcon Slashed="true" /></button>
    </div>
    <CalculationAccuracyResult Context="Snapshot.Context" ModeDescription="@Snapshot.Context.ModeDescription" Contract="Snapshot.Contract" />
    <CalculationAccuracyDetails />

    <ProbabilityResultBody Projection="ProbabilityResultProjection.Create(Snapshot)" Contract="Snapshot.Contract" Certificate="Snapshot.SearchAvailability" Pinned="true" />
</section>

@code {
    [Parameter, EditorRequired] public PinnedResultSnapshot Snapshot { get; set; } = null!;
    [Parameter] public EventCallback OnClear { get; set; }
}
