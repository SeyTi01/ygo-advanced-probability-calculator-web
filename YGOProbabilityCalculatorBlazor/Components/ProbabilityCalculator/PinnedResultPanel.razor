<section class="alert alert-secondary mt-3 pinned-result" aria-labelledby="pinnedResultHeading">
    <div class="pinned-heading">
        <h5 id="pinnedResultHeading">Pinned result</h5>
        <button type="button" class="btn btn-sm btn-outline-secondary" title="Unpin result" aria-label="Unpin result" @onclick="OnClear"><PinIcon Slashed="true" /></button>
    </div>
    <p class="small text-body-secondary mb-2">@Snapshot.Context.Description</p>
    <CalculationAccuracyResult Contract="Snapshot.Contract" />

    <div class="pinned-row pinned-total">
        <span>Any active combo</span><ProbabilityValue Probability="Snapshot.Total" Contract="Snapshot.Contract" Certificate="Snapshot.SearchAvailability" ValueClass="probability-total-value" />
    </div>
    @foreach (PinnedGroupRow group in Snapshot.Groups) {
        <section class="pinned-group">
            <h6 class="pinned-row">
                <span>@group.Label <small class="text-body-secondary fw-normal">(@group.ActiveCount active)</small></span>
                <ProbabilityValue Probability="group.Probability" Contract="Snapshot.Contract" Certificate="Snapshot.SearchAvailability" Row="ProbabilityRow.Group" Index="@Snapshot.Groups.IndexOf(group)" />
            </h6>
            @if (Current is not null) {
                string groupMatch = Snapshot.CompareGroup(group, Current, false);
                if (groupMatch != "Comparable") {
                    <small class="pinned-match">@groupMatch</small>
                }
            }
            <ol class="pinned-list pinned-members">
                @foreach (PinnedComboRow row in Snapshot.Combos.Where(combo => combo.GroupId == group.Id)) {
                    <li>
                        <div class="pinned-row">
                            <span>@row.Label</span>
                            <ProbabilityValue Probability="row.Probability" Contract="Snapshot.Contract" Certificate="Snapshot.SearchAvailability" Row="ProbabilityRow.Combo" Index="row.Index" />
                        </div>
                        @if (Current is not null) {
                            string match = Snapshot.CompareCombo(row, Current, false);
                            if (match != "Comparable") {
                                <small class="pinned-match">@match</small>
                            }
                        }
                    </li>
                }
            </ol>
        </section>
    }
    @if (Snapshot.Groups.IsEmpty || Snapshot.Combos.Any(combo => combo.GroupId is null || !Snapshot.Groups.Any(group => group.Id == combo.GroupId))) {
        <h6>@(Snapshot.Groups.IsEmpty ? "Individual combos" : "Ungrouped combos")</h6>
        <ol class="pinned-list">
            @foreach (PinnedComboRow row in Snapshot.Combos.Where(combo => combo.GroupId is null || !Snapshot.Groups.Any(group => group.Id == combo.GroupId))) {
                <li>
                    <div class="pinned-row">
                        <span>@row.Label</span>
                        <ProbabilityValue Probability="row.Probability" Contract="Snapshot.Contract" Certificate="Snapshot.SearchAvailability" Row="ProbabilityRow.Combo" Index="row.Index" />
                    </div>
                    @if (Current is not null) {
                        string match = Snapshot.CompareCombo(row, Current, false);
                        if (match != "Comparable") {
                            <small class="pinned-match">@match</small>
                        }
                    }
                </li>
            }
        </ol>
    }
</section>

@code {
    [Parameter, EditorRequired] public PinnedResultSnapshot Snapshot { get; set; } = null!;
    [Parameter] public PinnedResultSnapshot? Current { get; set; }
    [Parameter] public EventCallback OnClear { get; set; }
}
