root = true

[*.cs]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
# Only rules repaired by scripts/style/fix.ps1 belong in this policy.
csharp_prefer_braces = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = false:suggestion
csharp_style_var_elsewhere = false:suggestion

dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion
dotnet_style_prefer_collection_expression = when_types_exactly_match:suggestion
# IDE0028 handles empty/initialized constructors; disable its traditional initializer fallback.
dotnet_style_collection_initializer = false:none
dotnet_style_prefer_simplified_boolean_expressions = true:suggestion

dotnet_diagnostic.IDE0001.severity = suggestion
dotnet_diagnostic.IDE0002.severity = suggestion
dotnet_diagnostic.IDE0003.severity = suggestion
dotnet_diagnostic.IDE0004.severity = suggestion
dotnet_diagnostic.IDE0005.severity = suggestion
dotnet_diagnostic.IDE0008.severity = suggestion
dotnet_diagnostic.IDE0011.severity = suggestion
dotnet_diagnostic.IDE0028.severity = suggestion
dotnet_diagnostic.IDE0034.severity = suggestion
dotnet_diagnostic.IDE0060.severity = none
dotnet_diagnostic.IDE0075.severity = suggestion
dotnet_diagnostic.IDE0090.severity = suggestion
dotnet_diagnostic.IDE0300.severity = suggestion
dotnet_diagnostic.IDE0301.severity = suggestion
dotnet_diagnostic.IDE0302.severity = suggestion
dotnet_diagnostic.IDE0303.severity = suggestion
dotnet_diagnostic.IDE0304.severity = suggestion
dotnet_diagnostic.IDE0305.severity = suggestion
dotnet_diagnostic.IDE0306.severity = suggestion
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.CA1851.severity = none
# Keep primary constructors deferred while Info-level style cleanup runs.
dotnet_diagnostic.IDE0290.severity = none

# JetBrains syntax style: always use braces for ordinary control flow.
resharper_csharp_braces_for_ifelse = required
resharper_csharp_braces_for_for = required
resharper_csharp_braces_for_foreach = required
resharper_csharp_braces_for_while = required
resharper_csharp_braces_for_dowhile = required
resharper_csharp_braces_for_using = required
resharper_csharp_braces_for_lock = required
resharper_csharp_braces_for_fixed = required
resharper_csharp_space_after_logical_not_op = true

# Disable inspection-only findings; interactive quick-fixes are not a lint contract.
resharper_member_can_be_made_static_local_highlighting = none
resharper_member_can_be_made_static_global_highlighting = none
resharper_unused_parameter_local_highlighting = none
resharper_unused_parameter_global_highlighting = none
resharper_possible_multiple_enumeration_highlighting = none
resharper_condition_is_always_true_or_false_highlighting = none
resharper_condition_is_always_true_or_false_according_to_nullable_api_contract_highlighting = none

# Keep invocation arguments and formal parameters together or chop them one per line.
# CI verifies already-wrapped lists/dots and the custom foreach layout.
# Length-driven wrapping and general continuation indentation are local fixer preferences.
# Keep long fluent chains compact until wrapping, with leading dots and aligned closures.
resharper_csharp_wrap_chained_method_calls = chop_if_long
resharper_csharp_wrap_after_dot_in_method_calls = false
resharper_csharp_wrap_before_invocation_rpar = true
resharper_csharp_wrap_before_declaration_rpar = true
resharper_csharp_wrap_arguments_style = chop_if_long
resharper_csharp_wrap_parameters_style = chop_if_long
resharper_csharp_wrap_after_declaration_lpar = true

# JetBrains formatting: one blank line around methods/local functions,
# before and after block statements, and before control-transfer statements;
# cap retained blank-line runs at one.
resharper_csharp_blank_lines_around_invocable = 1
resharper_csharp_blank_lines_around_single_line_invocable = 1
resharper_csharp_blank_lines_around_local_method = 1
resharper_csharp_blank_lines_around_single_line_local_method = 1
resharper_csharp_blank_lines_before_block_statements = 1
resharper_csharp_blank_lines_after_block_statements = 1
resharper_csharp_blank_lines_before_control_transfer_statements = 1
resharper_csharp_keep_blank_lines_in_code = 1
resharper_csharp_keep_blank_lines_in_declarations = 1
