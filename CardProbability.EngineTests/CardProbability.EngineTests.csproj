<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.4.0" />
    <Using Include="NUnit.Framework" />
    <!-- The engine remains embedded in the application until package substitution. -->
    <ProjectReference Include="../YGOProbabilityCalculatorBlazor/YGOProbabilityCalculatorBlazor.csproj" />
    <None Update="Fixtures/Data/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
